form sher
{

			datasource = zoho_sheet_records
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			age
			(
				datasource field = age
				displayname = "Age"
	 			row = 1
	 			column = 1   
				width = medium
			)
			names
			(
				datasource field = names
				displayname = "Names"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}