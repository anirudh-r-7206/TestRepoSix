void initial.seedEmailTemplates()
{

                 	templates = List();
                 	templates.add({"Template_Name":"Training_Request_Rejected","Subject_field":"Training Request Rejected – ${Training_Name}","Email_Content":"<div>Hello, <br /></div><div><br /></div><div>The training request for ${Training_Name}, which is a ${Training_Type} training, has been rejected for ${Staff_Name}.<br /></div><div><br /></div><div>Rejected By: ${Rejected_By} <br /></div><div>Reason: ${Rejection_Reason}<br /></div><div><br /></div><div>Regards, <br /></div><div>Admin<br /></div>"});
                 	templates.add({"Template_Name":"Training_Request_Approved","Subject_field":"Training Request Approved – ${Training_Name}","Email_Content":"<div>Hello, <br /></div><div><br /></div><div>The training request for <b>${Training_Name}</b>, which is a ${Training_Type} training, has been approved for ${Staff_Name}.<br /></div><div><br /></div><div>Regards, <br /></div><div>Admin<br /></div>"});
                 	templates.add({"Template_Name":"Training_Approval_Pending","Subject_field":"Training Request Pending for Approval – ${Training_Name}","Email_Content":"<div><span>Hello ${Approver_Name},</span><br /></div><div><br /></div><div><span>A training request for ${Training_Name}, which is a ${Training_Type} training, has been submitted for ${Staff_Name} by ${Raised_By}.</span><br /></div><div><br /></div><div><span>The request is currently pending for your approval. Kindly approve or reject the request.</span><br /></div><div><br /></div><div><span>Regards, </span><br /></div><div><span>Admin</span><br /></div>"});
                 	templates.add({"Template_Name":"Accreditation_Renewal_Email","Subject_field":"New Accreditation Added – ${Staff_Name}","Email_Content":"<p>Hello <b>${Staff_Name}</b>,<br /></p><p>A new accreditation for <b>${Accreditation_Name}</b> has been added for you.<br /></p><p>Please click below to view and complete your pending trainings.<br /></p><p><b>${Accreditation_Link}</b><br /></p><p>Regards, <br />Admin<br /></p><div><br /></div>"});
                 	templates.add({"Template_Name":"Accreditation_Expiring_Reminder_Admin","Subject_field":"Accreditation Expiring – ${Staff_Name}","Email_Content":"<p>Hello,<br /></p><p><b>${Staff_Name}</b>'s accreditation for <b>${Accreditation_Name}</b> will expire on <b>${Due_Date}</b>.<br /></p><p>Please update and plan the next accreditation for this staff.<br /></p><p>Click below to change the next accreditation.<br /></p><p><b>${Accreditation_Link}</b><br /></p><p>Regards,<br />Admin<br /></p><div><br /></div>"});
                 	templates.add({"Template_Name":"Accreditation_Expiring_Reminder_Staff","Subject_field":"Accreditation Expiring – ${Staff_Name}","Email_Content":"<p>Hello <b>${Staff_Name}</b>,<br /></p><p>Your accreditation for <b>${Accreditation_Name}</b> will expire on <b>${Due_Date}</b>.<br /></p><p>Please plan accordingly.<br /></p><p>Regards, <br />Admin<br /></p><div><br /></div>"});
                 	templates.add({"Template_Name":"Accreditation_Not_Completed_Reminder","Subject_field":"Accreditation Pending – ${Staff_Name}","Email_Content":"<p>Hello <b>${Staff_Name}</b>,<br /></p><p>Your accreditation for <b>${Accreditation_Name}</b> is due on <b>${Due_Date}</b> and has not been completed yet.<br /></p><p>Please complete your training to ensure compliance.<br /></p><p>Regards, <br />Admin<br /></p><div><br /></div>"});
                 	templates.add({"Template_Name":"Sabbatical_Return","Subject_field":"Staff Returned from Leave – ${Staff_Name}","Email_Content":"<p>Hello,<br /></p><p><b>${Staff_Name}</b> has returned from leave and is now active in the system.<br /></p><p>The return has been processed on <b>${Effective_To}</b>.<br /></p><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	templates.add({"Template_Name":"Request_Processed","Subject_field":"Staff Request Processed – ${Request_Type}","Email_Content":"<p>Hello,<br /></p><p>The <b>${Request_Type}</b> request for <b>${Staff_Name}</b> has been processed and applied in the system on <b>${Effective_Date}</b>.<br /></p><p>The request was raised by <b>${Raised_By}</b>.<br /></p><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	templates.add({"Template_Name":"Request_Rejected","Subject_field":"Staff Request Rejected – ${Request_Type}","Email_Content":"<p>Hello,<br /></p><p>The <b>${Request_Type}</b> request for <b>${Staff_Name}</b> has been rejected.<br /></p><p>The request was raised by <b>${Raised_By}</b>.<br /></p><div>Rejected By: <b>${Rejected_By}</b><br /></div><div>Reason: <b>${Rejection_Reason}</b><br /></div><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	templates.add({"Template_Name":"Request_Submitted","Subject_field":"Staff Request Submitted – ${Request_Type}","Email_Content":"<p>Hello,<br /></p><p>The <b>${Request_Type}</b> request for <b>${Staff_Name}</b> has been successfully submitted by <b>${Raised_By}</b>.<br /></p><p>This request is currently under review and pending approval. You will be notified once the request is approved or rejected.<br /></p><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	templates.add({"Template_Name":"Request_Approved","Subject_field":"Staff Request Approved – ${Request_Type}","Email_Content":"<p>Hello,<br /></p><p>The <b>${Request_Type}</b> request for <b>${Staff_Name}</b> has been approved.<br /></p><p>The request was raised by <b>${Raised_By}</b> and is scheduled to take effect on <b>${Effective_Date}</b>.<br /></p><p>No further action is required.<br /></p><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	templates.add({"Template_Name":"Approval_Pending","Subject_field":"Staff Request Pending – ${Request_Type}","Email_Content":"<p>Hello <b>${Approver_Name}</b>,<br /></p><p>A <b>${Request_Type}</b> request for <b>${Staff_Name}</b> is pending your approval.<br /></p><p>The request was raised by <b>${Raised_By}</b> and is scheduled to take effect on <b>${Effective_Date}</b>.<br /></p><p>Please log in to the system and take the necessary action.<br /></p><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	templates.add({"Template_Name":"Request_Raised","Subject_field":"Staff Request Submitted – ${Request_Type}","Email_Content":"<p>Hello <b>${Approver_Name}</b>,<br /></p><p>A new <b>${Request_Type}</b> request has been submitted for <b>${Staff_Name}</b> by <b>${Raised_By}</b>.<br /></p><p>The request is scheduled to take effect on <b>${Effective_Date}</b> and is now awaiting your review and approval.<br /></p><p>Please log in to the system to review the details and take the necessary action.<br /></p><div>Regards,<br /></div><div> <b>Admin</b><br /></div>"});
                 	for each  template in templates
                 	{
                 		existing = Email_Templates[Template_Name == template.get("Template_Name")];
                 		if(existing.count() == 0)
                 		{
                 			addEmail = insert into Email_Templates
                 			[
                 				Added_User=zoho.loginuser
                 				Template_Name=template.get("Template_Name")
                 				Email_Content=template.get("Email_Content")
                 				Subject_field=template.get("Subject_field")
                 			];
                 		}
                 	}
                 
}