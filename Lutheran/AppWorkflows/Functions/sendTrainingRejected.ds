void mail.sendTrainingRejected(int requestId, string rejectionReason, string rejectedBy)
{

			
			                 	req = Training_Completion_Request[ID == requestId];
			                 	if(req.count() > 0)
			                 	{
			                 		staffRec = Staff_Master[ID == req.Staff];
			                 		if(staffRec.count() > 0)
			                 		{
			                 			template = Email_Templates[Template_Name == "Training_Request_Rejected"];
			                 			if(template.count() > 0)
			                 			{
			                 				/* VALUES */
			                 				staffName = "";
			                 				if(req.Staff != null)
			                 				{
			                 					staffName = req.Staff.Name;
			                 				}
			                 				trainingName = "";
			                 				if(req.Training_Name != null)
			                 				{
			                 					trainingName = req.Training_Name;
			                 				}
			                 				trainingType = "";
			                 				if(req.Training_Type != null)
			                 				{
			                 					trainingType = req.Training_Type.Training;
			                 				}
			                 				/* SUBJECT */
			                 				subjectText = template.Subject_field;
			                 				subjectText = subjectText.replaceAll("${Training_Name}",trainingName,true);
			                 				/* CONTENT */
			                 				messageContent = template.Email_Content;
			                 				messageContent = messageContent.replaceAll("${Training_Name}",trainingName,true);
			                 				messageContent = messageContent.replaceAll("${Training_Type}",trainingType,true);
			                 				messageContent = messageContent.replaceAll("${Staff_Name}",staffName,true);
			                 				messageContent = messageContent.replaceAll("${Rejected_By}",rejectedBy,true);
			                 				messageContent = messageContent.replaceAll("${Rejection_Reason}",rejectionReason,true);
			                 				sendmail
			                 				[
			                 					from :zoho.adminuserid
			                 					to :staffRec.Staff_Email
			                 					subject :subjectText
			                 					message :messageContent
			                 				]
			                 			}
			                 		}
			                 	}
			                 
			
}