list checkdata.getDuplicatePhoneWithCount()
{

                 	newNumbers = {"0456011234","0456022345","0456033456","0456044567","0456055678","0456066789","0456077890","0456088901","0456099012","0456100123","0456111234","0456122345","0456133456","0456144567","0456155678","0456166789","0456177890","0456188901","0456199012","0456200123","0456211234","0456222345","0456233456","0456244567","0456255678","0456266789","0456277890","0456288901","0456299012","0456300123","0456311234","0456322345","0456333456","0456344567","0456355678","0456366789","0456377890","0456388901","0456399012","0456400123","0456411234","0456422345","0456433456","0456444567","0456455678","0456466789","0456477890","0456488901","0456499012","0456500123","0456511234","0456522345","0456533456","0456544567","0456555678","0456566789","0456577890","0456588901","0456599012","0456600123","0456611234","0456622345","0456633456","0456644567","0456655678","0456666789","0456677890","0456688901","0456699012","0456700123","0456711234","0456722345","0456733456","0456744567","0456755678","0456766789","0456777890","0456788901","0456799012","0456800123","0456811234","0456822345","0456833456","0456844567","0456855678","0456866789","0456877890","0456888901","0456899012","0456900123","0456911234","0456922345","0456933456","0456944567","0456955678"};
                 	index = 0;
                 	allStaff = Staff_Master[ID != 0];
                 	for each  s in allStaff
                 	{
                 		if(index < newNumbers.size())
                 		{
                 			num = newNumbers.get(index);
                 			/* Convert 04 → +614 */
                 			formattedNum = "+61" + num.subString(1,num.length());
                 			update Staff_Master[ID == s.ID]
                 			[
                 				Phone_Number=formattedNum
                 			];
                 			index = index + 1;
                 		}
                 	}
                 	return newNumbers;
                 
}