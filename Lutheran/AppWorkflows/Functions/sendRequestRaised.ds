void mail.sendRequestRaised(int requestId)
{

			
			                 	req = Staff_Request[ID == requestId];
			                 	if(req.count() > 0)
			                 	{
			                 		getStaff = Staff_Master[ID == req.Raised_by];
			                 		approverList = List();
			                 		if(req.Next_Approver == "School Admin")
			                 		{
			                 			approverList = Staff_Master[Organisation == getStaff.Organisation && Current_Employment == getStaff.Current_Employment && Admin_Type == "School"].Staff_Email.getAll();
			                 		}
			                 		else if(req.Next_Approver == "Region Admin")
			                 		{
			                 			approverList = Staff_Master[Organisation == getStaff.Organisation && Regions == getStaff.Regions && Admin_Type == "Region"].Staff_Email.getAll();
			                 		}
			                 		else if(req.Next_Approver == "National Admin")
			                 		{
			                 			approverList = Staff_Master[Organisation == getStaff.Organisation && Admin_Type == "National"].Staff_Email.getAll();
			                 		}
			                 		if(approverList.size() > 0)
			                 		{
			                 			template = Email_Templates[Template_Name == "Request_Raised"];
			                 			if(template.count() > 0)
			                 			{
			                 				staffName = "";
			                 				if(req.Staff != null)
			                 				{
			                 					staffName = req.Staff.Name;
			                 				}
			                 				raisedBy = "";
			                 				if(req.Raised_by != null)
			                 				{
			                 					raisedBy = req.Raised_by.Name;
			                 				}
			                 				effectiveDate = "";
			                 				if(req.Effective_Date != null)
			                 				{
			                 					effectiveDate = req.Effective_Date.toString("dd-MMM-yyyy");
			                 				}
			                 				subjectText = template.Subject_field;
			                 				subjectText = subjectText.replaceAll("${Request_Type}",req.Request_Type,true);
			                 				messageContent = template.Email_Content;
			                 				messageContent = messageContent.replaceAll("${Approver_Name}",req.Next_Approver,true);
			                 				messageContent = messageContent.replaceAll("${Staff_Name}",staffName,true);
			                 				messageContent = messageContent.replaceAll("${Request_Type}",req.Request_Type,true);
			                 				messageContent = messageContent.replaceAll("${Raised_By}",raisedBy,true);
			                 				messageContent = messageContent.replaceAll("${Effective_Date}",effectiveDate,true);
			                 				sendmail
			                 				[
			                 					from :zoho.adminuserid
			                 					to :approverList
			                 					subject :subjectText
			                 					message :messageContent
			                 				]
			                 			}
			                 		}
			                 	}
			                 
			
}