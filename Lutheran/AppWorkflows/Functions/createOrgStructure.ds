void helpers.createOrgStructure()
{

			
			                 	/* ---------------- NATIONAL ---------------- */
			                 	orgID = insert into Organisation
			                 	[
			                 		logo="https://files.zohopublic.in/public?x-service=ZohoCreator&event-id=251690000002946002_Image&x-cli-"
			                 		organisation_name="India"
			                 		contact_number="+61 412 345 678"
			                 		Added_User=zoho.loginuser
			                 	];
			                 	getOrg = Organisation[ID == orgID];
			                 	/* ---------------- REGION ---------------- */
			                 	regionID = insert into Regions
			                 	[
			                 		Main_Organisation=getOrg.ID
			                 		region_name="South"
			                 		Regional_Office_Email="south@lutheran.org"
			                 		regional_logo="https://files.zohopublic.in/public?x-service=ZohoCreator&event-id=251690000002946004_Image&x-cli-%3D"
			                 		Regional_Office_Address.address_line_1="South Office"
			                 		Regional_Office_Address.address_line_2="Central Block"
			                 		Regional_Office_Address.district_city="Chennai"
			                 		Regional_Office_Address.state_province="Tamil Nadu"
			                 		Regional_Office_Address.postal_Code="600001"
			                 		Regional_Office_Address.country="India"
			                 		Added_User=zoho.loginuser
			                 	];
			                 	getRegion = Regions[ID == regionID];
			                 	/* ---------------- SCHOOL ---------------- */
			                 	schoolID = insert into School
			                 	[
			                 		Region=getRegion.ID
			                 		school_name="Chennai School"
			                 		school_type="Private"
			                 		Commonwealth_Govt_School_ID="SCH1001"
			                 		School_Email="chennai@school.com"
			                 		ABN="ABN123456"
			                 		school_image="https://files.zohopublic.in/public?x-service=ZohoCreator&event-id=251690000002946006_Image&x-cli-%3D"
			                 		school_address.address_line_1="Anna Salai"
			                 		school_address.address_line_2="Near Signal"
			                 		school_address.district_city="Chennai"
			                 		school_address.state_province="Tamil Nadu"
			                 		school_address.postal_Code="600002"
			                 		school_address.country="India"
			                 		Added_User=zoho.loginuser
			                 	];
			                 	getSchool = School[ID == schoolID];
			                 	/* ---------------- CAMPUS ---------------- */
			                 	campusID = insert into Campus
			                 	[
			                 		School=getSchool.ID
			                 		campus_name="Anna Nagar Campus"
			                 		Campus_Email="annanagar@school.com"
			                 		campus_image="https://files.zohopublic.in/public?x-service=ZohoCreator&event-id=251690000002946008_Image&x-cli-"
			                 		campus_address.address_line_1="Anna Nagar Main Road"
			                 		campus_address.address_line_2="Block A"
			                 		campus_address.district_city="Chennai"
			                 		campus_address.state_province="Tamil Nadu"
			                 		campus_address.postal_Code="600040"
			                 		campus_address.country="India"
			                 		Added_User=zoho.loginuser
			                 	];
			                 	info "Organisation structure created successfully";
			                 
			
}