customize
{

	
				layout
				{
					theme = "theme_8"
				}
				font = "lato"
				color options
				{
					name = "custom_color"
					brand color = "#215bcf"
					navigation background color = "#103275"
					type = "custom"
				}
				logo
				{
					preference = "app_icon"
					placement = "left"
				}
			
	
}