.form-view div#s2id_autogen3 {
    width: 100% !important;
	   
}

.form-view div#s2id_autogen5 {
    width: 100% !important;
}
.form-view .select2-container 
 {
    width: 100% !important;
}

.form-view .form-field.clearfix.searchable-lookup.mediumSizeLive.zc-Default {
    border-left: 1px solid #DADADA;
	    padding-left: 13px;
}
.form-view a.select2-choice {
    width: 100% !important;
    border: none !important;
}
.form-view .select2-container .select2-choice:hover{
    box-shadow: unset !important;
	}
