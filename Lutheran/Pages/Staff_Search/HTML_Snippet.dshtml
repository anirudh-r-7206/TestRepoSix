	.zc-pb-tile-column-container.zcp-panel-wrapper > .zcp-row > .zcp-col > .zcp-row:nth-child(3) .zcp-col > span::before{
       content: url("data:image/svg+xml,%3Csvg width='22' height='22' viewBox='0 0 22 22' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M5.4 6H16.6C17.37 6 18 6.6125 18 7.36111V15.5278C18 16.2764 17.37 16.8889 16.6 16.8889H5.4C4.63 16.8889 4 16.2764 4 15.5278V7.36111C4 6.6125 4.63 6 5.4 6Z' stroke='%23194BB2' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M18 7.55566L11 12.2223L4 7.55566' stroke='%23194BB2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C%2Fsvg%3E");
