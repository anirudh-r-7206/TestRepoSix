.form-view .form-field input {
    border: none !important;
    width: 100% !important;
}

.formContainer {
    width: 100%;
}

.form-view .zc-footer-wrapper label.form-label {
    display: none;
}
.form-view .zc-footer-wrapper input.zc-live-primary-btn {
    margin: 0;
    margin-left: 30px;
    display: flex;
    width: 93px;
    height: 40px;
    padding: 8px 12px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 8px !important;
    font-size: 14px;
    font-weight: 500;
}

.form-view .zc-dem-container .inner .form-outer-wrapper>.row {
    border-radius: unset !important;
}

.form-view .zc-dem-container .inner .form-outer-wrapper form.form-table {
    border-radius: unset !important;
}

.form-view .formColumn .form-group {
    flex: 1;
}

.form-view .form-group .form-field {
    width: 100% !important;
}

.form-view .zc-form-fullheight {
    display: block !important;
    height: 100%;
    width: 100%;
}

.form-view .form-outer-wrapper {
    height: 100% !important;
    width: 100%;
}

.inner .zc-page-content-wrapper .zc-pb-page-content-wrapper .form-table .formContainer {
    height: 100% !important;
}

.form-view .zc-form-scroll-wrapper {
    height: 100%;
}

.form-view .form-view .zc-form-scroll-wrapper div[elname="formRow"] {
    height: 100%;
}

.form-view .form-field input {
    height: 100% !important;
    min-height: 100% !important;
}

 .form-view .form-group .form-field {
    height: 100% !important;
}

.form-view .form-group:is(.zc-focus, .zc-label-float) label{
    display: none !important;
}
