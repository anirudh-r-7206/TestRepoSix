<%
	bgimg = "https://creatorapp.zohopublic.com/jumpstartteam/jaztest/report/All_Public_Images/4235496000029151002/Files/download-file/hspRKS5HmZJrBG9RnW7mzmZnxFGmsxBFHsNPzUM5yTgGt50pBTwnCQEUuQKVRnjjrgyd1aC08QApSSVvW5S43Qh1AkWyhpxq950R?filepath=/1775736609864125_Lutheran_BG.svg&digestValue=eyJsYW5ndWFnZSI6ImVuIn0=";
	var = thisapp.permissions.loginUserProfile();
	getStaff = Staff_Master[Staff_Email == zoho.loginuserid];
	if(false)
	{
		openUrl("#Page:Initial_Setup","same window");
	}
	else if(zoho.loginuserid == zoho.adminuserid || var == "Administrator")
	{
		if(getStaff.count() == 0)
		{
			if(zoho.loginuserid == zoho.adminuserid)
			{
				openUrl("#Page:Staff_Admin_Entry","same window");
			}
			else
			{
				openUrl("#Page:Embed_Page","same window");
			}
		}
	}
	else if(getStaff.count() == 0)
	{
		openUrl("#Page:Not_Registered","same window");
	}
	%>
<style>
* {
    padding: 0;
    margin: 0;
    border: none;
}
div#zppagesLive,
div#elementsContainer,
.Layout.elemContainment,
div#row_1,
.zc-pb-formreport-placeholder {
    height: 100% !important;
}
.Layout.elemContainment {
    padding: unset !important;
}
.sd-fullContainer {
    height: 100%;
    width: 100%;
    background: #F3F3F3;
	padding: 12px;
    box-sizing: border-box;
}
.sd-topdivContaner {
    width: 100%;
    height: 77px;
    border: 1px solid #E8E8E8;
    background: #FFF;
    border-radius: 16px 16px 14px 14px;
	padding-inline: 32px 18px;
    box-sizing: border-box;
	
}

.zpelement-wrapper .zc-pb-tile-container.zc-qv-custom-layout .zc-pb-tile-cnt-wrapper:hover,
.zpelement-wrapper .zc-pb-tile-container.zc-qv-custom-layout.zc-selected-card .zc-pb-tile-cnt-wrapper{
    border-color: var(--primary_color) !important;
	box-shadow: unset !important;
}


.sd-formdivContaner {
       width: 100%;
    height: 69px;
    border: 1px solid #E8E8E8;
    background: #FFF;
    border-radius: 20px;
    margin-top: 9px;
    box-sizing: border-box;
	overflow: hidden;
}

.sd-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
}

.sd-card {
    background: #ffffff;
    padding: 18px;
    border-radius: 20px;
    border: 1px solid #EAEAEA;
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 206px; /* instead of fixed height */
}


.sd-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0,0,0,0.1);
}

.sd-top {
    display: flex;
    align-items: center;
    margin-bottom: 17px;
}

.sd-avatar {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    object-fit: cover;
    margin-right: 12px;
    border: 2px solid #e6ecff;
}

.sd-name {
    font-weight: 600;
    font-size: 16px;
    color: #222;
}

.sd-role {
    font-size: 12px;
    color: #e63946;
    margin-top: 2px;
}

.sd-info {
    font-size: 13px;
    color: #444;
    margin-top: 10px;
	    display: flex;
    flex-direction: column;
    height: calc(100% - 70px);
    justify-content: space-between;
}

.sd-info-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
	font-size: 14.5px;

}

.sd-icon svg {

    display: block;
}
.sd-bottomdivContaner {
    margin-top: 10px;
    height: calc(100% - 170px);
    width: 100%;
    border-radius: 20px 20px 32px 32px;
   background: url("<%=bgimg%>");
	       background-color: white;
    box-sizing: border-box;
background-size: cover;
background-repeat: no-repeat;
    background-position: 0px bottom;

}


.Staff.Details {
    color: #000;
    font-family: Poppins;
    font-size: 18px;
    font-style: normal;
    font-weight: 600;
}
.sd-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
	    height: 100%;
}

.sd-staffTitle {
    color: #000;
    font-family: Poppins, sans-serif;
    font-size: 18px;
    font-weight: 600;
}

.sd-addBtn {
    width: 46px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.2s ease;
}

.sd-addBtn:hover {
    transform: scale(1.05);
}



.form-view {
		height: 55px !important;
	}

	.form-view .zc-footer-wrapper {
		display: block;
	}

	.form-view .zc-form-fullheight {
		display: unset;
	}

	.form-view .zc-form-fullheight,
	.form-view .zc-form-fullheight .form-outer-wrapper {}

	.form-view .form-group {
		margin-bottom: unset !important;
	}
	
	.form-table.label-inplace .zc-form-scroll-wrapper {
		margin: 10px 0;
	}

	.form-view .zc-form-scroll-wrapper div[elname="formRow"] .second-column .form-group>label {
		display: none;
	}

	.form-view .zc-form-scroll-wrapper div[elname="formRow"] {
		display: flex;
		gap: 10px;
		height: 100%;
		padding: 10px;
		box-sizing: border-box;
	}

	.form-view .zc-form-scroll-wrapper div[elname="formRow"] .second-column {
		min-width: unset !important;
	}

	.form-view .zc-form-scroll-wrapper div[elname="formRow"]>div:first-child,
	.form-view .zc-form-scroll-wrapper div[elname="formRow"]>div:last-child {
		display: none;
	}



	.form-view form {
		width: unset !important;
		display: flex;
		align-items: center;
    justify-content: space-between;
	height: 42px;
	}

	.form-view .form-field .choice-table-row:first-child .choice-table-cell span {
		width: max-content;
	}

	.form-view .form-field .tempContDiv .choice-table-cell:last-child {
		padding: unset;
	}

	.form-view .form-field .choice-table-row:first-child .choice-table-cell span {
		width: max-content;
		height: 55px;
		background: white;
		border: 1px solid #EFF0F6;
		border-radius: 10px;
		display: flex;
		flex-direction: row-reverse;
		gap: 10px;
		align-items: center;
		padding-top: unset !important;
		padding-left: 10px;
	}

	.form-view .zc-Search_Box-group .form-field input {
		width: 100%;
		border: 1px solid #EFF0F6;
		height: 55px;
		border-radius: 10px;
		padding-left: 15px;
		padding-right: 45px;
	}

	.form-view .zc-Search_Box-group .form-field {
		width: 100% !important;
		position: relative;
	}

	.form-view .zc-Search_Box-group .form-field::after {
		content: url("data:image/svg+xml,%3Csvg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M7.66683 14C11.1646 14 14.0002 11.1644 14.0002 7.66665C14.0002 4.16884 11.1646 1.33331 7.66683 1.33331C4.16903 1.33331 1.3335 4.16884 1.3335 7.66665C1.3335 11.1644 4.16903 14 7.66683 14Z' stroke='%23292D32' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'/%3E%3Cpath d='M14.6668 14.6666L13.3335 13.3333' stroke='%23292D32' stroke-width='1.3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E%0A");
		position: absolute;
		right: 23px;
		top: 50%;
		transform: translateY(-50%);
	}

	.form-view .form-field .choice-table-row:first-child .choice-table-cell span label {
		top: unset !important;
	}

	.form-view .zc-Search_Box-group>label {
		font-size: 0.9rem !important;
		top: 50% !important;
		transform: translate(10px, -50%) !important;
	}

	.form-view .zc-Search_Box-group:is(.zc-focus, .zc-label-float)>label {
		transform: translate(10px, -35px) !important;
		background: unset !important;
	}

	div[elname="recordcontainerwrapper"]:has(.zc-cardcontainerwrapper),
	.report-view .custom-report .zc-cardcontainerwrapper {
		border-bottom: unset !important;
	}

	.form-view .form-field .choice-table-row:first-child .choice-table-cell span label:after {
		top: 2px;
		left: 2px;
	}

	.form-view .zc-Search_Box-group .form-field .cogLoader {
		display: none;
	}
	.form-view .zc-form-scroll-wrapper div[elname="formRow"] .first-column {
    width: 100%;
    display: flex;
    width: 100% !important;
    justify-content: flex-end;
    gap: 25px;
}

.form-view .formContainer {
    padding: unset !important;
}
.form-action.formbutton {
    padding: unset !important;
}
.zc-form-scroll-wrapper {
    margin: unset !important;
}
.statelessFormWidth .zc-live-primary-btn {
    margin-bottom: unset !important;
}
.divEmbedContainer {
    height: 100% !important;
}
div#All_Staff_ZC_VWF2BG {
    background: unset !important;
}
div#All_Staff_ZC_NQYTO7 {
    background: unset !important;
}
.row.reportfullwidth.zc-report-no-header.custom-report.zc-card-report {
    background: unset !important;
	padding: unset !important;
}

.zc-pb-reportlive-container .view-outer-wrapper.summary-type-report, .divEmbedContainer .view-outer-wrapper.summary-type-report {
    background-color: unset !important;
}
.zc-pb-tile-card.zc-pb-tile-cnt-wrapper {
    border: 1px solid #EAEAEA !important;
	    border-radius: 20px !important;
}
.zc-pb-tile-column-container.zcp-panel-wrapper > .zcp-row > .zcp-col > .zcp-row:nth-child(2) .zcp-col > span:before ,
.zc-pb-tile-column-container.zcp-panel-wrapper > .zcp-row > .zcp-col > .zcp-row:nth-child(3) .zcp-col > span:before ,
.zc-pb-tile-column-container.zcp-panel-wrapper > .zcp-row > .zcp-col > .zcp-row:nth-child(4) .zcp-col > span:before {
    display: inline;
    width: 22px;
    height: 22px;
    vertical-align: middle;
