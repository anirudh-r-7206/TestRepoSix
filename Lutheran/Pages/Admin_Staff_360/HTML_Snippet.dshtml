<%
staffRec = Staff_Master[ID == input.staffID];
%>
<style>
div#zppagesLive,
div#elementsContainer,
.Layout.elemContainment,
div#row_1 {
    height: 100% !important;
}
div#zppagesLive,
div#elementsContainer,
.Layout.elemContainment,
div#row_1,
div#row_1 > div,
div#row_1 .column,
div#row_1 .zc-dsp,
div#row_1 .html-snippet,
div#row_1 .html-snippet > div {
    max-height: 100% !important;
    min-height: 0 !important;
    box-sizing: border-box !important;
}
div#elementsContainer,
.Layout.elemContainment,
div#row_1 {
    padding: 0 !important;
    margin: 0 !important;
    overflow: hidden !important;
}
:root {
    --s360-brand: var(--zcs_brand_color, var(--theme_brand_color, #2563eb));
    --s360-brand-fg: var(--zcs_brand_foreground_color, #ffffff);
    --s360-brand-light: var(--zcs_brand_light_color, #eef4ff);
    --s360-text: var(--zcs_primary_text_color, #18202c);
    --s360-text2: var(--zcs_secondary_text_color, #5f6673);
    --s360-text3: var(--zcs_tertiary_text_color, #878895);
    --s360-border: var(--zcs_tertiary_border_color, #e6e8ef);
    --s360-bg: #f3f6fb;
    --s360-white: #ffffff;
    --s360-r: 14px;
    --s360-r-sm: 9px;
    --s360-shadow: 0 12px 28px rgba(15,23,42,0.06);
}
.s360 *, .s360 *::before, .s360 *::after { box-sizing: border-box; }
.s360 { font-family: inherit; font-size: 14px; line-height: 1.38; color: var(--s360-text); background: radial-gradient(circle at 8% 0%, var(--s360-brand-light), transparent 28%), var(--s360-bg); height: 100%; max-height: 100%; overflow: hidden; display: flex; flex-direction: column; }
.s360 a { text-decoration: none; }

/* ── COMPACT IDENTITY BAR ───────────────── */
.s360-topbar {
    display: flex; align-items: center; gap: 10px;
    background: linear-gradient(135deg, var(--s360-white), #fbfcff);
    border: 1px solid var(--s360-border); border-radius: var(--s360-r);
    margin: 8px 10px 0; padding: 8px 10px;
    box-shadow: var(--s360-shadow); flex-wrap: wrap;
}
.s360-back { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--s360-border); border-radius: var(--s360-r-sm); color: var(--s360-text); background: var(--s360-white); flex-shrink: 0; }
.s360-back:hover { border-color: var(--s360-brand); color: var(--s360-brand); }
.s360-avatar-mini { width: 36px; height: 36px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--s360-brand), #18202c); color: var(--s360-brand-fg); font-size: 13px; font-weight: 800; letter-spacing: .4px; flex-shrink: 0; }
.s360-topbar-info { flex: 1; min-width: 220px; }
.s360-topbar-name { font-size: 16px; font-weight: 800; color: var(--s360-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.s360-topbar-sub { font-size: 12px; color: var(--s360-text2); font-weight: 600; margin-top: 1px; }
.s360-topbar-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.s360-btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: var(--s360-r-sm); font-size: 12px; font-weight: 800; border: 1px solid transparent; white-space: nowrap; cursor: pointer; transition: all 0.15s; }
.s360-btn-primary { background: var(--s360-brand); color: var(--s360-brand-fg); border-color: var(--s360-brand); }
.s360-btn-primary:hover { filter: brightness(0.92); }
.s360-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; white-space: nowrap; }
.s360-badge-green  { background: #e4f9f1; color: #0d6e4a; }
.s360-badge-red    { background: #fde3e6; color: #b7172e; }
.s360-badge-yellow { background: #fff5d6; color: #7a4f00; }
.s360-badge-grey   { background: #eef0f5; color: #444; }

/* ── LAYOUT ─────────────────────────────── */
.s360-body { display: grid; grid-template-columns: minmax(0,1fr) 330px; gap: 10px; padding: 10px; align-items: stretch; overflow: hidden; flex: 1 1 auto; min-height: 0; }
.s360-main { display: flex; flex-direction: column; gap: 8px; min-width: 0; min-height: 0; height: 100%; }
.s360-rail { display: flex; flex-direction: column; gap: 8px; position: static; align-self: stretch; min-height: 0; height: 100%; overflow: hidden; }

/* ── OVERVIEW ───────────────────────────── */
.s360-overview { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; }
.s360-overview-card { position: relative; overflow: hidden; min-height: 76px; background: var(--s360-white); border: 1px solid var(--s360-border); border-radius: var(--s360-r); padding: 10px 13px; box-shadow: 0 1px 0 rgba(15,23,42,0.03); }
.s360-overview-card::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--s360-brand); opacity: .9; }
.s360-overview-label { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--s360-text3); font-weight: 800; margin-bottom: 6px; }
.s360-overview-value { font-size: 15px; font-weight: 850; color: var(--s360-text); overflow-wrap: anywhere; }
.s360-overview-sub { font-size: 12px; color: var(--s360-text2); font-weight: 650; margin-top: 3px; }

/* ── KPI ROW ─────────────────────────────── */
.s360-kpi-row { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 10px; }
.s360-kpi { background: var(--s360-white); border: 1px solid var(--s360-border); border-radius: var(--s360-r); padding: 10px 12px; display: flex; align-items: center; gap: 10px; min-height: 62px; }
.s360-kpi-icon { width: 42px; height: 42px; border-radius: 12px; background: var(--s360-brand-light); color: var(--s360-brand); display: inline-flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
.s360-kpi-lbl { font-size: 12px; color: var(--s360-text2); font-weight: 750; margin-top: 4px; }

/* ── TABS ────────────────────────────────── */
.s360-tabs-card { background: var(--s360-white); border: 1px solid var(--s360-border); border-radius: var(--s360-r); overflow: hidden; box-shadow: 0 1px 0 rgba(15,23,42,0.03); flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
.s360-tab-input { position: absolute; opacity: 0; pointer-events: none; }
.s360-tabhead { display: flex; gap: 0; list-style: none; margin: 0; padding: 0 12px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--s360-border); background: linear-gradient(180deg, #ffffff, #fbfcff); flex: 0 0 auto; }
.s360-tabhead::-webkit-scrollbar { display: none; }
.s360-tabitem { flex: 0 0 auto; border-bottom: 2px solid transparent; }
.s360-tablabel { display: flex; align-items: center; gap: 6px; padding: 8px 11px 7px; font-size: 12px; font-weight: 800; color: var(--s360-text2); cursor: pointer; white-space: nowrap; }
.s360-tabcount { background: var(--s360-bg); border-radius: 5px; padding: 1px 6px; font-size: 11px; font-weight: 800; }
.s360-tabitem:hover .s360-tablabel { color: var(--s360-brand); }
#s-compliance:checked ~ .s360-tabwrap .s360-li-compliance,
#s-requests:checked   ~ .s360-tabwrap .s360-li-requests,
#s-accred:checked     ~ .s360-tabwrap .s360-li-accred,
#s-quals:checked      ~ .s360-tabwrap .s360-li-quals,
#s-facts:checked      ~ .s360-tabwrap .s360-li-facts { border-bottom-color: var(--s360-brand); }
#s-compliance:checked ~ .s360-tabwrap label[for="s-compliance"],
#s-requests:checked   ~ .s360-tabwrap label[for="s-requests"],
#s-accred:checked     ~ .s360-tabwrap label[for="s-accred"],
#s-quals:checked      ~ .s360-tabwrap label[for="s-quals"],
#s-facts:checked      ~ .s360-tabwrap label[for="s-facts"] { color: var(--s360-brand); }
#s-compliance:checked ~ .s360-tabwrap label[for="s-compliance"] .s360-tabcount,
#s-requests:checked   ~ .s360-tabwrap label[for="s-requests"] .s360-tabcount,
#s-accred:checked     ~ .s360-tabwrap label[for="s-accred"] .s360-tabcount,
#s-quals:checked      ~ .s360-tabwrap label[for="s-quals"] .s360-tabcount,
#s-facts:checked      ~ .s360-tabwrap label[for="s-facts"] .s360-tabcount { background: var(--s360-brand-light); color: var(--s360-brand); }
.s360-tabwrap { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
.s360-tabpanel { display: none; padding: 10px; min-height: 0; flex: 1 1 auto; flex-direction: column; overflow: hidden; }
#s-compliance:checked ~ .s360-tabwrap .s360-panel-compliance,
#s-requests:checked   ~ .s360-tabwrap .s360-panel-requests,
#s-accred:checked     ~ .s360-tabwrap .s360-panel-accred,
#s-quals:checked      ~ .s360-tabwrap .s360-panel-quals,
#s-facts:checked      ~ .s360-tabwrap .s360-panel-facts { display: flex; }

/* ── TABLES ───────────────────────────────── */
.s360-panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 7px; gap: 10px; flex-wrap: wrap; flex: 0 0 auto; }
.s360-panel-title { font-size: 13px; font-weight: 900; color: var(--s360-text); }
.s360-panel-sub { font-size: 11px; color: var(--s360-text2); font-weight: 600; margin-top: 0; }
.s360-view-link { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 800; color: var(--s360-brand); }
.s360-view-link:hover { text-decoration: underline; }
.s360-tbl-wrap { border: 1px solid var(--s360-border); border-radius: var(--s360-r-sm); overflow: auto; background: var(--s360-white); flex: 1 1 auto; min-height: 0; display: block; }
.s360-tbl-wrap table { width: 100%; height: auto; border-collapse: collapse; min-width: 600px; }
.s360-tbl-wrap th { position: sticky; top: 0; z-index: 1; background: #f8f9fc; border-bottom: 1px solid var(--s360-border); font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.04em; color: var(--s360-text2); padding: 6px 10px; text-align: left; white-space: nowrap; height: 32px; }
.s360-tbl-wrap td { border-top: 1px solid var(--s360-border); font-size: 12px; font-weight: 600; color: var(--s360-text); padding: 7px 10px; vertical-align: middle; }
.s360-tbl-wrap tbody tr:hover td { background: #f8f9fc; }
.s360-tbl-empty { height: 42px; line-height: 1.25; text-align: center; color: var(--s360-text2); font-weight: 700; padding: 10px !important; font-size: 12px; vertical-align: middle; }
.s360-pill { display: inline-flex; align-items: center; border-radius: 999px; padding: 3px 9px; font-size: 11px; font-weight: 800; white-space: nowrap; }
.pill-success { background: #e4f9f1; color: #0d6e4a; }
.pill-warn    { background: #fff5d6; color: #7a4f00; }
.pill-danger  { background: #fde3e6; color: #b7172e; }
.pill-info    { background: #e8efff; color: #1f56c7; }
.pill-neutral { background: #eef0f5; color: #444; }
.s360-edit-link { display: inline-flex; align-items: center; gap: 4px; color: var(--s360-brand); font-size: 12px; font-weight: 800; }
.s360-edit-link:hover { text-decoration: underline; }
.s360-tbl-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 6px; font-size: 11px; color: var(--s360-text2); font-weight: 700; flex-wrap: wrap; gap: 6px; flex: 0 0 auto; }
.s360-add-link { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 800; color: var(--s360-brand); }
.s360-add-link:hover { text-decoration: underline; }
.s360-panel-facts .s360-facts-grid { flex: 1 1 auto; min-height: 0; overflow: auto; align-content: start; padding-right: 4px; }
/* ── STAFF FACTS ─────────────────────────── */
.s360-facts-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 8px; }
.s360-fact { background: var(--s360-white); border: 1px solid var(--s360-border); border-radius: var(--s360-r-sm); padding: 10px 12px; }
.s360-fact-label { font-size: 10px; text-transform: uppercase; letter-spacing: .055em; color: var(--s360-text3); font-weight: 800; margin-bottom: 3px; }
.s360-fact-value { font-size: 13px; font-weight: 800; color: var(--s360-text); overflow-wrap: anywhere; }
/* ── INSIGHT RAIL ────────────────────────── */
.s360-rail-card { background: var(--s360-white); border: 1px solid var(--s360-border); border-radius: var(--s360-r); overflow: hidden; box-shadow: 0 1px 0 rgba(15,23,42,0.03); flex: 0 0 auto; }
.s360-rail-card:last-child { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
.s360-rail-card:last-child .s360-chip-grid { flex: 1 1 auto; align-content: start; }
.s360-rail-head { padding: 10px 14px 8px 16px; border-bottom: 1px solid var(--s360-border); font-size: 12px; font-weight: 900; text-transform: uppercase; letter-spacing: .05em; color: var(--s360-text2); background: linear-gradient(180deg, #ffffff, #fbfcff); }
.s360-info-row { display: grid; grid-template-columns: 24px minmax(0,1fr); gap: 7px; align-items: start; padding: 7px 12px; border-top: 1px solid #f0f2f7; }
.s360-info-row:first-child { border-top: 0; }
.s360-info-icon { width: 24px; height: 24px; border-radius: 8px; background: var(--s360-brand-light); color: var(--s360-brand); display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
.s360-info-label { font-size: 9px; text-transform: uppercase; letter-spacing: .05em; color: var(--s360-text3); font-weight: 800; }
.s360-info-value { font-size: 12px; color: var(--s360-text); font-weight: 800; overflow-wrap: anywhere; }
.s360-info-sub { font-size: 10px; color: var(--s360-text2); font-weight: 600; margin-top: 1px; }
.s360-health { padding: 8px 12px 10px; }
.s360-health-row { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; font-weight: 800; margin-bottom: 5px; }
.s360-meter { height: 7px; border-radius: 999px; background: #eef0f5; overflow: hidden; }
.s360-meter-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #16ad78, var(--s360-brand)); }
.s360-chip-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 7px; padding: 10px 12px 12px; }
.s360-chip { border: 1px solid var(--s360-border); border-radius: var(--s360-r-sm); padding: 8px 9px; background: #fbfcff; }
.s360-chip-label { font-size: 9px; text-transform: uppercase; letter-spacing: .05em; color: var(--s360-text3); font-weight: 800; }
.s360-chip-value { font-size: 15px; font-weight: 900; color: var(--s360-text); margin-top: 1px; }

/* ── NODATA ──────────────────────────────── */
.s360-nodata { min-height: 72vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
.s360-nodata-box { max-width: 460px; background: var(--s360-white); border: 1px solid var(--s360-border); border-radius: var(--s360-r); padding: 36px; text-align: center; box-shadow: var(--s360-shadow); }
.s360-nodata-icon { width: 60px; height: 60px; border-radius: 16px; background: var(--s360-brand-light); color: var(--s360-brand); display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 14px; }

/* ── RESPONSIVE ──────────────────────────── */
@media (max-width: 1120px) {
    .s360-body { grid-template-columns: 1fr; }
    .s360-rail { position: static; display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); }
    .s360-overview, .s360-kpi-row { grid-template-columns: repeat(3, minmax(0,1fr)); }
}
@media (max-width: 820px) {
    .s360-rail { grid-template-columns: 1fr; }
    .s360-overview, .s360-kpi-row, .s360-facts-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .s360-topbar-actions { width: 100%; justify-content: flex-start; }
}
@media (max-width: 520px) {
    .s360-body { padding: 8px; gap: 8px; }
    .s360-topbar { margin: 8px 8px 0; }
    .s360-overview, .s360-kpi-row, .s360-facts-grid { grid-template-columns: 1fr; }
}
</style>
<%
if(input.staffID == null || staffRec.count() == 0)
{
%>
<div class="s360">
    <div class="s360-nodata">
        <div class="s360-nodata-box">
            <div class="s360-nodata-icon"><i class="zc-li-outline ui-3-alert"></i></div>
            <h5 style="margin:0 0 8px;font-size:16px;font-weight:800;color:var(--s360-text);">Staff member not found</h5>
            <p style="margin:0 0 18px;font-size:13px;color:var(--s360-text2);">This page needs a valid staffID parameter. Return to the staff directory and open a staff member.</p>
            <a class="s360-btn s360-btn-primary" href="#Page:Staff_Details">
                <i class="zc-li-outline arrows-1-tail-left"></i> Back to Staff Details
            </a>
        </div>
    </div>
</div>
<%
}
else
{
    staffID = staffRec.ID;
    /* Name */
    prefixVal = ifnull(staffRec.Name.prefix,"");
    firstVal  = ifnull(staffRec.Name.first_name,"");
    lastVal   = ifnull(staffRec.Name.last_name,"");
    suffixVal = ifnull(staffRec.Name.suffix,"");
    emailVal  = ifnull(staffRec.Staff_Email,"");
    phoneVal  = ifnull(staffRec.Phone_Number,"");
    fullName  = "";
    if(prefixVal != "") { fullName = prefixVal; }
    if(firstVal  != "") { if(fullName != "") { fullName = fullName + " "; } fullName = fullName + firstVal; }
    if(lastVal   != "") { if(fullName != "") { fullName = fullName + " "; } fullName = fullName + lastVal; }
    if(suffixVal != "") { if(fullName != "") { fullName = fullName + " "; } fullName = fullName + suffixVal; }
    fullName = fullName.trim();
    if(fullName == "") { if(emailVal != "") { fullName = emailVal; } else { fullName = "Staff #" + staffID; } }
    initials = "";
    if(firstVal != "") { initials = initials + firstVal.subString(0,1); }
    if(lastVal  != "") { initials = initials + lastVal.subString(0,1); }
    if(initials == "" && emailVal != "") { initials = emailVal.subString(0,1); }
    if(initials == "") { initials = "S"; }
    initials = initials.toUpperCase();
    emailDisplay = emailVal;   if(emailDisplay == "") { emailDisplay = "-"; }
    phoneDisplay = phoneVal;   if(phoneDisplay == "") { phoneDisplay = "-"; }
    /* Status */
    statusText  = ifnull(staffRec.status,"");
    if(statusText == "") { statusText = "-"; }
    statusClass = "s360-badge-grey";
    statusLower = statusText.toLowerCase();
    if(statusLower.contains("active") && !statusLower.contains("inactive")) { statusClass = "s360-badge-green"; }
    else if(statusLower.contains("pending") || statusLower.contains("probation")) { statusClass = "s360-badge-yellow"; }
    else if(statusLower.contains("inactive") || statusLower.contains("terminated") || statusLower.contains("ceased")) { statusClass = "s360-badge-red"; }
    /* Fields */
    positionVal   = ifnull(staffRec.Current_Position.position_name,"-");
    adminTypeVal  = ifnull(staffRec.Admin_Type,"-");
    adminTypeLower = adminTypeVal.toLowerCase();
    adminVal      = "-";
    if(staffRec.Overall_Admin != null) { if(staffRec.Overall_Admin == true) { adminVal = "Yes"; } else { adminVal = "No"; } }
    isOverallAdmin = false;
    if(adminVal == "Yes" || adminTypeLower.contains("overall admin")) { isOverallAdmin = true; }
    isAdminProfile = false;
    if(isOverallAdmin == true || adminTypeLower.contains("admin") || adminTypeLower.contains("administrative office")) { isAdminProfile = true; }
    schoolVal     = ifnull(staffRec.Current_Employment.school_name,"");
    campusRawVal  = ifnull(staffRec.Campus.campus_name,"");
    nationVal     = ifnull(staffRec.Organisation.organisation_name,"");
    regionVal     = ifnull(staffRec.Regions.region_name,"");
    employmentVal = schoolVal; if(employmentVal == "") { employmentVal = "-"; }
    campusVal = campusRawVal; if(campusVal == "") { campusVal = "-"; }
    locationScopeVal = ""; locationLevelVal = "-"; locationSubVal = "No organisation assigned";
    if(isOverallAdmin == true) { locationScopeVal = "Not mapped"; locationLevelVal = "Overall Admin"; locationSubVal = "Overall Admin access"; }
    else { if(nationVal != "") { locationScopeVal = nationVal; } if(regionVal != "") { if(locationScopeVal != "") { locationScopeVal = locationScopeVal + " / "; } locationScopeVal = locationScopeVal + regionVal; } if(schoolVal != "") { if(locationScopeVal != "") { locationScopeVal = locationScopeVal + " / "; } locationScopeVal = locationScopeVal + schoolVal; } if(campusRawVal != "") { if(locationScopeVal != "") { locationScopeVal = locationScopeVal + " / "; } locationScopeVal = locationScopeVal + campusRawVal; } if(campusRawVal != "") { locationLevelVal = "Campus"; } else if(schoolVal != "") { locationLevelVal = "School"; } else if(regionVal != "") { locationLevelVal = "Region"; } else if(nationVal != "") { locationLevelVal = "Nation"; } if(locationScopeVal == "") { locationScopeVal = "-"; } if(locationLevelVal != "-") { locationSubVal = "Mapped at " + locationLevelVal + " level"; } }
    orgRegionVal  = locationScopeVal;
    teachingVal   = ifnull(staffRec.Teaching_Staff,"-");
    fteVal        = "";
    if(staffRec.FTE != null) { fteVal = staffRec.FTE.toString(); }
    teacherTypeVal = ifnull(staffRec.Teacher_Type,"");
    fteTeacherVal  = fteVal;
    if(fteTeacherVal != "" && teacherTypeVal != "") { fteTeacherVal = fteTeacherVal + " / " + teacherTypeVal; }
    else if(fteTeacherVal == "" && teacherTypeVal != "") { fteTeacherVal = teacherTypeVal; }
    if(fteTeacherVal == "") { fteTeacherVal = "-"; }
    roleProfileVal = fteTeacherVal;
    if(isAdminProfile == true) { roleProfileVal = adminTypeVal; if(roleProfileVal == "-") { roleProfileVal = "Admin"; } }
    serviceVal    = ifnull(staffRec.Total_Service_Period,"-");
    staffNumVal   = ifnull(staffRec.LEA_Staff_Rec_Num,"-");
    dobVal        = ifnull(staffRec.date_of_birth,"-");
    genderVal     = ifnull(staffRec.gender,"-");
    middleNameVal = ifnull(staffRec.Surname,"-");
    previousSurnameVal = ifnull(staffRec.Previous_Surname,"-");
    religionVal = ifnull(staffRec.religion,"-");
    originVal = ifnull(staffRec.origin,"-");
    actingVal = ifnull(staffRec.Acting,"-");
    commencedSchoolVal = ifnull(staffRec.Date_Commenced_in_Current_School,"-");
    commencedLutheranVal = ifnull(staffRec.Date_Commenced_in_Lutheran_School,"-");
    commencedPositionVal = ifnull(staffRec.Date_commenced_in_current_position,"-");
    yearLevelVal = "-";
    if(staffRec.Year_Level != null) { yearLevelVal = staffRec.Year_Level.toString(); }
    subjectVal = "-";
    if(staffRec.Subject_form != null) { subjectVal = staffRec.Subject_form.toString(); }
    specialityVal = "-";
    if(staffRec.Speciality != null) { specialityVal = staffRec.Speciality.toString(); }
    committeesVal = "-";
    if(staffRec.Committees != null) { committeesVal = staffRec.Committees.toString(); }
    serviceYearsVal = ifnull(staffRec.Service_In_Years,"-");
    serviceDaysVal  = ifnull(staffRec.Service_In_Days,"-");
    /* Lists and counts */
    complianceList   = Compliance_Training[Staff == input.staffID] sort by Added_Time desc;
    trainingReqList  = Training_Completion_Request[Staff == input.staffID] sort by Added_Time desc;
    staffRequestList = Staff_Request[Staff == input.staffID || Raised_by == input.staffID] sort by Added_Time desc;
    employmentList   = Staff_Employment[Staff == input.staffID] sort by Commencement_Date desc;
    accredList       = Accreditation_Details[Staff == input.staffID] sort by Due_Date desc;
    qualList         = Qualifications[Staff == input.staffID] sort by completion_date desc;
    historyList      = History[Staff == input.staffID] sort by Added_Time desc;
    complianceTotal    = complianceList.count();
    complianceCompleted = Compliance_Training[Staff == input.staffID && Status == "Completed"].count();
    compliancePending  = complianceTotal - complianceCompleted;
    requestTotal       = trainingReqList.count();
    requestCompleted   = Training_Completion_Request[Staff == input.staffID && (Status == "Approved" || Status == "Credited")].count();
    requestPending     = Training_Completion_Request[Staff == input.staffID && Status == "Pending"].count();
    staffRequestTotal  = staffRequestList.count();
    staffRequestPending = Staff_Request[(Staff == input.staffID || Raised_by == input.staffID) && Status == "Pending"].count();
    employmentTotal = employmentList.count();
    activeEmploymentTotal = Staff_Employment[Staff == input.staffID && End_Date == null].count();
    qualCount   = qualList.count();
    accredCount = accredList.count();
    compliancePct = 0;
    if(complianceTotal > 0) { compliancePct = (complianceCompleted * 100) / complianceTotal; }
    pendingTotal = compliancePending + requestPending;
    recordTotal = complianceTotal + requestTotal + staffRequestTotal + employmentTotal;
    /* URLs */
    editStaffUrl       = "#Form:Staff_Request?Staff=" + staffID + "&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
    addTrainingUrl     = "#Form:Training_Completion_Request?Staff=" + staffID + "&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
    addComplianceUrl   = "#Form:Compliance_Training?Staff=" + staffID + "&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
    addEmploymentUrl   = "#Form:Staff_Employment?Staff=" + staffID + "&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
%>
<div class="s360">

    <!-- TOPBAR -->
    <div class="s360-topbar">
        <a href="#Page:Staff_Details" class="s360-back" title="Back">
            <i class="zc-li-outline arrows-1-tail-left" style="font-size:15px;"></i>
        </a>
        <div class="s360-avatar-mini"><%=initials%></div>
        <div class="s360-topbar-info">
            <div class="s360-topbar-name"><%=fullName%></div>
            <div class="s360-topbar-sub"><%=positionVal%><% if(locationScopeVal != "-") { %> &middot; <%=locationScopeVal%><% } %><% if(staffNumVal != "-") { %> &middot; <%=staffNumVal%><% } %></div>
        </div>
        <div class="s360-topbar-actions">
            <span class="s360-badge <%=statusClass%>"><%=statusText%></span>
            <a class="s360-btn s360-btn-primary" href="<%=editStaffUrl%>">
                <i class="zc-li-outline ui-1-edit-72"></i> Edit Staff
            </a>
        </div>
    </div>

    <div class="s360-body">
        <div class="s360-main">

            <!-- OVERVIEW STRIP -->
            <div class="s360-overview">
                <div class="s360-overview-card">
                    <div class="s360-overview-label">Contact</div>
                    <div class="s360-overview-value"><%=emailDisplay%></div>
                    <div class="s360-overview-sub"><%=phoneDisplay%></div>
                </div>
                <div class="s360-overview-card">
                    <div class="s360-overview-label">Assigned Organisation</div>
                    <div class="s360-overview-value"><%=locationScopeVal%></div>
                    <div class="s360-overview-sub"><%=locationSubVal%></div>
                </div>
                <div class="s360-overview-card">
                    <div class="s360-overview-label">Role Profile</div>
                    <div class="s360-overview-value"><%=roleProfileVal%></div>
                    <div class="s360-overview-sub"><% if(isAdminProfile == true) { %>Admin profile<% } else { %><%=teachingVal%> teaching &middot; <%=adminVal%> admin<% } %></div>
                </div>
                <div class="s360-overview-card">
                    <div class="s360-overview-label">Service / Staff #</div>
                    <div class="s360-overview-value"><%=serviceVal%></div>
                    <div class="s360-overview-sub"><%=staffNumVal%></div>
                </div>
            </div>

            <!-- KPI ROW -->
            <div class="s360-kpi-row">
                <div class="s360-kpi"><div class="s360-kpi-icon"><i class="zc-li-outline ui-1-check-circle-08"></i></div><div><div class="s360-kpi-val"><%=complianceTotal%></div><div class="s360-kpi-lbl">Assigned Trainings</div></div></div>
                <div class="s360-kpi"><div class="s360-kpi-icon"><i class="zc-li-outline ui-2-time"></i></div><div><div class="s360-kpi-val"><%=compliancePending%></div><div class="s360-kpi-lbl">Pending Training</div></div></div>
                <div class="s360-kpi"><div class="s360-kpi-icon"><i class="zc-li-outline files-2-doc"></i></div><div><div class="s360-kpi-val"><%=requestTotal%></div><div class="s360-kpi-lbl">Completion Requests</div></div></div>
                <div class="s360-kpi"><div class="s360-kpi-icon"><i class="zc-li-outline ui-2-time"></i></div><div><div class="s360-kpi-val"><%=requestPending%></div><div class="s360-kpi-lbl">Pending Completion Requests</div></div></div>
                <div class="s360-kpi"><div class="s360-kpi-icon"><i class="zc-li-outline files-2-doc"></i></div><div><div class="s360-kpi-val"><%=staffRequestTotal%></div><div class="s360-kpi-lbl">Staff Requests</div></div></div>
                <div class="s360-kpi"><div class="s360-kpi-icon"><i class="zc-li-outline business-briefcase-24"></i></div><div><div class="s360-kpi-val"><%=employmentTotal%></div><div class="s360-kpi-lbl">Employment Records</div></div></div>
            </div>

            <!-- TABS -->
            <div class="s360-tabs-card">
                <input class="s360-tab-input" id="s-compliance" name="s360t" type="radio" checked>
                <input class="s360-tab-input" id="s-requests"  name="s360t" type="radio">
                <input class="s360-tab-input" id="s-accred"    name="s360t" type="radio">
                <input class="s360-tab-input" id="s-quals"     name="s360t" type="radio">
                <input class="s360-tab-input" id="s-facts"     name="s360t" type="radio">
                <div class="s360-tabwrap">
                    <ul class="s360-tabhead">
                        <li class="s360-tabitem s360-li-compliance"><label class="s360-tablabel" for="s-compliance">Assigned Trainings <span class="s360-tabcount"><%=complianceTotal%></span></label></li>
                        <li class="s360-tabitem s360-li-requests"><label class="s360-tablabel" for="s-requests">Completion Requests <span class="s360-tabcount"><%=requestTotal%></span></label></li>
                        <li class="s360-tabitem s360-li-accred"><label class="s360-tablabel" for="s-accred">Staff Requests <span class="s360-tabcount"><%=staffRequestTotal%></span></label></li>
                        <li class="s360-tabitem s360-li-quals"><label class="s360-tablabel" for="s-quals">Employment <span class="s360-tabcount"><%=employmentTotal%></span></label></li>
                        <li class="s360-tabitem s360-li-facts"><label class="s360-tablabel" for="s-facts">Staff Details</label></li>
                    </ul>

                    <!-- ASSIGNED TRAININGS -->
                    <div class="s360-tabpanel s360-panel-compliance">
                        <div class="s360-panel-head">
                            <div><div class="s360-panel-title">Assigned Compliance Trainings</div><div class="s360-panel-sub">Compliance trainings assigned to this staff member. Completion requests are raised against these records.</div></div>
                            <a class="s360-view-link" href="#Report:All_Compliance_Trainings?zc_LoadIn=dialog&zc_Header=true"><i class="zc-li-outline arrows-1-tail-right"></i> Full report</a>
                        </div>
                        <div class="s360-tbl-wrap"><table><thead><tr><th>Training Name</th><th>Type</th><th>Completion Request</th><th>Completion Date</th><th>Hours</th><th>Status</th><th>Action</th></tr></thead><tbody>
                        <%
                        if(complianceTotal == 0) { %><tr><td class="s360-tbl-empty" colspan="7">No assigned compliance trainings found.</td></tr><% }
                        else {
                            compShown = 0;
                            for each comp in complianceList {
                                if(compShown < 100) {
                                    compShown = compShown + 1;
                                    compStatus = ifnull(comp.Status,"-");
                                    compClass = "pill-neutral";
                                    compStatusLower = compStatus.toLowerCase();
                                    if(compStatusLower.contains("complete") || compStatusLower.contains("approved")) { compClass = "pill-success"; }
                                    else if(compStatusLower.contains("pending") || compStatusLower.contains("wait")) { compClass = "pill-warn"; }
                                    else if(compStatusLower.contains("reject") || compStatusLower.contains("expired")) { compClass = "pill-danger"; }
                                    linkedReqCount = Training_Completion_Request[Compliance_Training == comp.ID].count();
                                    linkedReqText = "No";
                                    if(linkedReqCount > 0) { linkedReqText = linkedReqCount.toString(); }
                                    compEditUrl = "#Form:Compliance_Training?recLinkID=" + comp.ID + "&viewLinkName=All_Compliance_Trainings&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
                        %>
                            <tr><td><%=ifnull(comp.Training_Name,"-")%></td><td><%=ifnull(comp.Training_Type.Training,"-")%></td><td><%=linkedReqText%></td><td><%=ifnull(comp.Completion_Date,"-")%></td><td><%=ifnull(comp.Hours_Number_for_PD,"-")%></td><td><span class="s360-pill <%=compClass%>"><%=compStatus%></span></td><td><a class="s360-edit-link" href="<%=compEditUrl%>"><i class="zc-li-outline ui-1-edit-72"></i>Edit</a></td></tr>
                        <% } } } %>
                        </tbody></table></div>
                        <div class="s360-tbl-foot">
                            <span><%=complianceTotal%> assigned training(s). <%=compliancePending%> pending completion.</span>
                            <a class="s360-add-link" href="<%=addComplianceUrl%>"><i class="zc-li-outline ui-1-simple-add"></i>Assign Compliance Training</a>
                        </div>
                    </div>

                    <!-- COMPLETION REQUESTS -->
                    <div class="s360-tabpanel s360-panel-requests">
                        <div class="s360-panel-head">
                            <div><div class="s360-panel-title">Training Completion Requests</div><div class="s360-panel-sub">Requests raised against assigned compliance trainings to record completion evidence and approval.</div></div>
                            <a class="s360-view-link" href="#Report:All_Training_Completion_Requests?zc_LoadIn=dialog&zc_Header=true"><i class="zc-li-outline arrows-1-tail-right"></i> Full report</a>
                        </div>
                        <div class="s360-tbl-wrap"><table><thead><tr><th>Assigned Training</th><th>Training Type</th><th>Completion Date</th><th>Status</th><th>Current Approver</th><th>Action</th></tr></thead><tbody>
                        <%
                        if(requestTotal == 0) { %><tr><td class="s360-tbl-empty" colspan="6">No training completion requests found.</td></tr><% }
                        else {
                            reqShown = 0;
                            for each req in trainingReqList {
                                if(reqShown < 100) {
                                    reqShown = reqShown + 1;
                                    reqStatus = ifnull(req.Status,"-");
                                    reqClass = "pill-neutral";
                                    reqStatusLower = reqStatus.toLowerCase();
                                    if(reqStatusLower.contains("approved") || reqStatusLower.contains("credited")) { reqClass = "pill-success"; }
                                    else if(reqStatusLower.contains("pending") || reqStatusLower.contains("wait")) { reqClass = "pill-warn"; }
                                    else if(reqStatusLower.contains("reject")) { reqClass = "pill-danger"; }
                                    reqEditUrl = "#Form:Training_Completion_Request?recLinkID=" + req.ID + "&viewLinkName=All_Training_Completion_Requests&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
                        %>
                            <tr><td><%=ifnull(req.Compliance_Training.Training_Name,ifnull(req.Training_Name,"-"))%></td><td><%=ifnull(req.Training_Type.Training,"-")%></td><td><%=ifnull(req.Completion_Date,"-")%></td><td><span class="s360-pill <%=reqClass%>"><%=reqStatus%></span></td><td><%=ifnull(req.Current_Approver,"-")%></td><td><a class="s360-edit-link" href="<%=reqEditUrl%>"><i class="zc-li-outline ui-1-edit-72"></i>Edit</a></td></tr>
                        <% } } } %>
                        </tbody></table></div>
                        <div class="s360-tbl-foot">
                            <span><%=requestTotal%> completion request(s). <%=requestPending%> pending approval.</span>
                            <a class="s360-add-link" href="<%=addTrainingUrl%>"><i class="zc-li-outline ui-1-simple-add"></i>Add Completion Request</a>
                        </div>
                    </div>

                    <!-- STAFF REQUESTS -->
                    <div class="s360-tabpanel s360-panel-accred">
                        <div class="s360-panel-head">
                            <div><div class="s360-panel-title">Staff Data Update Requests</div><div class="s360-panel-sub">Requests raised to update Staff Master personal, employment, position, transfer, leave, or status data.</div></div>
                            <a class="s360-view-link" href="#Report:All_Requests?zc_LoadIn=dialog&zc_Header=true"><i class="zc-li-outline arrows-1-tail-right"></i> Full report</a>
                        </div>
                        <div class="s360-tbl-wrap"><table><thead><tr><th>Request Type</th><th>Raised By</th><th>Employment</th><th>Effective Date</th><th>Status</th><th>Next Approver</th><th>Action</th></tr></thead><tbody>
                        <%
                        if(staffRequestTotal == 0) { %><tr><td class="s360-tbl-empty" colspan="7">No staff update requests found.</td></tr><% }
                        else {
                            staffReqShown = 0;
                            for each sreq in staffRequestList {
                                if(staffReqShown < 100) {
                                    staffReqShown = staffReqShown + 1;
                                    sreqStatus = ifnull(sreq.Status,"-");
                                    sreqClass = "pill-neutral";
                                    sreqStatusLower = sreqStatus.toLowerCase();
                                    if(sreqStatusLower.contains("approved") || sreqStatusLower.contains("completed")) { sreqClass = "pill-success"; }
                                    else if(sreqStatusLower.contains("pending")) { sreqClass = "pill-warn"; }
                                    else if(sreqStatusLower.contains("reject") || sreqStatusLower.contains("cancel")) { sreqClass = "pill-danger"; }
                                    raisedByName = ifnull(sreq.Raised_by.Name.first_name,"");
                                    if(ifnull(sreq.Raised_by.Name.last_name,"") != "") { if(raisedByName != "") { raisedByName = raisedByName + " "; } raisedByName = raisedByName + sreq.Raised_by.Name.last_name; }
                                    if(raisedByName == "") { raisedByName = "-"; }
                                    empText = ifnull(sreq.Employment.Position1,"-");
                                    sreqEditUrl = "#Form:Staff_Request?recLinkID=" + sreq.ID + "&viewLinkName=All_Requests&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
                        %>
                            <tr><td><%=ifnull(sreq.Request_Type,"-")%></td><td><%=raisedByName%></td><td><%=empText%></td><td><%=ifnull(sreq.Effective_Date,"-")%></td><td><span class="s360-pill <%=sreqClass%>"><%=sreqStatus%></span></td><td><%=ifnull(sreq.Next_Approver,"-")%></td><td><a class="s360-edit-link" href="<%=sreqEditUrl%>"><i class="zc-li-outline ui-1-edit-72"></i>Edit</a></td></tr>
                        <% } } } %>
                        </tbody></table></div>
                        <div class="s360-tbl-foot">
                            <span><%=staffRequestTotal%> staff request(s). <%=staffRequestPending%> pending.</span>
                            <a class="s360-add-link" href="<%=editStaffUrl%>"><i class="zc-li-outline ui-1-simple-add"></i>Raise Staff Request</a>
                        </div>
                    </div>

                    <!-- EMPLOYMENT -->
                    <div class="s360-tabpanel s360-panel-quals">
                        <div class="s360-panel-head">
                            <div><div class="s360-panel-title">Employment Records</div><div class="s360-panel-sub">A staff member may have one or more employment records with the organisation.</div></div>
                            <a class="s360-view-link" href="#Report:All_Staff_Employment?zc_LoadIn=dialog&zc_Header=true"><i class="zc-li-outline arrows-1-tail-right"></i> Full report</a>
                        </div>
                        <div class="s360-tbl-wrap"><table><thead><tr><th>School</th><th>Campus</th><th>Position</th><th>Admin Type</th><th>Commenced</th><th>End Date</th><th>FTE</th><th>Action</th></tr></thead><tbody>
                        <%
                        if(employmentTotal == 0) { %><tr><td class="s360-tbl-empty" colspan="8">No employment records found.</td></tr><% }
                        else {
                            empShown = 0;
                            for each emp in employmentList {
                                if(empShown < 100) {
                                    empShown = empShown + 1;
                                    empEditUrl = "#Form:Staff_Employment?recLinkID=" + emp.ID + "&viewLinkName=All_Staff_Employment&zc_LoadIn=dialog&zc_NextUrl=#Script:page.parent.refresh";
                        %>
                            <tr><td><%=ifnull(emp.School.school_name,"-")%></td><td><%=ifnull(emp.Campus.campus_name,"-")%></td><td><%=ifnull(emp.Position.position_name,"-")%></td><td><%=ifnull(emp.Admin_Type,"-")%></td><td><%=ifnull(emp.Commencement_Date,"-")%></td><td><%=ifnull(emp.End_Date,"Current")%></td><td><%=ifnull(emp.FTE,"-")%></td><td><a class="s360-edit-link" href="<%=empEditUrl%>"><i class="zc-li-outline ui-1-edit-72"></i>Edit</a></td></tr>
                        <% } } } %>
                        </tbody></table></div>
                        <div class="s360-tbl-foot">
                            <span><%=employmentTotal%> employment record(s). <%=activeEmploymentTotal%> active/current.</span>
                            <a class="s360-add-link" href="<%=addEmploymentUrl%>"><i class="zc-li-outline ui-1-simple-add"></i>Add Employment</a>
                        </div>
                    </div>

                    <!-- STAFF DETAILS -->
                    <div class="s360-tabpanel s360-panel-facts">
                        <div class="s360-panel-head">
                            <div><div class="s360-panel-title">Staff Master Details</div><div class="s360-panel-sub">Personal, organisation, employment summary, and service data from Staff Master.</div></div>
                            <a class="s360-view-link" href="<%=editStaffUrl%>"><i class="zc-li-outline ui-1-edit-72"></i> Raise Staff Request</a>
                        </div>
                        <div class="s360-facts-grid">
                            <div class="s360-fact"><div class="s360-fact-label">Staff Number</div><div class="s360-fact-value"><%=staffNumVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Full Name</div><div class="s360-fact-value"><%=fullName%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Middle Name</div><div class="s360-fact-value"><%=middleNameVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Previous Surname</div><div class="s360-fact-value"><%=previousSurnameVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Date of Birth</div><div class="s360-fact-value"><%=dobVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Gender</div><div class="s360-fact-value"><%=genderVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Religion</div><div class="s360-fact-value"><%=religionVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Origin</div><div class="s360-fact-value"><%=originVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Email</div><div class="s360-fact-value"><%=emailDisplay%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Phone</div><div class="s360-fact-value"><%=phoneDisplay%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Status</div><div class="s360-fact-value"><%=statusText%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Current Position</div><div class="s360-fact-value"><%=positionVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Assigned Organisation</div><div class="s360-fact-value"><%=locationScopeVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Mapping Level</div><div class="s360-fact-value"><%=locationLevelVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Teaching Staff</div><div class="s360-fact-value"><%=teachingVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Overall Admin</div><div class="s360-fact-value"><%=adminVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">FTE / Teacher Type</div><div class="s360-fact-value"><%=fteTeacherVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Acting</div><div class="s360-fact-value"><%=actingVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Year Level</div><div class="s360-fact-value"><%=yearLevelVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Subject</div><div class="s360-fact-value"><%=subjectVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Speciality</div><div class="s360-fact-value"><%=specialityVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Committees</div><div class="s360-fact-value"><%=committeesVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Commenced Current School</div><div class="s360-fact-value"><%=commencedSchoolVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Commenced Lutheran School</div><div class="s360-fact-value"><%=commencedLutheranVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Commenced Current Position</div><div class="s360-fact-value"><%=commencedPositionVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Service Years / Days</div><div class="s360-fact-value"><%=serviceYearsVal%> / <%=serviceDaysVal%></div></div>
                            <div class="s360-fact"><div class="s360-fact-label">Total Service</div><div class="s360-fact-value"><%=serviceVal%></div></div>
                        </div>
                    </div>

                </div><!-- /tabwrap -->
            </div><!-- /tabs -->

        </div><!-- /main -->

        <!-- INSIGHT RAIL -->
        <aside class="s360-rail">
            <div class="s360-rail-card">
                <div class="s360-rail-head">Staff Snapshot</div>
                <div class="s360-info-list">
                    <div class="s360-info-row"><div class="s360-info-icon"><i class="zc-li-outline users-1-single-01"></i></div><div><div class="s360-info-label">Staff Number</div><div class="s360-info-value"><%=staffNumVal%></div><div class="s360-info-sub"><%=statusText%></div></div></div>
                    <div class="s360-info-row"><div class="s360-info-icon"><i class="zc-li-outline business-briefcase-24"></i></div><div><div class="s360-info-label">Role Profile</div><div class="s360-info-value"><%=roleProfileVal%></div><div class="s360-info-sub"><% if(isAdminProfile == true) { %>Admin profile<% } else { %><%=positionVal%><% } %></div></div></div>
                    <div class="s360-info-row"><div class="s360-info-icon"><i class="zc-li-outline location-pin-copy"></i></div><div><div class="s360-info-label">Assigned Organisation</div><div class="s360-info-value"><%=locationScopeVal%></div><div class="s360-info-sub"><%=locationSubVal%></div></div></div>
                </div>
            </div>
            <div class="s360-rail-card">
                <div class="s360-rail-head">Training Health</div>
                <div class="s360-health">
                    <div class="s360-health-row"><span>Completed trainings</span><span><%=complianceCompleted%> / <%=complianceTotal%></span></div>
                    <div class="s360-meter"><div class="s360-meter-fill" style="width:<%=compliancePct%>%;"></div></div>
                    <div class="s360-info-sub" style="margin-top:8px;"><%=pendingTotal%> pending item(s) across assigned trainings and completion requests.</div>
                </div>
            </div>
            <div class="s360-rail-card">
                <div class="s360-rail-head">Record Mix</div>
                <div class="s360-chip-grid">
                    <div class="s360-chip"><div class="s360-chip-label">Assigned Trainings</div><div class="s360-chip-value"><%=complianceTotal%></div></div>
                    <div class="s360-chip"><div class="s360-chip-label">Completion Requests</div><div class="s360-chip-value"><%=requestTotal%></div></div>
                    <div class="s360-chip"><div class="s360-chip-label">Staff Requests</div><div class="s360-chip-value"><%=staffRequestTotal%></div></div>
                    <div class="s360-chip"><div class="s360-chip-label">Employment</div><div class="s360-chip-value"><%=employmentTotal%></div></div>
                </div>
            </div>
        </aside>

    </div><!-- /body -->
</div>
<%
}
%>
