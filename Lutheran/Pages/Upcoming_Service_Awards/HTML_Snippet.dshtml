.form-button-div {
    display: flex;
    align-items: center;
    position: relative;
}
.top-timeline-div {
    display: flex;
    gap: 80px;
    align-items: center;
    justify-content: flex-end;
}
.top-logo-div {
     width: 252px;
/*     height: 100px; */
    border-radius: 14px;
    display: flex;
    align-items: center;
//     border: 2px solid #090986;
    justify-content: center;
}

.zc-dem-container .inner .form-outer-wrapper form.form-table{
	border-radius: unset !important;
}
img.logo-img {
    height: 65%;
}
.zc-pb-tile-card {
    overflow: hidden !important;
}
.popage:empty:after {
    content: "Please choose an Award to view the eligible Staff";
    font-size: 16px;
}

.popage:empty {
    position: relative;
    height: 100% !important;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>
<div class="main-container">
<div class = "top-timeline-div">

<div class ="top-logo-div">
