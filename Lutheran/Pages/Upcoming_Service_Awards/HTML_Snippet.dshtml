<style>
	
.zc-container-wrapper .zc-main-content-wrapper .zc-main-content .inner .page_content_wrapper .form-outer-wrapper {
    box-shadow: unset !important;
}

     * {
            padding: 0;
            margin: 0;
            border: none;
        }
	
        .main-container {
			height: calc(100% - 30px);
			width: calc(100% - 30px);
			padding: 10px 20px;
			position: relative;
			display: flex;
			flex-direction: column;
			gap: 15px;
			margin: 15px;
			box-sizing: border-box;
			border-radius: 10px;
// 			box-shadow: 0 0 10px 0 #cccccc;
			            box-sizing: border-box;

		}
		.Layout.elemContainment {
    padding: unset !important;
}
		.popage {
			border: 1px solid #cccccc;
			border-radius: 10px;
			overflow: auto;
		}

	  div#zppagesLive,
		div#elementsContainer,
		.Layout.elemContainment,
		div#row_1,
		.zc-pb-formreport-placeholder{
			height: 100% !important;
		}
		.PO_search .zc-footer-wrapper {
			display: none !important;
		}
		.PO_search .form-group {
        margin-bottom: 0px !important; 
        }
		.PO_search .zc-form-fullheight .form-outer-wrapper .formContainer,
		.PO_search  .form-outer-wrapper .formContainer
		{
			padding:0px !important;
		}
		.PO_search.divEmbedContainer {
			height:60px !important;
			padding-top:6px;
			            box-sizing: border-box;

        }
		.popage.divEmbedContainer {
			height:calc(100% - 90px) !important; 
        }
		.popage .zc-pb-page-content-wrapper [displaytype="plain"] .elemContainment
		{
			border:0px !important;
		}
		.search-text
		{
			font-size: 20px;
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%,-50%);
			color:#444aa5;
		}
		
			.button-div {
    width: 60px;
    height: 41px;
    background: #f8bb27;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
}
.zpelement-wrapper.zcpage-elemContainer#row_1 {
    border: none;
}
