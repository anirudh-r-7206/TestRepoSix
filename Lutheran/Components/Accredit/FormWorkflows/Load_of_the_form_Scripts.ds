Load_of_the_form_Scripts as "Load of the form - Scripts"
{

			
							type =  form
							form = Accredit
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														input.Renewal_Date = input.Accreditation.Due_Date;
									)
								}
							}
			
						
			
}