User_input_of_renewal_act as "User input of renewal action"
{

			
							type =  form
							form = Accredit
			
							record event = on add
			
							on user input of Renewal_Action
							{
								actions 
								{
									custom deluge script
									(
														if(input.Renewal_Action == "Extend")
													{
														show Renewal_Date;
													}
													else
													{
														disable Renewal_Date;
													}
													input.Renewal_Date = input.Accreditation.Due_Date;
									)
								}
							}
			
						
			
}