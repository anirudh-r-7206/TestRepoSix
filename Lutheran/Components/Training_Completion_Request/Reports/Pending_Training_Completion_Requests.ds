list Pending_Training_Completion_Requests
{

		
					displayName = "Awaiting Approval"
					show all rows from Training_Completion_Request  [ID == thisapp.reportfilters.getPendingTrainingCompletionRequests()]  
					(
						Completion_Date as "Completion Date"
						Evidence_File as "Evidence File "
						Status
						Staff
						Compliance_Training as " Compliance Training"
						Training_Type as "Training Type"
						custom action "Approve"
						(
			  			workflow = Approve1
						show action in edit record menu = true
						column header = "Approve"
						)
						custom action "Reject "
						(
			  			workflow = Reject1
						show action in edit record menu = true
						column header = "Reject "
						)
						Training_Name as "Training Name"
					)
					conditional formatting
					(
						"Completed"
						{
						condition = (Status == "Approved")
						fields = [Status]
						format = "color:#00a321;"
						}
						"Rejected"
						{
						condition = (Status == "Rejected")
						fields = [Status]
						format = "color:#e64d3b;"
						}
						"Pending"
						{
						condition = (Status == "Pending")
						fields = [Status]
						format = "color:#e77f06;"
						}
						"Credited"
						{
						condition = (Status == "Credited")
						fields = [Status]
						format = "color:#007cba;"
						}
					)
				
		
}