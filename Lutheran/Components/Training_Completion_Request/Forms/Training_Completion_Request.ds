form Training_Completion_Request
{

		
					displayname = "Training Completion Request"
					success message = "Training Completion Request Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Compliance_Training
					(
						type = picklist	
						displayname = " Compliance Training"
						values  = Compliance_Training.ID
		    			displayformat = [Training_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Staff
					(
						type = picklist	
						values  = Staff_Master.ID
		    			displayformat = [" " + Name.first_name + " " + Name.last_name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Training_Type
					(
						type = picklist	
						displayname = "Training Type"
						values  = Training_Type.ID
		    			displayformat = [Training]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Training_Name
					(
		    			type = text
						displayname = "Training Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Completion_Date
					(
		    			type = date
						displayname = "Completion Date"
						initial value = "${zoho.currentdate}"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Evidence_File
					(
		    			type = upload file
						displayname = "Evidence File "
		    			file count = 10
						browse = local_drive
			 			row = 1
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						maxchar = 100
						values = {"Pending","Approved","Credited","Rejected"}
						initial value = "Pending"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Current_Approver
					(
						type = picklist
						displayname = "Current Approver"
						maxchar = 100
						values = {"National Admin","Region Admin","School Admin","Campus Admin"}
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}