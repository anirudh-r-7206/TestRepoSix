On_Created_User_Input_of_1 as "On Created - User Input of Training Type"
{

			
							type =  form
							form = Training_Completion_Request
			
							record event = on add
			
							on user input of Training_Type
							{
								actions 
								{
									custom deluge script
									(
														fetExisting = Compliance_Training[ID != input.Compliance_Training && Staff == input.Staff && Training_Type == input.Training_Type && Completion_Date == input.Completion_Date && Status == "Pending"];
													if(fetExisting.count() > 0)
													{
														alert "There is a Pending Compliance Training for this Training Type.";
														input.Training_Type = null;
													}
									)
								}
							}
			
						
			
}