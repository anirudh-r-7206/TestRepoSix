user_input_of_staff as "user input of staff"
{

			
							type =  form
							form = Employee_Filter
			
							record event = on add
			
							on user input of Search_Staff
							{
								actions 
								{
									custom deluge script
									(
													if(input.Current_Page == "staffOnboard")
													{
														openUrl("#Report:All_Staff_Grouped?zc_LoadIn=embed-sd-reportview&zc_Header=false&zc_Footer=false","same window");
													}
									)
								}
							}
			
						
			
}