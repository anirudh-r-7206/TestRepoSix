form Qualifications
{

		
					success message = "Qualification Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Staff
					(
						type = picklist	
						values  = Staff_Master.ID
		    			bidirectional = Qualifications
		    			displayformat = [" " + Name.first_name + " " + Name.last_name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Qualification_Type
					(
						type = picklist	
						displayname = "Qualification Type"
						values  = Qualification_Type.ID
		    			displayformat = [qualification_type]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have completion_date
					(
		    			type = date
						displayname = "Completion Date"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = medium
					)
					Institution
					(
		    			type = text
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}