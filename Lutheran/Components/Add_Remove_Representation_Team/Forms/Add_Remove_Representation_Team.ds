form Add_Remove_Representation_Team
{

		
					displayname = "Add / Remove Representation/Team"
					store data in zc = false
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					From_Field
					(
						type = radiobuttons
						displayname = "From"
						maxchar = 100
						values = {"Staff","Representation/Team"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Action_field
					(
						type = radiobuttons
						displayname = "Action "
						maxchar = 100
						values = {"Add","Remove"}
						layout = 3
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Staff_Master
					(
						type = list	
						displayname = "Staff"
						values  = Staff_Master.ID
		    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Representation_Team
					(
						type = list	
						displayname = "Representation/Team"
						values  = Representation_Team.ID
		    			displayformat = [Representation_Team + " - " + Type_field]
						allow new entries
						[
							displayname = "Add New Committee"
						]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		
}