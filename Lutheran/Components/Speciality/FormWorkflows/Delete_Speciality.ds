Delete_Speciality as "Delete Speciality"
{

			
							type =  form
							form = Speciality
			
							record event = on delete
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														staff_masters = Staff_Master[Speciality == input.ID];
													staff_employments = Staff_Employment[Speciality == input.ID];
													staff_requests = Staff_Request[Speciality == input.ID];
													isImplemented = staff_masters.count() > 0 || staff_employments.count() > 0 || staff_requests.count() > 0;
													if(isImplemented)
													{
														alert "Speciality has been linked to few modules. Please unlink them to delete this Speciality.";
														cancel delete;
													}
									)
								}
							}
			
						
			
}