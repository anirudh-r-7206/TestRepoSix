Delete_Position as "Delete Position"
{

			
							type =  form
							form = Positions
			
							record event = on delete
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														staff_masters = Staff_Master[Current_Position == input.ID];
													staff_employments = Staff_Employment[Position == input.ID];
													staff_requests = Staff_Request[Current_Position == input.ID];
													isImplemented = staff_masters.count() > 0 || staff_employments.count() > 0 || staff_requests.count() > 0;
													if(isImplemented)
													{
														alert "Position has been linked to few modules. Please unlink them to delete this Position.";
														cancel delete;
													}
									)
								}
							}
			
						
			
}