list All_Staff_Admin
{

			displayName = "Raise Request"
			show all rows from Staff_Master  [status == "Active" && ID == thisapp.helpers.returnEligibleStaff()]  
			(
				date_of_birth as "Date Of Birth"
				gender as "Gender"
				religion as "Religion"
				origin as "Origin"
				status as "Status"
				Name 
				custom action "Edit Staff Record"
				(
	  			workflow = Raise_Request
				show action in edit record menu = true
				column header = "Edit Staff Record"
				condition = (status == "Active" && ID == thisapp.helpers.returnEligibleStaff())
				)
				Surname as "Middle name"
				Teaching_Staff as "Teaching Staff"
				Current_Position as "Current Position"
				FTE
				Teacher_Type as "Teacher Type"
				Date_Commenced_in_Current_School as "Date Commenced in Current School"
				Date_Commenced_in_Lutheran_School as "Date Commenced in Lutheran School"
				Current_Employment as "Current Employment"
				Photograph
				Phone_Number as "Phone"
				(
					displayformat = plainnumber 
				)
				Current_Employment.school_name as "School Name"
				Staff_Email as "Staff Email"
				Admin_Type as "Admin Type"
				Regions
				Organisation.organisation_name as "National Name"
				Campus.campus_name as "Campus Name"
				Added_Time as "Added Time"
			)
			sort by
			(
				Added_Time descending
			)
}