list Buzz_Book_Report
{

		
					displayName = "Buzz Book Report"
					show all rows from Staff_Master  [Teaching_Staff == "Yes" && status == "Active"]  
					(
						Photograph
						LEA_Staff_Rec_Num as "LEA staff record number"
						Name 
						Surname as "Middle name"
						Previous_Surname as "Previous  Surname "
						Phone_Number as "Phone"
						(
							displayformat = plainnumber 
						)
						date_of_birth as "Date Of Birth"
						gender as "Gender"
						Staff_Email as "Staff Email"
						religion as "Religion"
						origin as "Origin"
						status as "Status"
						Admin_Type as "Admin Type"
						Organisation as "National"
						Regions
						Current_Employment as "Current Employment"
						Campus
						Date_Commenced_in_Current_School as "Date Commenced in Current School"
						Date_Commenced_in_Lutheran_School as "Date Commenced in Lutheran School"
						Date_commenced_in_current_position as "Date commenced in current position"
						Teaching_Staff as "Teaching Staff"
						Acting as "Acting?"
						Current_Position as "Current Position"
						FTE
						Teacher_Type as "Teacher Type"
						Year_Level as "Year Level"
						Subject_form as "Subject"
						Speciality
						Total_Service_Period as "Total Service Period"
						Current_Employment.school_name as "School Name"
					)
				
		
}