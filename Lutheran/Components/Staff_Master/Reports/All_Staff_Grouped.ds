custom All_Staff_Grouped
{

		
					displayName = "All Staff Grouped"
					show all rows from Staff_Master    
					(
						date_of_birth as "Date Of Birth"
						gender as "Gender"
						religion as "Religion"
						origin as "Origin"
						status as "Status"
						Name 
						Surname as "Middle name"
						Current_Position as "Current Position"
						Photograph
						Phone_Number as "Phone"
						(
							displayformat = plainnumber 
						)
						Staff_Email as "Staff Email"
						Added_Time as "Added Time"
						Previous_Surname as "Previous  Surname "
						Admin_Type as "Admin Type"
						Organisation as "National"
						Regions
						Current_Employment as "Current Employment"
						Campus
						Teaching_Staff as "Teaching Staff"
						FTE
						Teacher_Type as "Teacher Type"
						Acting as "Acting?"
						Total_Service_Period as "Total Service Period"
						Date_Commenced_in_Current_School as "Date Commenced in Current School"
					)
					group by
					(
						status ascending
					)
					sort by
					(
						Added_Time descending
					)
					custom actions
					(
						"Raise Request"
						(
			  			workflow = Raise_Request1
						show action in edit record menu = true
						condition = (status == "Resigned" || status == "On Leave")
						)
						"Continue Onboarding"
						(
			  			workflow = Continue_Onboarding
						show action in edit record menu = true
						condition = (status == "Draft")
						)
						"Add / Remove Representation/Team"
						(
			  			workflow = Add_Remove_Representation
						show action in edit record menu = true
						condition = (status == "Active")
						)
					)
		
}