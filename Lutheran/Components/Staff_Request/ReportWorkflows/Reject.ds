Reject as "Reject"
{

			
							type =  functions
							form = Staff_Request
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									openUrl("#Form:History?Staff_Request=" + input.ID + "&Action_field=Request Rejected&zc_SubmitVal=Reject&zc_Header=false&zc_NextUrl=#Script:page.refresh","popup window");
								)
								}
							}
						
			
}