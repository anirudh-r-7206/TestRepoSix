On_Created_Edited_Success1 as "On Created & Edited - Successful form submission"
{

			
							type =  form
							form = School
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.school_image == "" || input.school_image.isEmpty())
													{
														input.school_image = thisapp.helpers.getEmptyState("DEFAULT_IMAGE");
													}
									)
								}
							}
			
						
			
}