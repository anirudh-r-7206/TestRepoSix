default list All_School_Infos
{

		
					displayName = "All Schools"
					show all rows from School    
					(
						school_name as "School Name"
						school_type as "School Type"
						school_image as "School Image"
						school_address  as "School Address"
						School_Email as "School Email"
						Region
						Region_Name as "Region Name"
					)
					group by
					(
						Region descending
					)
				
		
}