Load_of_the_form_On_Add_S as "Load of the form - On Add Scripts"
{

				type =  form
				form = Accreditation_Details

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Staff == null)
										{
											alert "You cannot add accreditation details directly here";
											openUrl("#Script:dialog.close","same window");
											return;
										}
										all_accreditations = Accreditation[ID != 0].ID.getAll();
										input.Required_Accreditation:ui.add(all_accreditations);
										last_accreditation = Accreditation_Details[Staff == input.Staff] sort by Added_Time desc range from 1 to 1;
										input.Due_Date = last_accreditation.Due_Date.addYear(5);
						)
					}
				}

			
}