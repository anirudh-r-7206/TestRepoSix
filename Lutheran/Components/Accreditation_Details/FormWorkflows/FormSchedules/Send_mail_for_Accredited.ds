Send_mail_for_Accredited as "Send mail for Accredited"
{

				type =  schedule
				form = Accreditation_Details[Status_Accreditation == "Accredited" && Completion_Date is null]
					status = inactive
				start = before 365 days from Due_Date at "08:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						thisapp.mail.sendAccreditationExpiringReminder(input.ID);
					)
					}
				}
			
}