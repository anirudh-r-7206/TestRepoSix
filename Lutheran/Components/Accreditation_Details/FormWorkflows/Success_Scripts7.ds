Success_Scripts7 as "Success Scripts"
{

			
							type =  form
							form = Accreditation_Details
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Due_Date < zoho.currentdate)
													{
														input.Status_Accreditation = "Not Accredited";
													}
									)
								}
							}
			
						
			
}