default list All_Accreditation_Details
{

			displayName = "All Accreditation Details"
			show all rows from Accreditation_Details  [Staff.ID == thisapp.helpers.returnEligibleStaff()]  
			(
				Status_Accreditation as "Status Accreditation"
				Staff
				Required_Accreditation as "Required Accreditation"
				Due_Date as "Due Date"
				PD_Hours_Collected as "PD Hours Collected"
				Staff.Photograph
				Completion_Date as "Completion Date"
			)
		
}