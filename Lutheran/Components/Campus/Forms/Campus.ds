form Campus
{

		
					success message = "Campus Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have School
					(
						type = picklist	
						values  = School.ID
		    			bidirectional = Campus
		    			displayformat = [school_name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have campus_name
					(
		    			type = text
						displayname = "Campus Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					campus_image
					(
		    			type = image
						displayname = "Campus Image"
						source  = file
						aspect ratio = original
						camera = primary
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Campus_Email
					(
		    			type = email
						displayname = "Campus Email"
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					campus_address
					(
		    			type = address
						displayname = "Campus Address"
		     			capture_coordinates = true
		     			adjust_using_map = false
		     			address_line_1
		     			(
			     			  type = address_line_1
			     			  displayname = "Address Line 1"
		     			) 
		     			address_line_2
		     			(
			     			  type = address_line_2
			     			  displayname = "Address Line 2"
		     			) 
		     			district_city
		     			(
			     			  type = district_city
			     			  displayname = "City / District"
		     			) 
		     			state_province
		     			(
			     			  type = state_province
			     			  displayname = "State / Province"
		     			) 
		     			postal_Code
		     			(
			     			  type = postal_Code
			     			  displayname = "Postal Code"
		     			) 
		     			country
		     			(
			     			  type = country
			     			  displayname = "Country"
		     			) 
		     			latitude
		     			(
			     			  type = latitude
			     			  displayname = "latitude"
			     			 visibility = false
		     			) 
		     			longitude
		     			(
			     			  type = longitude
			     			  displayname = "longitude"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Web_Address
					(
		    			type = url
						displayname = "Web Address"
						enable  linkname
			 			row = 1
			 			column = 1   
						width = medium
					)
					Head_of_Campus
					(
						type = picklist	
						displayname = "Head of Campus"
						values  = Staff_Master.ID
		    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Telephone
					(
		    			type = phonenumber
		    			defaultcountry="au"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Enrollment
					(
		    			type = text
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Postal_Address
					(
		    			type = address
						displayname = "Postal Address"
		     			capture_coordinates = true
		     			adjust_using_map = false
		     			address_line_1
		     			(
			     			  type = address_line_1
			     			  displayname = "Address Line 1"
		     			) 
		     			address_line_2
		     			(
			     			  type = address_line_2
			     			  displayname = "Address Line 2"
		     			) 
		     			district_city
		     			(
			     			  type = district_city
			     			  displayname = "City / District"
		     			) 
		     			state_province
		     			(
			     			  type = state_province
			     			  displayname = "State / Province"
		     			) 
		     			postal_Code
		     			(
			     			  type = postal_Code
			     			  displayname = "Postal Code"
		     			) 
		     			country
		     			(
			     			  type = country
			     			  displayname = "Country"
		     			) 
		     			latitude
		     			(
			     			  type = latitude
			     			  displayname = "latitude"
			     			 visibility = false
		     			) 
		     			longitude
		     			(
			     			  type = longitude
			     			  displayname = "longitude"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Staff_Generic_Email
					(
		    			type = email
						displayname = "Staff Generic Email"
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Organisation_Name
					(
		    			type = formula
						displayname = "National  Name"
						value =  ""
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
					Region_Name
					(
		    			type = formula
						displayname = "Region Name"
						value =  ""
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
					School_Name
					(
		    			type = formula
						displayname = "School Name"
						value =  ""
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}