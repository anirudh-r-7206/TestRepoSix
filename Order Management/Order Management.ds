			                 		{
			                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
			                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Buyer_Name}",get_PO.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			//	Amendment in app notification
			                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Buyer_Name}",get_PO.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 		}
			                 	}
			                 	else if(input.Template_Name == "Factory_Amendment")
			                 	{
			                 		to_Email = get_PO.Supplier.Email;
			                 		//	Amendment mail content
			                 		get_Email_Template = Email_Template[Template_Name == "Factory_Amendment"];
			                 		report_Name = "Production_Orders";
			                 		if(get_Email_Template.count() > 0)
			                 		{
			                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
			                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${PO_Number}",get_PO.PO_Number,true);
			                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Factory_Name}",get_PO.Supplier.Supplier_Organisation,true).replaceAll("${PO_Number}",get_PO.PO_Number,true);
			                 			//	Amendment in app notification
			                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${PO_Number}",get_PO.PO_Number,true);
			                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Factory_Name}",get_PO.Supplier.Supplier_Organisation,true).replaceAll("${PO_Number}",get_PO.PO_Number,true);
