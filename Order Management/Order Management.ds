t\t\t\t\t\t\t\t&lt;!-- Requests Details (Donut) --&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;card requests-details&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;card-title&quot;&gt;Requests Details&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;donut-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; style=&quot;width:100%;&quot; pageLinkName=&apos;Request_Details&apos; params=&apos;zc_Header=false&apos;&gt;Loading View...&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t&lt;!-- Purchase Orders (Bars) --&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;card po-bars&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;card-title&quot;&gt;Purchase Orders&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-list&quot;&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Awaiting Buyer review&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Buyer_Revew_Percentage&apos;)%&gt;%;background:#6366f1&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Buyer_Revew&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Awaiting Factory review&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Factory_Revew_Percentage&apos;)%&gt;%;background:#ef4444&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Factory_Revew&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Amendment Request&lt;br&gt;&lt;span\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstyle=&quot;font-size:0.74rem;color:var(--clr-text-muted)&quot;&gt;(Buyer)&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Buyer_Amendment_Requested_Percentage&apos;)%&gt;%;background:#38bdf8&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Buyer_Amendment_Requested&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Amendment Request&lt;br&gt;&lt;span\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstyle=&quot;font-size:0.74rem;color:var(--clr-text-muted)&quot;&gt;(Factory)&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Factory_Amendment_Requested_Percentage&apos;)%&gt;%;background:#a855f7&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Factory_Amendment_Requested&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\n\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Awaiting Production&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&