			void Delete_Records.Delete_PO(int ID1)
			{
			
			                 	fetPO = Purchase_Order[ID == ID1];
			                 	// Build PO details for email
			                 	poNumber = fetPO.PO_Number;
			                 	qoNumber = fetPO.QO_Number;
			                 	orderRef = fetPO.Order_Reference;
			                 	poDate = fetPO.PO_Date;
			                 	orderType = fetPO.Order_Type;
			                 	deliveryDate = fetPO.Delivery_Date;
			                 	transportMode = fetPO.Transport_Mode;
			                 	paymentTerms = fetPO.Payment_Terms;
			                 	orderStatus = fetPO.Order_Status;
			                 	totalQty = fetPO.Total_Quantity;
			                 	totalSellingPrice = fetPO.Total_Selling_Price;
			                 	totalPurchasePrice = fetPO.Total_Purchase_Price;
			                 	comments = fetPO.Comments11;
			                 	// Get Supplier display name from lookup
			                 	supplierName = "";
			                 	supplierID = fetPO.Supplier;
			                 	if(!supplierID.isNull())
			                 	{
			                 		supplierRec = Add_Suppliers[ID == supplierID];
			                 		supplierName = supplierRec.Supplier_Organisation;
			                 	}
			                 	// Get Buyer Organisation display name from lookup
			                 	buyerName = "";
			                 	buyerID = fetPO.Buyer_Organisation;
			                 	if(!buyerID.isNull())
			                 	{
			                 		buyerRec = Buyers_Master[ID == buyerID];
			                 		buyerName = buyerRec.Buyer_Organisation;
			                 	}
			                 	// Handle null values for display
			                 	if(poNumber.isNull())
			                 	{
			                 		poNumber = "-";
			                 	}
			                 	if(qoNumber.isNull())
			                 	{
			                 		qoNumber = "-";
			                 	}
			                 	if(orderRef.isNull())
			                 	{
			                 		orderRef = "-";
			                 	}
			                 	poDateStr = "";
			                 	if(!poDate.isNull())
			                 	{
			                 		poDateStr = poDate.toString("dd-MMM-yyyy");
			                 	}
			                 	else
			                 	{
			                 		poDateStr = "-";
			                 	}
			                 	if(orderType.isNull())
			                 	{
			                 		orderType = "-";
			                 	}
			                 	deliveryDateStr = "";
			                 	if(!deliveryDate.isNull())
			                 	{
			                 		deliveryDateStr = deliveryDate.toString("dd-MMM-yyyy");
			                 	}
			                 	else
			                 	{
			                 		deliveryDateStr = "-";
			                 	}
			                 	if(transportMode.isNull())
			                 	{
			                 		transportMode = "-";
			                 	}
			                 	if(paymentTerms.isNull())
			                 	{
			                 		paymentTerms = "-";
			                 	}
			                 	if(orderStatus.isNull())
			                 	{
			                 		orderStatus = "-";
			                 	}
			                 	if(totalQty.isNull())
			                 	{
			                 		totalQty = 0;
			                 	}
			                 	if(totalSellingPrice.isNull())
			                 	{
			                 		totalSellingPrice = 0;
			                 	}
			                 	if(totalPurchasePrice.isNull())
			                 	{
			                 		totalPurchasePrice = 0;
			                 	}
			                 	if(comments.isNull())
			                 	{
			                 		comments = "-";
			                 	}
			                 	if(supplierName.isNull() || supplierName.isEmpty())
			                 	{
			                 		supplierName = "-";
			                 	}
			                 	if(buyerName.isNull() || buyerName.isEmpty())
			                 	{
			                 		buyerName = "-";
			                 	}
			                 	// Build styled HTML table
			                 	hdrStyle = "style=\"background-color:#2c3e50;color:#ffffff;padding:10px 15px;text-align:left;font-family:Arial,sans-serif;font-size:14px;border:1px solid #ddd;\"";
			                 	oddRowLbl = "style=\"background-color:#f9f9f9;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;border:1px solid #ddd;color:#333;\"";
			                 	oddRowVal = "style=\"background-color:#f9f9f9;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;border:1px solid #ddd;color:#555;\"";
			                 	evenRowLbl = "style=\"background-color:#ffffff;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;border:1px solid #ddd;color:#333;\"";
			                 	evenRowVal = "style=\"background-color:#ffffff;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;border:1px solid #ddd;color:#555;\"";
			                 	htmlBody = "<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#333;\">";
			                 	htmlBody = htmlBody + "<p>The following Purchase Order has been deleted:</p>";
			                 	htmlBody = htmlBody + "<table style=\"border-collapse:collapse;width:100%;max-width:700px;margin:15px 0;border:1px solid #ddd;\">";
			                 	htmlBody = htmlBody + "<thead><tr><th " + hdrStyle + ">Field</th><th " + hdrStyle + ">Value</th></tr></thead>";
			                 	htmlBody = htmlBody + "<tbody>";
			                 	// Row 1 - PO Number (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">PO Number</td><td " + oddRowVal + ">" + poNumber + "</td></tr>";
			                 	// Row 2 - QO Number (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">QO Number</td><td " + evenRowVal + ">" + qoNumber + "</td></tr>";
			                 	// Row 3 - Order Reference (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Order Reference</td><td " + oddRowVal + ">" + orderRef + "</td></tr>";
			                 	// Row 4 - PO Date (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">PO Date</td><td " + evenRowVal + ">" + poDateStr + "</td></tr>";
			                 	// Row 5 - Supplier (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Supplier</td><td " + oddRowVal + ">" + supplierName + "</td></tr>";
			                 	// Row 6 - Buyer Organisation (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Buyer Organisation</td><td " + evenRowVal + ">" + buyerName + "</td></tr>";
			                 	// Row 7 - Order Type (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Order Type</td><td " + oddRowVal + ">" + orderType + "</td></tr>";
			                 	// Row 8 - Delivery Date (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Delivery Date</td><td " + evenRowVal + ">" + deliveryDateStr + "</td></tr>";
			                 	// Row 9 - Transport Mode (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Transport Mode</td><td " + oddRowVal + ">" + transportMode + "</td></tr>";
			                 	// Row 10 - Payment Terms (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Payment Terms</td><td " + evenRowVal + ">" + paymentTerms + "</td></tr>";
			                 	// Row 11 - Order Status (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Order Status</td><td " + oddRowVal + ">" + orderStatus + "</td></tr>";
			                 	// Row 12 - Total Quantity (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Total Quantity</td><td " + evenRowVal + ">" + totalQty + "</td></tr>";
			                 	// Row 13 - Total Selling Price (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Total Selling Price</td><td " + oddRowVal + ">" + totalSellingPrice + "</td></tr>";
			                 	// Row 14 - Total Purchase Price (even)
			                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Total Purchase Price</td><td " + evenRowVal + ">" + totalPurchasePrice + "</td></tr>";
			                 	// Row 15 - Comments (odd)
			                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Comments</td><td " + oddRowVal + ">" + comments + "</td></tr>";
			                 	htmlBody = htmlBody + "</tbody></table>";
			                 	htmlBody = htmlBody + "</div>";
			                 	// Perform all deletions
			                 	delete from Purchase_LineItems[Purchase_Order == ID1];
			                 	delete from Additional_Charges_Form[Purchase_Order == ID1];
			                 	fileRec = History[Purchase_Order_ID == ID1 && !File_upload.isEmpty()];
			                 	delete from History[Purchase_Order_ID == ID1];
			                 	fetCopyPO = Copy_of_Purchase_Order[Purchase_Order == fetPO.ID];
			                 	delete from Copy_of_Purchase_LineItems[Copy_of_Purchase_Order == fetCopyPO.ID];
			                 	delete from Copy_of_Purchase_Order[ID == fetCopyPO.ID];
			                 	delete from Order_Details[Order_Request == fetPO.Order_Request];
			                 	delete from Order_Request[ID == fetPO.Order_Request];
			                 	delete from Purchase_Order[ID == ID1];
			                 	emailList = Create_User[User_Type == "Admin" && User_Type == "Internal"].Email.getAll();
			                 	sendmail
			                 	[
			                 		from :zoho.adminuserid
			                 		to :emailList
			                 		subject :"PO Deleted : " + poNumber
			                 		message :htmlBody
			                 		content type :HTML
			                 	]
			                 
			}

			list Delete_Records.Delete_Partners()
			{
			
			                 	Partners_List = List();
			                 	get_From_PO = Purchase_Order[ID != 0];
			                 	Partners_List.addAll(get_From_PO.Freight_Forwarder.getall());
			                 	return Partners_List.distinct();
			                 
			}

			list Delete_Records.Delete_Product_Categories()
			{
			
			                 	Product_Category_List = List();
			                 	get_From_Sizes = Create_Size[ID != 0];
			                 	Product_Category_List.addAll(get_From_Sizes.Product_Category.getall());
			                 	get_From_Catelog = Add_Product[ID != 0];
			                 	Product_Category_List.addAll(get_From_Catelog.Style_Category.getall());
			                 	get_Style = Style[ID != 0];
			                 	Product_Category_List.addAll(get_Style.Style_Category.getall());
			                 	return Product_Category_List.distinct();
			                 
			}

			list Delete_Records.Delete_Product_catalog()
			{
			
			                 	product_List = List();
			                 	get_Order_Product = Order_Details[ID != 0];
			                 	product_List.addAll(get_Order_Product.Product.getall());
			                 	get_Purchase_Product = Purchase_LineItems[ID != 0];
			                 	product_List.addAll(get_Purchase_Product.Product.getall());
			                 	get_Buyer_Product = Buyer_Products[ID != 0 && Buyer_Product_Mapping != null];
			                 	product_List.addAll(get_Buyer_Product.Style_ID.getall());
			                 	return product_List.distinct();
			                 
			}

			list Delete_Records.Delete_Size()
			{
			
			                 	size_List = List();
			                 	get_Size_Map = Size_Chart_Mapping[ID != 0];
			                 	size_List.addAll(get_Size_Map.Size.getall());
			                 	get_Product_Size = Add_Product[ID != 0];
			                 	size_List.addAll(get_Product_Size.Size_Set.getall());
			                 	get_Order_Size = Order_Details[ID != 0];
			                 	size_List.addAll(get_Order_Size.Product_Size.getall());
			                 	get_Purchase_Size = Purchase_LineItems[ID != 0];
			                 	size_List.addAll(get_Purchase_Size.Product_Size.getall());
			                 	return size_List.distinct();
			                 
			}

			list Delete_Records.Delete_Styles()
			{
			
			                 	Style_List = List();
			                 	// 	get_From_Currency = Currency_Conversion_Rates[ID != 0];
			                 	// 	Style_List.addAll(get_From_Currency.Style_Name.getall());
			                 	get_Product = Add_Product[ID != 0];
			                 	Style_List.addAll(get_Product.Style_Code.getall());
			                 	return Style_List.distinct();
			                 
			}

			list Delete_Records.Delete_Suppliers()
			{
			
			                 	Supplier_List = List();
			                 	get_User_Suppliers = Create_User[ID != 0];
			                 	Supplier_List.addAll(get_User_Suppliers.Associated_Factory.getall());
			                 	get_Buyer_Suppliers = Buyer_Product_Mapping[ID != 0];
			                 	Supplier_List.addAll(get_Buyer_Suppliers.Factory_Allocated.getall());
			                 	get_Order_Supplier = Order_Request[ID != 0];
			                 	Supplier_List.addAll(get_Order_Supplier.Factory.getall());
			                 	return Supplier_List.distinct();
			                 
			}

			void Delete_Records.Delete_Unmapped_Products()
			{
			
			                 	delete from Buyer_Products[Buyer_Product_Mapping == null];
			                 
			}

			list Delete_Records.Delete_Users()
			{
			
			                 	Users_List = List();
			                 	get_From_Order_Request = Order_Request[ID != 0];
			                 	Users_List.addAll(get_From_Order_Request.Buyer_Name.getall());
			                 	get_From_PO = Purchase_Order[ID != 0];
			                 	Users_List.addAll(get_From_PO.Customer_Name.getall());
			                 	Users_List.addAll(get_From_PO.Supplier_old.getall());
			                 	return Users_List.distinct();
			                 
			}

			list Delete_Records.Delete_Wardrobes()
			{
			
			                 	Wardrobes_List = List();
			                 	get_From_Products = Add_Product[ID != 0];
			                 	Wardrobes_List.addAll(get_From_Products.Wardrobe.getall());
			                 	get_From_Buyers = Buyers_Master[ID != 0];
			                 	Wardrobes_List.addAll(get_From_Buyers.Wardrobe.getall());
			                 	return Wardrobes_List.distinct();
			                 
			}

			void Discontinue_Product_Catalog(Add_Product Ids)
			{
			
			                 	for each  id in Ids
			                 	{
			                 		get_Catalog = Add_Product[ID == id.ID];
			                 		if(get_Catalog.count(ID) > 0)
			                 		{
			                 			get_Catalog.Status="Discontinued";
			                 		}
			                 	}
			                 
			}

			void Publish_URL.Download_PDF_to_PO_QO(int id, string type)
			{
			
			                 	get_PO = Purchase_Order[ID == input.id];
			                 	// 	https://creatorapp.zohopublic.com/sodexo/order-management-sodexo-v2/page-perma/PO_Template/FUCnB3TwzbeFgNPFmPk7FvAwZdpkzM2Py0BxxajRsZFMtTq0YdDs6gWRKFHOZMsafHTsSs87U0ZJ1QNA3HSVBKpNKG1pGPT1ksnf
			                 	// 	https://creatorapp.zohopublic.com/sodexo/order-management-sodexo-v2/page-perma/QO_Template/QDh30qgtrRTBZsA2h23vf60vFMTP5TV2KwNENauuVHZNOkNjzZYjEkZ4QuzzEPY5HC593PtvCdtmuROS60AM2OHmUa2BQHYe3dQ6
			                 	// https://creatorapp.zohopublic.com/sodexo/order-management-sodexo-v2/page-perma/POTemplate/3xuz5kZKKWwWOmMXa9rr2RrzuxKyKzg1XV3Zupn8AgMkm1REx9hJFurSd7zzNqB81MYC3sWdZFOfwWRrPwEz8WrzawY3GPh98xCJ
			                 	// https://creatorapp.zohopublic.com/sodexo/order-management-sodexo-v2/page-perma/QOTemplate/Z3FtHtuGumY3mvg93tymj5qK6RVCzp9GbVzdxOujxz5TGn7xHbUxf30CDHSyAPBwTWA66FBnJkV7kpYxgzQEG2YQ7pxPDmed9me0
			                 	if(type == "PO")
			                 	{
			                 		url = "https://creatorapp.zohopublic.com" + thisapp.Publish_URL.AppURI() + "pdf/POTemplate/3xuz5kZKKWwWOmMXa9rr2RrzuxKyKzg1XV3Zupn8AgMkm1REx9hJFurSd7zzNqB81MYC3sWdZFOfwWRrPwEz8WrzawY3GPh98xCJ?isc5page=true&Po_ID=" + input.id + "&pageorientation=landscape";
			                 		resp = invokeurl
			                 		[
			                 			url :url
			                 			type :GET
			                 		];
			                 		filee = resp;
			                 		filee.setFileName(get_PO.PO_Number + ".pdf");
			                 	}
			                 	else
			                 	{
			                 		url = "https://creatorapp.zohopublic.com" + thisapp.Publish_URL.AppURI() + "pdf/QOTemplate/Z3FtHtuGumY3mvg93tymj5qK6RVCzp9GbVzdxOujxz5TGn7xHbUxf30CDHSyAPBwTWA66FBnJkV7kpYxgzQEG2YQ7pxPDmed9me0?isc5page=true&QO_ID=" + input.id + "&pageorientation=landscape";
			                 		resp = invokeurl
			                 		[
			                 			url :url
			                 			type :GET
			                 		];
			                 		filee = resp;
			                 		filee.setFileName(get_PO.QO_Number + ".pdf");
			                 	}
			                 	rs = insert into PO_QO_template
			                 	[
			                 		Added_User=zoho.loginuser
			                 		File_upload=filee
			                 		Purchase_Order=input.id
			                 	];
			                 	fetchFile = PO_QO_template[ID == rs];
			                 	openUrl("https://creator.zoho.com/file" + zoho.appuri + "PO_QO_template_Report/" + fetchFile.ID + "/File_upload/download?filepath=/" + fetchFile.File_upload,"new window");
			                 
			}

			void Send_Mail.Email_Template(int QO_ID, String Template_Name)
			{
			
			                 	//	QO Email Template
			                 	// 			QO_ID = 4908788000001014076;
			                 	// 			Template_Name = "Buyer_QO_Cancelled";
			                 	// 			
			                 	get_PO = Purchase_Order[ID == input.QO_ID];
			                 	// 	to_Email = get_PO.Buyer_Organisation.Primary_Email;
			                 	cc_Email = List();
			                 	cc_Email.add(thisapp.Dev.Primary_SSA_Admin_Email());
			                 	PO_File = false;
			                 	QO_File = false;
			                 	if(input.Template_Name == "Buyer_Order_Submit")
			                 	{
			                 		get_Order = Order_Request[ID == input.QO_ID];
			                 		to_Email = get_Order.Buyer_Organisation.Primary_Email;
			                 		//	mail content
			                 		get_Email_Template = Email_Template[Template_Name == "Buyer_Order_Submit"];
			                 		report_Name = "Production_Orders";
			                 		if(get_Email_Template.count() > 0)
			                 		{
			                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
			                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${OR_Number}",get_Order.Order_ID,true);
			                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Buyer_Name}",get_Order.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${OR_Number}",get_Order.Order_ID,true);
			                 			//	In app notification
			                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${OR_Number}",get_Order.Order_ID,true);
			                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Buyer_Name}",get_Order.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${OR_Number}",get_Order.Order_ID,true);
			                 		}
			                 	}
			                 	else if(input.Template_Name == "QO_Template")
			                 	{
			                 		QO_File = true;
			                 		to_Email = get_PO.Buyer_Organisation.Primary_Email;
			                 		//	QO mail content
			                 		get_Email_Template = Email_Template[Template_Name == "QO_Template"];
			                 		report_Name = "My_Purchase_Orders";
			                 		if(get_Email_Template.count() > 0)
			                 		{
			                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
			                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Buyer_Name}",get_PO.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			mail_Msg = mail_Msg.replaceAll("${Review_Link}","<a href='https://creatorapp.zoho.com" + thisapp.Publish_URL.AppURI() + "#Report:My_Purchase_Orders?zc_AddRec=false&zc_MoreAction=false&QO_Number=" + get_PO.QO_Number + "' style='display:inline-block; padding:10px 18px; background-color:#2563eb; color:#ffffff; text-decoration:none; border-radius:4px; font-weight:600;'> Review Order </a>",true);
			                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Buyer_Name}",get_PO.Buyer_Organisation.Buyer_Organisation,true);
			                 			app_Msg = app_Msg.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 		}
			                 	}
			                 	else if(input.Template_Name == "Awaiting_PO_Generation")
			                 	{
			                 		to_Email = get_PO.Supplier.Email;
			                 		//	mail content
			                 		get_Email_Template = Email_Template[Template_Name == "Awaiting_PO_Generation"];
			                 		report_Name = "Production_Orders";
			                 		if(get_Email_Template.count() > 0)
			                 		{
			                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
			                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Factory_Name}",get_PO.Supplier.Supplier_Organisation,true).replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			//	In app notification
			                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Factory_Name}",get_PO.Supplier.Supplier_Organisation,true).replaceAll("${QO_Number}",get_PO.QO_Number,true);
			                 		}
			                 	}
			                 	else if(input.Template_Name == "Buyer_Review")
			                 	{
			                 		to_Email = get_PO.Buyer_Organisation.Primary_Email;
			                 		QO_File = true;
			                 		//	mail content
			                 		get_Email_Template = Email_Template[Template_Name == "Buyer_Review"];
			                 		report_Name = "My_Purchase_Orders";
			                 		if(get_Email_Template.count() > 0)
			                 		{
			                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
