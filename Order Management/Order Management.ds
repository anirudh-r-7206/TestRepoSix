age%&gt;% margin on sell&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;section&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;section-hd&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;hd-dot&quot; style=&quot;background:#185FA5&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;section-title&quot;&gt;Order details&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;field-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;PO number&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Purchase_Order.PO_Number%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Order type&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Order_Type%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Order reference&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Order_Reference%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Payment terms&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Payment_Terms%&gt; days&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;section&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;section-hd&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;hd-dot&quot; style=&quot;background:#1D9E75&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;span class=&quot;section-title&quot;&gt;Parties &amp;amp; location&lt;/span&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;field-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Supplier&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Supplier.Supplier_Organisation%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Buyer organisation&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Buyer_Organisation.Buyer_Organisation%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Country&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Country.Country_Name%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;field&quot;&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-label&quot;&gt;Incoterm&lt;/div&gt;\n\t\t\t\t\t\t\t&lt;div class=&quot;field-val&quot;&gt;&lt;%=get_PO.Incoterms%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t\t\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;PO_subForm&quot;&gt;\n\t\t\t&lt;div class=&quot;Form_Header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;header_Name&quot;&gt;Purchase LineItems&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;header_backBtn&quot;&gt;\n\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;PO_Style_Search&apos; style=&quot;height: 54px;&quot; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Purchase_Order=&lt;%=input.PO_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;a class=&quot;add_POItem&quot; style=&quot;width: 30px; padding: 0;&quot; href=&quot;#Form:Copy_of_Purchase_LineItems?zc_LoadIn=embed-editPO&amp;Copy_of_Purchase_Order=&lt;%=get_PO.ID%&gt;&amp;zc_Header=false&quot;&gt;\n\t\t\t\t\t\t&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; height=&quot;24px&quot; viewBox=&quot;0 -960 960 960&quot; width=&quot;24px&quot; fill=&quot;var(--primary_color)&quot