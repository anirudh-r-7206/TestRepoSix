					custom actions
					(
						"Reject"
						(
			  			workflow = Buyer_Reject
						show action in view header = true
						show action in edit record menu = true
						condition = (Approval_Status == "Pending")
						)
						"Activate"
						(
			  			workflow = Activate_Buyers
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Inactive")
						)
						"Delete Buyers"
						(
			  			workflow = Delete_Selected_Buyers1
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Buyers())
						)
						"Deactivate"
						(
			  			workflow = Deactivate_Buyer
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Active" && Approval_Status == "Approved" && ID != thisapp.Deactivate_Records.Deactivate_Buyer())
						confirmation before execution
						(
							message for individual record = "Do you want to proceed with deactivating this buyer?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Approve"
						(
			  			workflow = Buyer_Approve
						show action in view header = true
						show action in edit record menu = true
						condition = (Approval_Status == "Pending")
						)
					)
					conditional formatting
					(
						"Active"
						{
						condition = (Status == "Active")
						fields = [Status]
						format = "color:#5dc35a;"
						}
						"Inactive"
						{
						condition = (Status == "Inactive")
						fields = [Status]
						format = "color:#ef1616;"
						}
					)
				
		}

