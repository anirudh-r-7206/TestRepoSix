					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet15' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet15()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tuser_Data = thisapp.Page.dashboard_data(&quot;userData&quot;);\n\t%&gt;\n&lt;html&gt;\n\n&lt;head&gt;\n\t\t&lt;style&gt;\n\t\t&lt;%=thisapp.Style.user_dashboard_style()%&gt;\n\t\t\n// \t\t.stat-item:hover {\n// \t\t\tbackground: var(--clr-hover);\n// \t\t\tcolor: var(--clr-primary);\n// \t\t\tpadding: 0px 10px;\n// \t\t}\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body class=&quot;procure-dashboard&quot;&gt;\n\n\t\t&lt;!-- ===== MAIN WRAPPER ===== --&gt;\n\t\t&lt;div class=&quot;page-wrapper&quot;&gt;\n\n\t\t\t\t&lt;!-- ===== MAIN CONTENT ===== --&gt;\n\t\t\t\t&lt;main class=&quot;main-content&quot;&gt;\n\n\t\t\t\t\t\t&lt;!-- ===== STAT CARDS ROW ===== --&gt;\n\t\t\t\t\t\t&lt;section class=&quot;stat-cards&quot;&gt;\n\n\t\t\t\t\t\t\t\t&lt;!-- Requests --&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;stat-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;stat-card__header&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;stat-card__label&quot;&gt;Requests&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;stat-card__icon&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;svg width=&quot;35&quot; height=&quot;35&quot; viewBox=&quot;0 0 35 35&quot; fill=&quot;none&quot;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\txmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;path\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\td=&quot;M11.7174 30.1619V19.664L11.7174 14.3148H8.57345C8.25639 14.3148 7.99935 14.0578 7.99935 13.7407V11.7177C7.99935 9.66431 9.66398 7.99967 11.7174 7.99967L25.285 7.99967C26.1154 7.99967 26.9118 8.36835 27.499 9.0246C28.0861 9.68084