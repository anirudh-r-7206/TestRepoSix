		    			displayformat = [" " + User_Name.prefix + " " + User_Name.first_name + " " + User_Name.last_name + " " + User_Name.suffix]
						sortorder = ascending
			 			row = 4
			 			column = 1   
						width = small
					)
					Last_Order
					(
		    			type = checkbox
						displayname = "Last Order"
						initial value = false
			 			row = 4
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						maxchar = 100
						values = {"Pending","Awaiting Supplier Selection","Awaiting QO Generation","Validation Pending","In Production","In Transit","Completed","Cancelled"}
						initial value = "Pending"
			 			row = 4
			 			column = 1   
						width = small
					)
					Auto_Number
					(
		    			type = autonumber
						displayname = "Auto Number"
						start index = 1001
			 			row = 4
			 			column = 1   
						width = medium
					)
					Total_Quantity
					(
						type = number
						displayname = "Total Quantity"
						initial value = 0
			 			row = 4
			 			column = 1   
						width = medium
					)
					Order_Reference
					(
		    			type = text
						displayname = "Order Reference"
			 			row = 4
			 			column = 1   
						width = medium
					)
					Delivery_Address
					(
						type = picklist	
						displayname = "Delivery Address"
						values  = Buyer_Contact_Person_Details[Buyers_Master.ID == input.Buyer_Organisation].ID
		    			displayformat = [" " + Address.address_line_1 + " " + Address.address_line_2 + " " + Address.district_city + " " + Address.state_province]
						sortorder = ascending
			 			row = 4
			 			column = 1   
						width = medium
					)
					Transport_Mode
					(
						type = picklist
						displayname = "Transport Mode"
						maxchar = 100
						values = {"SEA","AIR","ROAD"}
			 			row = 4
			 			column = 1   
						width = medium
					)
					Comments
					(
		    			type = textarea
						height = 100px
			 			row = 4
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

