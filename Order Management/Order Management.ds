						)
						Status as "Status "
						Remarks as "Remarks "
						User_Name  as "User Name"
						Approval_Status as "Approval Status"
						custom action "Approve"
						(
			  			workflow = Approve_User1
						show action in view header = true
						show action in edit record menu = true
						column header = "Approve"
						confirmation before execution
						(
							message for individual record = "Execute the Approve action for this record?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						custom action "Reject"
						(
			  			workflow = Reject_User
						show action in view header = true
						show action in edit record menu = true
						column header = "Reject"
						condition = (Approval_Status != "Rejected")
						confirmation before execution
						(
							message for individual record = "Execute the Reject action for this record?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					filters
					(
						Persona_Role
						Status
						"Activate User"  :  Status == "Active"
						"Deactivate User"  :  Status == "Inactive"
					)
					group by
					(
						Approval_Status ascending
					)
					custom actions
					(
						"Activate"
						(
			  			workflow = User_Activate
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Inactive")
						)
						"Deactivate"
						(
			  			workflow = User_Deactivate
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Active")
						)
					)
					conditional formatting
					(
						"Pending"
						{
						condition = (Approval_Status == "Pending")
						fields = [Approval_Status]
						format = "color:#398ef3;"
						}
						"Approved"
						{
						condition = (Approval_Status == "Approved")
						fields = [Status, Approval_Status]
						format = "color:#5dc35a;"
						}
						"Rejected"
						{
						condition = (Approval_Status == "Rejected")
						fields = [Status, Approval_Status]
						format = "color:#ef1616;"
						}
					)
				
		}

