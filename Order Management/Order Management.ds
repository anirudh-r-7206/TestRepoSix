			string Page.PO_Currency_Convert(float Amount)
			{
			
			                 	amtStr = input.Amount;
			                 	parts = amtStr.toList(".");
			                 	intPart = parts.get(0).toList("");
			                 	decPart = "";
			                 	if(parts.size() > 1)
			                 	{
			                 		decPart = parts.get(1);
			                 	}
			                 	formattedInt = "";
			                 	count = 0;
			                 	intPart_Size = intPart.size() - 1;
			                 	for each  ch in intPart
			                 	{
			                 		if(intPart.get(intPart_Size) != "")
			                 		{
			                 			if(count == 3)
			                 			{
			                 				formattedInt = "," + formattedInt;
			                 				count = 0;
			                 			}
			                 			formattedInt = intPart.get(intPart_Size) + formattedInt;
			                 			count = count + 1;
			                 		}
			                 		intPart_Size = intPart_Size - 1;
			                 	}
			                 	if(decPart != "")
			                 	{
			                 		return formattedInt + "." + decPart;
			                 	}
			                 	else
			                 	{
			                 		return formattedInt;
			                 	}
			                 
			}

			string Style.PO_Templet_Style()
			{
			
			                 	return "<style>.page * { padding: 0; margin: 0; box-sizing: border-box; } .page { margin: auto; background: #fff; padding: 30px 10px; } .header { display: flex; justify-content: space-between; /* border-bottom: 3px solid #000; */ padding-bottom: 20px; } .logo img { width: 130px; } .logo p { font-size: 12px; margin: 5px 0 0; } .title { display: flex; flex-direction: column; justify-content: space-around; text-align: right; } .title h2 { margin: 0; } .title p { font-size: 12px; } .info-section { display: flex; justify-content: space-between; margin-top: 15px; margin-bottom: 15px; } .box { width: calc(100% / 3); font-size: 12px; } .box h4 { background: #000; color: #fff; padding: 5px; margin: 0 0 5px; } .box_Content { height: calc(100% - 30px); font-size: 11px; display: flex; flex-direction: column; justify-content: space-between; padding-right: 10px; } .summary { width: 100%; border-collapse: collapse; } .summary td { padding: 3px; font-size: 11px; } .order-title { text-align: center !important; padding: 6px !important; font-weight: bold; font-size: 15px; } .order-table { width: 100%; border-collapse: collapse; font-size: 11px; } .order-table th, .order-table td { border: 1px solid #000; padding: 4px 10px; text-align: center; }.order-table td:last-child { text-align: right; } .order-table th { color: #fff; background: #000; } /*  */ .text_Left { text-align: right !important; } .text_Bold { font-weight: bold; } /* Repeat header on every page */ thead { display: table-header-group !important; } /* Comments box */ .comments-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; page-break-inside: avoid !importent; } .comments-label { width: 120px; border: 1px solid #000; vertical-align: top; padding: 6px;page-break-inside: avoid; } .comments-content { border: 1px solid #000; padding: 6px 6px 6px 20px; line-height: 1.4; } /* Signature box */ .signature-table { width: 40%; border-collapse: collapse; border: 1px solid #000; margin-top: 30px; font-size: 12px; bold;page-break-inside: avoid;  } .signature-table td { padding: 12px; height: 30px; font-weight:} td.t_right { text-align: right; }</style>";
			                 
			}

			string Page.PO_Templet_Table(int Po_ID, String type)
			{
			
			                 	// 	Po_ID = 4235496000027466275;
			                 	get_PO = Purchase_Order[ID == input.Po_ID];
			                 	get_Po_Cat_No = (get_PO.Purchase_LineItems.Style_Code.getall()).distinct();
			                 	//	Table Header 
			                 	// 	(" + if(input.type == "PO","Purchase Price","Selling Price") + ")
			                 	// 	<tr> <th colspan=\"11\" class=\"order-title\">Order Information</th> </tr>
			                 	PO_Table = "<table class=\"order-table\"> <thead>  <tr> <th>#</th> <th>Style Name</th> <th>Style Code</th> <th>Colour</th> <th>Size</th> <th>Gender</th> <th>Fabric Composition</th> <th>HS Code</th> <th>Qty</th> <th>Unit Price<br></th> <th>Total</th> </tr> </thead>";
			                 	// Table Body
			                 	PO_Table = PO_Table + "<tbody>";
			                 	s_No = 0;
			                 	total_Qty = 0;
			                 	for each  catNO in get_Po_Cat_No
			                 	{
			                 		s_No = s_No + 1;
			                 		get_Cat_Items = Purchase_LineItems[Purchase_Order == input.Po_ID && Style_Code == catNO] sort by Size_Order;
			                 		for each  Items in get_Cat_Items
			                 		{
			                 			// 			s_No = s_No + 1;
			                 			get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_PO.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == get_PO.Supplier && Style_ID == Items.Product];
			                 			// 			if(get_Buyer_Product.count(ID) > 0,get_Buyer_Product.HS_Code,"")
			                 			PO_Table = PO_Table + "<tr> <td>" + s_No + "</td> <td>" + get_Cat_Items.Product.Style_Code.Style_Name + "</td> <td>" + catNO + "</td> <td>" + Items.Product_Color.Color_Name + "</td> <td>" + Items.Product_Size.Size + "</td> <td>" + Items.Product.Gender + "</td> <td>" + if(!Items.Fabric_Composition.isEmpty(),Items.Fabric_Composition,"") + "</td> <td>" + if(!Items.HS_Code,Items.HS_Code,"") + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(Items.Quantity) + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(if(input.type == "PO",Items.Purchase_Price,Items.Selling_Price)) + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(if(input.type == "PO",Items.Purchase_Price_Sub_Total,Items.Selling_Price_Sub_Total)) + "</td> </tr>";
			                 		}
			                 		total_Qty = total_Qty + get_Cat_Items.sum(Quantity);
			                 		PO_Table = PO_Table + "<tr> <td colspan=\"8\" class=\"text_Left text_Bold\">Sub Total</td> <td class=\"text_Bold t_right\">" + thisapp.Page.PO_Currency_Convert(get_Cat_Items.sum(Quantity)) + "</td> <td></td> <td class=\"text_Bold t_right\">" + thisapp.Page.PO_Currency_Convert(if(input.type == "PO",get_Cat_Items.sum(Purchase_Price_Sub_Total).round(2),get_Cat_Items.sum(Selling_Price_Sub_Total).round(2))) + "</td> </tr>";
			                 	}
			                 	// ---- Buyer-paid Additional Charges (QO template only) ----
			                 	if(input.type == "QO")
			                 	{
			                 		buyerCharges = Additional_Charges_Form[Purchase_Order == input.Po_ID && Paid_By == "Buyer"];
			                 		if(buyerCharges.count() > 0)
			                 		{
			                 			PO_Table = PO_Table + "<tr> <td colspan=\"11\" class=\"text_Left text_Bold\">Additional Charges : </td> </tr>";
			                 			for each  charge in buyerCharges
			                 			{
			                 				chargeLabel = ifnull(charge.Charge_Type.Charge_Type,"Additional Charge");
			                 				if(!charge.Description.isEmpty())
			                 				{
			                 					chargeLabel = chargeLabel + " - " + charge.Description;
			                 				}
			                 				PO_Table = PO_Table + "<tr> <td colspan=\"10\" class=\"text_Left\">" + chargeLabel + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(ifnull(charge.Amount1,0).round(2)) + "</td> </tr>";
			                 			}
			                 		}
			                 	}
			                 	//Grand Total
			                 	PO_Table = PO_Table + "<tr> <td colspan=\"8\" class=\"text_Left text_Bold\">Grand Total</td> <td class=\"text_Bold t_right\">" + thisapp.Page.PO_Currency_Convert(total_Qty) + "</td> <td></td> <td class=\"text_Bold t_right\">" + if(input.type == "PO",thisapp.Page.PO_Currency_Convert(get_PO.Total_Purchase_Price.round(2)),thisapp.Page.PO_Currency_Convert(get_PO.Total_Selling_Price.round(2))) + "</td> </tr>";
			                 	PO_Table = PO_Table + "</tbody> </table>";
			                 	return PO_Table;
			                 
			}

			string Style.PO_V2_Templet_Style()
			{
			
			                 	return ".po-container *{ padding: 0; margin: 0; box-sizing: border-box; } .po-container { background-color: #ffffff; position: relative; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); } /* Action Bar inside Header Row */ .logo-area { width: 140px; height: 46px; } .logo-area img { height: 100%; } .action-bar { display: flex; gap: 12px; } /* Updated Button Styles to White Background */ .btn { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; padding: 8px 24px; border-radius: 4px; cursor: pointer; outline: none; background-color: #ffffff; color: #000000; border: 1px solid #ffffff; } /* Header & First Row (Updated with Black Background) */ .header { background-color: #000000; margin-bottom: 25px; padding: 20px; display: flex; justify-content: space-between; align-items: center; } /* Metadata Title Area */ .po-meta-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 15px; } .title-tag { font-size: 11px; font-weight: 600; color: #7a8b9a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; } .po-number { font-size: 28px; font-weight: 700; color: #0d1b2a; margin-bottom: 5px; } .date-info { font-size: 12px; color: #9aa8b6; } /* Right side totals block styling preserved */ .totals-summary { display: flex; gap: 45px; text-align: right; } /* Divider line */ .divider { border: none; border-top: 1px solid #edf1f5; margin: 20px 0; } /* Parties Section */ .parties-grid { display: flex; justify-content: space-between; margin-top: 25px; margin-bottom: 25px; } .party-col { width: 48%; } .party-title { font-size: 16px; font-weight: 600; color: #1a2530; margin-bottom: 14px; } .party-name { font-size: 14px; font-weight: 600; color: #2c3a47; margin-bottom: 8px; } .party-details { font-size: 13px; color: #5a6b7c; line-height: 1.6; } /* Summary and Factory/Delivery Grid */ .logistics-grid { display: grid; grid-template-columns: 4.8fr 5.2fr; gap: 50px; margin-top: 25px; margin-bottom: 35px; } .sec-heading { font-size: 14px; font-weight: 600; color: #1a2530; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 15px; } /* Summary Table Specifics */ .summary-box { background-color: #fcfdfe; border-radius: 4px; } .summary-table { width: 100%; border-collapse: collapse; } .summary-table td { padding: 7px 0; font-size: 13.5px; color: #5a6b7c; vertical-align: top; } .summary-table td:nth-child(1) { width: 120px; } .summary-table td:nth-child(2) { width: 25px; color: #9aa8b6; } .summary-table td:nth-child(3) { color: #000000; font-weight: 500; } /* Factory / Delivery text styling */ .addr-text { font-size: 13px; color: #2c3a47; line-height: 1.6; } .muted-text { color: #5a6b7c; } /* Items Table Container Wrapper */ .order-info-section { margin-top: 40px; } /* Items Table */ .items-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; } .items-table th { background-color: #000000; color: #ffffff; font-size: 11px; font-weight: 500; text-align: left; padding: 12px 8px; letter-spacing: 0.2px; vertical-align: middle; } .items-table td { padding: 16px 8px; font-size: 12px; color: #2c3a47; border-bottom: 1px solid #edf1f5; vertical-align: top; line-height: 1.4; } .items-table td.desc-text { color: #5a6b7c; font-size: 11.5px; max-width: 250px; } /* Table helper weight classes */ .font-medium { font-weight: 500; } .font-semibold { font-weight: 600; } .font-bold { font-weight: 700; } /* Totals Row Backgrounds */ .row-subtotal td { background-color: #eef1f4; border-bottom: 1px solid #ffffff; padding: 12px 8px; font-size: 13px; color: #1a2530; } .row-grandtotal td { background-color: #e2e7ec; border-bottom: none; padding: 12px 8px; font-size: 13px; color: #1a2530; } /* Footer signoff layout */ .footer-signoff { display: grid; grid-template-columns: 4.8fr 5.2fr; gap: 50px; margin-top: 45px; align-items: start; } /* Lines Signature inputs */ .signature-form { display: flex; flex-direction: column; gap: 16px; } .form-line { display: flex; align-items: flex-end; } .form-line .label { width: 110px; font-size: 12px; font-weight: 600; color: #3e4e5e; padding-bottom: 2px; } .form-line .line-input { flex-grow: 1; border-bottom: 1px solid #ced7e0; height: 20px; } /* Empty placeholder container to maintain layout structure */ .comments-box { display: flex; flex-direction: column; } .t_right {text-align: right;} thead { display: table-header-group !important; } .po-meta-row, .parties-grid, .logistics-grid, .order-info-section { margin: 0 25px; }";
			                 
			}

