		form organization
		{
		
					title 
		    		{
						displayname = "Organization"
		    			on add = "Organization"
		   	 			on edit = "Organization"
					}
					success message = "Organization Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Logo
					(
		    			type = image
						source  = file
						aspect ratio = original
						camera = primary
						show gallery = true
						switch camera = true
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Organization_Name
					(
		    			type = text
						displayname = "Organization Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Phone_Number
					(
		    			type = phonenumber
						displayname = "Phone"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Address
					(
		    			type = address
		     			capture_coordinates = true
		     			adjust_using_map = false
		     			address_line_1
		     			(
			     			  type = address_line_1
			     			  displayname = "Address Line 1"
		     			) 
		     			address_line_2
		     			(
			     			  type = address_line_2
			     			  displayname = "Address Line 2"
		     			) 
		     			district_city
		     			(
			     			  type = district_city
			     			  displayname = "City / District"
		     			) 
		     			state_province
		     			(
			     			  type = state_province
			     			  displayname = "State / Province"
		     			) 
		     			postal_Code
		     			(
			     			  type = postal_Code
			     			  displayname = "Postal Code"
		     			) 
		     			country
		     			(
			     			  type = country
			     			  displayname = "Country"
		     			) 
		     			latitude
		     			(
			     			  type = latitude
			     			  displayname = "latitude"
			     			 visibility = false
		     			) 
		     			longitude
		     			(
			     			  type = longitude
			     			  displayname = "longitude"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 2   
						width = medium
						personal data = true
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				properties
				{
					total entries
					{
						allowed count = 1
					}
				}
				
		}
	}

	reports
	{
		default list All_Colors
		{
		
					displayName = "Colors"
					show all rows from Add_Colors    
					(
						Color_Name as "Color Name"
						Color_Code as "Color Code"
						Status
						Hex_Color_Code as "Hex Color Code"
					)
					custom actions
					(
						"Activate"
						(
			  			workflow = Activate_Color
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Inactive")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to activate this color?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Delete Colors"
						(
			  			workflow = Delete_Color
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Colors())
						)
						"Deactivate"
						(
			  			workflow = Deactive_Color
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Active")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to deactivate this color?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Edit "
						(
			  			workflow = Edit_Color1
						show action in view header = true
						show action in edit record menu = true
						)
						"Delete "
						(
			  			workflow = Delete_Color1
						show action in view header = true
						show action in edit record menu = true
						confirmation before execution
						(
							message for individual record = "Execute the Delete Color action for this record?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					conditional formatting
					(
						"Active"
						{
						condition = (Status == "Active")
						fields = [Status]
						format = "color:#5dc35a;"
						}
						"Inactive"
						{
						condition = (Status == "Inactive")
						fields = [Status]
						format = "color:#ef1616;"
						}
					)
				
		}

		default list All_Countries
		{
		
					displayName = "Countries"
					show all rows from Add_Country    
					(
						Country_Name as "Country Name"
						Status
						Region_Code as "Region Code"
						Region_Code_New as "Region Code New"
					)
					custom actions
					(
						"Delete Countries"
						(
			  			workflow = Delete_Selected_Countries
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Countries())
						)
						"Activate"
						(
			  			workflow = Active_Country
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Inactive")
						confirmation before execution
						(
							message for individual record = "Do you want to activate this country?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Deactivate"
						(
			  			workflow = Deactivate_Country
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Active")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to deactivate this country?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Edit Country"
						(
			  			workflow = Edit1
						show action in view header = true
						)
						"Delete Country"
						(
			  			workflow = Delete_workflow
						show action in view header = true
						confirmation before execution
						(
							message for individual record = "Are you sure you want to delete this item? This action cannot be undone."
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					conditional formatting
					(
						"Active"
						{
						condition = (Status == "Active")
						fields = [Status]
						format = "color:#5dc35a;"
						}
						"Inactive"
						{
						condition = (Status == "Inactive")
						fields = [Status]
						format = "color:#ef1616;"
						}
					)
				
		}

		list Active_Products
		{
		
					displayName = "Active Products"
					show all rows from Add_Product  [ID == thisapp.Filters.Filter_Products() && Status == "Approved"]  
					(
						Style_Code as "Style Code"
						Style_Colour as "Style Colour"
						Style_Range as "Style Range"
						Style_Name as "Style Name"
						Style_Category as "Product Category"
						Gender
						Size_Set as "Size Set"
						Fabric_Code as "Fabric Colour Code"
						HS_Code_EU as "HS Code EU "
						HS_Code_USA as "HS Code USA"
						HS_Code_APAC as "HS Code APAC"
						Product_Weight as "Product Weight"
						Status as "Status "
						Wardrobe
						CBM
						Product_Picture.Image as "Product Picture"
						Product_Description as "Fabric Description"
						Product_Sub_Code as "Product Sub Code"
						Style_ID as "Style ID"
						custom action "Add to Cart"
						(
			  			workflow = Add_to_Cart
						show action in edit record menu = true
						column header = "Add to Cart"
						)
						Primary_Image as "Primary Image"
						Size_Set.Size_Order as "Size Order"
					)
					filters
					(
						Status
						Wardrobe
						Style_Category
					)
					group by
					(
						properties
		    			(
		  	    			display record count = true
		   				)
						Style_Category ascending
						Style_Code ascending
					)
					sort by
					(
						Style_Category ascending
						Size_Set.Size_Order ascending
					)
					custom actions
					(
						"Discontinue"
						(
			  			workflow = Discontinue_Product_Catal
						show action in view header = true
						execute action for collection of records
						condition = (Status == "Approved")
						confirmation before execution
						(
							message for multiple records = "Are you sure you want to discontinue the selected ${record_count} records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Approve "
						(
			  			workflow = Approve_Product_Catalog
						show action in view header = true
						execute action for collection of records
						condition = (Status == "Discontinued")
						confirmation before execution
						(
							message for multiple records = "Are you sure you want to Approve  for the selected ${record_count} records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Delete Products"
						(
			  			workflow = Delete_Products
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Product_catalog())
						confirmation before execution
						(
							message for multiple records = "Are you sure you want to delete products for the selected ${record_count} records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					conditional formatting
					(
						"Approved"
						{
						condition = (Status == "Approved")
						fields = [Status]
						format = "color:#5dc35a;"
						}
						"Discontinued"
						{
						condition = (Status == "Discontinued")
						fields = [Status]
						format = "color:#cc1111;"
						}
					)
				
		}

