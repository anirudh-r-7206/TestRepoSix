iv&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Completed&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t&lt;!-- Quick Links --&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;card quick-links&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;card-title&quot;&gt;Quick Links&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;link-list&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Countries?zc_LoadIn=dialog&quot;&gt;Countries&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Colors?zc_LoadIn=dialog&quot;&gt;Colors&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Fabrics?zc_LoadIn=dialog&quot;&gt;Fabrics&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Styles?zc_LoadIn=dialog&quot;&gt;Styles&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Product_Categories?zc_LoadIn=dialog&quot;&gt;Style Categories&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Sizes?zc_LoadIn=dialog&quot;&gt;Sizes&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Wardrobes?zc_LoadIn=dialog&quot;&gt;Wardrobes&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t\t\t&lt;!-- ===== PURCHASE ORDERS TABLE ===== --&gt;\n\t\t\t\t\t\t&lt;div class=&quot;card table-card&quot;&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;All_Purchase_Orders&apos; params=&apos;zc_Header=true&apos;&gt;Loading View...&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;/main&gt;\n\t\t&lt;/div&gt;\n\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page My_Basket_Page(int supplierId)
		{
					displayname = "My Basket"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet20' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet20()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tparam_value = &quot;zc_AddRec=false&quot;;\n\tif(input.supplierId != null)\n\t{\n\t\tparam_value = &quot;Status=Pending&amp;Factory.ID=&quot; + input.supplierId;\n\t}\n\t%&gt;\n&lt;div class=&apos;report&apos; elName=&apos;zc-component&apos; style=&quot;height:calc(100vh - 70px);&quot; viewLinkName=&apos;My_Order_Requests&apos; params=&apos;&lt;%=param_value%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page My_Basket_Summary(int ID1)
		{
					displayname = "My Basket Summary"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet30' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet30()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tresp = &quot;https://creatorapp.zoho.com&quot; + zoho.appuri + &quot;record-summary/My_Order_Requests/&quot; + input.ID1;\n\tfetOrder = Order_Request[ID == input.ID1];\n\t%&gt;\n&lt;style&gt;\n\t.jsoverall{\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t}\n\t.jsSubmit{\n\t\tmargin-right: 55px;\n\t\tbackground: #4548d9;\n\t\tcolor: #fff;\n\t\tpadding: 8px;\n\t\tborder-radius: 8px;\n\t\tmargin-top: 10px;\n}\n\t}\n\t&lt;/style&gt;\n&lt;div style=&quot;height:calc(100vh - 70px);&quot;&gt;\n&lt;div class=&quot;jsoverall&quot;&gt;\n\t&lt;a href=&quot;#Page:My_Basket_Page?supplierId=&lt;%=fetOrder.Factory%&gt;&quot; style=&quot;display: flex; gap: 5px; align-items: center; padding: 10px 0 0 10px;&quot;&gt;&lt;svg width=&quot;20&quot; height=&quot;20&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;none&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;\n\t&lt;path d=&quot;M15.833 10H4.167M4.167 10l5-5m-5 5 5 5&quot; stroke=&quot;#2b3797&quot; stroke-width=&quot;1.8&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;/&gt;\n&lt;/svg&gt; Go to My Basket&lt;/a&gt;\n&lt;a href=&quot;#Form:Order_Request_Update?Order_Request=&lt;%=input.ID1%&gt;&amp;zc_LoadIn=dialog&quot; class=&quot;jsSubmit&quot;&gt;Submit&lt;/a&gt; \n&lt;/div&gt;\n&lt;iframe name=&apos;zohoview&apos; height=&apos;100%&apos; width=&apos;100%&apos; frameborder=&apos;0&apos; scrolling=&apos;Auto&apos; src=&apos;&lt;%=resp%&gt;&apos; &gt;&lt;/iframe&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page My_Purchase_Orders_Page
		{
					displayname = "My Purchase Orders"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet23' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet23()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; name=&quot;editPO&quot; style=&quot;height: calc(100vh - 70px);&quot; viewLinkName=&apos;My_Purchase_Orders&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page POTemplate(int Po_ID)
		{
					displayname = "POTemplate"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet24' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet24()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\t// \tPo_ID = 4908788000000468095;\n\tget_PO = Purchase_Order[ID == input.Po_ID];\n\tget_PO_Items = Purchase_LineItems[Purchase_Order == input.Po_ID];\n\tget_Buyer = Buyers_Master[ID == get_PO.Buyer_Organisation];\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;UTF-8&quot; /&gt;\n&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;/&gt;\n&lt;title&gt;Purchase Order \u2013 &lt;%=get_PO.PO_Number%&gt;&lt;/title&gt;\n&lt;style&gt;\n\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n}\ndiv#zppagesLive,\ndiv#elementsContainer,\n.Layout.elemContainment,\ndiv#row_1,\n.zc-pb-formreport-placeholder {\n\t\theight: 100% !important;\n}\n.Layout.elemContainment {\n\t\tpadding: unset !important;\n}\n\n\tform[name=&quot;Print_and_PDF_Button&quot;].label-left{\n\t\t\twidth: 100% !important;\n\t\t\tbackground-color: #000000 !important;\n\t\t\tborder-radius: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .label-left{\n\t\t\twidth: 100%;\n\t\t\t\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formContainer {\n\t\t\tpadding: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .form-group.zc-decisionbox-field-group, form[name=&quot;Print_and_PDF_Button&quot;] .zc-form-scroll-wrapper {\n\t\t\tmargin: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .decision-box-field.form-field.clearfix {\n\t\t\tdisplay: none;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formColumn.first-column\n\t\t{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: end;\n\t\t\tgap: 10px;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] label.form-label.decision-box-label {\n\t\t\tcolor: #fff !important;\n\t\t\tpadding: 10px 20px !important;\n\t\t\tbackground-color: var(--primary_color);\n\t\t\tborder-radius: 8px;\n\t\t\tmargin: 0px !important;\n\t\t}\n\n\t\t.zc-footer-wrapper{\n\t\t\tdisplay: none;\n\t\t}\n\t\t@media print {\n\t\t  /* Specific margins for different sides */\n\t\t  @page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t  }\n\t\t   .action-bar{\n\t\t\t display: none !important;\n\t\t }\n\t\t  .page{\n\t\t\t  padding: 0px;\n\t\t  }\n\t\t}\n\t/* \u2500\u2500 ROOT CONTAINER \u2500\u2500 */\n\t#po-root {\n\t\tfont-family: &apos;Segoe UI&apos;, Arial, sans-serif;\n\t\tfont-size: 13px;\n\t\tcolor: #222;\n\t}\n\n\t/* \u2500\u2500 MAIN PAGE CARD \u2500\u2500 */\n\t#po-card {\n\t\tmax-width: 100%;\n\t\tbackground: #fff;\n\t\tborder-radius: 6px;\n\t\tbox-shadow: 0 2px 16px rgba(0,0,0,0.10);\n\t\toverflow: hidden;\n\t}\n\n\t/* \u2500\u2500 TOP BAR (inside card) \u2500\u2500 */\n\t#po-topbar {\n\t\tbackground: #1a1a2e;\n\t\tpadding: 10px 40px;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t}\n\t#po-topbar .po-logo-img {\n\t\theight: 36px;\n\t\twidth: auto;\n\t\tdisplay: inline-block;\n\t\tborder-radius: 4px;\n\t}\n\t#po-topbar .action-bar {\n\t\tdisplay: flex;\n\t\tgap: 10px;\n\t}\n\n\t/* \u2500\u2500 CONTENT AREA \u2500\u2500 */\n\t#po-content {\n\t\tpadding: 36px 40px;\n\t}\n\n\t/* \u2500\u2500 PO HEADER \u2500\u2500 */\n\t#po-header {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: flex-start;\n\t\tmargin-bottom: 28px;\n\t}\n\t#po-header .po-label {\n\t\tfont-size: 10.5px;\n\t\tfont-weight: 700;\n\t\tcolor: #e05a00;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 1px;\n\t\tmargin-bottom: 4px;\n\t}\n\t#po-header .po-number {\n\t\tfont-size: 26px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tline-height: 1.1;\n\t}\n\t#po-header .po-issued {\n\t\tfont-size: 11.5px;\n\t\tcolor: #888;\n\t\tmargin-top: 5px;\n\t}\n\t#po-header .po-issued .po-due { color: #e05a00; }\n\t#po-header .po-totals {\n\t\tdisplay: flex;\n\t\tgap: 40px;\n\t\ttext-align: right;\n\t}\n\t#po-header .po-totals .tot-block .tot-label {\n\t\tfont-size: 10px;\n\t\tfont-weight: 700;\n\t\tcolor: #888;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.8px;\n\t\tmargin-bottom: 4px;\n\t}\n\t#po-header .po-totals .tot-block .tot-val {\n\t\tfont-size: 24px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t}\n\t#po-header .po-totals .tot-block .tot-val.tot-accent { color: #e05a00; }\n\n\t/* \u2500\u2500 DIVIDER \u2500\u2500 */\n\t.po-divider {\n\t\tborder: none;\n\t\tborder-top: 1.5px solid #e8e8e8;\n\t\tmargin: 0 0 24px;\n\t}\n\n\t/* \u2500\u2500 SUPPLIER / BUYER \u2500\u2500 */\n\t#po-parties {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\tgap: 30px;\n\t\tmargin-bottom: 28px;\n\t}\n\t.po-party .party-title {\n\t\tfont-size: 14px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tmargin-bottom: 10px;\n\t}\n\t.po-party .party-info {\n\t\tfont-size: 12.5px;\n\t\tcolor: #333;\n\t\tline-height: 1.7;\n\t}\n\t.po-party .party-info .party-name { font-weight: 700; color: #111; }\n\n\t/* \u2500\u2500 SUMMARY SECTION \u2500\u2500 */\n\t#po-summary {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\tborder: 1px solid #e0e0e0;\n\t\tborder-radius: 6px;\n\t\tmargin-bottom: 28px;\n\t\toverflow: hidden;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-summary-left {\n\t\tpadding: 22px 26px;\n\t\tborder-right: 1px solid #e0e0e0;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-summary-left .summary-heading {\n\t\tfont-size: 11px;\n\t\tfont-weight: 800;\n\t\tletter-spacing: 1.2px;\n\t\ttext-transform: uppercase;\n\t\tcolor: #444;\n\t\tmargin-bottom: 14px;\n\t}\n\t#po-summary-left .summary-table { width: 100%; border-collapse: collapse; }\n\t#po-summary-left .summary-table .s-key {\n\t\tcolor: #888;\n\t\twidth: 120px;\n\t\tpadding: 4px 0;\n\t\tfont-size: 12.5px;\n\t\tvertical-align: top;\n\t}\n\t#po-summary-left .summary-table .s-colon {\n\t\twidth: 16px;\n\t\tcolor: #888;\n\t\tpadding: 4px 0;\n\t\tfont-size: 12.5px;\n\t}\n\t#po-summary-left .summary-table .s-val {\n\t\tfont-weight: 500;\n\t\tcolor: #111;\n\t\tpadding: 4px 0;\n\t\tfont-size: 12.5px;\n\t}\n\n\t/* \u2500\u2500 FACTORY / DELIVERY \u2500\u2500 */\n\t#po-summary-right { padding: 22px 26px; background: #fff; }\n\t#po-summary-right .factory-block { margin-bottom: 22px; }\n\t#po-summary-right .block-title {\n\t\tfont-size: 14px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tmargin-bottom: 8px;\n\t}\n\t#po-summary-right .block-attn {\n\t\tfont-size: 12.5px;\n\t\tcolor: #444;\n\t\tmargin-bottom: 2px;\n\t}\n\t#po-summary-right .block-attn .attn-name { font-weight: 700; color: #111; }\n\t#po-summary-right .block-info {\n\t\tfont-size: 12.5px;\n\t\tcolor: #444;\n\t\tline-height: 1.7;\n\t}\n\t#po-summary-right .block-info .info-bold { font-weight: 700; color: #111; }\n\n\t/* \u2500\u2500 ORDER TABLE \u2500\u2500 */\n\t#po-order-title {\n\t\tfont-size: 16px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tmargin-bottom: 12px;\n\t}\n\t#po-order-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-bottom: 28px;\n\t\tfont-size: 12px;\n\t}\n\t#po-order-table .thead-row { background: #1a1a2e; }\n\t#po-order-table .thead-row .th-cell {\n\t\tpadding: 11px 10px;\n\t\ttext-align: center;\n\t\tfont-weight: 600;\n\t\tfont-size: 11.5px;\n\t\tcolor: #fff;\n\t\tletter-spacing: 0.3px;\n\t}\n\t#po-order-table .tbody-row { border-bottom: 1px solid #eee; }\n\t#po-order-table .tbody-row .td-cell {\n\t\tpadding: 12px 10px;\n\t\ttext-align: center;\n\t\tcolor: #333;\n\t\tvertical-align: middle;\n\t}\n\t#po-order-table .tbody-row .td-fabric {\n\t\ttext-align: left;\n\t\tfont-size: 11.5px;\n\t\tcolor: #555;\n\t\tpadding: 12px 10px;\n\t\tvertical-align: middle;\n\t}\n\t#po-order-table .tfoot-subtotal .tfd-cell {\n\t\tpadding: 11px 10px;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n\t\tbackground: #f0f0f0;\n\t\tborder-top: 1.5px solid #ddd;\n\t\ttext-align: center;\n\t}\n\t#po-order-table .tfoot-subtotal .tfd-cell.tfd-label { text-align: left; padding-left: 14px; }\n\t#po-order-table .tfoot-grandtotal .tfd-cell {\n\t\tpadding: 11px 10px;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n\t\tbackground: #e8e8e8;\n\t\tborder-top: 1.5px solid #ddd;\n\t\ttext-align: center;\n\t}\n\t#po-order-table .tfoot-grandtotal .tfd-cell.tfd-label { text-align: left; padding-left: 14px; }\n\n\t/* \u2500\u2500 DYNAMIC ORDER TABLE (from PO_Templet_Table function) \u2500\u2500 */\n\t.order-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-bottom: 28px;\n\t\tfont-size: 12px;\n\t}\n\t.order-table thead tr {\n\t\tbackground: #1a1a2e;\n\t}\n\t.order-table thead th {\n\t\tpadding: 11px 10px;\n\t\ttext-align: center;\n\t\tfont-weight: 600;\n\t\tfont-size: 11.5px;\n\t\tcolor: #fff;\n\t\tletter-spacing: 0.3px;\n\t\tborder: none;\n\t}\n\t.order-table tbody tr {\n\t\tborder-bottom: 1px solid #eee;\n\t}\n\t.order-table tbody td {\n\t\tpadding: 12px 10px;\n\t\ttext-align: center;\n\t\tcolor: #333;\n\t\tvertical-align: middle;\n\t\tborder: none;\n\t}\n\t.order-table .t_right { text-align: right; }\n\t.order-table .text_Left { text-align: left; padding-left: 14px; }\n\t.order-table .text_Bold { font-weight: 700; }\n\t/* Sub Total row */\n\t.order-table tr:has(td[colspan=&quot;8&quot;]:not(.text_Bold ~ *)) td,\n\t.order-table tbody tr td[colspan=&quot;8&quot;] {\n\t\tbackground: #f0f0f0;\n\t}\n\t.order-table tbody tr:last-child td {\n\t\tbackground: #e8e8e8;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n\t\tborder-top: 1.5px solid #ddd;\n\t}\n\t/* Sub total rows - any row with colspan=8 */\n\t.order-table tbody tr td.text_Bold[colspan=&quot;8&quot;] {\n\t\tbackground: #f0f0f0;\n\t\tborder-top: 1.5px solid #ddd;\n\t\tfont-size: 13px;\n\t}\n\t.order-table tbody tr:has(td[colspan=&quot;8&quot;]) td {\n\t\tbackground: #f0f0f0;\n\t\tborder-top: 1.5px solid #ddd;\n\t\tfont-size: 13px;\n\t\tfont-weight: 700;\n\t}\n\t.order-table tbody tr:last-child td {\n\t\tbackground: #e8e8e8 !important;\n\t\tborder-top: 2px solid #ccc;\n\t}\n\n\t/* \u2500\u2500 FOOTER SIGNATURE \u2500\u2500 */\n\t#po-footer {\n\t\tborder: 1px solid #e0e0e0;\n\t\tborder-radius: 6px;\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\toverflow: hidden;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-footer-left {\n\t\tpadding: 22px 26px;\n\t\tborder-right: 1px solid #e0e0e0;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 18px;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-footer-left .sig-row {\n\t\tdisplay: flex;\n\t\talign-items: flex-end;\n\t\tgap: 12px;\n\t}\n\t#po-footer-left .sig-row .sig-label {\n\t\tfont-size: 12.5px;\n\t\tcolor: #444;\n\t\tmin-width: 110px;\n\t\tfont-weight: 500;\n\t}\n\t#po-footer-left .sig-row .sig-line {\n\t\tflex: 1;\n\t\tborder-bottom: 1.5px solid #bbb;\n\t\theight: 20px;\n\t}\n\t#po-footer-right {\n\t\tpadding: 22px 26px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-footer-right .commentss-label {\n\t\tfont-size: 11px;\n\t\tfont-weight: 700;\n\t\tletter-spacing: 1px;\n\t\tcolor: #888;\n\t\ttext-transform: uppercase;\n\t\tmargin-bottom: 8px;\n\t}\n\t#po-footer-right .comments-area {\n\t\tflex: 1;\n\t\tborder: 1.5px solid #ccc;\n\t\tborder-radius: 4px;\n\t\tmin-height: 90px;\n\t\tresize: none;\n\t\tpadding: 8px;\n\t\tfont-family: &apos;Segoe UI&apos;, Arial, sans-serif;\n\t\tfont-size: 12.5px;\n\t\tcolor: #333;\n\t\toutline: none;\n\t}\n\n\t/* \u2500\u2500 PRINT \u2500\u2500 */\n\t.zc-footer-wrapper { display: none; }\n\t@media print {\n\t\t@page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t}\n\t\t.action-bar { display: none !important; }\n\t #po-footer\n\t {\npage-break-inside: avoid;\t   \n\t }\n\t}\n\n\tspan.party-address {\n\t\t\tcolor: #959595;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n}\n\t&lt;%=thisapp.Style.PO_Templet_Style()%&gt;\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n\n&lt;div id=&quot;po-root&quot;&gt;\n\t&lt;div id=&quot;po-card&quot;&gt;\n\n\t\t&lt;!-- TOP BAR --&gt;\n\t\t&lt;div id=&quot;po-topbar&quot;&gt;\n\t\t\t&lt;img src=&quot;&lt;%=thisapp.Publish_URL.Org_IMG()%&gt;&quot; class=&quot;po-logo-img&quot;&gt;\n\t\t\t&lt;div class=&quot;action-bar&quot;&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Print_and_PDF_Button&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Template=PO_V2&amp;Purchase_Order=&lt;%=input.Po_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- CONTENT --&gt;\n\t\t&lt;div id=&quot;po-content&quot;&gt;\n\n\t\t\t&lt;!-- PO HEADER --&gt;\n\t\t\t&lt;div id=&quot;po-header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;po-meta&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;po-label&quot;&gt;Purchase Order&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;po-number&quot;&gt;&lt;%=get_PO.PO_Number%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;po-issued&quot;&gt;Issued &lt;%=get_PO.PO_Date%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;hr class=&quot;po-divider&quot;/&gt;\n\n\t\t\t&lt;!-- SUPPLIER / BUYER --&gt;\n\t\t\t&lt;div id=&quot;po-parties&quot;&gt;\n\t\t\t\t&lt;div class=&quot;po-party&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;party-title&quot;&gt;Buyer&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;party-info&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;party-name&quot;&gt;&lt;%=if(get_PO.Buyer_Organisation.Buyer_Organisation.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Buyer_Organisation)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t&lt;span class = &quot;party-address&quot;&gt;    &lt;%=if(get_PO.Buyer_Organisation.Office_Address.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Office_Address)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Name1.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Name1)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Email)%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;po-party&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;party-title&quot;&gt;Supplier&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;party-info&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;party-name&quot;&gt;&lt;%=if(get_PO.Supplier.Supplier_Organisation.isEmpty(),&quot;---&quot;,get_PO.Supplier.Supplier_Organisation)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t &lt;span class = &quot;party-address&quot;&gt;     &lt;%=if(get_PO.Supplier.Factory_Address.isEmpty(),&quot;---&quot;,get_PO.Supplier.Factory_Address)%&gt;&lt;br&gt; &lt;/span&gt; \n\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Contact_Person2.isEmpty(),&quot;---&quot;,get_PO.Supplier.Contact_Person2)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Phone.isEmpty(),&quot;---&quot;,get_PO.Supplier.Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Email.isEmpty(),&quot;---&quot;,get_PO.Supplier.Email)%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- SUMMARY + FACTORY --&gt;\n\t\t\t&lt;div id=&quot;po-summary&quot;&gt;\n\t\t\t\t&lt;div id=&quot;po-summary-left&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;summary-heading&quot;&gt;Summary&lt;/div&gt;\n\t\t\t\t\t&lt;table class=&quot;summary-table&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Payment Terms&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Customer_Name.Associated_Buyer.Payment_Terms%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t            &lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Currency&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Purchase_Currency.Currency_Name%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Total Cost&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO.Total_Purchase_Price.round(2))%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Total Qty&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO_Items.sum(Quantity))%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t            &lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;COO&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=if(get_PO.Supplier.Country != null,get_PO.Supplier.Country.Country_Name.upper(),&quot;---&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Freight Mode&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Transport_Mode.upper()%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Incoterm&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;FOB&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div id=&quot;po-summary-right&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;factory-block&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-title&quot;&gt;Factory&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-attn&quot;&gt;&lt;span class=&quot;attn-name&quot;&gt;ATTN :&lt;/span&gt; &lt;%=if(get_PO.Factory_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Factory_Contact_Person)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-info&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;info-bold&quot;&gt;&lt;%=if(get_PO.Factory_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Factory_Company_Name)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t\t &lt;span class = &quot;party-address&quot;&gt;   &lt;%=if(get_PO.Factory_Address1.address_line_1.isempty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Factory_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_2)%&gt;, &lt;%=if(get_PO.Factory_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.district_city)%&gt;, &lt;%=if(get_PO.Factory_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.state_province)%&gt;, &lt;%=if(get_PO.Factory_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Factory_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.country)%&gt;&lt;br&gt; &lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Factory_Phone.isEmpty(),&quot;---&quot;,get_PO.Factory_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Factory_Email.isEmpty(),&quot;---&quot;,get_PO.Factory_Email)%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;delivery-block&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-title&quot;&gt;Delivery Address&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-attn&quot;&gt;&lt;span class=&quot;attn-name&quot;&gt;ATTN :&lt;/span&gt; &lt;%=if(get_PO.Buyer_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Buyer_Contact_Person)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-info&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;info-bold&quot;&gt;&lt;%=if(get_PO.Buyer_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Buyer_Company_Name)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t &lt;span class = &quot;party-address&quot;&gt;     &lt;%=if(get_PO.Delivery_Address1.address_line_1.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Delivery_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_2)%&gt;, &lt;%=if(get_PO.Delivery_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.district_city)%&gt;, &lt;%=if(get_PO.Delivery_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.state_province)%&gt;, &lt;%=if(get_PO.Delivery_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Delivery_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.country)%&gt;&lt;br&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Email)%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- ORDER TABLE --&gt;\n\t\t\t&lt;%=thisapp.Page.PO_Templet_Table(input.Po_ID,&quot;PO&quot;)%&gt;\n\n\t\t\t&lt;!-- FOOTER SIGNATURE --&gt;\n\t\t\t&lt;div id=&quot;po-footer&quot;&gt;\n\t\t\t\t&lt;div id=&quot;po-footer-left&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Name&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Position&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Company Stamp&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Signature&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div id=&quot;po-footer-right&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;commentss-label&quot;&gt;Comments:&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;comments-area&quot;&gt;&lt;%=get_PO.Comments%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t&lt;/div&gt;&lt;!-- /#po-content --&gt;\n\t&lt;/div&gt;&lt;!-- /#po-card --&gt;\n&lt;/div&gt;&lt;!-- /#po-root --&gt;\n\n&lt;/body&gt;\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page PO_Template(int PO_ID, string Template_Type)
		{
					displayname = "PO_Template"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_PO = Purchase_Order[ID == input.PO_ID];\n\tget_PO_Items = Purchase_LineItems[Purchase_Order == input.PO_ID];\n\tget_Buyer = Buyers_Master[ID == get_PO.Customer_Name.Associated_Buyer];\n\tget_Org = organization[ID != 0];\n\t// \tprint_URL = &quot;https://creatorapp.zoho.com/export&quot; + zoho.appuri + &quot;print/PO_Template/?PO_ID=&quot; + input.PO_ID + &quot;&amp;isc5page=true&quot;;\n\t// \tpdf_URL = &quot;https://creatorapp.zoho.com/export&quot; + zoho.appuri + &quot;pdf/PO_Template/?PO_ID=&quot; + input.PO_ID + &quot;&amp;isc5page=true&quot;;\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n\n&lt;head&gt;\n\t&lt;%=thisapp.Style.PO_Templet_Style()%&gt;\n\t&lt;style&gt;\n\t.page_Buttons {\n\t\tpadding-top: 18px;\n\t}\n\tform[name=&quot;Print_and_PDF_Button&quot;] .label-left{\n\t\twidth: 100%;\n\t}\n\tform[name=&quot;Print_and_PDF_Button&quot;] .formContainer {\n\t\tpadding: 0 !important;\n\t}\n\tform[name=&quot;Print_and_PDF_Button&quot;] .form-group.zc-decisionbox-field-group {\n\t\tmargin: 0 !important;\n\t}\n\tform[name=&quot;Print_and_PDF_Button&quot;] .decision-box-field.form-field.clearfix {\n\t\tdisplay: none;\n\t}\n\tform[name=&quot;Print_and_PDF_Button&quot;] .formColumn.first-column\n\t{\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: end;\n\t\tgap: 10px;\n\t}\n\tform[name=&quot;Print_and_PDF_Button&quot;] label.form-label.decision-box-label {\n\t\tcolor: #fff !important;\n\t\tpadding: 10px 20px !important;\n\t\tbackground-color: var(--primary_color);\n\t\tborder-radius: 8px;\n\t\tmargin: 0px !important;\n\t}\n\t\n\t.zc-footer-wrapper{\n\t\tdisplay: none;\n\t}\n\t@media print {\n\t\t  /* Specific margins for different sides */\n\t\t @page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t }\n\t\t .page_Buttons{\n\t\t\t display: none;\n\t\t }\n\t\t .page{\n\t\t\t  padding: 0px;\n\t\t }\n\t}\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body&gt;\n\t&lt;div class=&quot;page_Buttons&quot;&gt;\n\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Print_and_PDF_Button&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Template=PO&amp;Purchase_Order=&lt;%=input.PO_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t\t&lt;div class=&quot;page&quot;&gt;\n\n\t\t\t\t&lt;!-- Header --&gt;\n\t\t\t\t&lt;div class=&quot;header&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;logo&quot;&gt;\n\t\t\t&lt;img src=&lt;%=thisapp.Publish_URL.Org_IMG()%&gt; &gt;\n&lt;p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=get_Buyer.Buyer_Organisation%&gt;&lt;/strong&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=get_Buyer.Office_Address.address_line_1%&gt;, &lt;%=get_Buyer.Office_Address.address_line_2%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=get_Buyer.Office_Address.district_city%&gt;, &lt;%=get_Buyer.Office_Address.state_province%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=get_Buyer.Office_Address.postal_Code%&gt;, &lt;%=get_Buyer.Office_Address.country%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=get_Buyer.Primary_Email%&gt;\n\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;title&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2&gt;Purchase Order &lt;%=get_PO.PO_Number%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;strong&gt;Date : &lt;%=zoho.currentdate%&gt;&lt;/strong&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;!-- Seller / Ship / Summary --&gt;\n\t\t\t\t&lt;div class=&quot;info-section&quot;&gt;\n\t\t\n\t\t\t&lt;div class=&quot;box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4&gt;Delivery Address&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;box_Content&quot;&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;Attn:&lt;/b&gt; &lt;%=if(get_PO.Buyer_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Buyer_Contact_Person)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;&lt;%=if(get_PO.Buyer_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Buyer_Company_Name)%&gt;&lt;/b&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Delivery_Address1.address_line_1.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Delivery_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_2)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Delivery_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.district_city)%&gt;, &lt;%=if(get_PO.Delivery_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.state_province)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Delivery_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Delivery_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.country)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Buyer_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Phone)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Buyer_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Email)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\n\t\t\t\t\t\t&lt;div class=&quot;box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4&gt;Factory&lt;/h4&gt;\n\t\t\t\t&lt;div class=&quot;box_Content&quot;&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;Attn:&lt;/b&gt; &lt;%=if(get_PO.Factory_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Factory_Contact_Person)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;&lt;%=if(get_PO.Factory_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Factory_Company_Name)%&gt;&lt;/b&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Factory_Address1.address_line_1.isempty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Factory_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_2)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Factory_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.district_city)%&gt;, &lt;%=if(get_PO.Factory_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.state_province)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Factory_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Factory_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.country)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Factory_Phone.isEmpty(),&quot;---&quot;,get_PO.Factory_Phone)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Factory_Email.isEmpty(),&quot;---&quot;,get_PO.Factory_Email)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4&gt;Summary&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;summary&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;!--    \n\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t &lt;td&gt;Customer&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Customer_Name.User_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t --&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Payment Terms&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Buyer_Organisation.Payment_Terms%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Currency&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;USD&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Total Cost&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO.Total_Purchase_Price.round(2))%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Total Qty&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO_Items.sum(Quantity))%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;COO&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%=if(get_PO.Supplier.Country != null,get_PO.Supplier.Country.Country_Name.upper(),&quot;---&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Freight Method&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Transport_Mode.upper()%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Incoterms&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Incoterms%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;!-- Order Table --&gt;\n\t\t&lt;%=thisapp.Page.PO_Templet_Table(input.PO_ID,&quot;PO&quot;)%&gt;\n\t\t\n \t\t&lt;!-- Comments Section --&gt;\n\t\t\t\t&lt;table class=&quot;comments-table&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;comments-label&quot;&gt;Comments:&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;comments-content&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=get_PO.Comments%&gt;\n\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/table&gt;\n\n\t\t\t\t&lt;!-- Signature Section --&gt;\n\t\t\t\t&lt;table class=&quot;signature-table&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Name&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Position&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Company Stamp&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Signature&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
					script
					{
						/* Write your script logic here. You can assign values to the page variables you've created in the previous tab. Enter 'input.' to list the created page variables. */
										input.Template_Type = "PO";
					}
		}

		page Patch_Update
		{
					displayname = "Patch Update"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Panel'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<button margin='0px' paddingTop='12px' paddingLeft='15px' paddingRight='15px' paddingBottom='12px' action='ExecuteFunction' functionName='OneTime.Update_PO_Delivery_Address' color='theme' size='16px' borderColor='theme' borderWidth='1px' text='Update PO Factory Address' bgColor='transparent' bgColorType='noFill' cornerRadius='60px' /> </pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Panel 1'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<button margin='0px' paddingTop='12px' paddingLeft='15px' paddingRight='15px' paddingBottom='12px' action='ExecuteFunction' executeWorkflow='afterConfirmation' functionName='OneTime.updateSellingCurrency' color='#FFFFFF' size='16px' borderColor='#FFFFFF' borderWidth='0px' text='Update Selling Currency' bgColor='theme' cornerRadius='60px' /> </pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Panel 2'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<button margin='0px' paddingTop='12px' paddingLeft='15px' paddingRight='15px' paddingBottom='12px' action='ExecuteFunction' executeWorkflow='afterConfirmation' functionName='OneTime.updateTotalQuantity' color='theme' size='16px' borderColor='theme' borderWidth='1px' text='Update Total Quantity' bgColor='transparent' bgColorType='noFill' cornerRadius='60px' /> </pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<panel elementName='Panel 3'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='20px' bgColor='#FFFFFF' width='100%' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t<pc vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<button margin='0px' paddingTop='12px' paddingLeft='15px' paddingRight='15px' paddingBottom='12px' action='ExecuteFunction' executeWorkflow='afterConfirmation' functionName='OneTime.UpdateAdditionChargeAmount' color='#FFFFFF' size='16px' borderColor='#FFFFFF' borderWidth='0px' text='Update Additional charge amount' bgColor='theme' cornerRadius='60px' /> </pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Pending_Amendments_Page
		{
					displayname = "Pending Amendments"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet17' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet17()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n\t\n\t&lt;/style&gt;\n\t&lt;div elName=&apos;zc-component&apos; name=&quot;editPO&quot; style=&quot;height: calc(100vh - 70px) !important;&quot; viewLinkName=&apos;Pending_Amendments&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&amp;zc_MoreAction=false&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Pending_Approval_Page
		{
					displayname = "Pending Approval"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet26' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet26()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; name=&quot;editPO&quot; style=&quot;height: calc(100vh - 70px);&quot; viewLinkName=&apos;All_Order_Requests&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Product_Cart_Details(int Category, int Style_Master_Code, int Supplier, int Wardrobe)
		{
					displayname = "Product Cart Details"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet9' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet9()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() &amp;&amp; Status == &quot;Active&quot;];\n\tget_style = Style[Product_Code == input.Style_Master_Code];\n\tget_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer.Associated_Buyer &amp;&amp; Buyer_Product_Mapping.Factory_Allocated == input.Supplier &amp;&amp; Style_ID.Style_Code in get_style.ID.getall() &amp;&amp; Style_ID.Wardrobe == input.Wardrobe &amp;&amp; Style_ID.Style_Category == input.Category];\n\tprice = get_Product.Sell_Price.getall();\n\tdiscription = get_Product.Style_Description;\n\t%&gt;\n&lt;html&gt;\n\n&lt;head&gt;\n\t&lt;style&gt;\n\t\t&lt;%=thisapp.Style.Cart_Detail_Page_Style()%&gt;\n\t\t.zc-content-loader {\n\t\t\tdisplay: none !important;\n\t\t}\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body&gt;\n\n\t\t&lt;div class=&quot;product-container&quot;&gt;\n\n\t\t\t\t&lt;!-- Left: Product Image --&gt;\n\t\t\t\t&lt;div class=&quot;product-image&quot;&gt;\n\t\t\t\t\t &lt;!-- &lt;img src=&quot;https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600&amp;q=80&quot; alt=&quot;Product&quot; /&gt; --&gt;\n\t\t   &lt;div elName=&apos;zc-component&apos; name=&quot;ProductIMG&quot; PageLinkName=&apos;Dynamic_Product_Image&apos; params=&apos;zc_Header=false&amp;Product_ID=&lt;%=get_Product.Style_ID%&gt;&apos;&gt;Loading View...&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;!-- Right: Product Details --&gt;\n\t\t\t\t&lt;div class=&quot;product-details&quot;&gt;\n\n\t\t\t\t\t &lt;!-- &lt;div class=&quot;product_name&quot;&gt;Product Name&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;product_price&quot;&gt;$&lt;%=price.smallest()%&gt;&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;product-description&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;%=discription%&gt;\n\t\t\t\t\t\t&lt;/div&gt; --&gt;\n\n\t\t\t\t\t\t&lt;!-- Size --&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Buyer_Cart_Detail&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Supplier=&lt;%=input.Supplier%&gt;&amp;Product_Code=&lt;%=input.Style_Master_Code%&gt;&amp;Wardrobe=&lt;%=input.Wardrobe%&gt;&amp;Product_Category=&lt;%=input.Category%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Product_Catalogue
		{
					displayname = "Raise Request"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet2' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet2()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_User = Create_User[Email == zoho.loginuserid];\n\t%&gt;\n&lt;style&gt;\n// .zc-content-loader {\n//     display: none !important;\n// }\n\t\t.page_content_wrapper.zc-page-content-wrapper {\n\t\t\tpadding: 1.25rem !important;\n\t\t}\n\t\t.zc-pb-page-content-wrapper{\n\t\t\tborder-radius: 10px;\n\t\t}\n\t\t.OverAll_Div{\n\t\t\theight: calc(100% - 20px);\n\t\t\tpadding: 10px;\n\t\t}\n\t\t.cart_Products {\n\t\t\theight: calc(100% - 0px);\n\t\t\twidth: 100%;\n\t\t}\n\t\t.cart_Alert{\n\t\t\theight: 100%;\n\t\t\tfont-size: 18px;\n\t\t\tfont-weight: 600;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t}\n\t\t/* Page Height */\n\t\t[formLinkName=&apos;Buyer_Order&apos;] div#zppagesLive, div#elementsContainer, .Layout.elemContainment, div#row_1 {\n\t\t\theight: 100%;\n\t\t\tpadding: 0px !important;\n\t\t}\n\t\tdiv#zppagesLive{\n\t\t\theight: 100%;\n\t\t}\n\n\t\t/* Form Body Style */\n\t\t.buyer_Filter {\n// \t\t\twidth: 240px;\n\t\t\tposition: absolute;\n\t\t\ttop: 16px;\n\t\t\tleft: 20px;\n\t\t\tz-index: 1;\n\t\t}\n\t\t.buyer_Filter.divEmbedContainer * {\n\t\t\tbox-sizing: border-box;\n\t\t\tbox-shadow: unset !important;\n\t\t}\n\t\tdiv[formlinkname=&quot;Buyer_Order&quot;] form[name=&quot;Buyer_Order&quot;] .formContainer .formColumn .form-group .form-label .zc-label-text,\n\t\tdiv[formlinkname=&quot;Buyer_Order&quot;] form[name=&quot;Buyer_Order&quot;] .formContainer .formColumn .form-group .form-label {\n\t\t\tmax-width: 100% !important;\n\t\t}\n\t\tform[name=&quot;Buyer_Order&quot;].label-inplace{\n\t\t\twidth: 100% !important;\n\t\t\toverflow: unset !important;\n\t\t}\n\t\t[formLinkName=&apos;Buyer_Order&apos;] .formContainer {\n\t\t\tpadding: 0px !important;\n\t\t}\n\t\t[formLinkName=&apos;Buyer_Order&apos;] .row {\n\t\t\theight: 100%;\n\t\t}\n\t\t[formLinkName=&apos;Buyer_Order&apos;] .zcform_Buyer_Order .form-label {\n\t\t\tmin-width: 125px;\n\t\t\twidth: 125px;\n\t\t}\n\n\t\t/* Form Footer Style */\n\t\t[formLinkName=&apos;Buyer_Order&apos;] .zc-footer-wrapper {\n\t\t\tdisplay: none;\n\t\t}\n\n\t\t/* Report style */\n\t\t[pagelinkname=&quot;Product_Catalogue_Cart_Page&quot;] .zc-pb-tile-card {\n\t\t\toverflow: unset;\n\t\t}\n\t\t[pagelinkname=&quot;Product_Catalogue_Cart_Page&quot;] div#row_1 {\n\t\t    border: 1px solid #e6e6e6;\n\t\t\t\tborder-radius: 10px;\n\t\t\tpadding-top: 8px !important;\n\t\t}\n\t\t\n\t\t[viewlinkname=&quot;Active_Products&quot;].divEmbedContainer{\n\t\t\theight: 100% !important;\n\t\t}\n\t\t[viewlinkname=&quot;Active_Products&quot;] .zc-reports-footer-sec {\n\t\t\tborder: none;\n\t\t\tborder-top: 1px solid #e3e3e3;\n\t\t}\n\t\t[viewlinkname=&quot;Active_Products&quot;] .view-outer-wrapper .view-header .zc-reportoptionheader {\n\t\t\tpadding-right: 50px;\n\t\t}\n\t\t[viewlinkname=&quot;Active_Products&quot;] td.zcReport_Edit.htDimmed {\n\t\t\tfont-weight: 600;\n\t\t\tfont-size: 16px !important;\n\t\t}\n\t\t\n\t\t\n\t\t.cart_Products .view-outer-wrapper .view-header .view-options{\n\t\t\tpadding: 0px ;\t\n\t\t}\n\t\t.cart_Products .view-outer-wrapper .view-header .zc-reportoptionheader ul li a.zc-filter, .cart_Products .view-outer-wrapper .view-header .zc-reportoptionheader ul li a.zc-advance-search-icon\n\t\t{\n\t\t\theight: 42px;\n\t\t\twidth: 42px;\n\t\t\tpadding: 12px 5px;\n\t\t}\n\t\t\n\t\t/* Cart Style */\n\t\t.cartSection {\n\t\t\theight: 42px;\n\t\t\twidth: 42px;\n\t\t\tposition: absolute;\n\t\t\ttop: 8px;\n\t\t\tright: 24px;\n\t\t\tz-index: 99;\n\t\t}\n\t\t.cartRow {\n\t\t\tborder: 1px solid #cbcbdc;\n\t\t\tcolor: rgba(0, 0, 0, 0.7);\n\t\t\tbackground: #fff;\n\t\t\theight: 40px;\n\t\t\tposition: relative;\n\t\t\tborder-radius: 8px;\n\t\t}\n\t\t.cartCount {\n\t\t\twidth: 18px;\n\t\t\theight: 16px;\n\t\t\tpadding-top: 1px;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\tfont-size: 10px;\n\t\t\tcolor: #fff;\n\t\t\tposition: absolute;\n\t\t\ttop: -5px;\n\t\t\tright: -5px;\n\t\t\tbackground: var(--theme_brand_color);\n\t\t\tborder-radius: 50%;\n\t\t}\n\t\t.cartIcon {\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\theight: 40px;\n\t\t}\n\t\t.cartRow:hover{\n\t\t\tcolor: var(--primary_color);\n\t\t\tbackground: var(--component_hover_color);\n\t \t\t\tborder: 1px solid var(--primary_color);\n\t\t}\n\t\t.cartRow:hover svg{\n\t\t\tfill: var(--primary-color);\n\t\t}\n\t\t/* Popup Style */\n\t\t.popupConentContainer {\n\t\t\twidth: 100% !important;\n\t\t}\n\t\t.OverAll_Div{\n\tposition: relative;   \n}\n\n.sizeChartLink{\n\t    position: absolute;\n\t\ttop: 37px;\n\t\tright: 207px;\n\t\tz-index: 9;\n\t\tcursor: pointer;\n\t\tfont-weight: 600;\n\t    text-decoration: underline;\n}\n.sizeChartLink:hover {\n\t\ttext-decoration: underline !important;\n}\n\n\t&lt;/style&gt;\n&lt;%\n\tif(get_User.count() &gt; 0)\n\t{\n\t\tif(get_User.Status == &quot;Active&quot;)\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;OverAll_Div&quot; name=&quot;cartPage&quot;&gt;\n&lt;a class=&quot;sizeChartLink&quot; href=&quot;#Page:Size_Chart_Page?zc_LoadIn=dialog&quot;&gt;Size Chart&lt;/a&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; class=&quot;buyer_Filter&quot; formLinkName=&apos;Buyer_Order&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&apos;  style=&quot;height: 53px;&quot;&gt;\n\t\t\t\t\t&lt;style&gt;\n\t\t\t\t\t\tdiv#pagepreloader {\n\t\t\t\t\t\t\tdisplay: block !important;\n\t\t\t\t\t\t}\n\t\t\t\t\t&lt;/style&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t\n\t\t\t\t&lt;div class=&quot;cart_Products&quot; name=&quot;Cart_Products&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;cart_Alert&quot;&gt;Please select a buyer before adding the product to your cart.&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;cart_Products&quot; name=&quot;Cart_Products&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cart_Alert&quot;&gt;Please contact the administrator to approve or activate your access.&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\topenUrl(&quot;#Form:Create_User&quot;,&quot;popup window&quot;);\n\t\t%&gt;\n&lt;div class=&quot;cart_Products&quot; name=&quot;Cart_Products&quot;&gt;\n\t\t\t&lt;div class=&quot;cart_Alert&quot;&gt;&lt;span&gt; Please add your user details &lt;a href=&quot;#Form:Create_User?zc_LoadIn=dialog&quot;&gt;here&lt;/a&gt; to use the Product Catalogue. &lt;/span&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Product_Catalogue_Cart_Page(int Buyer_ID, string DeleteCart, int Suppliyer_ID)
		{
					displayname = "Product Catalogue Cart Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet31' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet31()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tif(input.DeleteCart == &quot;Delete&quot;)\n\t{\n\t\tthisapp.Delete_Records.Delete_Cart_Details(input.Buyer_ID,input.Suppliyer_ID);\n\t\topenUrl(&quot;#Script:page.refresh&quot;,&quot;same window&quot;);\n\t}\n\t%&gt;\n&lt;style&gt;\n\t\t.no_Data{\n\t\t    height: 100%;\n\t\t\talign-content: center;\n\t\t\ttext-align: center;\n\t\t\tfont-size: 16px;\n\t\t\tfont-weight: 600;\n\t\t}\n\t&lt;/style&gt;\n&lt;div style=&quot;height: 100%;&quot;&gt;\n&lt;%\n\tif(input.Suppliyer_ID != null)\n\t{\n\t\t%&gt;\n&lt;a href=&quot;#Page:Cart_Page?zc_LoadIn=embed-cartPage&amp;Buyer_ID=&lt;%=input.Buyer_ID%&gt;&amp;Suppliyer_ID=&lt;%=input.Suppliyer_ID%&gt;&quot; class=&quot;cartSection&quot;&gt;\n\t\t&lt;div class=&quot;cartRow&quot;&gt;\n\t\t\t&lt;div class=&quot;cartCount&quot;&gt;&lt;%=thisapp.Page.Cart_Count(input.Buyer_ID,input.Suppliyer_ID)%&gt;&lt;/div&gt;\n\t\t\t&lt;div class=&quot;cartIcon&quot;&gt;\n\t\t\t\t&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; height=&quot;18px&quot; viewBox=&quot;0 -960 960 960&quot; width=&quot;18px&quot; fill=&quot;rgb(113 113 140)&quot;&gt;&lt;path d=&quot;M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z&quot;/&gt;&lt;/svg&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\t\n\t&lt;/a&gt;\n&lt;%\n\t\tget_Product_List = thisapp.Filters.Filter_Products();\n\t\tif(get_Product_List.size() &gt; 0)\n\t\t{\n\t\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;Active_Products&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&amp;zc_MoreAction=false&amp;zc_ReportName=false&apos;&gt;&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div class=&quot;no_Data&quot;&gt;No products available for the selected buyer.&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;no_Data&quot;&gt;Please select a factory before adding the product to your cart.&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Production_Orders_Page
		{
					displayname = "Production Orders"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet28' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet28()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; name=&quot;editPO&quot; style=&quot;height: calc(100vh - 70px);&quot; viewLinkName=&apos;Production_Orders&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Purchase_Order_Details(int PO_ID, string back_Page)
		{
					displayname = "Purchase Order Details"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet16' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet16()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\t// \tinput.PO_ID = 4908788000000528100;\n\tget_PO = Copy_of_Purchase_Order[Purchase_Order == input.PO_ID];\n\tCreate_URL = &quot;https://creatorapp.zoho.com/&quot; + zoho.appuri + &quot;record-summary/Purchase_Order_detail_view/&quot; + input.PO_ID + &quot;/&quot;;\n\t%&gt;\n&lt;style&gt;\n\t\t.overAll_Div *{\n\t\t\tbox-sizing: border-box;\n\t\t\tpadding: 0;\n\t\t\tmargin: 0;\n\t\t}\n\t\tdiv[pagelinkname=&quot;Purchase_Order_Details&quot;]#zppagesLive, div[pagelinkname=&quot;Purchase_Order_Details&quot;] div#elementsContainer, div[pagelinkname=&quot;Purchase_Order_Details&quot;] div#row_1 {\n\t\t\theight: 100% !important;\n\t\t}\n\t\t[viewlinkname=&quot;Copy_of_Purchase_LineItems_Report&quot;].divEmbedContainer {\n\t\t\theight: calc(100% - 50px) !important;\n\t\t\tmin-height: 500px;\n\t\t}\n\t\t.iframe_Div{\n\t\t\theight: calc(100% - 50px);\n\t\t}\n\t\t.zc-pb-embed-placeholder-content{\n\t\t\toverflow: auto;\n\t\t}\n\t\t[pagelinkname=&quot;Purchase_Order_Details&quot;] .Layout.elemContainment {\n\t\t\theight: calc(100% - 16px);\n\t\t}\n\t\t.overAll_Div {\n\t\t    height: calc(100% - 15px);\n\t\t}\n\t\t.detailView{\n\t\t\tmargin: 0px 15px;\n\t\t}\n\t\t.PO_subForm {\n\t\t\tmargin: 17px;\n\t\t\theight: calc(100% - 314px);\n\t\t}\n\t\t.Form_Header {\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: space-between;\n\t\t\tmargin: 15px 0px;\n\t\t}\n\t\t.header_Name{\n\t\t\tfont-size: 16px;\n\t\t\tfont-weight: 600;\n\t\t    line-height: 25px;\n\t\t}\n\t\t.add_POItem{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\tfont-size: 14px;\n\t\t\tgap: 10px;\n\t\t\theight: 30px;\n\t\t\tline-height: normal;\n\t\t\tmin-width: 30px;\n// \t\t\tpadding: 8px;\n\t\t\tborder-radius: 8px;\n\t\t\tcursor: var(--zc-cursor-pointer);\n\t\t\tbackground-color: var(--primary_bg_text_color) !important;\n\t\t\tcolor: var(--primary_color);\n\t\t\tborder: 2px solid var(--primary_color);\n\t\t}\n\t\n\t\t\n\t\t.wrap {\n\t\t\t/* max-width: 1000px; */\n\t\t\tmargin: 0 auto;\n\t\t}\n\n\t\t/* 3-col price strip */\n\t\t.price-strip {\n\t\t\tdisplay: grid;\n\t\t\tgrid-template-columns: repeat(3, 1fr);\n\t\t\tgap: 8px;\n\t\t\tmargin-bottom: 10px;\n\t\t}\n\n\t\t.price-card {\n\t\t\tbackground: #fff;\n\t\t\tborder: 0.5px solid #e0e0e0;\n\t\t\tborder-radius: 8px;\n\t\t\tpadding: 10px 12px;\n\t\t}\n\n\t\t.price-card.buy {\n\t\t\tborder-top: 2px solid #378ADD;\n\t\t}\n\n\t\t.price-card.sell {\n\t\t\tborder-top: 2px solid #1D9E75;\n\t\t}\n\n\t\t.price-card.margin {\n\t\t\tborder-top: 2px solid #BA7517;\n\t\t}\n\n\t\t.price-label {\n\t\t\tfont-size: 10px;\n\t\t\tfont-weight: 500;\n\t\t\ttext-transform: uppercase;\n\t\t\tletter-spacing: .06em;\n\t\t\tmargin-bottom: 3px;\n\t\t}\n\n\t\t.price-label.buy {\n\t\t\tcolor: #185FA5;\n\t\t}\n\n\t\t.price-label.sell {\n\t\t\tcolor: #0F6E56;\n\t\t}\n\n\t\t.price-label.margin {\n\t\t\tcolor: #854F0B;\n\t\t}\n\n\t\t.price-val {\n\t\t\tfont-size: 18px;\n\t\t\tfont-weight: 500;\n\t\t\tline-height: 1;\n\t\t}\n\n\t\t.price-val.buy {\n\t\t\tcolor: #185FA5;\n\t\t}\n\n\t\t.price-val.sell {\n\t\t\tcolor: #0F6E56;\n\t\t}\n\n\t\t.price-val.margin {\n\t\t\tcolor: #854F0B;\n\t\t}\n\n\t\t.price-sub {\n\t\t\tfont-size: 10px;\n\t\t\tcolor: #999;\n\t\t\tmargin-top: 2px;\n\t\t\twhite-space: nowrap;\n\t\t\toverflow: hidden;\n\t\t\ttext-overflow: ellipsis;\n\t\t}\n\n\t\t/* Sections */\n\t\t.section {\n\t\t\tbackground: #fff;\n\t\t\tborder: 0.5px solid #e0e0e0;\n\t\t\tborder-radius: 8px;\n\t\t\toverflow: hidden;\n\t\t\tmargin-bottom: 8px;\n\t\t}\n\n\t\t.section-hd {\n\t\t\tpadding: 6px 12px;\n\t\t\tbackground: #F8F9FA;\n\t\t\tborder-bottom: 0.5px solid #e0e0e0;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tgap: 6px;\n\t\t}\n\n\t\t.hd-dot {\n\t\t\twidth: 6px;\n\t\t\theight: 6px;\n\t\t\tborder-radius: 50%;\n\t\t}\n\n\t\t.section-title {\n\t\t\tfont-size: 10px;\n\t\t\tfont-weight: 500;\n\t\t\tcolor: #666;\n\t\t\ttext-transform: uppercase;\n\t\t\tletter-spacing: .06em;\n\t\t}\n\n\t\t/* 4-column field grid */\n\t\t.field-grid {\n\t\t\tdisplay: grid;\n\t\t\tgrid-template-columns: repeat(4, 1fr);\n\t\t}\n\n\t\t.field {\n\t\t\tpadding: 8px 12px;\n\t\t\tborder-right: 0.5px solid #e0e0e0;\n\t\t\tborder-bottom: 0.5px solid #e0e0e0;\n\t\t}\n\n\t\t.field:nth-child(4n) {\n\t\t\tborder-right: none;\n\t\t}\n\n\t\t.field:nth-last-child(-n+4) {\n\t\t\tborder-bottom: none;\n\t\t}\n\n\t\t.field-label {\n\t\t\tfont-size: 10px;\n\t\t\tcolor: #999;\n\t\t\ttext-transform: uppercase;\n\t\t\tletter-spacing: .05em;\n\t\t\tmargin-bottom: 2px;\n\t\t}\n\n\t\t.field-val {\n\t\t\tfont-size: 12px;\n\t\t\tcolor: #1a1a2e;\n\t\t\tfont-weight: 500;\n\t\t\twhite-space: nowrap;\n\t\t\toverflow: hidden;\n\t\t\ttext-overflow: ellipsis;\n\t\t}\n\n\t\t.field-val.empty {\n\t\t\tcolor: #bbb;\n\t\t\tfont-weight: 400;\n\t\t\tfont-style: italic;\n\t\t}\n\n\t\t/* Comment */\n\t\t.comment-btn {\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tgap: 6px;\n\t\t\tbackground: none;\n\t\t\tborder: 0.5px solid #ccc;\n\t\t\tborder-radius: 8px;\n\t\t\tpadding: 6px 12px;\n\t\t\tfont-size: 12px;\n\t\t\tcolor: #666;\n\t\t\tcursor: pointer;\n\t\t\tmargin-top: 8px;\n\t\t}\n\n\t\t.comment-btn:hover {\n\t\t\tbackground: #F8F9FA;\n\t\t}\n\t\t\n\t\t.header_backBtn{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tgap: 10px;\n\t\t}\n\t\t.back_Product{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t}\n\t\t.back_Product:before {\n\t\t\tcontent: &quot;\\ed89&quot;;\n\t\t\tfont-family: ZC Live Outline;\n\t\t\tfont-size: 30px;\n\t\t}\n\t\t\n\t\t\n\t\tform[name=&quot;PO_Style_Search&quot;].label-inplace{\n\t\t\twidth: 100% !important;\n\t\t\toverflow: unset !important;\n\t\t}\n\t\t form[name=&quot;PO_Style_Search&quot;] .formContainer {\n\t\t\tpadding: 0 !important;\n\t\t}\n\t\t[formlinkname=&quot;PO_Style_Search&quot;] .form-outer-wrapper{\n\t\t\tbox-shadow: none !important;\n\t\t}\n\t\tform[name=&quot;PO_Style_Search&quot;] .form-group.clearfix.zc-Select_Supplier-group {\n\t\t\tmargin-bottom: 1px !important;\n\t\t}\n\t\t[formlinkname=&quot;PO_Style_Search&quot;]  a.select2-choice.select2-default {\n\t\t\tmin-height: 35px !important;\n\t\t\theight: 35px !important;\n\t\t}\n\t\t[formlinkname=&quot;PO_Style_Search&quot;]  .form-group.clearfix.zc-Search_Style-group {\n\t\t\tmargin-bottom: 0px !important;\n\t\t}\n\t\t[formlinkname=&quot;PO_Style_Search&quot;] .zc-footer-wrapper{\n\t\t\tdisplay: none;\n\t\t}\n\t\t\n\t&lt;/style&gt;\n\n\t&lt;div class=&quot;overAll_Div&quot;&gt;\n\t\t&lt;div class=&quot;detailView&quot;&gt;\n\t\t\t&lt;div class=&quot;Form_Header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;header_Name&quot;&gt;Purchase Order&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;header_backBtn&quot;&gt;\n\t\t\t\t\t&lt;a class=&quot;add_POItem&quot; href=&quot;#Form:Copy_of_Purchase_Order?zc_LoadIn=dialog&amp;recLinkID=&lt;%=get_PO.ID%&gt;&amp;viewLinkName=Copy_of_Purchase_Order_Report&amp;zc_Header=false&quot;&gt;\n\t\t\t\t\t\t\t&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; height=&quot;20px&quot; viewBox=&quot;0 -960 960 960&quot; width=&quot;20px&quot; fill=&quot;var(--primary_color)&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;path d=&quot;M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z&quot;/&gt;\n\t\t\t\t\t\t\t&lt;/svg&gt;\n\t\t\t\t\t\t&lt;/svg&gt;\n\t\t\t\t\t&lt;/a&gt;\n\t\t\t\t\t&lt;a class=&quot;back_Product&quot; href=&quot;#Script:page.refresh&quot;&gt;\n\t\t\t\t\t\t&lt;!--\n\t\t\t\t\t\t&lt;svg xmlns=&quo