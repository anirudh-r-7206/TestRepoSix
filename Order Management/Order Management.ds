						initial value = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Phone_Number
					(
		    			type = phonenumber
						displayname = "Phone"
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have Country
					(
						type = picklist	
