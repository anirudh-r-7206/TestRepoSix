		page Buyer_Main_Cart_Page
		{
					displayname = "Buyer Cart Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet11' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet11()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n\t.buyer_OverAll_container{\n\t\theight: 100%;\n\t}\n\t[pagelinkname=&quot;Buyer_Cart_Page&quot;] .divEmbedContainer {\n\t\theight: calc(100% - 83px) !important;\n\t}\n\t[pagelinkname=&quot;Buyer_Cart_Page&quot;] .Layout.elemContainment{\n\t\theight: 100% !important;\n\t\tborder: none;\n\t}\n\t[pagelinkname=&quot;Buyer_Cart_Page&quot;] .zc-pb-page-content-wrapper{\n\t\t overflow: hidden;\n\t }\n\t \n\t .buyer_Header_container {\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t\tgap: 15px;\n\t\tpadding: 15px 0px 10px;\n\t\tmargin: 0px 20px;\n\t\t\tborder-bottom: 1px solid #E8E8E8;\n\t}\n\t.cart_header {\n\t\tfont-size: 20px;\n\t\tfont-weight: 600;\n\t}\n\t \n\t /* Buyer Filter form style*/\n\tform[name=&quot;Buyer_Filter&quot;].label-inplace{\n\t\twidth: 100% !important;\n\t\toverflow: unset !important;\n\t}\n\t form[name=&quot;Buyer_Filter&quot;] .formContainer {\n\t\tpadding: 0 !important;\n\t}\n\t[formlinkname=&quot;Buyer_Filter&quot;] .form-outer-wrapper{\n\t    box-shadow: none !important;\n\t}\n\tform[name=&quot;Buyer_Filter&quot;] .form-group.clearfix.zc-Select_Supplier-group {\n\t\tmargin-bottom: 1px !important;\n\t}\n\n\t [formlinkname=&quot;Buyer_Filter&quot;] .zc-footer-wrapper{\n\t\t display: none;\n\t }\n&lt;/style&gt;\n&lt;div class=&quot;buyer_OverAll_container&quot;&gt;\n\t&lt;div class=&quot;buyer_Header_container&quot;&gt;\n\t\t&lt;div class=&quot;cart_header&quot;&gt;Product catalogue&lt;/div&gt;\n\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Buyer_Filter&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&apos;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t&lt;div elName=&apos;zc-component&apos; name=&quot;BuyerCart&quot; pageLinkName=&apos;Buyer_Cart_Page&apos; params=&apos;zc_Header=true&apos;&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

