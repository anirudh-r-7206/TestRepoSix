		custom Active_Suppliers
		{
		
					displayName = "Active Suppliers"
					show all rows from Add_Suppliers  [Status == "Active"]  
					(
						Supplier_Code as "Supplier Code"
						Country
						Email
						Phone
						(
							displayformat = plainnumber 
						)
						Factory_Address  as "Invoice Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						ERP_System as "ERP System"
