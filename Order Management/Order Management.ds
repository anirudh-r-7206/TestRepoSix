					(
		    			type = text
						displayname = "Company Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Contact_Person1
					(
		    			type = name
						displayname = "Contact Person"
		     			prefix
		     			(
			     			 type = prefix
			     			 displayname ="Prefix"
			     			 visibility = false
			     			 value = {"Mr.","Mrs.","Ms."}
		     			) 
		     			first_name
		     			(
			     			 type = first_name
			     			 displayname ="First Name"
		     			) 
		     			last_name
		     			(
			     			 type = last_name
			     			 displayname ="Last Name"
		     			) 
		     			suffix
		     			(
			     			 type = suffix
			     			 displayname ="Suffix"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					Contact_Person
					(
		    			type = text
						displayname = "Contact Person"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
