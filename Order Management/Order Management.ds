		}

		page Buyer_Product_Mapping_Page(int map_ID)
		{
					displayname = "Buyer Product Mapping Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet12' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet12()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_Buyer_Product_Mapping = Buyer_Product_Mapping[ID == input.map_ID];\n\tBuyer_Name = get_Buyer_Product_Mapping.Buyer.Buyer_Organisation;\n\tFactory_Name = get_Buyer_Product_Mapping.Factory_Allocated.Supplier_Organisation;\n\t%&gt;\n&lt;style&gt;\n\t/* Hide scrollbar for Chrome, Safari and Opera */\n\t.buyer_OverAll_container *::-webkit-scrollbar {\n\t\tdisplay: none;\n\t}\n\n\t/* Hide scrollbar for IE, Edge and Firefox */\n\t.buyer_OverAll_container * {\n\t  -ms-overflow-style: none;  /* IE and Edge */\n\t  scrollbar-width: none;  /* Firefox */\n\t}\n\t.ht_clone_top.handsontable {\n\t\twidth: 100% !important;\n\t}\n\t.wtHolder {\n\t\twidth: 100% !important;\n\t}\n\t.buyer_OverAll_container {\n\t\theight: 100%;\n\t\tposition: relative;\n\t}\n\t.col-sm-4.zc-reportoptionheader {\n\t\tmargin-right: 30px;\n\t}\n\ta.add_Product {\n\t\tposition: absolute;\n\t\ttop: 11px;\n\t\tright: 12px;\n\t\tz-index: 99;\n\t\tcursor: var(--zc-cursor-pointer);\n\t\theight: 34px;\n\t\tline-height: normal;\n\t\tmin-width: 34px;\n\t\tpadding: 8px 5px;\n\t\twidth: 34px;\n\t\tfont-size: 22px;\n\t\tborder-radius: var(--input_radius);\n\t\tcolor: var(--primary_bg_text_color);\n\t\tbackground-color: var(--primary_color);\n\t\tbox-sizing: border-box;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t}\n\t/*span.zc-view-name {\n\t\tmargin-left: 40px;\n\t}*/\n\t.back_Product{\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tposition: absolute;\n\t\tz-index: 1;\n\t\ttop: 17px;\n\t}\n\t[viewlinkname=&quot;All_Buyer_Products&quot;], [pagelinkname=&quot;Buyer_Product_Mapping_Page&quot;]#zppagesLive, [pagelinkname=&quot;Buyer_Product_Mapping_Page&quot;] div#elementsContainer, [pagelinkname=&quot;Buyer_Product_Mapping_Page&quot;] div#row_1 {\n\t\theight: 100% !important;\n\t}\n\t[pagelinkname=&quot;Buyer_Product_Mapping_Page&quot;] .Layout.elemContainment{\n\t\theight: calc(100% - 16px);\n\t}\n\tspan.zc-view-name:after {\n\t\tcontent: &quot;(Buyer: &lt;%=Buyer_Name%&gt;, Factory: &lt;%=Factory_Name%&gt;)&quot;;\n\t\tmargin-left: 10px;\n\t}\n\n\t[viewlinkname=&quot;All_Buyer_Products&quot;] span.zc-view-name {\n\t\t\tmargin-left: 35px;\n\t}\n\t[viewlinkname=&quot;All_Buyer_Products&quot;] ul.view-options.pull-left.view-options-menufix.zc-report-newheader {\n\t\tz-index: 10;\n\t\tbackground-color: #fff;\n\t}\n&lt;/style&gt;\n&lt;div class=&quot;buyer_OverAll_container&quot;&gt;\n\t&lt;a class=&quot;back_Product&quot; href=&quot;#Script:page.refresh&quot;&gt;\n\t&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; height=&quot;20px&quot; viewBox=&quot;0 -960 960 960&quot; width=&quot;20px&quot; fill=&quot;var(--primary_color)&quot;&gt;&lt;path d=&quot;M400-240 160-480l240-240 56 58-142 142h486v80H314l142 142-56 58Z&quot;/&gt;&lt;/svg&gt;\n\t\tBack\n\t&lt;/a&gt;\n\t&lt;a class=&quot;add_Product&quot; href=&quot;#Form:Buyer_Products?zc_LoadIn=dialog&amp;Buyer_Product_Mapping=&lt;%=input.map_ID%&gt;&amp;zc_NextUrl=#Script:page.parent.close&quot;&gt;+&lt;/a&gt;\n\t&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;All_Buyer_Products&apos; params=&apos;zc_Header=true&amp;zc_MoreAction=false&amp;zc_AddRec=false&amp;Buyer_Product_Mapping=&lt;%=input.map_ID%&gt;&apos;&gt;&lt;/div&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Buyer_Users
		{
					displayname = "Buyer Users"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet33' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet33()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n/* Hide scrollbar for Chrome, Safari and Opera */\n\t.buyer_OverAll_container *::-webkit-scrollbar {\n\t\tdisplay: none;\n\t}\n\n\t/* Hide scrollbar for IE, Edge and Firefox */\n\t.buyer_OverAll_container * {\n\t  -ms-overflow-style: none;  /* IE and Edge */\n\t  scrollbar-width: none;  /* Firefox */\n\t}\n\t.ht_clone_top.handsontable {\n\t\twidth: 100% !important;\n\t}\n\t.wtHolder {\n\t\twidth: 100% !important;\n\t}\n\t.buyer_OverAll_container {\n\t\theight: calc(100vh - 70px);\n\t\tposition: relative;\n\t}\n.col-sm-4.zc-reportoptionheader {\n\t\tmargin-right: 30px;\n\t}\n\ta.add_Buyer {\n\t\tposition: absolute;\n\t\ttop: 11px;\n\t\tright: 12px;\n\t\tz-index: 99;\n\t\tcursor: var(--zc-cursor-pointer);\n\t\theight: 34px;\n\t\tline-height: normal;\n\t\tmin-width: 34px;\n\t\tpadding: 8px 5px;\n\t\twidth: 34px;\n\t\tfont-size: 22px;\n\t\tborder-radius: var(--input_radius);\n\t\tcolor: var(--primary_bg_text_color);\n\t\tbackground-color: var(--primary_color);\n\t\tbox-sizing: border-box;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t}\n\t&lt;/style&gt;\n\t&lt;div class=&quot;buyer_OverAll_container&quot;&gt;\n\n\t&lt;a class=&quot;add_Buyer&quot; href=&quot;#Form:Create_User?zc_LoadIn=dialog&amp;User_Type=Buyer&amp;zc_NextUrl=#Script:page.parent.close&quot;&gt;+&lt;/a&gt;\n\t\t&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;Buyer_Users_Report&apos; params=&apos;zc_Header=true&amp;zc_MoreAction=false&amp;zc_AddRec=false&apos; style=&quot;height:100%;&quot;&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Cart_Main_Page(int Buyer_ID, int Suppliyer_ID)
		{
					displayname = "Cart Main Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet14' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet14()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; name=&apos;CartMainPage&apos; viewLinkName=&apos;Cart_Page&apos; params=&apos;zc_Header=true&amp;Buyer_ID=&lt;%=input.Buyer_ID%&gt;&amp;Suppliyer_ID=&lt;%=input.Suppliyer_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Cart_Page(int Buyer_ID, int CartCount, int Suppliyer_ID)
		{
					displayname = "Cart Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet3' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet3()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\t// \tfetEmp = Employee[Mail_ID.equalsIgnoreCase(zoho.loginuserid)];\n\tget_Order_Buyer = Order_Request[Buyer_Organisation == input.Buyer_ID &amp;&amp; Factory == input.Suppliyer_ID &amp;&amp; Order_By.Email == zoho.loginuserid &amp;&amp; Status == &quot;Awaiting QO Generation&quot;];\n\tinput.CartCount = thisapp.Page.CartQuantity(input.Buyer_ID,input.Suppliyer_ID);\n\t%&gt;\n&lt;style&gt;\n\t\t.popupbox-wrapper:not(.zc-alert-popup-wrapper) .popupbox {\n\t\t\twidth: 80% !important;\n\t\t\toverflow: unset !important;\n\t\t}\n\t\t.overAllDiv {\n\t\t\theight: calc(100vh - 110px);\n\t\t\t/*padding: 10px;*/\n\t\t\tbackground: var(--teritiary_bg_color);\n\t\t\tdisplay: flex;\n\t\t\tflex-direction: column;\n\t\t\t/*gap: 15px;*/\n\t\t}\n\t\t.CartReportSection {\n\t\t\theight: calc(100% - 70px);\n\t\t}\n\t\t.HeaderSectionUser{\n\t\t\tposition: absolute;\n\t\t\tz-index: 1;\n\t\t\twidth: calc(100% - 100px);\n\t\t\ttop: 0px;\n\t\t}\n\t\t.back_Product{\n\t\t\tdisplay: flex;\n\t\t\t\talign-items: center;\n\t\t\tpadding: 5px;\n\t\t\tborder-radius: 5px;\n\t\t}\n\t\ta.back_Product:hover {\n\t\t\tbackground-color: #eaeaea;\n\t\t}\n\t\t.HeaderSectionUser, .ButtonsSection {\n\t\t\theight: 35px;\n\t\t\tpadding: 10px;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: space-between;\n\t\t\tbackground-color: #fff;\n\t\t\tborder-radius: 10px;\n\t\t}\n\t\t.HeaderSection{\n\t\t\twidth: calc(100% - 70px);\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: space-between;\n\t\t}\n\t\t.UserName, .ItemsCount {\n\t\t\tmargin: 0px;\n\t\t\tfont-size: 16px;\n\t\t\tfont-weight: 600;\n\t\t}\n\t\t.ProceedBtn, .ResetBtn {\n\t\t\tpadding: 10px;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\tcolor: #fff;\n\t\t\tfont-size: 16px;\n\t\t\tbackground: var(--theme_brand_color);\n\t\t\tborder: 1px solid #ffffff;\n\t\t\tborder-radius: 25px;\n\t\t}\n\t\t/* Report Style */\n\t\t[viewLinkName=&apos;My_Cart_Details&apos;] .record-container .scroll-fix {\n\t\t\tpadding-top: 10px;\n\t\t}\n\t\t[viewLinkName=&apos;My_Cart_Details&apos;] .record-container.record-container-fix {\n\t\t\tpadding: 0;\n\t\t}\n\t\t[viewLinkName=&apos;My_Cart_Details&apos;] .gridpad.gridpad-table {\n\t\t\tbackground: var(--theme_light_bg_color);\n\t\t}\n\t\t[viewlinkname=&quot;My_Cart_Details&quot;] .zc-pb-tile-card.zc-pb-tile-cnt-wrapper{\n\t\t\tborder-radius: 10px !important;\n\t\t}\n\t\t[viewlinkname=&quot;My_Cart_Details&quot;] .view-header, [viewlinkname=&quot;My_Cart_Details&quot;] .col-sm-4.zc-reportoptionheader {\n\t\t\tpadding-right: 10px !important;\n\t\t}\n\t\t[viewlinkname=&quot;My_Cart_Details&quot;] {\n\t\t\theight: 100% !important;\n\t\t}\n\t\tform[name=&quot;Order_Details&quot;] .formContainer {\n\t\t\tpadding-left: 14px !important;\n\t\t}\n&lt;%\n\tif(input.CartCount == 0)\n\t{\n\t\t%&gt;\n.ProceedBtn {\n\t\t\t\tdisplay: none;\n\t\t\t}\n&lt;%\n\t}\n\t%&gt;\n&lt;/style&gt;\n\t&lt;div class=&quot;overAllDiv&quot;&gt;\n\t\t&lt;div class=&quot;HeaderSectionUser&quot;&gt;\n\t\t\t&lt;a class=&quot;back_Product&quot; href=&quot;#Script:page.refresh&quot;&gt;\n\t\t\t\t&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; height=&quot;20px&quot; viewBox=&quot;0 -960 960 960&quot; width=&quot;20px&quot; fill=&quot;var(--primary_color)&quot;&gt;&lt;path d=&quot;M400-240 160-480l240-240 56 58-142 142h486v80H314l142 142-56 58Z&quot;/&gt;&lt;/svg&gt;\n\t\t\t\tBack\n\t\t\t&lt;/a&gt;\n\t\t\t&lt;div class=&quot;HeaderSection&quot;&gt;\n\t\t\t\t&lt;p class=&quot;UserName&quot;&gt;&lt;%=get_Order_Buyer.Buyer_Name.User_Name%&gt;&apos;s Cart Details&lt;/p&gt;\n\t\t\t\t&lt;p class=&quot;ItemsCount&quot; style=&quot;padding-right: 20px;&quot;&gt;Total Quantity : &lt;%=if(input.CartCount != null,input.CartCount,&quot;0&quot;)%&gt;, Total Amount : &lt;%=get_Order_Buyer.Selling_Currency.Symbol%&gt; &lt;%=if(input.get_Order_Buyer != null,thisapp.numberFormatter(get_Order_Buyer.Cart_Total),&quot;0.00&quot;)%&gt;&lt;/p&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;CartReportSection&quot;&gt;\n\t\t\t&lt;div elName=&apos;zc-component&apos; name=&apos;CartView&apos; viewLinkName=&apos;My_Cart_Details&apos; params=&apos;zc_Header=true&amp;zc_Footer=false&amp;zc_AddRec=false&amp;zc_MoreAction=false&amp;zc_ReportName=false&amp;zc_Search=true&amp;Order_Request=&lt;%=get_Order_Buyer.Order_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;ButtonsSection&quot; style=&quot;height: 50px; justify-content: center; gap: 15px;&quot;&gt;\n\t\t\t&lt;a class=&quot;ProceedBtn&quot; href=&quot;#Form:Purchase_Order?zc_LoadIn=embed-cartPage&amp;Order_Request=&lt;%=get_Order_Buyer.ID%&gt;&quot; style=&quot;width: 150px;&quot;&gt;Generate QO&lt;/a&gt;\n\t\t\t&lt;a class=&quot;ResetBtn&quot; href=&quot;#Page:Product_Catalogue_Cart_Page?zc_LoadIn=embed-cartPage&amp;Buyer_ID=&lt;%=input.Buyer_ID%&gt;&amp;Suppliyer_ID=&lt;%=input.Suppliyer_ID%&gt;&amp;DeleteCart=Delete&quot; style=&quot;width: 110px;&quot;&gt;Reset Cart&lt;/a&gt;\n\t\t&lt;/div&gt;\n\t\t\n\t&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Dynamic_Product_Image(int Product_ID)
		{
					displayname = "Dynamic Product Image"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet10' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet10()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_Product = Add_Product[ID == input.Product_ID];\n\timage_link = get_Product.Primary_Image;\n\tfileName = image_link.getSuffix(&quot;image/&quot;).getPrefix(&quot;\\&quot; lowqual&quot;);\n\tpubImageUrl = &quot;https://creatorapp.zoho.com/file&quot; + zoho.appuri + &quot;Buyer_Products1/&quot; + get_Product.ID + &quot;/Primary_Image/image-download?filepath=/&quot; + fileName;\n\t%&gt;\n&lt;img src=&lt;%=pubImageUrl%&gt; alt=&quot;Product&quot; /&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page External(string appLinkName, string baseURL, string buyerCurrency, string buyerEmail, string buyerOrg, string buyerRegion, string imageFieldLinkName, string imgReportName, string reportPrivateLink, string userRole)
		{
					displayname = "External"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<widgets elementName='Widget' importedTemplate='true'/> </column>\n\t\t</row>\n\t</layout>\n</zml>"
					script
					{
						user_info = Create_User[Email == zoho.loginuserid && Status == "Active"];
										input.buyerCurrency = user_info.Associated_Buyer.Currency.Symbol;
										input.buyerOrg = user_info.Associated_Buyer.Buyer_Organisation;
										input.buyerEmail = zoho.loginuserid;
										input.buyerRegion = user_info.Associated_Buyer.Country.Region_Code_New.Region;
										input.userRole = user_info.User_Type;
										input.baseURL = "https://creatorapp.zohopublic.com";
										input.imgReportName = "Products_Report";
										input.appLinkName = zoho.appuri;
										input.imageFieldLinkName = "Primary_Image";
										input.reportPrivateLink = "0xVezyHDwYKwMnfzVYUwVkrbWaz3jrwYg90FanhxXxVrYxhHJ8M4b8gguYXHatQuyx97hfpPMebj0nGOh3yPBwsmvD7kT5uxR02C";
					}
		}

		page Factory_Dashboard
		{
					displayname = "Factory Dashboard"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='25%'>\n\t\t\t\t<panel elementName='Panel'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='0px' bgColor='#FFFFFF' action='OpenURL' url='#Report:Production_Orders?zc_LoadIn=embed-myOrder&amp;zc_MoreAction=false&amp;zc_AddRec=false' target='same-window' width='100%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t<pc paddingTop='17px' paddingLeft='17px' paddingRight='0px' paddingBottom='17px' bgColor='transparent' bgColorType='noFill' width='30%' hAlign='center'>\n\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#7F79F2' width='52px' height='52px' type='icon' value='shopping-receipt-list-42' size='24px' cornerRadius='26px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t<pc padding='10px' bgColor='#FFFFFF' width='70%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' value='Total Orders'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#2A70E7' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill