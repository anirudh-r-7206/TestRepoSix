tus != &quot;Cancelled&quot;' value='thisapp.History.ID.count'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='50%'>\n\t\t\t\t<chart elementName='Chart 1' title='Request Details' titleSize='16px' titleColor='#222326' type='Donut' bgColor='#FFFFFF' theme='theme1' legendPos='right.center' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Order_Request' xfield='Status' yfields='count:Status' /> </column>\n\t\t\t<column width='50%'>\n\t\t\t\t<chart elementName='Chart 2' title='Purchase Orders' titleSize='16px' titleColor='#222326' type='Bar' bgColor='#FFFFFF' theme='theme1' legendPos='center.top' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Purchase_Order' xfield='Order_Status' yfields='count:Order_Status' /> </column>\n\t\t</row>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet61' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet61()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n\tdiv[pagelinkname=&quot;Main_Dashboard&quot;], [pagelinkname=&quot;Main_Dashboard&quot;] div#elementsContainer{\n\t\theight: 100%;\n\t}\n\t/* div#html_snippet5 {\n\t\theight: 100% !important;\n\t} */\n\t[pagelinkname=&quot;Main_Dashboard&quot;] .Layout.elemContainment {\n\t\theight: calc(100% - 1.5rem);\n\t}\n\tdiv#row_3 {\n\t\tmin-height: 400px;\n\t\theight: calc(100% - 455px);\n\t}\n\t/* [pagelinkname=&quot;Buyer_Dashboard&quot;] .zc-pb-tile-card {\n\t\toverflow: unset;\n\t}\n\t[viewlinkname=&quot;My_Order_Requests&quot;] .zc-new-report-header.row.zc-fixed-header{\n\t\tborder-radius: 16px;\n\t}\n\t[viewlinkname=&quot;My_Order_Requests&quot;] .zc-reports-footer-sec.zc-mfooter-search-icon\n\t{\n\t\tborder-radius: 0 0 16px