\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Awaiting Factory review&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Factory_Revew_Percentage&apos;)%&gt;%;background:#ef4444&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Factory_Revew&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Amendment Request&lt;br&gt;&lt;span\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstyle=&quot;font-size:0.74rem;color:var(--clr-text-muted)&quot;&gt;(Buyer)&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Buyer_Amendment_Requested_Percentage&apos;)%&gt;%;background:#38bdf8&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Buyer_Amendment_Requested&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Amendment Request&lt;br&gt;&lt;span\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tstyle=&quot;font-size:0.74rem;color:var(--clr-text-muted)&quot;&gt;(Factory)&lt;/span&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Factory_Amendment_Requested_Percentage&apos;)%&gt;%;background:#a855f7&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Factory_Amendment_Requested&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\n\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Awaiting Production&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Awaiting_Production_Percentage&apos;)%&gt;%;background:#f97316&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Awaiting_Production&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;In production&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;In_Production_Percentage&apos;)%&gt;%;background:#06b6d4&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;In_Production&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Cancelled&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Cancelled_Percentage&apos;)%&gt;%;background:#ca8a04&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Cancelled&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\n\t\t\t\t\t\t&lt;div class=&quot;bar-row&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-label&quot;&gt;Completed&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-track&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;bar-fill&quot; style=&quot;width:&lt;%=user_Data.get(&apos;Completed_Percentage&apos;)%&gt;%;background:#22c55e&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;bar-val&quot;&gt;&lt;%=user_Data.get(&quot;Completed&quot;)%&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t&lt;!-- Quick Links --&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;card quick-links&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h2 class=&quot;card-title&quot;&gt;Quick Links&lt;/h2&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;ul class=&quot;link-list&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Countries?zc_LoadIn=dialog&quot;&gt;Countries&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Colors?zc_LoadIn=dialog&quot;&gt;Colors&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Fabrics?zc_LoadIn=dialog&quot;&gt;Fabrics&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Styles?zc_LoadIn=dialog&quot;&gt;Styles&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Product_Categories?zc_LoadIn=dialog&quot;&gt;Style Categories&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Sizes?zc_LoadIn=dialog&quot;&gt;Sizes&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;li&gt;&lt;a href=&quot;#Report:All_Wardrobes?zc_LoadIn=dialog&quot;&gt;Wardrobes&lt;/a&gt;&lt;/li&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/ul&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;/section&gt;\n\n\t\t\t\t\t\t&lt;!-- ===== PURCHASE ORDERS TABLE ===== --&gt;\n\t\t\t\t\t\t&lt;div class=&quot;card table-card&quot;&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;All_Purchase_Orders&apos; params=&apos;zc_Header=true&apos;&gt;Loading View...&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;/main&gt;\n\t\t&lt;/div&gt;\n\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}
	}

	workflow
	{
		form
		{
			Disable_fields7 as "Disable fields"
			{
			
							type =  form
							form = Add_Colors
			
							record event = on edit
			
							field rules
							{
								actions 
								{
									disable Color_Code,Color_Name;
								}
							}
			
						
			}

			Hide_Show_fields5 as "Hide & Show fields"
			{
			
							type =  form
							form = Add_Colors
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														hide Status;
									)
								}
							}
			
						
			}

			On_Created_Edited_Field_R as "On Created & Edited - Field Rules"
			{
			
							type =  form
							form = Add_Colors
			
							record event = on add or edit
			
							field rules
							{
								actions 
								{
									hide plain;
								}
							}
			
						
			}

			On_Created_Edited_User_in1 as "On Created & Edited - User input of Hex Color Code"
			{
			
							type =  form
							form = Add_Colors
			
							record event = on add or edit
			
							on user input of Hex_Color_Code
							{
								actions 
								{
									custom deluge script
									(
														if(input.Hex_Color_Code != null && input.Hex_Color_Code.toString() != "")
													{
														isValid = input.Hex_Color_Code.matches("^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$");
														if(!isValid)
														{
															alert "Invalid hex color code. Use format #RRGGBB (e.g. #FF5733) or shorthand #RGB (e.g. #F53).";
															input.Hex_Color_Code = null;
														}
														// 	else
														// 	{
														// 		input.plain = "<style>label[for=\"zc-Hex_Color_Code\"] + div:after { content: \"\"; height: 25px; width: 25px; background: " + input.Hex_Color_Code + "; border-radius: 50%; display: inline-block; vertical-align: middle; margin-left: 10px; margin-top: 5px; box-shadow: rgb(0 0 0 / 25%) 0px 0px 50px 1px; border: 0.1px solid lightgrey; }</style>";
														// 	}
													}
													else
													{
														// 	input.plain = "";
													}
									)
								}
							}
			
						
			}

			Refresh_page1 as "Refresh page"
			{
			
							type =  form
							form = Add_Colors
			
							record event = on edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														thisapp.PageRefresh();
									)
								}
							}
			
						
			}

			Valid_status_changes1 as "Valid status changes"
			{
			
							type =  form
							form = Add_Colors
			
							record event = on edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Status != old.Status)
													{
														alert "Status cannot be changed.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Disable_fields6 as "Disable fields"
			{
			
							type =  form
							form = Add_Country
			
							record event = on edit
			
							field rules
							{
								actions 
								{
									disable Country_Name;
								}
							}
			
						
			}

			Hide_Show_fields as "Hide & Show fields"
			{
			
							type =  form
							form = Add_Country
			
							record event = on add or edit
			
							field rules
							{
								actions 
								{
									hide Status,Region_Code;
								}
							}
			
						
			}

			Auto_fill_Fabric_Name as "Auto fill Fabric Name"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Fabric_Code
							{
								actions 
								{
									custom deluge script
									(
														input.Product_Description = input.Fabric_Code.Fabric_Description;
									)
								}
							}
			
						
			}

			Clear_all_lookups as "Clear all lookups"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														clear Style_Category;
													clear Style_Code;
													clear Size_Set;
													clear Fabric_Code;
									)
								}
							}
			
						
			}

			Disable_fields10 as "Disable fields"
			{
			
							type =  form
							form = Add_Product
			
							record event = on edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														disable Wardrobe;
													disable Style_Category;
													disable Style_Code;
													disable Style_Name;
													disable Gender;
													disable Size_Set;
													disable Product_Weight;
									)
								}
							}
			
						
			}

			Generate_product_sub_code as "Generate product sub code"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														input.Product_Sub_Code = input.Style_Code.Style_Code + "-" + input.Style_Colour.Color_Code + "-" + input.Size_Set.Size;
													// input.Product_Sub_Code_2 = input.Cat_NO + "-" + input.Supplier_Name.Supplier_Code + "-" + input.Product_Colour.Color_Code;
									)
								}
							}
			
						
			}

			Generate_product_sub_code2 as "Generate product sub code"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Style_Colour
							{
								actions 
								{
									custom deluge script
									(
														input.Style_ID = if(input.Style_Code == null,"",input.Style_Code.Style_Code) + if(input.Size_Set == null,"","-" + input.Size_Set.Size);
													// + if(input.Style_Colour == null,"","-" + input.Style_Colour.Color_Code) 
													// Fabric Lookup
													get_Fabric_Code = Fabric_Form[Colour_Code == input.Style_Colour && Status == "Active"].ID.getAll();
													input.Fabric_Code:ui.add(get_Fabric_Code);
													// 
													if(input.Style_Category != null && !input.Gender.isEmpty())
													{
														get_One_Size = Create_Size[Product_Category == input.Style_Category && Gender == input.Gender && Status == "Active" && Size.contains("One Size")];
														getAll_Size = Create_Size[Product_Category == input.Style_Category && Gender == input.Gender && Status == "Active"].ID.getAll();
														if(getAll_Size.size() > 0)
														{
															get_Product_Size = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Style_Category && Style_Code == input.Style_Code && Style_Colour == input.Style_Colour].Size_Set.getAll();
															get_Product_One_Size = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Style_Category && Style_Code == input.Style_Code && Style_Colour == input.Style_Colour && Size_Set.Size.contains("One Size")];
															getAll_Size.removeAll(get_Product_Size);
															if(get_Product_One_Size.count(ID) > 0)
															{
																clear Size_Set;
															}
															else
															{
																if(get_Product_Size.size() > 0)
																{
																	getAll_Size.removeElement(get_One_Size.ID);
																}
																if(input.Size_Set != null)
																{
																	this_Rec_Size = Add_Product[ID == input.ID];
																	if(this_Rec_Size.count() > 0)
																	{
																		old_Size = input.Size_Set;
																		getAll_Size.add(old_Size);
																	}
																	input.Size_Set:ui.add(getAll_Size.distinct());
																	input.Size_Set = old_Size;
																}
																else
																{
																	input.Size_Set:ui.add(getAll_Size);
																}
																if(input.Gender == "Unisex" && get_Product_Size.size() == 0)
																{
																	input.Size_Set = get_One_Size.ID;
																}
															}
														}
														else
														{
															clear Size_Set;
														}
													}
													else
													{
														clear Size_Set;
													}
									)
								}
							}
			
						
			}

			Generate_product_sub_code4 as "Generate product sub code"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Size_Set
							{
								actions 
								{
									custom deluge script
									(
														input.Style_ID = if(input.Style_Code == null,"",input.Style_Code.Style_Code) + if(input.Size_Set == null,"","-" + input.Size_Set.Size);
													//  + if(input.Product_Colour == null,"","-" + input.Product_Colour.Color_Code)
									)
								}
							}
			
						
			}

			Hide_Show_fields7 as "Hide & Show fields"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														hide Hide_Section;
													disable Style_ID;
													disable Style_Colour;
													disable Style_Range;
													hide Packaging_Options;
													hide CBM;
													if(input.Fabric_Code != null)
													{
														old_Fabric = input.Fabric_Code;
														get_Fabric_Code = Fabric_Form[Colour_Code == input.Style_Colour].ID.getAll();
														get_Fabric_Code.add(old_Fabric);
														input.Fabric_Code:ui.add(get_Fabric_Code);
														input.Fabric_Code = old_Fabric;
													}
													if(input.Size_Set != null)
													{
														if(input.Style_Category != null)
														{
															getAll_Size = Create_Size[Product_Category == input.Style_Category && Status == "Active"].ID.getAll();
															get_Product_Size = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Style_Category && Style_Code == input.Style_Code && Style_Colour == input.Style_Colour].Size_Set.getAll();
															getAll_Size.removeAll(get_Product_Size);
															if(input.Size_Set != null)
															{
																old_Size = input.Size_Set;
																getAll_Size.add(old_Size);
																input.Size_Set:ui.add(getAll_Size.distinct());
																input.Size_Set = old_Size;
															}
															else
															{
																input.Size_Set:ui.add(getAll_Size);
															}
														}
														else
														{
															clear Size_Set;
														}
													}
									)
								}
							}
			
						
			}

			Hide_show3 as "Hide & show"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Style_Category
							{
								actions 
								{
									custom deluge script
									(
														if(input.Style_Category == null)
													{
														input.Style_Name = null;
													}
									)
								}
							}
			
						
			}

			Set_Primary_Image as "Set Primary Image"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Product_Picture.Set_Primary
							{
								actions 
								{
									custom deluge script
									(
														if(row.Set_Primary == true)
													{
														for each  pic in input.Product_Picture
														{
															pic.Set_Primary=false;
														}
														row.Set_Primary=true;
													}
									)
								}
							}
			
						
			}

			Size_filter_by_Gender as "Size filter by Gender"
			{
			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Gender
							{
								actions 
								{
									custom deluge script
									(
														if(input.Style_Category != null && !input.Gender.isEmpty())
													{
														get_One_Size = Create_Size[Product_Category == input.Style_Category && Gender == input.Gender && Status == "Active" && Size.contains("One Size")];
														getAll_Size = Create_Size[Product_Category == input.Style_Category && Gender == input.Gender && Status == "Active"].ID.getAll();
														if(getAll_Size.size() > 0)
														{
															get_Product_Size = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Style_Category && Style_Code == input.Style_Code && Style_Colour == input.Style_Colour].Size_Set.getAll();
															get_Product_One_Size = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Style_Category && Style_Code == input.Style_Code && Style_Colour == input.Style_Colour && Size_Set.Size.contains("One Size")];
															getAll_Size.removeAll(get_Product_Size);
															if(get_Product_One_Size.count(ID) > 0)
															{
																clear Size_Set;
															}
															else
															{
																if(get_Product_Size.size() > 0)
																{
																	getAll_Size.removeElement(get_One_Size.ID);
																}
																if(input.Size_Set != null)
																{
																	this_Rec_Size = Add_Product[ID == input.ID];
																	if(this_Rec_Size.count() > 0)
																	{
																		old_Size = input.Size_Set;
																		getAll_Size.add(old_Size);
																	}
																	input.Size_Set:ui.add(getAll_Size.distinct());
																	input.Size_Set = old_Size;
																}
																else
																{
																	input.Size_Set:ui.add(getAll_Size);
																}
																if(input.Gender == "Unisex" && get_Product_Size.size() == 0)
																{
																	input.Size_Set = get_One_Size.ID;
																}
															}
														}
														else
														{
															clear Size_Set;
														}
													}
													else
													{
														clear Size_Set;
													}
									)
								}
							}
			
						
			}

