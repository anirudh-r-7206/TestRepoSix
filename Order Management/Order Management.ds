			Size_and_Style_filter as "Size and Style filter"
			{
			
							type =  form
							form = Product_Duplicate
			
							record event = on add
			
							on user input of Variant_Type
							{
								actions 
								{
									custom deluge script
									(
														clear Size;
													clear Style;
													clear Colors;
													if(input.Product != null)
													{
														if(input.Variant_Type == "Size")
														{
															getAll_Size = Create_Size[Product_Category == input.Product.Style_Category && Gender == input.Product.Gender && Status == "Active"].ID.getAll();
															get_Product_Size = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code == input.Product.Style_Code && Style_Colour == input.Product.Style_Colour].Size_Set.getAll();
															get_Product_One_Size = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code == input.Product.Style_Code && Style_Colour == input.Product.Style_Colour && Size_Set.Size.contains("One Size")];
															getAll_Size.removeAll(get_Product_Size);
															if(get_Product_One_Size.count(ID) > 0)
															{
																clear Size;
															}
															else
															{
																if(get_Product_Size.size() > 0)
																{
																	get_One_Size = Create_Size[Product_Category == input.Product.Style_Category && Status == "Active" && Size.contains("One Size")];
																	getAll_Size.removeAll(get_One_Size.ID.getall());
																}
																input.Size:ui.add(getAll_Size);
															}
														}
														else if(Variant_Type == "Color")
														{
															get_Color_Code = Style[Product_Code == input.Product.Style_Code.Product_Code].Product_Colour.getAll();
															get_Product_Color = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code.Product_Code == input.Product.Style_Code.Product_Code].Style_Colour.getAll();
															get_Color_Code.removeAll(get_Product_Color);
															// 
															get_Fabric_Code = Fabric_Form[Fabric_Master_Code == input.Product.Fabric_Code.Fabric_Master_Code && Status == "Active"].Colour_Code.getAll();
															color_List = List();
															for each  co_List in get_Color_Code
															{
																if(get_Fabric_Code.contains(co_List))
																{
																	color_List.add(co_List);
																}
															}
															// 		
															input.Colors:ui.add(color_List);
														}
													}
									)
								}
							}
			
						
			}

			Auto_populate_style_detai1 as "Auto populate style details"
			{
			
							type =  form
							form = Purchase_LineItems
			
							record event = on add or edit
			
							on user input of Product
							{
								actions 
								{
									custom deluge script
									(
														get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Purchase_Order.Buyer_Organisation && Style_ID == input.Product && Buyer_Product_Mapping.Factory_Allocated == input.Purchase_Order.Supplier];
													// get_Fabric = Fabric_Form[ID == input.Product.Fabric_Code];
													// get_PO_Item.Fabric_Composition = if(get_Fabric.count(ID) > 0,get_Fabric.Fabric_Composition,"");
													input.Product_Color = input.Product.Style_Colour;
													input.Product_Size = input.Product.Size_Set;
													input.Description = input.Product.Product_Description;
													input.Purchase_Price = if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0);
													input.Selling_Price = if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0);
													input.Style_Code = input.Product.Style_Code.Style_Code;
													input.HS_Code = if(get_product_Price.count(ID) > 0,get_product_Price.HS_Code,"");
													input.Fabric_Composition = input.Product.Fabric_Code.Fabric_Composition;
													if(input.Product != null && input.Quantity != null)
													{
														input.Selling_Price_Sub_Total = input.Selling_Price * input.Quantity;
														input.Purchase_Price_Sub_Total = input.Purchase_Price * input.Quantity;
													}
									)
								}
							}
			
						
			}

			Calculate_Price2 as "Calculate Price"
			{
			
							type =  form
							form = Purchase_LineItems
			
							record event = on add or edit
			
							on user input of Quantity
							{
								actions 
								{
									custom deluge script
									(
														if(input.Quantity <= 0)
													{
														alert "Quantity must be greater than 0.";
														input.Quantity = null;
													}
													else if(input.Product != null && input.Quantity > 0)
													{
														get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Purchase_Order.Buyer_Organisation && Style_ID == input.Product && Buyer_Product_Mapping.Factory_Allocated == input.Purchase_Order.Supplier];
														input.Selling_Price_Sub_Total = if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0) * input.Quantity;
														input.Purchase_Price_Sub_Total = if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0) * input.Quantity;
													}
									)
								}
							}
			
						
			}

