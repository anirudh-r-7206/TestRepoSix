			On_Success_Status_Change_ as "On Success - Status Change & History Push"
			{
			
							type =  form
							form = Purchase_Order
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														input.Factory_Address1 = if(input.Factory_Address != null,input.Factory_Address.Factory_Address,"");
													input.Factory_Company_Name = input.Factory_Address.Company_Name;
													input.Factory_Contact_Person = if(input.Factory_Address.Contact_Person1.first_name.isEmpty(),"",input.Factory_Address.Contact_Person1.first_name) + if(input.Factory_Address.Contact_Person1.last_name.isEmpty(),""," " + input.Factory_Address.Contact_Person1.last_name);
													input.Factory_Email = input.Factory_Address.Factory_Email;
													input.Factory_Phone = input.Factory_Address.Factory_Phone;
													//
													input.Delivery_Address1 = if(input.Delivery_Address != null,input.Delivery_Address.Address,"");
													input.Buyer_Company_Name = input.Delivery_Address.Company_Name;
													input.Buyer_Contact_Person = if(input.Delivery_Address.Contact_Person1.first_name.isEmpty(),"",input.Delivery_Address.Contact_Person1.first_name) + if(input.Delivery_Address.Contact_Person1.last_name.isEmpty(),""," " + input.Delivery_Address.Contact_Person1.last_name);
													input.Buyer_Email = input.Delivery_Address.Email;
													input.Buyer_Phone = input.Delivery_Address.Phone_Number;
													if(input.Order_Request != null)
													{
														get_Oder = Order_Request[ID == input.Order_Request];
														get_Oder.Status="Validation Pending";
														// Order History Push
														get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
														HistoryPush = insert into History
														[
															Added_User=zoho.loginuser
															Order_ID=input.Order_Request
															Raised_By=get_User.ID
															Status=input.Order_Status
															Comments="Order Request " + get_Oder.Order_ID + " has been moved to '" + input.Order_Status + "' by " + get_User.User_Name + "."
														];
													}
													// Purchase History Push
													HistoryPush = insert into History
													[
														Added_User=zoho.loginuser
														Purchase_Order_ID=input.ID
														Raised_By=get_User.ID
														Status=input.Order_Status
														Comments="Quotation Order " + input.QO_Number + " has been raised by " + get_User.User_Name + "."
													];
													// Send Mail to Buyer
													thisapp.Send_Mail.Email_Template(input.ID,"QO_Template");
													success message "QO generated successfully";
													openUrl("#Script:page.refresh","same window");
									)
								}
							}
			
						
			}

			Push_to_Error_Log as "Push to Error Log"
			{
			
							type =  form
							form = Purchase_Order
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														for each  recRow in input.Purchase_LineItems
													{
														if(recRow.Product.Size_Set != recRow.Product_Size || recRow.Product.Style_Colour != recRow.Product_Color)
														{
															errLog = insert into Error_Log_Form
															[
																Added_User=zoho.loginuser
																Form_Name="Purchase_Order"
																Rec_ID=input.ID
																Comment="Mismatch in subform values \nPO ID : " + input.PO_Number + "\nProduct : " + recRow.Product.Style_ID + "\nColor : " + recRow.Product_Color.Color_Name + "\nSize : " + recRow.Product_Size.Size
															];
														}
													}
									)
								}
							}
			
						
			}

