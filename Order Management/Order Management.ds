					(
						type = number
						displayname = "Size Order"
			 			row = 2
			 			column = 1   
						width = medium
		    			Formula_Properties
		    			(
		    						value =  input.Product_Size.Size_Order
		    						visibility = false
		    			)
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
							reset
							(
		   						type = reset
		   						displayname = "Reset"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Copy_of_Purchase_Order
		{
		
					displayname = "Copy of Purchase Order"
					success message = "Purchase Order Created Successfully"
					Order_Details
					(
						type = section
