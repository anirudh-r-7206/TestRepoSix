application "Order Management"
{
	date format = "dd-MMM-yyyy"
	time zone = "Asia/Kolkata"
	time format = "24-hr"



	forms
	{
		form Add_Colors
		{
		
					displayname = "Add Colors"
					success message = "Test Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Color_Name
					(
		    			type = text
						displayname = "Color Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Color_Code
					(
		    			type = text
						displayname = "Color Code"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Hex_Color_Code
					(
		    			type = text
						displayname = "Hex Color Code"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						maxchar = 100
						values = {"Active","Inactive"}
						initial value = "Active"
			 			row = 1
			 			column = 1   
						width = medium
					)
					plain
					(
		    			type = plaintext
						value = "<div> <br /></div>"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Add_Country
		{
		
					title 
		    		{
						displayname = "Add Country"
		    			on add = "Create Country"
		   	 			on edit = "Create Country"
					}
					success message = "Country Created Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Country_Name
					(
		    			type = text
						displayname = "Country Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Region_Code
					(
		    			type = text
						displayname = "Region Code"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Region_Code_New
					(
						type = picklist	
						displayname = "Region Code New"
						values  = Add_Region.ID
		    			displayformat = [Region]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						maxchar = 100
						values = {"Active","Inactive"}
						initial value = "Active"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Create"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

		form Add_Product
		{
		
					displayname = "Add Product"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Wardrobe
					(
						type = picklist	
						values  = Wardrobe.ID
		    			displayformat = [Wardrobe_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Style_Category
					(
						type = picklist	
						displayname = "Style Category"
						values  = Product_Category[Status == "Active" && Wardrobe.ID == input.Wardrobe].ID
		    			displayformat = [Product_Category]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Style_Code
					(
						type = picklist	
						displayname = "Style Code"
						values  = Style[Style_Category.ID == input.Style_Category].ID
		    			displayformat = [Style_Code]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Style_Colour
					(
						type = picklist	
						displayname = "Style Colour"
						values  = Add_Colors[Status == "Active"].ID
		    			displayformat = [Color_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Gender
					(
						type = picklist
						maxchar = 100
						values = {"Men","Women","Unisex"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Size_Set
					(
						type = picklist	
						displayname = "Size Set"
						values  = Create_Size.ID
		    			displayformat = [Size]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Fabric_Code
					(
						type = picklist	
						displayname = "Fabric Colour Code"
						values  = Fabric_Form[Status == "Active"].ID
		    			displayformat = [Fabric_Code]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Product_Description
					(
		    			type = textarea
						displayname = "Fabric Description"
						height = 100px
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Style_ID
					(
		    			type = text
						displayname = "Style ID"
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Style_Name
					(
		    			type = text
						displayname = "Style Name"
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Style_Range
					(
						type = picklist
						displayname = "Style Range"
						maxchar = 100
						values = {"Global","Europe"}
						initial value = "Global"
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Product_Weight
					(
						type = decimal
						displayname = "Product Weight"
			 			row = 1
			 			column = 2   
						width = medium
					)
					HS_Code_USA
					(
		    			type = text
						displayname = "HS Code USA"
			 			row = 1
			 			column = 2   
						width = medium
					)
					HS_Code_EU
					(
		    			type = text
						displayname = "HS Code EU "
			 			row = 1
			 			column = 2   
						width = medium
					)
					HS_Code_APAC
					(
		    			type = text
						displayname = "HS Code APAC"
			 			row = 1
			 			column = 2   
						width = medium
					)
					Technical_File
					(
		    			type = upload file
						displayname = "Technical File"
						browse = local_drive
			 			row = 1
			 			column = 2   
						width = medium
					)
					Packaging_Options
					(
						type = grid
						displayname = "Packaging Options "
						values  = Packaging_Details.ID
		    			bidirectional = Product
			 			row = 2
			 			column = 1   
						width = medium
					)
					Section1
					(
						type = section
						displayname = "Section"
			 			row = 3
			 			column = 0   
						width = medium
					)
					CBM
					(
		    			type = text
			 			row = 3
			 			column = 1   
						width = medium
					)
					must have Product_Picture
					(
						type = grid
						displayname = "Product Picture"
						must have Image
						(
		    				type = image
							source  = file
							aspect ratio = original
							camera = primary
							show gallery = true
							switch camera = true
							width = medium
						)
						Set_Primary
						(
		    				type = checkbox
							displayname = "Set Primary"
							initial value = false
							width = medium
						)
			 			row = 4
			 			column = 1   
						width = medium
					)
					Section2
					(
						type = section
						displayname = "Section"
			 			row = 5
			 			column = 0   
						width = medium
					)
					Hide_Section
					(
						type = section
						displayname = "Hide Section"
						visibility = true
			 			row = 6
			 			column = 0   
						width = medium
					)
					Product_Custom_Display
					(
		    			type = formula
						displayname = "Product Custom Display"
						value =  input.Style_Code.Style_Name + " - " + input.Style_Colour.Color_Code + " - " + input.Size_Set.Size
						visibility = false
						display type = text
						format = plaintext
			 			row = 6
			 			column = 1   
						width = medium
					)
					Product_Sub_Code
					(
		    			type = text
						displayname = "Product Sub Code"
			 			row = 6
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						displayname = "Status "
						maxchar = 100
						values = {"Approved","Discontinued"}
						initial value = "Approved"
			 			row = 6
			 			column = 1   
						width = medium
					)
					Fabric_Composition
					(
		    			type = formula
						displayname = "Fabric Composition"
						value =  input.Fabric_Code.Fabric_Composition
						visibility = false
						display type = text
						format = plaintext
			 			row = 6
			 			column = 1   
						width = medium
					)
					Auto_Number
					(
		    			type = autonumber
						displayname = "Auto Number"
						start index = 1001
			 			row = 6
			 			column = 2   
						width = medium
					)
					Primary_Image
					(
		    			type = image
						displayname = "Primary Image"
						source  = file
						aspect ratio = original
						camera = primary
						show gallery = true
						switch camera = true
			 			row = 6
			 			column = 2   
						width = medium
					)
					Style_Master_Code
					(
		    			type = formula
						displayname = "Style Master Code"
						value =  input.Style_Code.Product_Code.Product_Code
						visibility = false
						display type = text
						format = plaintext
			 			row = 6
			 			column = 2   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		}

