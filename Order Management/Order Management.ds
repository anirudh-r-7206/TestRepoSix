		{
					displayname = "QOTemplate"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet29' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet29()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\t// \tinput.QO_ID = 4908788000000468095;\n\tget_PO = Purchase_Order[ID == input.QO_ID];\n\tget_PO_Items = Purchase_LineItems[Purchase_Order == input.QO_ID];\n\tget_Buyer = Buyers_Master[ID == get_PO.Buyer_Organisation];\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n&lt;meta charset=&quot;UTF-8&quot; /&gt;\n&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;/&gt;\n&lt;title&gt;Quotation Order \u2013 &lt;%=get_PO.QO_Number%&gt;&lt;/title&gt;\n&lt;style&gt;\n\n* {\n\t\tpadding: 0;\n\t\tmargin: 0;\n\t\tborder: none;\n}\ndiv#zppagesLive,\ndiv#elementsContainer,\n.Layout.elemContainment,\ndiv#row_1,\n.zc-pb-formreport-placeholder {\n\t\theight: 100% !important;\n}\n.Layout.elemContainment {\n\t\tpadding: unset !important;\n}\n\tform[name=&quot;Print_and_PDF_Button&quot;].label-left{\n\t\t\twidth: 100% !important;\n\t\t\tbackground-color: #000000 !important;\n\t\t\tborder-radius: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .label-left{\n\t\t\twidth: 100%;\n\t\t\t\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formContainer {\n\t\t\tpadding: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .form-group.zc-decisionbox-field-group, form[name=&quot;Print_and_PDF_Button&quot;] .zc-form-scroll-wrapper {\n\t\t\tmargin: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .decision-box-field.form-field.clearfix {\n\t\t\tdisplay: none;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formColumn.first-column\n\t\t{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: end;\n\t\t\tgap: 10px;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] label.form-label.decision-box-label {\n\t\t\tcolor: #fff !important;\n\t\t\tpadding: 10px 20px !important;\n\t\t\tbackground-color: var(--primary_color);\n\t\t\tborder-radius: 8px;\n\t\t\tmargin: 0px !important;\n\t\t}\n\n\t\t.zc-footer-wrapper{\n\t\t\tdisplay: none;\n\t\t}\n\t\t@media print {\n\t\t  /* Specific margins for different sides */\n\t\t  @page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t  }\n\t\t   .action-bar{\n\t\t\t display: none !important;\n\t\t }\n\t\t  .page{\n\t\t\t  padding: 0px;\n\t\t  }\n\t\t}\n\n\t/* \u2500\u2500 ROOT CONTAINER \u2500\u2500 */\n\t#po-root {\n\t\tfont-family: &apos;Segoe UI&apos;, Arial, sans-serif;\n\t\tfont-size: 13px;\n\t\tcolor: #222;\n\t}\n\n\t/* \u2500\u2500 MAIN PAGE CARD \u2500\u2500 */\n\t#po-card {\n\t\tmax-width: 100%;\n\t\tbackground: #fff;\n\t\tborder-radius: 6px;\n\t\tbox-shadow: 0 2px 16px rgba(0,0,0,0.10);\n\t\toverflow: hidden;\n\t}\n\n\t/* \u2500\u2500 TOP BAR (inside card) \u2500\u2500 */\n\t#po-topbar {\n\t\tbackground: #1a1a2e;\n\t\tpadding: 10px 40px;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: space-between;\n\t}\n\t#po-topbar .po-logo-img {\n\t\theight: 36px;\n\t\twidth: auto;\n\t\tdisplay: inline-block;\n\t\tborder-radius: 4px;\n\t}\n\t#po-topbar .action-bar {\n\t\tdisplay: flex;\n\t\tgap: 10px;\n\t}\n\n\t/* \u2500\u2500 CONTENT AREA \u2500\u2500 */\n\t#po-content {\n\t\tpadding: 36px 40px;\n\t}\n\n\t/* \u2500\u2500 PO HEADER \u2500\u2500 */\n\t#po-header {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\talign-items: flex-start;\n\t\tmargin-bottom: 28px;\n\t}\n\t#po-header .po-label {\n\t\tfont-size: 10.5px;\n\t\tfont-weight: 700;\n\t\tcolor: #e05a00;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 1px;\n\t\tmargin-bottom: 4px;\n\t}\n\t#po-header .po-number {\n\t\tfont-size: 26px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tline-height: 1.1;\n\t}\n\t#po-header .po-issued {\n\t\tfont-size: 11.5px;\n\t\tcolor: #888;\n\t\tmargin-top: 5px;\n\t}\n\t#po-header .po-issued .po-due { color: #e05a00; }\n\t#po-header .po-totals {\n\t\tdisplay: flex;\n\t\tgap: 40px;\n\t\ttext-align: right;\n\t}\n\t#po-header .po-totals .tot-block .tot-label {\n\t\tfont-size: 10px;\n\t\tfont-weight: 700;\n\t\tcolor: #888;\n\t\ttext-transform: uppercase;\n\t\tletter-spacing: 0.8px;\n\t\tmargin-bottom: 4px;\n\t}\n\t#po-header .po-totals .tot-block .tot-val {\n\t\tfont-size: 24px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t}\n\t#po-header .po-totals .tot-block .tot-val.tot-accent { color: #e05a00; }\n\n\t/* \u2500\u2500 DIVIDER \u2500\u2500 */\n\t.po-divider {\n\t\tborder: none;\n\t\tborder-top: 1.5px solid #e8e8e8;\n\t\tmargin: 0 0 24px;\n\t}\n\n\t/* \u2500\u2500 SUPPLIER / BUYER \u2500\u2500 */\n\t#po-parties {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\tgap: 30px;\n\t\tmargin-bottom: 28px;\n\t}\n\t.po-party .party-title {\n\t\tfont-size: 14px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tmargin-bottom: 10px;\n\t}\n\t.po-party .party-info {\n\t\tfont-size: 12.5px;\n\t\tcolor: #333;\n\t\tline-height: 1.7;\n\t}\n\t.po-party .party-info .party-name { font-weight: 700; color: #111; }\n\n\t/* \u2500\u2500 SUMMARY SECTION \u2500\u2500 */\n\t#po-summary {\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\tborder: 1px solid #e0e0e0;\n\t\tborder-radius: 6px;\n\t\tmargin-bottom: 28px;\n\t\toverflow: hidden;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-summary-left {\n\t\tpadding: 22px 26px;\n\t\tborder-right: 1px solid #e0e0e0;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-summary-left .summary-heading {\n\t\tfont-size: 11px;\n\t\tfont-weight: 800;\n\t\tletter-spacing: 1.2px;\n\t\ttext-transform: uppercase;\n\t\tcolor: #444;\n\t\tmargin-bottom: 14px;\n\t}\n\t#po-summary-left .summary-table { width: 100%; border-collapse: collapse; }\n\t#po-summary-left .summary-table .s-key {\n\t\tcolor: #888;\n\t\twidth: 120px;\n\t\tpadding: 4px 0;\n\t\tfont-size: 12.5px;\n\t\tvertical-align: top;\n\t}\n\t#po-summary-left .summary-table .s-colon {\n\t\twidth: 16px;\n\t\tcolor: #888;\n\t\tpadding: 4px 0;\n\t\tfont-size: 12.5px;\n\t}\n\t#po-summary-left .summary-table .s-val {\n\t\tfont-weight: 500;\n\t\tcolor: #111;\n\t\tpadding: 4px 0;\n\t\tfont-size: 12.5px;\n\t}\n\n\t/* \u2500\u2500 FACTORY / DELIVERY \u2500\u2500 */\n\t#po-summary-right { padding: 22px 26px; background: #fff; }\n\t#po-summary-right .factory-block { margin-bottom: 22px; }\n\t#po-summary-right .block-title {\n\t\tfont-size: 14px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tmargin-bottom: 8px;\n\t}\n\t#po-summary-right .block-attn {\n\t\tfont-size: 12.5px;\n\t\tcolor: #444;\n\t\tmargin-bottom: 2px;\n\t}\n\t#po-summary-right .block-attn .attn-name { font-weight: 700; color: #111; }\n\t#po-summary-right .block-info {\n\t\tfont-size: 12.5px;\n\t\tcolor: #444;\n\t\tline-height: 1.7;\n\t}\n\t#po-summary-right .block-info .info-bold { font-weight: 700; color: #111; }\n\n\t/* \u2500\u2500 ORDER TABLE \u2500\u2500 */\n\t#po-order-title {\n\t\tfont-size: 16px;\n\t\tfont-weight: 700;\n\t\tcolor: #111;\n\t\tmargin-bottom: 12px;\n\t}\n\t#po-order-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-bottom: 28px;\n\t\tfont-size: 12px;\n\t}\n\t#po-order-table .thead-row { background: #1a1a2e; }\n\t#po-order-table .thead-row .th-cell {\n\t\tpadding: 11px 10px;\n\t\ttext-align: center;\n\t\tfont-weight: 600;\n\t\tfont-size: 11.5px;\n\t\tcolor: #fff;\n\t\tletter-spacing: 0.3px;\n\t}\n\t#po-order-table .tbody-row { border-bottom: 1px solid #eee; }\n\t#po-order-table .tbody-row .td-cell {\n\t\tpadding: 12px 10px;\n\t\ttext-align: center;\n\t\tcolor: #333;\n\t\tvertical-align: middle;\n\t}\n\t#po-order-table .tbody-row .td-fabric {\n\t\ttext-align: left;\n\t\tfont-size: 11.5px;\n\t\tcolor: #555;\n\t\tpadding: 12px 10px;\n\t\tvertical-align: middle;\n\t}\n\t#po-order-table .tfoot-subtotal .tfd-cell {\n\t\tpadding: 11px 10px;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n\t\tbackground: #f0f0f0;\n\t\tborder-top: 1.5px solid #ddd;\n\t\ttext-align: center;\n\t}\n\t#po-order-table .tfoot-subtotal .tfd-cell.tfd-label { text-align: left; padding-left: 14px; }\n\t#po-order-table .tfoot-grandtotal .tfd-cell {\n\t\tpadding: 11px 10px;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n\t\tbackground: #e8e8e8;\n\t\tborder-top: 1.5px solid #ddd;\n\t\ttext-align: center;\n\t}\n\t#po-order-table .tfoot-grandtotal .tfd-cell.tfd-label { text-align: left; padding-left: 14px; }\n\n\t/* \u2500\u2500 DYNAMIC ORDER TABLE (from PO_Templet_Table function) \u2500\u2500 */\n\t.order-table {\n\t\twidth: 100%;\n\t\tborder-collapse: collapse;\n\t\tmargin-bottom: 28px;\n\t\tfont-size: 12px;\n\t}\n\t.order-table thead tr {\n\t\tbackground: #1a1a2e;\n\t}\n\t.order-table thead th {\n\t\tpadding: 11px 10px;\n\t\ttext-align: center;\n\t\tfont-weight: 600;\n\t\tfont-size: 11.5px;\n\t\tcolor: #fff;\n\t\tletter-spacing: 0.3px;\n\t\tborder: none;\n\t}\n\t.order-table tbody tr {\n\t\tborder-bottom: 1px solid #eee;\n\t}\n\t.order-table tbody td {\n\t\tpadding: 12px 10px;\n\t\ttext-align: center;\n\t\tcolor: #161616;\n\t\tvertical-align: middle;\n\t\tborder: none;\n\t}\n\t.order-table .t_right { text-align: right; }\n\t.order-table .text_Left { text-align: left; padding-left: 14px; }\n\t.order-table .text_Bold { font-weight: 700; }\n\t/* Sub Total row */\n\t.order-table tr:has(td[colspan=&quot;8&quot;]:not(.text_Bold ~ *)) td,\n\t.order-table tbody tr td[colspan=&quot;8&quot;] {\n\t\tbackground: #f0f0f0;\n\t}\n\t.order-table tbody tr:last-child td {\n\t\tbackground: #e8e8e8;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n\t\tborder-top: 1.5px solid #ddd;\n\t}\n\t/* Sub total rows - any row with colspan=8 */\n\t.order-table tbody tr td.text_Bold[colspan=&quot;8&quot;] {\n\t\tbackground: #f0f0f0;\n\t\tborder-top: 1.5px solid #ddd;\n\t\tfont-size: 13px;\n\t}\n\t.order-table tbody tr:has(td[colspan=&quot;8&quot;]) td {\n\t\tbackground: #f0f0f0;\n\t\tborder-top: 1.5px solid #ddd;\n\t\tfont-size: 13px;\n\t\tfont-weight: 700;\n\t}\n\t.order-table tbody tr:last-child td {\n\t\tbackground: #e8e8e8 !important;\n\t\tborder-top: 2px solid #ccc;\n\t}\n\n\t/* \u2500\u2500 FOOTER SIGNATURE \u2500\u2500 */\n\t#po-footer {\n\t\tborder: 1px solid #e0e0e0;\n\t\tborder-radius: 6px;\n\t\tdisplay: grid;\n\t\tgrid-template-columns: 1fr 1fr;\n\t\toverflow: hidden;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-footer-left {\n\t\tpadding: 22px 26px;\n\t\tborder-right: 1px solid #e0e0e0;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tgap: 18px;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-footer-left .sig-row {\n\t\tdisplay: flex;\n\t\talign-items: flex-end;\n\t\tgap: 12px;\n\t}\n\t#po-footer-left .sig-row .sig-label {\n\t\tfont-size: 12.5px;\n\t\tcolor: #444;\n\t\tmin-width: 110px;\n\t\tfont-weight: 500;\n\t}\n\t#po-footer-left .sig-row .sig-line {\n\t\tflex: 1;\n\t\tborder-bottom: 1.5px solid #bbb;\n\t\theight: 20px;\n\t}\n\t#po-footer-right {\n\t\tpadding: 22px 26px;\n\t\tdisplay: flex;\n\t\tflex-direction: column;\n\t\tbackground: #f5f5f5;\n\t}\n\t#po-footer-right .commentss-label {\n\t\tfont-size: 11px;\n\t\tfont-weight: 700;\n\t\tletter-spacing: 1px;\n\t\tcolor: #888;\n\t\ttext-transform: uppercase;\n\t\tmargin-bottom: 8px;\n\t}\n\t#po-footer-right .comments-area {\n\t\tflex: 1;\n\t\tborder: 1.5px solid #ccc;\n\t\tborder-radius: 4px;\n\t\tmin-height: 90px;\n\t\tresize: none;\n\t\tpadding: 8px;\n\t\tfont-family: &apos;Segoe UI&apos;, Arial, sans-serif;\n\t\tfont-size: 12.5px;\n\t\tcolor: #333;\n\t\toutline: none;\n\t}\n\n\t/* \u2500\u2500 PRINT \u2500\u2500 */\n\t.zc-footer-wrapper { display: none; }\n\t@media print {\n\t\t@page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t}\n\t\t.action-bar { display: none !important; }\n\t\t\t#po-footer\n\t {\npage-break-inside: avoid;\t   \n\t }\n\tspan.party-address {\n\t\t\tcolor: #959595;\n\t\tfont-weight: 700;\n\t\tfont-size: 13px;\n}\n\t&lt;%=thisapp.Style.PO_Templet_Style()%&gt;\n&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n\n&lt;div id=&quot;po-root&quot;&gt;\n\t&lt;div id=&quot;po-card&quot;&gt;\n\n\t\t&lt;!-- TOP BAR --&gt;\n\t\t&lt;div id=&quot;po-topbar&quot;&gt;\n\t\t\t&lt;img src=&quot;&lt;%=thisapp.Publish_URL.Org_IMG()%&gt;&quot; class=&quot;po-logo-img&quot;&gt;\n\t\t\t&lt;div class=&quot;action-bar&quot;&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Print_and_PDF_Button&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Template=QO_V2&amp;Purchase_Order=&lt;%=input.QO_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\t\t&lt;/div&gt;\n\n\t\t&lt;!-- CONTENT --&gt;\n\t\t&lt;div id=&quot;po-content&quot;&gt;\n\n\t\t\t&lt;!-- PO HEADER --&gt;\n\t\t\t&lt;div id=&quot;po-header&quot;&gt;\n\t\t\t\t&lt;div class=&quot;po-meta&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;po-label&quot;&gt;Quotation Order&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;po-number&quot;&gt;&lt;%=get_PO.QO_Number%&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;po-issued&quot;&gt;Issued &lt;%=get_PO.PO_Date%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;hr class=&quot;po-divider&quot;/&gt;\n\n\t\t\t&lt;!-- SUPPLIER / BUYER --&gt;\n\t\t\t&lt;div id=&quot;po-parties&quot;&gt;\n\t\t\t\t&lt;div class=&quot;po-party&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;party-title&quot;&gt;Buyer&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;party-info&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;party-name&quot;&gt;&lt;%=if(get_PO.Buyer_Organisation.Buyer_Organisation.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Buyer_Organisation)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t&lt;span class = &quot;party-address&quot;&gt;    &lt;%=if(get_PO.Buyer_Organisation.Office_Address.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Office_Address)%&gt;&lt;br&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Name1.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Name1)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Email)%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;po-party&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;party-title&quot;&gt;Supplier&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;party-info&quot;&gt;\n\t\t\t\t\t\t&lt;span class=&quot;party-name&quot;&gt;&lt;%=if(get_PO.Supplier.Supplier_Organisation.isEmpty(),&quot;---&quot;,get_PO.Supplier.Supplier_Organisation)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t&lt;span class = &quot;party-address&quot;&gt;      &lt;%=if(get_PO.Supplier.Factory_Address.isEmpty(),&quot;---&quot;,get_PO.Supplier.Factory_Address)%&gt;&lt;br&gt;&lt;/span&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Contact_Person2.isEmpty(),&quot;---&quot;,get_PO.Supplier.Contact_Person2)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Phone.isEmpty(),&quot;---&quot;,get_PO.Supplier.Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Email.isEmpty(),&quot;---&quot;,get_PO.Supplier.Email)%&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- SUMMARY + FACTORY --&gt;\n\t\t\t&lt;div id=&quot;po-summary&quot;&gt;\n\t\t\t\t&lt;div id=&quot;po-summary-left&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;summary-heading&quot;&gt;Summary&lt;/div&gt;\n\t\t\t\t\t&lt;table class=&quot;summary-table&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Payment Terms&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Customer_Name.Associated_Buyer.Payment_Terms%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t            &lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Currency&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Selling_Currency.Currency_Name%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Total Cost&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO.Total_Selling_Price.round(2))%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Total Qty&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO_Items.sum(Quantity))%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t            &lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;COO&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=if(get_PO.Supplier.Country != null,get_PO.Supplier.Country.Country_Name.upper(),&quot;---&quot;)%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Freight Mode&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Transport_Mode.upper()%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;&lt;td class=&quot;s-key&quot;&gt;Incoterm&lt;/td&gt;&lt;td class=&quot;s-colon&quot;&gt;:&lt;/td&gt;&lt;td class=&quot;s-val&quot;&gt;&lt;%=get_PO.Incoterms%&gt;&lt;/td&gt;&lt;/tr&gt;\n\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div id=&quot;po-summary-right&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;factory-block&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-title&quot;&gt;Factory&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-attn&quot;&gt;&lt;span class=&quot;attn-name&quot;&gt;ATTN :&lt;/span&gt; &lt;%=if(get_PO.Factory_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Factory_Contact_Person)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-info&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;info-bold&quot;&gt;&lt;%=if(get_PO.Factory_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Factory_Company_Name)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t &lt;span class = &quot;party-address&quot;&gt;       &lt;%=if(get_PO.Factory_Address1.address_line_1.isempty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Factory_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_2)%&gt;, &lt;%=if(get_PO.Factory_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.district_city)%&gt;, &lt;%=if(get_PO.Factory_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.state_province)%&gt;, &lt;%=if(get_PO.Factory_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Factory_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.country)%&gt;&lt;br&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Factory_Phone.isEmpty(),&quot;---&quot;,get_PO.Factory_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Factory_Email.isEmpty(),&quot;---&quot;,get_PO.Factory_Email)%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;delivery-block&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-title&quot;&gt;Delivery Address&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-attn&quot;&gt;&lt;span class=&quot;attn-name&quot;&gt;ATTN :&lt;/span&gt; &lt;%=if(get_PO.Buyer_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Buyer_Contact_Person)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;block-info&quot;&gt;\n\t\t\t\t\t\t\t&lt;span class=&quot;info-bold&quot;&gt;&lt;%=if(get_PO.Buyer_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Buyer_Company_Name)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t&lt;span class = &quot;party-address&quot;&gt;      &lt;%=if(get_PO.Delivery_Address1.address_line_1.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Delivery_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_2)%&gt;, &lt;%=if(get_PO.Delivery_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.district_city)%&gt;, &lt;%=if(get_PO.Delivery_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.state_province)%&gt;, &lt;%=if(get_PO.Delivery_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Delivery_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.country)%&gt;&lt;br&gt;&lt;/span&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Email)%&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t\t&lt;!-- ORDER TABLE --&gt;\n\t\t\t&lt;%=thisapp.Page.PO_Templet_Table(input.QO_ID,&quot;QO&quot;)%&gt;\n\n\t\t\t&lt;!-- FOOTER SIGNATURE --&gt;\n\t\t\t&lt;div id=&quot;po-footer&quot;&gt;\n\t\t\t\t&lt;div id=&quot;po-footer-left&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Name&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Position&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Company Stamp&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;sig-row&quot;&gt;&lt;span class=&quot;sig-label&quot;&gt;Signature&lt;/span&gt;&lt;div class=&quot;sig-line&quot;&gt;&lt;/div&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;div id=&quot;po-footer-right&quot;&gt;\n\t\t\t\t\t&lt;div class=&quot;commentss-label&quot;&gt;Comments:&lt;/div&gt;\n\t\t\t\t\t&lt;div class=&quot;comments-area&quot;&gt;&lt;%=get_PO.Comments%&gt;&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\n\n\t\t&lt;/div&gt;&lt;!-- /#po-content --&gt;\n\t&lt;/div&gt;&lt;!-- /#po-card --&gt;\n&lt;/div&gt;&lt;!-- /#po-root --&gt;\n\n&lt;/body&gt;\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page QO_Template(int QO_ID)
		{
					displayname = "QO Template"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet1' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet1()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_PO = Purchase_Order[ID == input.QO_ID];\n\tget_PO_Items = Purchase_LineItems[Purchase_Order == input.QO_ID];\n\tget_Buyer = Buyers_Master[ID == get_PO.Customer_Name.Associated_Buyer];\n\tget_Org = organization[ID != 0];\n\t%&gt;\n&lt;!DOCTYPE html&gt;\n&lt;html lang=&quot;en&quot;&gt;\n\n&lt;head&gt;\n\t&lt;%=thisapp.Style.PO_Templet_Style()%&gt;\n\t&lt;style&gt;\n\t\t.page_Buttons {\n\t\t\tpadding-top: 18px;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .label-left{\n\t\t\twidth: 100%;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formContainer {\n\t\t\tpadding: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .form-group.zc-decisionbox-field-group {\n\t\t\tmargin: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .decision-box-field.form-field.clearfix {\n\t\t\tdisplay: none;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formColumn.first-column\n\t\t{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: end;\n\t\t\tgap: 10px;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] label.form-label.decision-box-label {\n\t\t\tcolor: #fff !important;\n\t\t\tpadding: 10px 20px !important;\n\t\t\tbackground-color: var(--primary_color);\n\t\t\tborder-radius: 8px;\n\t\t\tmargin: 0px !important;\n\t\t}\n\n\t\t.zc-footer-wrapper{\n\t\t\tdisplay: none;\n\t\t}\n\t\t@media print {\n\t\t  /* Specific margins for different sides */\n\t\t  @page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t  }\n\t\t   .page_Buttons{\n\t\t\t display: none;\n\t\t }\n\t\t  .page{\n\t\t\t  padding: 0px;\n\t\t  }\n\t\t}\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body&gt;\n\t&lt;div class=&quot;page_Buttons&quot;&gt;\n\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Print_and_PDF_Button&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Template=QO&amp;Purchase_Order=&lt;%=input.QO_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t&lt;/div&gt;\n\t\t&lt;div class=&quot;page&quot;&gt;\n\n\t\t\t\t&lt;!-- Header --&gt;\n\t\t\t\t&lt;div class=&quot;header&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;logo&quot;&gt;\n\t\t\t\t&lt;img src=&lt;%=thisapp.Publish_URL.Org_IMG()%&gt; &gt;\n\t\t\t\t&lt;p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=get_Buyer.Buyer_Organisation%&gt;&lt;/strong&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=get_Buyer.Office_Address.address_line_1%&gt;, &lt;%=get_Buyer.Office_Address.address_line_2%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=get_Buyer.Office_Address.district_city%&gt;, &lt;%=get_Buyer.Office_Address.state_province%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;%=get_Buyer.Office_Address.postal_Code%&gt;, &lt;%=get_Buyer.Office_Address.country%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;title&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2&gt;Quotation Order &lt;%=get_PO.QO_Number%&gt;&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;p&gt;&lt;strong&gt;Date : &lt;%=zoho.currentdate%&gt;&lt;/strong&gt;&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;!-- Seller / Ship / Summary --&gt;\n\t\t\t\t&lt;div class=&quot;info-section&quot;&gt;\n\t\t\n\t\t\t&lt;div class=&quot;box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4&gt;Ship to&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;box_Content&quot;&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;Attn:&lt;/b&gt; &lt;%=if(get_PO.Buyer_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Buyer_Contact_Person)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;&lt;%=if(get_PO.Buyer_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Buyer_Company_Name)%&gt;&lt;/b&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Delivery_Address1.address_line_1.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Delivery_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_2)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Delivery_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.district_city)%&gt;, &lt;%=if(get_PO.Delivery_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.state_province)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Delivery_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Delivery_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.country)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Buyer_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Phone)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Buyer_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Email)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\n\t\t\t\t\t\t&lt;div class=&quot;box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4&gt;Factory&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;box_Content&quot;&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;Attn:&lt;/b&gt; &lt;%=if(get_PO.Factory_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Factory_Contact_Person)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;b&gt;&lt;%=if(get_PO.Factory_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Factory_Company_Name)%&gt;&lt;/b&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Factory_Address1.address_line_1.isempty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Factory_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_2)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Factory_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.district_city)%&gt;, &lt;%=if(get_PO.Factory_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.state_province)%&gt;&lt;br&gt;\n\t\t\t\t\t&lt;%=if(get_PO.Factory_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Factory_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.country)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Factory_Phone.isEmpty(),&quot;---&quot;,get_PO.Factory_Phone)%&gt;&lt;/p&gt;\n\t\t\t\t\t&lt;p&gt;&lt;%=if(get_PO.Factory_Email.isEmpty(),&quot;---&quot;,get_PO.Factory_Email)%&gt;&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h4&gt;Summary&lt;/h4&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;summary&quot;&gt;\n\t\t\t\t\t\t\t\t\t&lt;!--  &lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Customer&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Customer_Name.User_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t--&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Payment Terms&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Customer_Name.Associated_Buyer.Payment_Terms%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Currency&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Buyer_Organisation.Currency.Currency_Name%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Total Cost&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO.Total_Selling_Price.round(2))%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Total Qty&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO_Items.sum(Quantity))%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;COO&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=if(get_PO.Supplier.Country != null,get_PO.Supplier.Country.Country_Name.upper(),&quot;---&quot;)%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Freight Method&lt;/td&gt;\n\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Transport_Mode.upper()%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Incoterms&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;%=get_PO.Incoterms%&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;!-- Order Table --&gt;\n\t\t&lt;%=thisapp.Page.PO_Templet_Table(input.QO_ID,&quot;QO&quot;)%&gt;\n \t\t&lt;!-- Comments Section --&gt;\n\t\t\t\t&lt;table class=&quot;comments-table&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;comments-label&quot;&gt;Comments:&lt;/td&gt;\n\t\t\t\t\t\t\t\t&lt;td class=&quot;comments-content&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=get_PO.Comments%&gt;\n\t\t\t\t\t\t\t\t&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/table&gt;\n\n\t\t\t\t&lt;!-- Signature Section --&gt;\n\t\t\t\t&lt;table class=&quot;signature-table&quot;&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Name&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Position&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Company Stamp&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t&lt;td&gt;Signature&lt;/td&gt;\n\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t&lt;/table&gt;\n\t\t&lt;/div&gt;\n\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page QO_Template_V2(int QO_ID)
		{
					displayname = "QO Template V2"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet22' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet22()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tinput.QO_ID = 4908788000000468095;\n\tget_PO = Purchase_Order[ID == input.QO_ID];\n\tget_PO_Items = Purchase_LineItems[Purchase_Order == input.QO_ID];\n\tget_Buyer = Buyers_Master[ID == get_PO.Buyer_Organisation];\n\t%&gt;\n&lt;html&gt;\n&lt;head&gt;\n\t\t&lt;style&gt;\n\t\tform[name=&quot;Print_and_PDF_Button&quot;].label-left{\n\t\t\twidth: 100% !important;\n\t\t\tbackground-color: #000000 !important;\n\t\t\tborder-radius: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .label-left{\n\t\t\twidth: 100%;\n\t\t\t\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formContainer {\n\t\t\tpadding: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .form-group.zc-decisionbox-field-group, form[name=&quot;Print_and_PDF_Button&quot;] .zc-form-scroll-wrapper {\n\t\t\tmargin: 0 !important;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .decision-box-field.form-field.clearfix {\n\t\t\tdisplay: none;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] .formColumn.first-column\n\t\t{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: end;\n\t\t\tgap: 10px;\n\t\t}\n\t\tform[name=&quot;Print_and_PDF_Button&quot;] label.form-label.decision-box-label {\n\t\t\tcolor: #fff !important;\n\t\t\tpadding: 10px 20px !important;\n\t\t\tbackground-color: var(--primary_color);\n\t\t\tborder-radius: 8px;\n\t\t\tmargin: 0px !important;\n\t\t}\n\n\t\t.zc-footer-wrapper{\n\t\t\tdisplay: none;\n\t\t}\n\t\t@media print {\n\t\t  /* Specific margins for different sides */\n\t\t  @page {\n\t\t\tmargin-top: 40px;\n\t\t\tmargin-bottom: 40px;\n\t\t\tmargin-left: 10px;\n\t\t\tmargin-right: 10px;\n\t\t\tsize: A4 landscape;\n\t\t  }\n\t\t   .action-bar{\n\t\t\t display: none !important;\n\t\t }\n\t\t  .page{\n\t\t\t  padding: 0px;\n\t\t  }\n\t\t}\n\t&lt;%=thisapp.Style.PO_V2_Templet_Style()%&gt;\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body&gt;\n\n\t\t&lt;div class=&quot;po-container&quot;&gt;\n\t\t\t\t&lt;div class=&quot;header&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;logo-area&quot;&gt;\n\t\t\t\t&lt;!-- &lt;img src=&quot;https://profile.zoho.com/file?ot=30&amp;ID=910537807&amp;t=serviceorg&amp;nocache=1780989705840&quot; &gt; --&gt;\n\t\t\t\t&lt;img src=&lt;%=thisapp.Publish_URL.Org_IMG()%&gt; &gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;action-bar&quot;&gt;\n\t\t\t\t&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;Print_and_PDF_Button&apos; params=&apos;zc_Header=false&amp;amp;zc_SuccMsg=Data Added Successfully!&amp;amp;zc_SubmitVal=Submit&amp;amp;zc_ResetVal=Reset&amp;Template=QO_V2&amp;Purchase_Order=&lt;%=input.QO_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;po-meta-row&quot;&gt;\n\t\t\t\t\t\t&lt;div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;title-tag&quot;&gt;Quotation Order&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;h1 class=&quot;po-number&quot;&gt;&lt;%=get_PO.QO_Number%&gt;&lt;/h1&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;date-info&quot;&gt;Issued &lt;%=zoho.currentdate%&gt;&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;totals-summary&quot;&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;hr class=&quot;divider&quot;&gt;\n\n\t\t\t\t&lt;div class=&quot;parties-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;party-col&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;party-title&quot;&gt;Supplier&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;party-name&quot;&gt;&lt;%=if(get_PO.Supplier.Supplier_Organisation.isEmpty(),&quot;---&quot;,get_PO.Supplier.Supplier_Organisation)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;party-details&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Factory_Address.isEmpty(),&quot;---&quot;,get_PO.Supplier.Factory_Address)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Contact_Person2.isEmpty(),&quot;---&quot;,get_PO.Supplier.Contact_Person2)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Phone.isEmpty(),&quot;---&quot;,get_PO.Supplier.Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Supplier.Email.isEmpty(),&quot;---&quot;,get_PO.Supplier.Email)%&gt;\n\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;div class=&quot;party-col&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h2 class=&quot;party-title&quot;&gt;Buyer&lt;/h2&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;party-name&quot;&gt;&lt;%=if(get_PO.Buyer_Organisation.Buyer_Organisation.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Buyer_Organisation)%&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;p class=&quot;party-details&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Office_Address.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Office_Address)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Name1.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Name1)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Organisation.Primary_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Organisation.Primary_Email)%&gt;\n\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;hr class=&quot;divider&quot;&gt;\n\n\t\t\t\t&lt;div class=&quot;logistics-grid&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;summary-box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;h3 class=&quot;sec-heading&quot;&gt;SUMMARY&lt;/h3&gt;\n\t\t\t\t\t\t\t\t&lt;table class=&quot;summary-table&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Payment Terms&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=get_PO.Customer_Name.Associated_Buyer.Payment_Terms%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Due Date&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=get_PO.Delivery_Date%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Total Qty&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO_Items.sum(Quantity))%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Total cost&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=thisapp.Page.PO_Currency_Convert(get_PO.Total_Selling_Price.round(2))%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Freight&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=get_PO.Transport_Mode.upper()%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Incoterms&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=get_PO.Incoterms%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Currency&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=get_PO.Buyer_Organisation.Currency.Currency_Name%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;COO&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;:&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;strong&gt;&lt;%=if(get_PO.Supplier.Country != null,get_PO.Supplier.Country.Country_Name.upper(),&quot;---&quot;)%&gt;&lt;/strong&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/table&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;addresses-box&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;address-block&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3 class=&quot;sec-heading&quot;&gt;Factory&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;addr-text&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;ATTN :&lt;/strong&gt; &lt;%=if(get_PO.Factory_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Factory_Contact_Person)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;&lt;%=if(get_PO.Factory_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Factory_Company_Name)%&gt;&lt;/strong&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;muted-text&quot;&gt;&lt;%=if(get_PO.Factory_Address1.address_line_1.isempty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Factory_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.address_line_2)%&gt;,&lt;%=if(get_PO.Factory_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.district_city)%&gt;, &lt;%=if(get_PO.Factory_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.state_province)%&gt;,&lt;%=if(get_PO.Factory_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Factory_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Factory_Address1.country)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Factory_Phone.isEmpty(),&quot;---&quot;,get_PO.Factory_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Factory_Email.isEmpty(),&quot;---&quot;,get_PO.Factory_Email)%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t\t\t&lt;div class=&quot;address-block&quot; style=&quot;margin-top: 25px;&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;h3 class=&quot;sec-heading&quot;&gt;Delivery Address&lt;/h3&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;p class=&quot;addr-text&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;strong&gt;ATTN :&lt;/strong&gt; &lt;%=if(get_PO.Buyer_Contact_Person.isEmpty(),&quot;---&quot;,get_PO.Buyer_Contact_Person)%&gt;&lt;br&gt;\n\t\t\t\t\t\t&lt;strong&gt;&lt;%=if(get_PO.Buyer_Company_Name.isEmpty(),&quot;---&quot;,get_PO.Buyer_Company_Name)%&gt;&lt;strong&gt;&lt;/br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;muted-text&quot;&gt;&lt;%=if(get_PO.Delivery_Address1.address_line_1.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_1)%&gt;, &lt;%=if(get_PO.Delivery_Address1.address_line_2.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.address_line_2)%&gt;,&lt;%=if(get_PO.Delivery_Address1.district_city.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.district_city)%&gt;, &lt;%=if(get_PO.Delivery_Address1.state_province.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.state_province)%&gt;,&lt;%=if(get_PO.Delivery_Address1.postal_Code.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.postal_Code)%&gt;, &lt;%=if(get_PO.Delivery_Address1.country.isEmpty(),&quot;---&quot;,get_PO.Delivery_Address1.country)%&gt;&lt;/span&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Phone.isEmpty(),&quot;---&quot;,get_PO.Buyer_Phone)%&gt;&lt;br&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;%=if(get_PO.Buyer_Email.isEmpty(),&quot;---&quot;,get_PO.Buyer_Email)%&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/p&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;order-info-section&quot;&gt;\n\t\t&lt;%=thisapp.Page.PO_V2_Templet_Table(input.QO_ID,&quot;QO&quot;)%&gt;\n\t\t\t\t&lt;!--    &lt;table class=&quot;items-table&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;thead&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 3%;&quot;&gt;#&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 10%;&quot;&gt;Style Name&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 8%;&quot;&gt;Style code&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 6%;&quot;&gt;Colour&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 8%;&quot;&gt;Size&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 6%;&quot;&gt;Gender&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 32%;&quot;&gt;Fabric Composition&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 10%;&quot;&gt;HS CODE&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 4%;&quot;&gt;Qty&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 13%;&quot;&gt;Unit Price (Purchase price)&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;th style=&quot;width: 10%; text-align: right;&quot;&gt;Total&lt;/th&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/thead&gt;\n\t\t\t\t\t\t\t\t&lt;tbody&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;1&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;font-medium&quot;&gt;Antiviral N5 spenic&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;20/5/01&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Denim&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;One size&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Unisex&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;desc-text&quot;&gt;Soft, breathable, and comfortable fabric made from cotton fibers, ideal\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tfor daily wear and summer clothing.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;bx374865&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;20&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;400.00&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td style=&quot;text-align: right;&quot; class=&quot;font-medium&quot;&gt;3,000.00&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;2&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;font-medium&quot;&gt;Kitchen wash paper&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;20/2/02&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Denim&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;One size&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;Unisex&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;desc-text&quot;&gt;Soft, breathable, and comfortable fabric made from cotton fibers, ideal\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tfor daily wear and summer clothing.&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;bx374865&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;20&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;100.00&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td style=&quot;text-align: right;&quot; class=&quot;font-medium&quot;&gt;3,000.00&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;row-subtotal&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td colspan=&quot;8&quot; class=&quot;font-semibold&quot;&gt;Sub Total&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;font-bold&quot;&gt;40&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td style=&quot;text-align: right;&quot; class=&quot;font-bold&quot;&gt;3,000.00&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;tr class=&quot;row-grandtotal&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td colspan=&quot;8&quot; class=&quot;font-bold&quot;&gt;Grand Total&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td class=&quot;font-bold&quot;&gt;40&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td&gt;&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;td style=&quot;text-align: right;&quot; class=&quot;font-bold&quot;&gt;7,000.00&lt;/td&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/tr&gt;\n\t\t\t\t\t\t\t\t&lt;/tbody&gt;\n\t\t\t\t\t\t&lt;/table&gt; --&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t&lt;div class=&quot;footer-signoff&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;signature-form&quot;&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;form-line&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Name&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;line-input&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;form-line&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Position&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;line-input&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;form-line&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Company Stamp&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;line-input&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;form-line&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;label&quot;&gt;Signature&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;line-input&quot;&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\n\t\t\t\t\t\t&lt;div class=&quot;comments-box&quot;&gt;\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n\n\t\t&lt;/div&gt;\n\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Request_Details
		{
					displayname = "Request Details"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<chart elementName='Chart' type='Donut' bgColor='#FFFFFF' theme='theme1' legendPos='right.center' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Order_Request' xfield='Status' yfields='count:Status' /> </column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Review_Page(string Email, int PO_ID)
		{
					displayname = "Review Page"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet19' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet19()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tget_User = Create_User[Email == input.Email];\n\tif(get_User.Status = &quot;Active&quot;)\n\t{\n\t\topenURL(&quot;#Form:History?Purchase_Order_ID=&quot; + input.PO_ID + &quot;&amp;Status=Amendment / Cancellation Required&quot;,&quot;same window&quot;);\n\t}\n\tif(get_User.Status == &quot;Inactive&quot;)\n\t{\n\t\t%&gt;\n&lt;div elName=&apos;zc-component&apos; formLinkName=&apos;History&apos; params=&apos;zc_Header=true&amp;zc_SuccMsg=Data Added Successfully!&amp;zc_SubmitVal=Submit&amp;zc_ResetVal=Reset&amp;privateLink=DxeCjF3mG8NWx87CBmqAe172J3k102hRWa9POQ1PCJTOFKWhV49ZXp1jnDuGNn0VYVJUB51qsHZ3j7MUCfbmJUU4vwdjmm5xa8qD?Purchase_Order_ID=&lt;%=input.PO_ID%&gt;&amp;&amp;Status=Amendment / Cancellation Required&amp;Raised_By=&lt;%=input.Email%&gt;&apos;&gt;&lt;/div&gt;\n&lt;%\n\t}\n%&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Size_Chart_Page
		{
					displayname = "Size Chart Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet7' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet7()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n\t\t*{\n\t\t\t\tpadding:0;\n\t\t\t\tmargin:0;\n\t\t\t\tborder:none;\n\t\t\t\tbox-sizing:border-box;\n\t\t\t\tfont-family: Arial, sans-serif;\n\t\t}\n\n//     .popupbox{\n//         width: 95vw !important;\n\n//     }\n\n\t\tdiv#zppagesLive,\n\t\tdiv#elementsContainer,\n\t\t.Layout.elemContainment,\n\t\tdiv#row_1,\n\t\t.zc-pb-formreport-placeholder{\n\t\t\t\theight: 100% !important;\n\t\t}\n\n\t\t#mainContainerDiv{\n\t\t\t\twidth: 100%;\n\t\t\t\theight: 100%;\n\t\t\t\tpadding: 18px 18px 24px 18px;\n\t\t\t\tbackground: #f5f7fb;\n\t\t\t\tdisplay: flex;\n\t\t\t\tflex-direction: column;\n\t\t\t\tgap: 16px;\n\t\t\t\toverflow: auto;\n\t\t}\n\n\t\t.sizeChartHeader{\n\t\t\t \n\t\t\t\twidth: 100%;\n\t\t\t\tborder-radius: 14px;\n\t\t\t\tpadding: 0 16px;\n\t\t\t\tdisplay: flex;\n\t\t\t\talign-items: center;\n\t\t}\n\n\t\t.sizeChartHeader .title{\n\t\t\t\tfont-size: 18px;\n\t\t\t\tfont-weight: 700;\n\t\t\t\tletter-spacing: 0.2px;\n\t\t}\n\n\t\t.sizeChartCard{\n\t\t\t\twidth: 100%;\n\t\t\t\tbackground: #fff;\n\t\t\t\tborder-radius: 14px;\n\t\t\t\tpadding: 30px;\n\t\t\t\tborder: 1px solid #e7eaf5;\n\t\t\t\tbox-shadow: 0 2px 12px rgba(0,0,0,0.06);\n\t\t}\n\n\t\t.sizeChartImg{\n\t\t\t\twidth: 100%;\n\t\t\t\tmax-height: 75vh;\n\t\t\t\tobject-fit: contain;\n\t\t\t\tdisplay: block;\n\t\t\t\tborder-radius: 12px;\n\t\t}\n\n\t\t@media(max-width: 768px){\n\t\t\t\t#mainContainerDiv{\n\t\t\t\t\t\tpadding: 12px;\n\t\t\t\t}\n//         .popupbox{\n//             width: 98vw !important;\n\n//         }\n\t\t\t\t.sizeChartHeader,\n\t\t\t\t.sizeChartCard{\n\t\t\t\t\t\tborder-radius: 12px;\n\t\t\t\t}\n\t\t\t\t.sizeChartImg{\n\t\t\t\t\t\tborder-radius: 10px;\n\t\t\t\t}\n\t\t}\n&lt;/style&gt;\n\n&lt;div id=&quot;mainContainerDiv&quot;&gt;\n\n\t&lt;div class=&quot;sizeChartHeader&quot;&gt;\n\t\t\t\t&lt;div class=&quot;title&quot;&gt;Size Chart&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\tfor each  rec in Size_Chart[ID != null]\n\t{\n\t\tprofile = rec.Image.replaceAll(&quot;/sharedBy/appLinkName/viewLinkName/fieldName/image&quot;,&quot;/file&quot; + zoho.appuri + &quot;All_Size_Charts/&quot; + rec.ID + &quot;/Image/image-download?filepath=&quot;);\n\t\tstart = profile.find(&quot;https&quot;);\n\t\tend = profile.find(&quot;lowqual&quot;);\n\t\timageUrl = profile.subText(start,end - 2);\n\t\t%&gt;\n&lt;div class=&quot;sizeChartCard&quot;&gt;\n\t\t\t\t&lt;img class=&quot;sizeChartImg&quot; src=&quot;&lt;%=imageUrl%&gt;&quot; alt=&quot;Size Chart Image&quot; /&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Supplier_Users
		{
					displayname = "Supplier Users"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet34' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet34()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;style&gt;\n/* Hide scrollbar for Chrome, Safari and Opera */\n\t.supplier_OverAll_container *::-webkit-scrollbar {\n\t\tdisplay: none;\n\t}\n\n\t/* Hide scrollbar for IE, Edge and Firefox */\n\t.supplier_OverAll_container * {\n\t  -ms-overflow-style: none;  /* IE and Edge */\n\t  scrollbar-width: none;  /* Firefox */\n\t}\n\t.ht_clone_top.handsontable {\n\t\twidth: 100% !important;\n\t}\n\t.wtHolder {\n\t\twidth: 100% !important;\n\t}\n\t.supplier_OverAll_container {\n\t\theight: calc(100vh - 70px);\n\t\tposition: relative;\n\t}\n.col-sm-4.zc-reportoptionheader {\n\t\tmargin-right: 30px;\n\t}\n\ta.add_Supplier {\n\t\tposition: absolute;\n\t\ttop: 11px;\n\t\tright: 12px;\n\t\tz-index: 99;\n\t\tcursor: var(--zc-cursor-pointer);\n\t\theight: 34px;\n\t\tline-height: normal;\n\t\tmin-width: 34px;\n\t\tpadding: 8px 5px;\n\t\twidth: 34px;\n\t\tfont-size: 22px;\n\t\tborder-radius: var(--input_radius);\n\t\tcolor: var(--primary_bg_text_color);\n\t\tbackground-color: var(--primary_color);\n\t\tbox-sizing: border-box;\n\t\tdisplay: flex;\n\t\talign-items: center;\n\t\tjustify-content: center;\n\t}\n\t&lt;/style&gt;\n\t&lt;div class=&quot;supplier_OverAll_container&quot;&gt;\n\n\t&lt;a class=&quot;add_Supplier&quot; href=&quot;#Form:Create_User?zc_LoadIn=dialog&amp;User_Type=Factory&amp;zc_NextUrl=#Script:page.parent.close&quot;&gt;+&lt;/a&gt;\n\t\t&lt;div elName=&apos;zc-component&apos; viewLinkName=&apos;Supplier_Users_Report&apos; params=&apos;zc_Header=true&amp;zc_MoreAction=false&amp;zc_AddRec=false&apos; style=&quot;height:100%;&quot;&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Test_Page
		{
					displayname = "Test Page"
