			Duplicate_Product1 as "Duplicate Product"
			{
			
							type =  form
							form = Buyer_product_duplicate
							button = Submit
							on click
							{
								actions 
								{
								on click
								(
									if(input.Variant_Type == "Size" && input.Size.Size() <= 0)
													{
														alert "Size is required.";
													}
													else if(input.Variant_Type == "Color" && input.Colors.size() <= 0)
													{
														alert "Color is required.";
													}
													else
													{
														if(input.Variant_Type == "Size" && input.Size != null)
														{
															for each  siz in input.Size
															{
																get_Product = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code == input.Product.Style_Code && Size_Set == siz];
																info get_Product.Style_ID;
																ProductID = get_Product.Style_ID + "-" + input.Buyer_Product_Mapping.Factory_Allocated.Supplier_Code + "-" + input.Buyer_Product_Mapping.Buyer.Buyer_Code;
																insert_Buyer_Products = insert into Buyer_Products
																[
																	Buyer_Product_Mapping=input.Buyer_Product_Mapping
																	Product_ID=ProductID
																	Style_ID=get_Product.ID
																	Style_Name=get_Product.ID
																	Size=siz
																	Colors=input.Buyer_Products.Colors
																	Buy_Price=input.Buyer_Products.Buy_Price
																	Sell_Price=input.Buyer_Products.Sell_Price
																	HS_Name=input.Buyer_Products.HS_Name
																	HS_Code=input.Buyer_Products.HS_Code
																	Added_User=zoho.loginuser
																];
															}
														}
														else if(input.Variant_Type == "Color" && input.Colors != null)
														{
															for each  col in input.Colors
															{
																get_Product = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code.Product_Code == input.Product.Style_Code.Product_Code && Style_Colour == col];
																// 		info get_Product.Style_ID;
																ProductID = get_Product.Style_ID + "-" + input.Buyer_Product_Mapping.Factory_Allocated.Supplier_Code + "-" + input.Buyer_Product_Mapping.Buyer.Buyer_Code;
																insert_Buyer_Products = insert into Buyer_Products
																[
																	Buyer_Product_Mapping=input.Buyer_Product_Mapping
																	Product_ID=ProductID
																	Style_ID=get_Product.ID
																	Style_Name=get_Product.ID
																	Size=get_Product.Size_Set
																	Colors=col
																	Buy_Price=input.Buyer_Products.Buy_Price
																	Sell_Price=input.Buyer_Products.Sell_Price
																	HS_Name=input.Buyer_Products.HS_Name
																	HS_Code=input.Buyer_Products.HS_Code
																	Added_User=zoho.loginuser
																];
															}
														}
														// 	openUrl("#Page:Buyer_Product_Mapping_Page?zc_LoadIn=embed-BuyerProducts&map_ID=" + input.Buyer_Product_Mapping,"same window");
														thisapp.PageRefresh();
													}
								)
								}
							}
						
			}

			Filter_Size_Color as "Filter Size & Color"
			{
			
							type =  form
							form = Buyer_product_duplicate
			
							record event = on add
			
							on user input of Variant_Type
							{
								actions 
								{
									custom deluge script
									(
														clear Size;
													clear Colors;
													hide Size;
													hide Colors;
													if(input.Buyer_Product_Mapping != null && input.Product != null)
													{
														if(input.Variant_Type == "Size")
														{
															show Size;
															// 		getAll_Size = Create_Size[Product_Category == input.Product.Style_Category && Gender == input.Product.Gender && Status == "Active"].ID.getAll();
															get_Product_Size = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code == input.Product.Style_Code && Style_Colour == input.Product.Style_Colour].Size_Set.getAll();
															get_Buyer_Product_Size = Buyer_Products[Buyer_Product_Mapping == input.Buyer_Product_Mapping && Style_ID.Style_Code == input.Product.Style_Code].Size.getAll();
															get_Product_Size.removeAll(get_Buyer_Product_Size);
															input.Size:ui.add(get_Product_Size);
														}
														else if(input.Variant_Type == "Color")
														{
															show Colors;
															get_Product_Color = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code.Product_Code == input.Product.Style_Code.Product_Code].Style_Colour.getAll();
															get_Style_Code = Style[Product_Code == input.Product.Style_Code.Product_Code].ID.getAll();
															get_Buyer_Product_Color = Buyer_Products[Buyer_Product_Mapping == input.Buyer_Product_Mapping && Style_ID.Style_Code in get_Style_Code].Colors.getAll();
															get_Product_Color.removeAll(get_Buyer_Product_Color);
															input.Colors:ui.add(get_Product_Color);
														}
													}
									)
								}
							}
			
						
			}

