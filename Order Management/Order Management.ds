		     			) 
		     			address_line_2
		     			(
			     			  type = address_line_2
			     			  displayname = "Address Line 2"
		     			) 
		     			district_city
		     			(
			     			  type = district_city
			     			  displayname = "City / District"
		     			) 
		     			state_province
		     			(
			     			  type = state_province
			     			  displayname = "State / Province"
		     			) 
		     			postal_Code
		     			(
			     			  type = postal_Code
			     			  displayname = "Postal Code"
		     			) 
		     			country
		     			(
			     			  type = country
			     			  displayname = "Country"
		     			) 
		     			latitude
		     			(
			     			  type = latitude
			     			  displayname = "latitude"
			     			 visibility = false
		     			) 
		     			longitude
		     			(
			     			  type = longitude
			     			  displayname = "longitude"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
			
