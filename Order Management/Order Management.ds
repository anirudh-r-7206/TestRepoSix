		default list Purchase_LineItems_Report
		{
		
					displayName = "Purchase LineItems Report"
					show all rows from Purchase_LineItems    
					(
						Product as "Style ID"
						Product_Color as "Product Color"
						Product_Size as "Product Size"
						Quantity
						Purchase_Price as "Purchase Price"
						Selling_Price as "Selling Price"
						Purchase_Price_Sub_Total as "Purchase Price Sub Total"
						Selling_Price_Sub_Total as "Selling Price Sub Total"
						Purchase_Order as "Purchase Order"
						Description
						Style_Code as "Style Code"
						Product_Size.Size_Order as "Size Order"
						HS_Code as "HS Code"
						Fabric_Composition as "Fabric Composition"
						Size_Order as "Size Order"
					)
					group by
					(
						Style_Code ascending
					)
					sort by
					(
						Product_Size.Size_Order ascending
					)
					custom actions
					(
						"Edit "
						(
			  			workflow = Edit_PO_Items
						show action in view header = true
						show action in edit record menu = true
						)
						"Delete "
						(
			  			workflow = Delete_Line_Item
						show action in edit record menu = true
						condition = (ID == thisapp.Filters.deletePurchaselineItem())
						confirmation before execution
						(
							message for individual record = "Are you sure you want to remove the selected line item from the Purchase Order? Once deleted, the item details cannot be recovered."
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
				
		}

		default list All_Purchase_Orders
		{
		
					displayName = "Purchase Orders"
					show all rows from Purchase_Order    
					(
						Order_Reference as "Order Reference"
						PO_Date as "PO Date"
						(
							width = 122px
						)
						Order_Type as "Order Type "
						(
							width = 134px
						)
						Order_Status as "Order Status"
						(
							width = 141px
						)
						Delivery_Date as "Ex-Factory date"
						(
							width = 149px
						)
						Delivery_Contact as "Delivery Contact "
						Freight_Forwarder as "Freight Forwarder"
						Incoterms as "Incoterm"
						Order_Request as "Order Request"
						(
							width = 155px
						)
						PO_Number as "PO Number"
						(
							width = 164px
						)
						Total_Purchase_Price as "Total Purchase Price"
						(
							width = 173px
						)
						Total_Selling_Price as "Total Selling Price"
						QO_Number as "QO Number"
						custom action "View PO"
						(
			  			workflow = View_PO
						show action in view header = true
						show action in edit record menu = true
						column header = "View PO"
						condition = (Order_Status == "Awaiting Factory Review" || Order_Status == "Amendment Requested (Factory)" || Order_Status == "Awaiting Production" || Order_Status == "In Production" || Order_Status == "Completed")
						)
						custom action "View QO"
						(
			  			workflow = View_QO
						show action in edit record menu = true
						column header = "View QO"
						condition = (Order_Status != "Awaiting QO Generation" && Order_Status != "Cancelled")
						)
						Country
						custom action "Generate PO"
						(
			  			workflow = Generate_PO1
						show action in view header = true
						show action in edit record menu = true
						column header = "Generate PO"
						condition = (Order_Status == "Awaiting PO Generation")
						)
						custom action "Move to Production"
						(
			  			workflow = Move_to_Production
						show action in view header = true
						show action in edit record menu = true
						column header = "Move to Production"
						condition = (Order_Status == "Awaiting Production")
						)
						custom action "Completed"
						(
			  			workflow = Complete_PO
						show action in edit record menu = true
						column header = "Completed"
						condition = (Order_Status == "In Production" && Order_Status != "Cancelled")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to complete this purchase order?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						Supplier
						Purchase_Currency as "Purchase Currency"
						Selling_Currency as "Selling Currency"
						Buyer_Organisation as "Buyer Organisation"
						custom action "Cancel"
						(
			  			workflow = Cancel_PO
						show action in edit record menu = true
						column header = "Cancel"
						condition = (Order_Status != "Completed" && Order_Status != "Cancelled")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to cancel this Purchase Order?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						Factory_Address1  as "Factory Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						Delivery_Address1  as "Delivery Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						Total_Quantity as "Total Quantity"
						custom action "Raise Amendment"
						(
			  			workflow = Raise_Amendment_for_PO
						show action in edit record menu = true
						column header = "Raise Amendment"
						condition = (Order_Status != "Completed" && Order_Status != "Cancelled" && ID != thisapp.Filters.Filter_buyer_pending_amendment())
						)
					)
					sort by
					(
						PO_Number descending
					)
					custom actions
					(
						"Edit PO"
						(
			  			workflow = Edit_PO
						show action in view header = true
						show action in edit record menu = true
						condition = (Order_Status == "Amendment Requested (Buyer)" || Order_Status == "Amendment Requested (Factory)" || Order_Status == "Awaiting QO Generation")
						)
						"Duplicate Order"
						(
			  			workflow = Duplicate_PO
						show action in edit record menu = true
						)
						"Delete PO"
						(
			  			workflow = Delete_PO
						show action in edit record menu = true
						confirmation before execution
						(
							message for individual record = "Are you sure you want to delete this PO and all related records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					conditional formatting
					(
						"Completed"
						{
						condition = (Order_Status == "Completed")
						fields = [Order_Status]
						format = "color:#16a34a;"
						}
						"Awaiting QO Generation"
						{
						condition = (Order_Status == "Awaiting QO Generation")
						fields = [Order_Status]
						format = "color:#3b82f6;"
						}
						"Awaiting Buyer Review"
						{
						condition = (Order_Status == "Awaiting Buyer Review")
						fields = [Order_Status]
						format = "color:#f59e0b;"
						}
						"Amendment Requested (Buyer)"
						{
						condition = (Order_Status == "Amendment Requested (Buyer)")
						fields = [Order_Status]
						format = "color:#ea580c;"
						}
						"Awaiting PO Generation"
						{
						condition = (Order_Status == "Awaiting PO Generation")
						fields = [Order_Status]
						format = "color:#eab308;"
						}
						"Awaiting Factory Review"
						{
						condition = (Order_Status == "Awaiting Factory Review")
						fields = [Order_Status]
						format = "color:#f59e0b;"
						}
						"Amendment Requested (Factory)"
						{
						condition = (Order_Status == "Amendment Requested (Factory)")
						fields = [Order_Status]
						format = "color:#ea580c;"
						}
						"Awaiting Production"
						{
						condition = (Order_Status == "Awaiting Production")
						fields = [Order_Status]
						format = "color:#6366f1;"
						}
						"In Production"
