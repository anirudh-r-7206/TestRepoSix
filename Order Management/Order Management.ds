App Sharing Failed: the associated buyer is pending approval. The user&apos;s account will remain inactive until the buyer is approved.&quot;;\n\t}\n\telse if(input.Message_Type == &quot;Buyer_Rejected&quot;)\n\t{\n\t\tMessage_Content = &quot;App Sharing Failed: the associated buyer has been rejected. Please contact the administrator for further assistance.&quot;;\n\t}\n\telse if(input.Message_Type == &quot;Buyer_Inactive&quot;)\n\t{\n\t\tMessage_Content = &quot;App Sharing Failed: the associated buyer is in Inactive Status. Please activate the Buyer and then try again.&quot;;\n\t}\n\telse if(input.Message_Type == &quot;Supplier_Not_Approved&quot;)\n\t{\n\t\tMessage_Content = &quot;App Sharing Failed: the associated supplier is pending approval. The user&apos;s account will remain inactive until the supplier is approved.&quot;;\n\t}\n\telse if(input.Message_Type == &quot;Supplier_Rejected&quot;)\n\t{\n\t\tMessage_Content = &quot;App Sharing Failed: the associated supplier has been rejected. Please contact the administrator for further assistance.&quot;;\n\t}\n\telse if(input.Message_Type == &quot;Supplier_Inactive&quot;)\n\t{\n\t\tMessage_Content = &quot;App Sharing Failed: the associated supplier is in Inactive Status. Please activate the Supplier and then try again.&quot;;\n\t}\n\telse if(input.Message_Type == &quot;User_Inactive&quot;)\n\t{\n\t\tMessage_Content = &quot;The User Account is yet to be Approved. Please Approve the User to provide access.&quot;;\n\t}\n\telse\n\t{\n\t\tsvg = &quot;&lt;svg width=\\&quot;130\\&quot; height=\\&quot;100\\&quot; viewBox=\\&quot;0 0 71 51\\&quot; fill=\\&quot;none\\&quot; xmlns=\\&quot;http://www.w3.org/2000/svg\\&quot;&gt; &lt;circle cx=\\&quot;54.5\\&quot; cy=\\&quot;38.5\\&quot; r=\\&quot;1.5\\&quot; stroke=\\&quot;#C3C3C3\\&quot;/&gt; &lt;path d=\\&quot;M37.299 12.25L48.5574 31.75C49.1347 32.75 48.413 34 47.2583 34H24.7417C23.587 34 22.8653 32.75 23.4426 31.75L34.701 12.25C35.2783 11.25 36.7217 11.25 37.299 12.25Z\\&quot; stroke=\\&quot;#C4C4C4\\&quot;/&gt; &lt;path d=\\&quot;M36 25.5625V18\\&quot; stroke=\\&quot;#C4C4C4\\&quot; stroke-width=\\&quot;1.3\\&quot; stroke-linecap=\\&quot;round\\&quot; stroke-linejoin=\\&quot;round\\&quot;/&gt; &lt;circle cx=\\&quot;35.9875\\&quot; cy=\\&quot;28.3125\\&quot; r=\\&quot;0.34375\\&quot; fill=\\&quot;#C4C4C4\\&quot; stroke=\\&quot;#C4C4C4\\&quot; stroke-width=\\&quot;0.6875\\&quot;/&gt; &lt;path d=\\&quot;M36.299 12.25L47.5574 31.75C48.1347 32.75 47.413 34 46.2583 34H23.7417C22.587 34 21.8653 32.75 22.4426 31.75L33.701 12.25C34.2783 11.25 35.7217 11.25 36.299 12.25Z\\&quot; stroke=\\&quot;#ED3026\\&quot;/&gt; &lt;path d=\\&quot;M35 25.5625V18\\&quot; stroke=\\&quot;#ED3026\\&quot; stroke-width=\\&quot;1.3\\&quot; stroke-linecap=\\&quot;round\\&quot; stroke-linejoin=\\&quot;round\\&quot;/&gt; &lt;circle cx=\\&quot;34.9875\\&quot; cy=\\&quot;28.3125\\&quot; r=\\&quot;0.6875\\&quot; fill=\\&quot;#ED3026\\&quot;/&gt; &lt;circle cx=\\&quot;15.5\\&quot; cy=\\&quot;42\\&quot; r=\\&quot;3.5\\&quot; stroke=\\&quot;#C3C3C3\\&quot;/&gt; &lt;circle cx=\\&quot;15\\&quot; cy=\\&quot;41\\&quot; r=\\&quot;3.5\\&quot; stroke=\\&quot;#ED3026\\&quot;/&gt; &lt;circle cx=\\&quot;54\\&quot; cy=\\&quot;38\\&quot; r=\\&quot;1.5\\&quot; stroke=\\&quot;#ED3026\\&quot;/&gt; &lt;circle cx=\\&quot;17.5\\&quot; cy=\\&quot;15.5\\&quot; r=\\&quot;1.5\\&quot; stroke=\\&quot;#C3C3C3\\&quot;/&gt; &lt;circle cx=\\&quot;17\\&quot; cy=\\&quot;15\\&quot; r=\\&quot;1.5\\&quot; stroke=\\&quot;#ED3026\\&quot;/&gt; &lt;circle cx=\\&quot;53\\&quot; cy=\\&quot;8\\&quot; r=\\&quot;2\\&quot; stroke=\\&quot;#C3C3C3\\&quot;/&gt; &lt;circle cx=\\&quot;52.5\\&quot; cy=\\&quot;7.5\\&quot; r=\\&quot;2\\&quot; stroke=\\&quot;#ED3026\\&quot;/&gt; &lt;/svg&gt;&quot;;\n\t\t// \t\tMessage_Content = &quot;&quot;;\n\t}\n\t%&gt;\n&lt;html lang=&quot;en&quot;&gt;\n&lt;head&gt;\n\t\t&lt;meta charset=&quot;UTF-8&quot;&gt;\n\t\t&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;\n\t\t&lt;title&gt;Popup Warning Alert&lt;/title&gt;\n\t\t&lt;style&gt;\n\t\t\t\t* {\n\t\t\t\t\t\tpadding: 0;\n\t\t\t\t\t\tmargin: 0;\n//             box-sizing: border-box;\n\t\t\t\t}\n\t\t\n\t\t\t\t/* The popup container (hidden by default) */\n\t\t\t\t.popup {\n//             position: fixed;\n//             top: 20%;\n//             left: 50%;\n//             transform: translate(-50%, -50%);\n\t\t\t\t\t\tbackground: #fff;\n\t\t\t\t\t\tpadding: 20px 20px 30px 20px;\n\t\t\t\t\t\tbox-shadow: 0 4px 5px rgba(0, 0, 0, 0.07);\n\t\t\t\t\t\tborder-radius: 10px;\n\t\t\tmax-width: 600px;\n\t\t\t\t\t\ttext-align: center;\n\t\t\tfont-size: 18px;\n\t\t\t\tfont-weight: 600;\n\t\t\t\t}\n\t\t.alert_content{\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t}\n\t\t[pagelinkname=&quot;Alert_Message&quot;] .zc-pb-tile-card{\n\t\t\tbackground-color: transparent !important;\n\t\t\t\tbox-shadow: none !important;\n\t\t}\n\t\ta.back_Button {\n\t\t\tborder-radius: 10px;\n\t\t\tpadding: 7px 18px;\n\t\t\tfont-size: 13px;\n\t\t\tbackground: #F1F2FA;\n\t\t\tcolor: #29379E;\n\t\t\tfont-weight: 500;\n\t\t\tmargin: 10px auto 0px;\n\t\t\tdisplay: flex;\n\t\t\twidth: fit-content;\n\t\t}\n\t\t&lt;/style&gt;\n&lt;/head&gt;\n&lt;body&gt;\n\n\t&lt;!-- The popup alert --&gt;\n\t\t&lt;div class=&quot;alert_content&quot;&gt;\n\t\t&lt;div id=&quot;alert&quot; class=&quot;popup&quot;&gt;\n\t\t&lt;div class=&quot;alert_Img&quot;&gt;\n\t\t\t&lt;%=svg%&gt;\n\t\t&lt;/div&gt;\n\t\t\t&lt;div style=&quot;font-weight: 500;&quot;&gt;&lt;%=Message_Content%&gt;&lt;/div&gt;\n&lt;%\n\tif(!redirect.isEmpty())\n\t{\n\t\t%&gt;\n&lt;a class=&quot;back_Button&quot; href=&quot;#Script:page.refresh&quot;&gt;Go back&lt;/a&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t&lt;/div&gt;\n&lt;/body&gt;\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page All_Order_Requests_Page
		{
					displayname = "All Order Requests"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet25' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet25()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; name=&quot;editPO&quot; style=&quot;height: calc(100vh - 70px);&quot; viewLinkName=&apos;All_Order_Requests1&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Awaiting_Action_Page
		{
					displayname = "Awaiting Action"
					Content="<zml>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet18' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet18()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;div elName=&apos;zc-component&apos; name=&quot;editPO&quot; style=&quot;height:calc(100vh - 70px) !important;&quot; viewLinkName=&apos;Awaiting_Action&apos; params=&apos;zc_Header=true&amp;zc_AddRec=false&amp;zc_MoreAction=false&apos;&gt;&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Buyer_Cart(string appLinkName, string baseURL, string buyerCurrency, string buyerEmail, string buyerOrg, string buyerRegion, string imageFieldLinkName, string imgReportName, string reportPrivateLink, string userRole)
		{
					displayname = "Buyer Cart"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<widgets elementName='Widget' importedTemplate='true'/> </column>\n\t\t</row>\n\t</layout>\n</zml>"
					script
					{
						user_info = Create_User[Email == zoho.loginuserid && Status == "Active"];
										input.buyerCurrency = user_info.Associated_Buyer.Currency.Symbol;
										input.buyerOrg = user_info.Associated_Buyer.Buyer_Organisation;
										input.buyerEmail = zoho.loginuserid;
										input.buyerRegion = user_info.Associated_Buyer.Country.Region_Code_New.Region;
										input.userRole = user_info.User_Type;
										input.baseURL = "https://creatorapp.zohopublic.com";
										input.imgReportName = "Products_Report";
										input.appLinkName = zoho.appuri;
										input.imageFieldLinkName = "Primary_Image";
										input.reportPrivateLink = "0xVezyHDwYKwMnfzVYUwVkrbWaz3jrwYg90FanhxXxVrYxhHJ8M4b8gguYXHatQuyx97hfpPMebj0nGOh3yPBwsmvD7kT5uxR02C";
					}
		}

		page Buyer_Cart_Detail_Page(int CartCount, string Cart_Delete_or_Submit, int Supplier)
		{
					displayname = "Buyer Cart Detail Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet32' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet32()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\t// \tfetEmp = Employee[Mail_ID.equalsIgnoreCase(zoho.loginuserid)];\n\t// \tget_Order_Buyer = Order_Request[Buyer_Organisation == input.Buyer_ID &amp;&amp; Factory == input.Suppliyer_ID &amp;&amp; Order_By.Email == zoho.loginuserid &amp;&amp; Status == &quot;Awaiting QO Generation&quot;];\n\t// \tinput.CartCount = thisapp.Page.Cart_Count(input.Buyer_ID,input.Suppliyer_ID);\n\tget_Order_Buyer = Order_Request[Order_By.Email == thisapp.Dev.get_User_Email() &amp;&amp; Factory == input.Supplier &amp;&amp; Status == &quot;Pending&quot;];\n\tinput.CartCount = (get_Order_Buyer.Order_details.ID.getall()).size();\n\tif(input.Cart_Delete_or_Submit == &quot;Delete&quot;)\n\t{\n\t\tget_Order_Buyer.Order_details.clear();\n\t\tget_Order_Buyer.Cart_Total=0;\n\t\t// \t\topenUrl(&quot;#Script:page.refresh&quot;,&quot;same window&quot;);\n\t\topenUrl(&quot;#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&amp;Supplier=&quot; + input.Supplier,&quot;same window&quot;);\n\t}\n\telse if(input.Cart_Delete_or_Submit == &quot;Submit&quot; &amp;&amp; input.CartCount &gt; 0)\n\t{\n\t\tget_Order_Buyer.Status=&quot;Awaiting QO Generation&quot;;\n\t\t// \t\topenUrl(&quot;#Script:page.refresh&quot;,&quot;same window&quot;);\n\t\topenUrl(&quot;#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&amp;Supplier=&quot; + input.Supplier,&quot;same window&quot;);\n\t}\n\t%&gt;\n&lt;style&gt;\n\t\t.popupbox-wrapper:not(.zc-alert-popup-wrapper) .popupbox {\n\t\t\twidth: 80% !important;\n\t\t\toverflow: unset !important;\n\t\t}\n\t\t.overAllDiv {\n\t\t\theight: calc(100vh - 110px);\n\t\t\tpadding: 10px;\n\t\t\tbackground: var(--teritiary_bg_color);\n\t\t\tdisplay: flex;\n\t\t\tflex-direction: column;\n\t\t\tgap: 15px;\n\t\t}\n\t\t.CartReportSection {\n\t\t\theight: calc(100% - 70px);\n\t\t}\n\t\t.HeaderSectionUser{\n\t\t\tposition: absolute;\n\t\t\tz-index: 1;\n\t\t\twidth: calc(100% - 100px);\n\t\t\ttop: 28px;\n\t\t}\n\t\t.HeaderSectionUser, .ButtonsSection {\n\t\t\theight: 35px;\n\t\t\tpadding: 10px;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: space-between;\n\t\t\tbackground-color: #fff;\n\t\t\tborder-radius: 10px;\n\t\t}\n\t\t.UserName, .ItemsCount {\n\t\t\tmargin: 0px;\n\t\t\tfont-size: 16px;\n\t\t\tfont-weight: 600;\n\t\t}\n\t\t.ProceedBtn, .ResetBtn {\n\t\t\tpadding: 10px;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\tcolor: #fff;\n\t\t\tfont-size: 16px;\n\t\t\tbackground: var(--theme_brand_color);\n\t\t\tborder: 1px solid #ffffff;\n\t\t\tborder-radius: 25px;\n\t\t}\n\t\t/* Report Style */\n\t\t[viewLinkName=&apos;My_Cart_Details&apos;] .record-container .scroll-fix {\n\t\t\tpadding-top: 10px;\n\t\t}\n\t\t[viewLinkName=&apos;My_Cart_Details&apos;] .record-container.record-container-fix {\n\t\t\tpadding: 0;\n\t\t}\n\t\t[viewLinkName=&apos;My_Cart_Details&apos;] .gridpad.gridpad-table {\n\t\t\tbackground: var(--theme_light_bg_color);\n\t\t}\n\t\t[viewlinkname=&quot;My_Cart_Details&quot;] .zc-pb-tile-card.zc-pb-tile-cnt-wrapper{\n\t\t\tborder-radius: 10px !important;\n\t\t}\n\t\t[viewlinkname=&quot;My_Cart_Details&quot;] .view-header, [viewlinkname=&quot;My_Cart_Details&quot;] .col-sm-4.zc-reportoptionheader {\n\t\t\tpadding-right: 10px !important;\n\t\t}\n\t\t[viewlinkname=&quot;My_Cart_Details&quot;] {\n\t\t\theight: 100% !important;\n\t\t}\n\t\tform[name=&quot;Order_Details&quot;] .formContainer {\n\t\t\tpadding-left: 14px !important;\n\t\t}\n&lt;%\n\tif(input.CartCount == 0)\n\t{\n\t\t%&gt;\n.ProceedBtn {\n\t\t\t\tdisplay: none;\n\t\t\t}\n&lt;%\n\t}\n\t%&gt;\n&lt;/style&gt;\n\t&lt;div class=&quot;overAllDiv&quot;&gt;\n\t\t&lt;div class=&quot;HeaderSectionUser&quot;&gt;\n\t\t\t&lt;p class=&quot;UserName&quot;&gt;Welcome &lt;%=get_Order_Buyer.Buyer_Name.User_Name%&gt;,&lt;/p&gt;\n\t\t\t&lt;p class=&quot;ItemsCount&quot; style=&quot;padding-right: 20px;&quot;&gt;Total Items : &lt;%=if(input.CartCount != null,input.CartCount,&quot;0&quot;)%&gt;&lt;/p&gt;\n\t\t&lt;/div&gt;\n\t\t&lt;div class=&quot;CartReportSection&quot;&gt;\n\t\t\t&lt;div elName=&apos;zc-component&apos; name=&apos;CartView&apos; viewLinkName=&apos;My_Cart_Details&apos; params=&apos;zc_Header=true&amp;zc_Footer=false&amp;zc_AddRec=false&amp;zc_MoreAction=false&amp;zc_ReportName=false&amp;zc_Search=true&amp;Order_Request=&lt;%=get_Order_Buyer.Order_ID%&gt;&apos;&gt;&lt;/div&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\tif(input.CartCount &gt; 0)\n\t{\n\t\t%&gt;\n&lt;div class=&quot;ButtonsSection&quot; style=&quot;height: 50px; justify-content: center; gap: 15px;&quot;&gt;\n\t\t\t&lt;a class=&quot;ResetBtn&quot; href=&quot;#Page:Buyer_Cart_Detail_Page?zc_LoadIn=dialog&amp;Supplier=&lt;%=input.Supplier%&gt;&amp;Cart_Delete_or_Submit=Submit&quot; style=&quot;width: 110px;&quot;&gt;Submit&lt;/a&gt;\n\t\t\t&lt;a class=&quot;ResetBtn&quot; href=&quot;#Page:Buyer_Cart_Detail_Page?zc_LoadIn=dialog&amp;Supplier=&lt;%=input.Supplier%&gt;&amp;Cart_Delete_or_Submit=Delete&quot; style=&quot;width: 110px;&quot;&gt;Reset Cart&lt;/a&gt;\n\t\t&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Buyer_Cart_Page(string Cart_Delete_or_Submit, int Category, int Supplier, int Wardrobe)
		{
					displayname = "Buyer Cart Page"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet8' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet8()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tno_Data = &quot;&quot;;\n\tget_Wardrobes = list();\n\tget_Categories = list();\n\tget_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() &amp;&amp; Status == &quot;Active&quot; &amp;&amp; User_Type == &quot;Buyer&quot;];\n\tget_Order_Buyer = Order_Request[Order_By.Email == thisapp.Dev.get_User_Email() &amp;&amp; Factory == input.Supplier &amp;&amp; Status == &quot;Pending&quot;];\n\tCartCount = (get_Order_Buyer.Order_details.ID.getall()).size();\n\tif(get_Buyer.count() &gt; 0 &amp;&amp; input.Supplier != null)\n\t{\n\t\tget_Buyer_Org = Buyers_Master[ID == get_Buyer.Associated_Buyer &amp;&amp; Status == &quot;Active&quot;];\n\t\tif(get_Buyer_Org.count() &gt; 0)\n\t\t{\n\t\t\tget_Stye_Codes = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer_Org.ID &amp;&amp; Buyer_Product_Mapping.Factory_Allocated == input.Supplier];\n\t\t\tif(get_Stye_Codes.count() &gt; 0)\n\t\t\t{\n\t\t\t\t// get Wardrobes\n\t\t\t\tget_Wardrobes = (get_Stye_Codes.Style_ID.Wardrobe.getall()).distinct();\n\t\t\t\tif(input.Wardrobe == null)\n\t\t\t\t{\n\t\t\t\t\tinput.Wardrobe = get_Wardrobes.get(0);\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tno_Data = &quot;No products are assigned to this buyer.&quot;;\n\t\t\t}\n\t\t}\n\t\telse\n\t\t{\n\t\t\tno_Data = &quot;Buyer organization not found or inactive.&quot;;\n\t\t}\n\t}\n\telse if(get_Buyer.count() &gt; 0)\n\t{\n\t\tno_Data = &quot;Please select a supplier before adding the product to your cart.&quot;;\n\t}\n\telse\n\t{\n\t\tno_Data = &quot;You do not have access to this page. Please contact your application admin.&quot;;\n\t}\n\t// \tget Category\n\tif(input.Wardrobe != null)\n\t{\n\t\tget_Wardrobe_Products = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer_Org.ID &amp;&amp; Buyer_Product_Mapping.Factory_Allocated == input.Supplier &amp;&amp; Style_ID.Wardrobe == input.Wardrobe];\n\t\tif(get_Wardrobe_Products.count() &gt; 0)\n\t\t{\n\t\t\tget_Categories = (get_Wardrobe_Products.Style_ID.Style_Category.getall()).distinct();\n\t\t\tif(input.Category == null)\n\t\t\t{\n\t\t\t\tinput.Category = get_Categories.get(0);\n\t\t\t}\n\t\t}\n\t}\n\t%&gt;\n&lt;html&gt;\n&lt;head&gt;\n\t&lt;style&gt;\n\t\t&lt;%=thisapp.Style.Cart_Page_Style()%&gt;\n\t\t\n\t\tdiv#zppagesLive, div#elementsContainer, div#row_1 {\n\t\t\theight: 100% !important;\n\t\t}\n\t\t.Layout.elemContainment {\n\t\theight: calc(100% - 16px) !important;\n\t\t}\n\t\t[pagelinkname=&quot;Buyer_Cart_Page&quot;] .Layout.elemContainment {\n\t\t\theight: calc(100% - 1.5rem);\n\t\t}\n\t\t.nav_Head {\n\t\t\tdisplay: flex;\n\t\t\tgap: 25px;\n\t\t\tjustify-content: space-between;\n\t\t\tborder-bottom: 1px solid #e8e3dc;\n\t\t}\n\t\t.cartSection {\n\t\t\theight: 42px;\n\t\t\twidth: 42px;\n\t\t\ttop: 8px;\n\t\t\tright: 24px;\n\t\t\tz-index: 99;\n\t\t}\n\t\t.cartRow {\n\t\t\tborder: 1px solid #cbcbdc;\n\t\t\tcolor: rgba(0, 0, 0, 0.7);\n\t\t\tbackground: #fff;\n\t\t\theight: 40px;\n\t\t\tposition: relative;\n\t\t\tborder-radius: 8px;\n\t\t}\n\t\t.cartCount {\n\t\t\twidth: 18px;\n\t\t\theight: 16px;\n\t\t\tpadding-top: 1px;\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\tfont-size: 10px;\n\t\t\tcolor: #fff;\n\t\t\tposition: absolute;\n\t\t\ttop: -5px;\n\t\t\tright: -5px;\n\t\t\tbackground: var(--theme_brand_color);\n\t\t\tborder-radius: 50%;\n\t\t}\n\t\t.cartIcon {\n\t\t\tdisplay: flex;\n\t\t\talign-items: center;\n\t\t\tjustify-content: center;\n\t\t\theight: 40px;\n\t\t}\n\t\t\n\t\t.prod-img-wrapper {\n\t\t\t\tbackground: #D9D9D9;\n\t\t\tborder-radius: 10px;\n\t\t}\n\t\t\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body&gt;\n\t\t&lt;div class=&quot;overAll_Div&quot;&gt;\n&lt;%\n\tif(no_Data.isEmpty())\n\t{\n\t\t%&gt;\n&lt;!-- Wardrobe Tabs --&gt;\n\t&lt;div class=&quot;nav_Head&quot;&gt;\n\t\t\t\t&lt;nav class=&quot;wardrobe-nav&quot;&gt;\n&lt;%\n\t\tfor each  war in get_Wardrobes\n\t\t{\n\t\t\tget_wardrobe = Wardrobe[ID == war];\n\t\t\t%&gt;\n&lt;a href=&quot;#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&amp;Supplier=&lt;%=input.Supplier%&gt;&amp;Wardrobe=&lt;%=get_wardrobe.ID%&gt;&quot;class=&lt;%=if(input.Wardrobe == get_wardrobe.ID,&quot;active&quot;,&quot;&quot;)%&gt;&gt;&lt;%=get_wardrobe.Wardrobe_Name%&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/nav&gt;\n\t\t&lt;a href=&quot;#Page:Buyer_Cart_Detail_Page?zc_LoadIn=dialog&amp;Supplier=&lt;%=input.Supplier%&gt;&quot; class=&quot;cartSection&quot;&gt;\n\t\t\t&lt;div class=&quot;cartRow&quot;&gt;\n\t\t\t\t&lt;div class=&quot;cartCount&quot;&gt;&lt;%=CartCount%&gt;&lt;/div&gt;\n\t\t\t\t&lt;div class=&quot;cartIcon&quot;&gt;\n\t\t\t\t\t&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; height=&quot;18px&quot; viewBox=&quot;0 -960 960 960&quot; width=&quot;18px&quot; fill=&quot;rgb(113 113 140)&quot;&gt;&lt;path d=&quot;M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z&quot;/&gt;&lt;/svg&gt;\n\t\t\t\t&lt;/div&gt;\n\t\t\t&lt;/div&gt;\t\n\t\t&lt;/a&gt;\n\t&lt;/div&gt;\n\t\t\t\t&lt;!-- Category Pills --&gt;\n\t\t\t\t&lt;div class=&quot;category-bar&quot;&gt;\n&lt;%\n\t\tfor each  cat in get_Categories\n\t\t{\n\t\t\tget_Category = Product_Category[ID == cat];\n\t\t\t%&gt;\n&lt;a href=&quot;#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&amp;Supplier=&lt;%=input.Supplier%&gt;&amp;Wardrobe=&lt;%=input.Wardrobe%&gt;&amp;Category=&lt;%=get_Category.ID%&gt;&quot; class=&quot;pill &lt;%=if(input.Category == get_Category.ID,&apos;active&apos;,&apos;&apos;)%&gt;&quot;&gt;&lt;%=get_Category.Product_Category%&gt;&lt;/a&gt;\n&lt;%\n\t\t}\n\t\t%&gt;\n&lt;/div&gt;\n\n\t\t\t\t&lt;!-- Scrollable Grid Wrapper --&gt;\n\t\t\t\t&lt;div class=&quot;grid-wrapper&quot;&gt;\n\t\t\t\t\t\t&lt;div class=&quot;product-grid&quot;&gt;\n\t\t\t\t&lt;%=thisapp.Page.Buyer_Product_List(input.Supplier,input.Wardrobe,input.Category)%&gt;\n\t\t\t\t\t\t\t &lt;!-- &lt;a href=&quot;#&quot; class=&quot;product-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;img src=&quot;https://images.unsplash.com/photo-1596755094514-f87e34085b2c?w=400&amp;q=80&quot; alt=&quot;Product&quot; /&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;product-info&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;product-name&quot;&gt;Product Name&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;product-sku&quot;&gt;1001&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;product-price&quot;&gt;Starting at : &lt;strong&gt;100.00&lt;/strong&gt;&lt;/div&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t\t\t\t\t&lt;/a&gt; --&gt;\n\t\t\t\t\n\t\t\t\t\t\t&lt;/div&gt;\n\t\t\t\t&lt;/div&gt;\n&lt;%\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div class=&quot;noData&quot;&gt;&lt;%=no_Data%&gt;&lt;/div&gt;\n&lt;%\n\t}\n\t%&gt;\n&lt;/div&gt;\n&lt;/body&gt;\n\n&lt;/html&gt;\n\t\t\t&lt;%}%&gt;\n\t\t\t\n\t\t\t]]>\n\t\t\t\t</dsp>\n\t\t\t</column>\n\t\t</row>\n\t</layout>\n</zml>"
		}

		page Buyer_Dashboard
		{
					displayname = "Buyer Dashboard"
					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='25%'>\n\t\t\t\t<panel elementName='Panel'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='0px' bgColor='#FFFFFF' action='OpenURL' url='#Report:My_Order_Requests?zc_LoadIn=embed-myOrder&amp;zc_MoreAction=false&amp;zc_AddRec=false' target='same-window' width='100%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t<pc paddingTop='17px' paddingLeft='17px' paddingRight='0px' paddingBottom='17px' bgColor='transparent' bgColorType='noFill' width='30%' hAlign='center'>\n\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#7F79F2' width='52px' height='52px' type='icon' value='shopping-receipt-list-42' size='24px' cornerRadius='26px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t<pc padding='10px' bgColor='#FFFFFF' width='70%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' value='Total Requests'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#2A70E7' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFi