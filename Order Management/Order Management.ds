					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='100%'>\n\t\t\t\t<dsp id='html_snippet151' elementName='HTML Snippet' bgColor=\"#FFFFFF\">\n\t\t\t\t\t<![CDATA[htmlpage html_snippet151()\ncontent\n\t\t\t&lt;%{%&gt;\n\t\t\t\t\t\t&lt;%\n\tuser_Data = thisapp.Page.dashboard_data(&quot;adminData&quot;);\n\t%&gt;\n&lt;html&gt;\n\n&lt;head&gt;\n\t\t&lt;style&gt;\n\t\t&lt;%=thisapp.Style.user_dashboard_style()%&gt;\n\t&lt;/style&gt;\n&lt;/head&gt;\n\n&lt;body class=&quot;procure-dashboard&quot;&gt;\n\n\t\t&lt;!-- ===== MAIN WRAPPER ===== --&gt;\n\t\t&lt;div class=&quot;page-wrapper&quot;&gt;\n\n\t\t\t\t&lt;!-- ===== MAIN CONTENT ===== --&gt;\n\t\t\t\t&lt;main class=&quot;main-content&quot;&gt;\n\n\t\t\t\t\t\t&lt;!-- ===== STAT CARDS ROW ===== --&gt;\n\t\t\t\t\t\t&lt;section class=&quot;stat-cards&quot;&gt;\n\n\t\t\t\t\t\t\t\t&lt;!-- User --&gt;\n\t\t\t\t\t\t\t\t&lt;div class=&quot;stat-card&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;stat-card__header&quot;&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;span class=&quot;stat-card__label&quot;&gt;User&lt;/span&gt;\n\t\t\t\t\t\t\t\t\t\t\t\t&lt;div class=&quot;stat-card__icon&quot;&gt;\n\t\t\t\t\t\t\t&lt;svg width=&quot;35&quot; height=&quot;35&quot; viewBox=&quot;0 0 35 35&quot; fill=&quot;none&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;\n\t\t\t\t\t\t\t&lt;path d=&quot;M18.75 17.75C21.1662 17.75 23.125 15.7912 23.125 13.375C23.125 10.9588 21.1662 9 18.75 9C16.3338 9 14.375 10.9588 14.375 13.375C14.375 15.7912 16.3338 17.75 18.75 17.75Z&quot; fill=&quot;#EEDAFF&quot;/&gt;\n\t\t\t\t\t\t\t&lt;path d=&quot;M27.5 25.7702C27.5 25.9623 27.4993 26.1513 27.4978 26.3373C27.4756 29.173 25.75 30.8743 18.75 30.8743C10 30.8743 10 28.5888 10 25.7702C10 22.9515 13.9178 20.666 18.75 20.666C23.5822 20.666 27.5 22.9515 27.5 25.7702Z&quot; fill=&quot;#EEDAFF&quot;