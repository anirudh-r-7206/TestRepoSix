			string References.Product(int productID)
			{
			
			                 	fetProduct = Add_Product[ID == productID];
			                 	// ─── Fetch references with meaningful display fields ───
			                 	refMap = Map();
			                 	// Add Product — display: Product_Custom_Display
			                 	rec1 = Buyer_Products[Style_Name == productID];
			                 	if(rec1 != null && rec1.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r1 in rec1
			                 		{
			                 			val = if(r1.Product_ID != null && r1.Product_ID.toString() != "",r1.Product_ID.toString(),"Unnamed Buyer Products");
