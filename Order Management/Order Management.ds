			Auto_Fill_Buyer as "Auto Fill Buyer"
			{
			
							type =  form
							form = Order_Request
			
							record event = on add
			
							on user input of Buyer_Organisation
							{
								actions 
								{
									custom deluge script
									(
														if(input.Buyer_Organisation != null && input.Purchase_Order == null)
													{
														get_Buyers = Create_User[Associated_Buyer == input.Buyer_Organisation && Status == "Active" && Persona_Role == "Buyer"];
														input.Buyer_Name:ui.add(get_Buyers.ID.getall());
														get_factory = Buyer_Product_Mapping[Buyer == input.Buyer_Organisation && Factory_Allocated.Status == "Active"].Factory_Allocated.getAll();
														input.Factory:ui.add(get_factory);
														fetch_Buyer = Create_User[Email == zoho.loginuserid && Status == "Active" && Persona_Role == "Buyer"];
														if(fetch_Buyer.count(ID) > 0)
														{
															input.Buyer_Name = fetch_Buyer.ID;
														}
													}
									)
								}
							}
			
						
			}

			Autopopulate_subform_valu as "Autopopulate subform values"
			{
			
							type =  form
							form = Order_Request
			
							record event = on add or edit
			
							on user input of Order_details.Product
							{
								actions 
								{
									custom deluge script
									(
														disable row.Product;
													if(row.Product != null)
													{
														row.Product_Color=row.Product.Style_Colour;
														row.Product_Size=row.Product.Size_Set;
														row.Description=row.Product.Product_Description;
														//
														row.Sub_Total=null;
														if(row.Quantity > 0)
														{
															if(input.Factory != null)
															{
																get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
															}
															else
															{
																get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product];
															}
															row.Sub_Total=get_product_Price.Sell_Price * row.Quantity;
														}
													}
													else
													{
														row.Product_Color=null;
														row.Product_Size=null;
														row.Description=null;
														row.Sub_Total=null;
													}
													input.Cart_Total = input.Order_details.sum(Sub_Total);
													// 
													if(input.Factory != null)
													{
														get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
													}
													else
													{
														get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation];
													}
													get_All_product = get_Product.Style_ID.getall();
													get_All_product.removeAll(input.Order_details.Product.getall());
													for each  order in input.Order_details
													{
														old_Product = order.Product;
														add_sub_Product = get_All_product;
														add_sub_Product.add(old_Product);
														order.Product:ui.add(add_sub_Product);
														order.Product=old_Product;
													}
									)
								}
							}
			
						
			}

			Calculate_sub_total_and_c as "Calculate sub total and cart total"
			{
			
							type =  form
							form = Order_Request
			
							record event = on add or edit
			
							on user input of Order_details.Quantity
							{
								actions 
								{
									custom deluge script
									(
														row.Sub_Total=null;
													if(row.Quantity <= 0)
													{
														alert "Quantity must be greater than 0.";
														row.Quantity=null;
													}
													else if(row.Product != null && row.Quantity > 0)
													{
														if(input.Factory != null)
														{
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
														}
														else
														{
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product];
														}
														row.Sub_Total=if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0) * row.Quantity;
													}
													input.Cart_Total = input.Order_details.sum(Sub_Total);
									)
								}
							}
			
						
			}

			Check_Buyer_or_Factory2 as "Check Buyer or Factory"
			{
			
							type =  form
							form = Order_Request
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Purchase_Order != null)
													{
														disable Buyer_Organisation;
														disable Buyer_Name;
														disable Factory;
														// 	
														input.Buyer_Organisation = input.Purchase_Order.Buyer_Organisation;
														input.Buyer_Name = input.Purchase_Order.Customer_Name;
														input.Factory = input.Purchase_Order.Supplier;
														get_PO = Purchase_LineItems[Purchase_Order == input.Purchase_Order];
														for each  items in get_PO
														{
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == items.Product && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
															map_Item = Order_Request.Order_details();
															map_Item.Product=items.Product;
															map_Item.Product_Color=items.Product_Color;
															map_Item.Product_Size=items.Product_Size;
															map_Item.Description=items.Description;
															map_Item.Quantity=items.Quantity;
															map_Item.Sub_Total=if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,items.Selling_Price) * items.Quantity;
															input.Order_details.insert(map_Item);
														}
														input.Cart_Total = input.Order_details.sum(Sub_Total);
													}
													else
													{
														// Fetch Buyer Details
														get_Buyer = Create_User[Status == "Active"].Associated_Buyer.getAll().distinct();
														input.Buyer_Organisation:ui.add(get_Buyer);
														clear Buyer_Name;
														clear Factory;
														fetch_Buyer = Create_User[Email == zoho.loginuserid && Status == "Active" && Persona_Role == "Buyer"];
														get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
														if(fetch_Buyer.count(ID) > 0)
														{
															input.Buyer_Organisation = fetch_Buyer.Associated_Buyer;
															disable Buyer_Organisation;
															disable Buyer_Name;
														}
														else if(get_User.count(ID) <= 0)
														{
															openUrl("#Page:Alert_Message?Message_Type=Buyer_Page","popup window");
														}
													}
									)
								}
							}
			
						
			}

