\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc padding='5px' hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' borderColor='#333333' borderWidth='0px' value='Pending Approvals'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t\t<pr>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#2A70E7' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' criteria='Status == &quot;Awaiting QO Generation&quot;' value='thisapp.Order_Request.ID.count'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t</pc>\n\t\t\t\t\t</pr>\n</panel>\n\t\t\t</column>\n\t\t\t<column width='25%'>\n\t\t\t\t<panel elementName='Panel 2'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='0px' bgColor='#FFFFFF' action='OpenReport' parameters='zc_MoreAction=false&amp;zc_AddRec=false&amp;Order_Status=Cancelled' componentLinkName='All_Purchase_Orders' target='popup' popupWidth='80%' popupHeight='80%' width='100%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t<pc paddingTop='17px' paddingLeft='17px' paddingRight='0px' paddingBottom='17px' bgColor='transparent' bgColorType='noFill' width='30%' hAlign='center'>\n\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='