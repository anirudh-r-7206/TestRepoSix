			void OneTime.Update_Fabric_Composition_to_PO()
			{
			
			                 	try 
			                 	{
			                 		for each  PO_Items in Purchase_LineItems[Purchase_Order != null && Fabric_Composition.isEmpty()]
			                 		{
			                 			get_PO_Item = Purchase_LineItems[ID == PO_Items.ID];
			                 			get_Fabric = Fabric_Form[ID == get_PO_Item.Product.Fabric_Code];
			                 			get_PO_Item.Fabric_Composition=if(get_Fabric.count(ID) > 0,get_Fabric.Fabric_Composition,"");
			                 		}
			                 	}
			                 	catch (e)
			                 	{
			                 		sendmail
			                 		[
			                 			from :zoho.adminuserid
			                 			to :"dylfa.d+zcjscom@zohotest.com"
			                 			subject :"Error - `OneTime.Update_HS_Code_to_PO` function."
			                 			message :e
			                 		]
			                 	}
			                 
			}

			void OneTime.Update_HS_Code_to_PO()
			{
			
			                 	try 
			                 	{
			                 		for each  PO_Items in Purchase_LineItems[Purchase_Order != null && HS_Code.isEmpty()]
			                 		{
			                 			get_PO_Item = Purchase_LineItems[ID == PO_Items.ID];
			                 			get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == PO_Items.Purchase_Order.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == PO_Items.Purchase_Order.Supplier && Style_ID == PO_Items.Product];
			                 			get_PO_Item.HS_Code=if(get_Buyer_Product.count(ID) > 0,get_Buyer_Product.HS_Code,"");
			                 			info get_Buyer_Product;
			                 		}
			                 	}
			                 	catch (e)
			                 	{
			                 		sendmail
			                 		[
			                 			from :zoho.adminuserid
			                 			to :"dylfa.d+zcjscom@zohotest.com"
			                 			subject :"Error - `OneTime.Update_HS_Code_to_PO` function."
			                 			message :e
			                 		]
			                 	}
			                 
			}

			void OneTime.Update_PO_Address()
			{
			
			                 	get_POs = Purchase_Order[Factory_Address != null || Delivery_Address != null];
			                 	for each  po in get_POs
			                 	{
			                 		get_PO = Purchase_Order[ID == po.ID];
			                 		// 		Factory Address
			                 		get_PO.Factory_Address1.address_line_1=po.Factory_Address.Factory_Address.address_line_1;
			                 		get_PO.Factory_Address1.address_line_2=po.Factory_Address.Factory_Address.address_line_2;
			                 		get_PO.Factory_Address1.district_city=po.Factory_Address.Factory_Address.district_city;
			                 		get_PO.Factory_Address1.state_province=po.Factory_Address.Factory_Address.state_province;
			                 		get_PO.Factory_Address1.postal_Code=po.Factory_Address.Factory_Address.postal_Code;
			                 		get_PO.Factory_Address1.country=po.Factory_Address.Factory_Address.country;
			                 		// Delivery Address
			                 		get_PO.Delivery_Address1.address_line_1=po.Delivery_Address.Address.address_line_1;
			                 		get_PO.Delivery_Address1.address_line_2=po.Delivery_Address.Address.address_line_2;
			                 		get_PO.Delivery_Address1.district_city=po.Delivery_Address.Address.district_city;
			                 		get_PO.Delivery_Address1.state_province=po.Delivery_Address.Address.state_province;
			                 		get_PO.Delivery_Address1.postal_Code=po.Delivery_Address.Address.postal_Code;
			                 		get_PO.Delivery_Address1.country=po.Delivery_Address.Address.country;
			                 	}
			                 
			}

			void OneTime.Update_PO_Buyer_Name()
			{
			
			                 	fetPO = Purchase_Order[ID != 0];
			                 	for each  po in fetPO
			                 	{
			                 		get_PO = Purchase_Order[ID == po.ID];
			                 		fetBuyer = Buyer_Contact_Person_Details[Buyers_Master == get_PO.Buyer_Organisation] sort by Added_Time desc;
			                 		get_PO.Buyer_Contact_Person=if(fetBuyer.Contact_Person1.first_name.isEmpty(),"",fetBuyer.Contact_Person1.first_name) + if(fetBuyer.Contact_Person1.last_name.isEmpty(),""," " + fetBuyer.Contact_Person1.last_name);
			                 	}
			                 
			}

