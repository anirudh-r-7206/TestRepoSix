			string References.Color(int colorID)
			{
			
			                 	fetColor = Add_Colors[ID == colorID];
			                 	// ─── Fetch references with meaningful display fields ───
			                 	refMap = Map();
			                 	// Add Product — display: Product_Custom_Display
			                 	rec1 = Add_Product[Style_Colour == colorID];
			                 	if(rec1 != null && rec1.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r1 in rec1
			                 		{
			                 			val = if(r1.Product_Custom_Display != null && r1.Product_Custom_Display.toString() != "",r1.Product_Custom_Display.toString(),"Unnamed Product");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Add Product",displayList.distinct());
			                 	}
			                 	// Buyer Products — display: Product_ID
			                 	rec2 = Buyer_Products[Colors == colorID];
			                 	if(rec2 != null && rec2.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r2 in rec2
			                 		{
			                 			val = if(r2.Product_ID != null && r2.Product_ID.toString() != "",r2.Product_ID.toString(),"Unnamed Product");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyer Products",displayList.distinct());
			                 	}
			                 	// Order Details — display: Order_Request.Order_ID (lookup traversal)
			                 	rec3 = Order_Details[Product_Color == colorID];
			                 	if(rec3 != null && rec3.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r3 in rec3
			                 		{
			                 			val = if(r3.Order_Request != null && r3.Order_Request.Order_ID != null && r3.Order_Request.Order_ID.toString() != "",r3.Order_Request.Order_ID.toString(),"Unnamed Order");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Order Details",displayList.distinct());
			                 	}
			                 	// Purchase Line Items — display: Purchase_Order.PO_Number (lookup traversal)
			                 	rec4 = Purchase_LineItems[Product_Color == colorID];
			                 	if(rec4 != null && rec4.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r4 in rec4
			                 		{
			                 			val = if(r4.Purchase_Order != null && r4.Purchase_Order.PO_Number != null && r4.Purchase_Order.PO_Number.toString() != "",r4.Purchase_Order.PO_Number.toString(),"Unnamed PO");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Purchase Line Items",displayList.distinct());
			                 	}
			                 	// Size Chart Mapping — display: Size_Name
			                 	rec5 = Style[Product_Colour == colorID];
			                 	if(rec5 != null && rec5.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r5 in rec5
			                 		{
			                 			val = if(r5.Style_Code != null && r5.Style_Code.toString() != "",r5.Style_Code.toString(),"Unnamed Size Chart");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Style",displayList.distinct());
			                 	}
			                 	// 
			                 	rec6 = Fabric_Form[Colour_Code == colorID];
			                 	if(rec6 != null && rec6.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r6 in rec6
			                 		{
			                 			val = if(r6.Fabric_Code != null && r6.Fabric_Code.toString() != "",r6.Fabric_Code.toString(),"Unnamed Size Chart");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Fabric",displayList.distinct());
			                 	}
			                 	// ─── Empty state ───
			                 	if(refMap.size() == 0)
			                 	{
			                 		return '';
			                 	}
			                 	// ─── Build module cards ───
			                 	moduleCards = '';
			                 	for each  key in refMap.keys()
			                 	{
			                 		displayValues = refMap.get(key);
			                 		itemCount = displayValues.size();
			                 		// Build chips from display values
			                 		chips = '';
			                 		for each  val in displayValues
			                 		{
			                 			chips = chips + '<span class="sr_chip">' + val + '</span>';
			                 		}
			                 		moduleCards = (moduleCards + '<div class="sr_card"> <div class="sr_card_header"> <span class="sr_card_title">' + key + '</span> <span class="sr_badge">') + itemCount.toString() + ' record' + if(itemCount > 1,'s','') + '</span> </div> <div class="sr_card_body">' + chips + '</div> </div>';
			                 	}
			                 	// ─── Totals ───
			                 	totalModules = refMap.size();
			                 	totalRecords = 0;
			                 	for each  key in refMap.keys()
			                 	{
			                 		totalRecords = totalRecords + refMap.get(key).size();
			                 	}
			                 	// ─── Final HTML ───
			                 	html = '<style> .sr_wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: 16px; background: #fff; } .sr_alert { background: #fff8f0; border: 1px solid #f97316; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; } .sr_alert_title { font-size: 14px; font-weight: 700; color: #c2410c; margin-bottom: 4px; } .sr_alert_sub { font-size: 12px; color: #9a3412; line-height: 1.5; } .sr_alert_meta { display: inline-block; background: #ffedd5; color: #9a3412; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fdba74; margin-top: 8px; margin-right: 6px; } .sr_section_title { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px; } .sr_card { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; } .sr_card_header { padding: 10px 14px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; overflow: hidden; } .sr_card_title { font-size: 13px; font-weight: 600; color: #1e293b; float: left; } .sr_badge { float: right; background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fde68a; } .sr_card_body { padding: 10px 14px; } .sr_chip { display: inline-block; background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; border: 1px solid #bfdbfe; margin-right: 6px; margin-bottom: 6px; } .sr_empty { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-align: center; padding: 40px 20px; } .sr_empty_icon { font-size: 36px; color: #22c55e; margin-bottom: 10px; } .sr_empty_title { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 6px; } .sr_empty_sub { font-size: 12px; color: #64748b; } </style> <div class="sr_wrapper"> <div class="sr_alert"> <div class="sr_alert_title">⚠ Color (<b>' + fetColor.Color_Name + '</b>) — cannot be deactivated, edited, or deleted</div> <div class="sr_alert_sub">Remove all references listed below before making any changes.</div> <div> <span class="sr_alert_meta">' + totalModules.toString() + ' Module' + if(totalModules > 1,'s','') + '</span><span class="sr_alert_meta">' + totalRecords.toString() + ' Record' + if(totalRecords > 1,'s','') + '</span> </div> </div> <div class="sr_section_title">Referenced In</div> ' + moduleCards + ' </div>';
			                 	return html;
			                 
			}

			void OneTime.CommentUpdate()
			{
			
			                 	fetPO = Purchase_Order[Comments == null || Comments == ""];
			                 	for each  po in fetPO
			                 	{
			                 		po.Comments=po.Comments11;
			                 	}
			                 
			}

			string References.Country(int countryId)
			{
			
			                 	fetchCountry = Add_Country[ID == countryId];
			                 	// ─── Fetch references with meaningful display fields ───
			                 	refMap = Map();
			                 	// Add Product — display: Product_Custom_Display
			                 	rec1 = Add_Suppliers[Country == countryId];
			                 	if(rec1 != null && rec1.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r1 in rec1
			                 		{
			                 			val = if(r1.Supplier_Organisation != null && r1.Supplier_Organisation.toString() != "",r1.Supplier_Organisation.toString(),"Unnamed Supplier");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Add Suppliers",displayList.distinct());
			                 	}
			                 	// Buyer Products — display: Product_ID
			                 	rec2 = Buyers_Master[Country == countryId];
			                 	if(rec2 != null && rec2.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r2 in rec2
			                 		{
			                 			val = if(r2.Buyer_Organisation != null && r2.Buyer_Organisation.toString() != "",r2.Buyer_Organisation.toString(),"Unnamed Buyer");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyers Master",displayList.distinct());
			                 	}
			                 	// Order Details — display: Order_Request.Order_ID (lookup traversal)
			                 	rec3 = Fabric_Form[Country_of_Origin == countryId];
			                 	if(rec3 != null && rec3.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r3 in rec3
			                 		{
			                 			val = if(r3.Fabric_Code != null && r3.Fabric_Code.toString() != "",r3.Fabric_Code.toString(),"Unnamed Fabric");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Fabric Form",displayList.distinct());
			                 	}
			                 	// Purchase Line Items — display: Purchase_Order.PO_Number (lookup traversal)
			                 	rec4 = Purchase_Order[Country == countryId];
			                 	if(rec4 != null && rec4.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r4 in rec4
			                 		{
			                 			val = if(r4.PO_Number != null && r4.PO_Number.toString() != "",r4.PO_Number.toString(),"Unnamed PO");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Purchase Order",displayList.distinct());
			                 	}
			                 	// Size Chart Mapping — display: Size_Name
			                 	// 	rec5 = Size_Chart_Mapping[Region_New == countryId];
			                 	// 	if(rec5 != null && rec5.count() > 0)
			                 	// 	{
			                 	// 		displayList = List();
			                 	// 		for each  r5 in rec5
			                 	// 		{
			                 	// 			val = if(r5.Size_Name != null && r5.Size_Name.toString() != "",r5.Size_Name.toString(),"Unnamed Size Chart");
			                 	// 			displayList.add(val);
			                 	// 		}
			                 	// 		refMap.put("Size Chart Mapping",displayList.distinct());
			                 	// 	}
			                 	// Factory Details Subform — display: Factory Details
			                 	rec6 = Factory_Details_Subform[Factory_Country == countryId];
			                 	if(rec6 != null && rec6.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r6 in rec6
			                 		{
			                 			val = if(r6.Factory_Name != null && r6.Factory_Name.toString() != "",r6.Factory_Name.toString(),"Unnamed Factory");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Factory Details",displayList.distinct());
			                 	}
			                 	// Buyer Details Subform — display: Buyer Details
			                 	rec7 = Buyer_Contact_Person_Details[Country == countryId];
			                 	if(rec7 != null && rec7.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r7 in rec7
			                 		{
			                 			val = if(r7.Contact_Person1 != null && r7.Contact_Person1.toString() != "",r7.Contact_Person1.toString(),"Unnamed Contact");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyer Details",displayList.distinct());
			                 	}
			                 	// ─── Empty state ───
			                 	if(refMap.size() == 0)
			                 	{
			                 		return '';
			                 	}
			                 	// ─── Build module cards ───
			                 	moduleCards = '';
			                 	for each  key in refMap.keys()
			                 	{
			                 		displayValues = refMap.get(key);
			                 		itemCount = displayValues.size();
			                 		// Build chips from display values
			                 		chips = '';
			                 		for each  val in displayValues
			                 		{
			                 			chips = chips + '<span class="sr_chip">' + val + '</span>';
			                 		}
			                 		moduleCards = (moduleCards + '<div class="sr_card"> <div class="sr_card_header"> <span class="sr_card_title">' + key + '</span> <span class="sr_badge">') + itemCount.toString() + ' record' + if(itemCount > 1,'s','') + '</span> </div> <div class="sr_card_body">' + chips + '</div> </div>';
			                 	}
			                 	// ─── Totals ───
			                 	totalModules = refMap.size();
			                 	totalRecords = 0;
			                 	for each  key in refMap.keys()
			                 	{
			                 		totalRecords = totalRecords + refMap.get(key).size();
			                 	}
			                 	// ─── Final HTML ───
			                 	html = '<style> .sr_wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: 16px; background: #fff; } .sr_alert { background: #fff8f0; border: 1px solid #f97316; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; } .sr_alert_title { font-size: 14px; font-weight: 700; color: #c2410c; margin-bottom: 4px; } .sr_alert_sub { font-size: 12px; color: #9a3412; line-height: 1.5; } .sr_alert_meta { display: inline-block; background: #ffedd5; color: #9a3412; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fdba74; margin-top: 8px; margin-right: 6px; } .sr_section_title { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px; } .sr_card { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; } .sr_card_header { padding: 10px 14px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; overflow: hidden; } .sr_card_title { font-size: 13px; font-weight: 600; color: #1e293b; float: left; } .sr_badge { float: right; background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fde68a; } .sr_card_body { padding: 10px 14px; } .sr_chip { display: inline-block; background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; border: 1px solid #bfdbfe; margin-right: 6px; margin-bottom: 6px; } .sr_empty { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-align: center; padding: 40px 20px; } .sr_empty_icon { font-size: 36px; color: #22c55e; margin-bottom: 10px; } .sr_empty_title { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 6px; } .sr_empty_sub { font-size: 12px; color: #64748b; } </style> <div class="sr_wrapper"> <div class="sr_alert"> <div class="sr_alert_title">⚠ Country (<b>' + fetchCountry.Country_Name + '</b>) — cannot be edited, deactivated, or deleted</div> <div class="sr_alert_sub">Remove all references listed below before making any changes.</div> <div> <span class="sr_alert_meta">' + totalModules.toString() + ' Module' + if(totalModules > 1,'s','') + '</span><span class="sr_alert_meta">' + totalRecords.toString() + ' Record' + if(totalRecords > 1,'s','') + '</span> </div> </div> <div class="sr_section_title">Referenced In</div> ' + moduleCards + ' </div>';
			                 	return html;
			                 
			}

			string References.Currency(int currencyId)
			{
			
			                 	fetCurrency = Currency[ID == currencyId];
			                 	// ─── Fetch references with meaningful display fields ───
			                 	refMap = Map();
			                 	// Buyer Products — display: Product_ID
			                 	rec1 = Buyers_Master[Currency == currencyId];
			                 	if(rec1 != null && rec1.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r1 in rec1
			                 		{
			                 			val = if(r1.Buyer_Organisation != null && r1.Buyer_Organisation.toString() != "",r1.Buyer_Organisation.toString(),"Unnamed Buyer");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyers Master",displayList.distinct());
			                 	}
			                 	// Purchase Line Items — display: Purchase_Order.PO_Number (lookup traversal)
			                 	rec2 = Purchase_Order[Purchase_Currency == currencyId || Selling_Currency == currencyId];
			                 	if(rec2 != null && rec2.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r2 in rec2
			                 		{
			                 			val = if(r2.PO_Number != null && r2.PO_Number.toString() != "",r2.PO_Number.toString(),"Unnamed PO");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Purchase Order",displayList.distinct());
			                 	}
			                 	// Factory Details Subform — display: Buyer Details
			                 	rec3 = Buyer_Product_Mapping[Buy_Currency == currencyId || Sell_Currency == currencyId];
			                 	if(rec3 != null && rec3.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r3 in rec3
			                 		{
			                 			val = if(r3.Buyer != null && r3.Factory_Allocated != null && r3.Buyer.Buyer_Organisation.toString() != "" && r3.Factory_Allocated.Supplier_Organisation.toString() != "",r3.Buyer.Buyer_Organisation.toString() + " - " + r3.Factory_Allocated.Supplier_Organisation,"Unnamed Product Mapping");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyer Product Mapping",displayList.distinct());
			                 	}
			                 	// ─── Empty state ───
			                 	if(refMap.size() == 0)
			                 	{
			                 		return '';
			                 	}
			                 	// ─── Build module cards ───
			                 	moduleCards = '';
			                 	for each  key in refMap.keys()
			                 	{
			                 		displayValues = refMap.get(key);
			                 		itemCount = displayValues.size();
			                 		// Build chips from display values
			                 		chips = '';
			                 		for each  val in displayValues
			                 		{
			                 			chips = chips + '<span class="sr_chip">' + val + '</span>';
			                 		}
			                 		moduleCards = (moduleCards + '<div class="sr_card"> <div class="sr_card_header"> <span class="sr_card_title">' + key + '</span> <span class="sr_badge">') + itemCount.toString() + ' record' + if(itemCount > 1,'s','') + '</span> </div> <div class="sr_card_body">' + chips + '</div> </div>';
			                 	}
			                 	// ─── Totals ───
			                 	totalModules = refMap.size();
			                 	totalRecords = 0;
			                 	for each  key in refMap.keys()
			                 	{
			                 		totalRecords = totalRecords + refMap.get(key).size();
			                 	}
			                 	// ─── Final HTML ───
			                 	html = '<style> .sr_wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: 16px; background: #fff; } .sr_alert { background: #fff8f0; border: 1px solid #f97316; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; } .sr_alert_title { font-size: 14px; font-weight: 700; color: #c2410c; margin-bottom: 4px; } .sr_alert_sub { font-size: 12px; color: #9a3412; line-height: 1.5; } .sr_alert_meta { display: inline-block; background: #ffedd5; color: #9a3412; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fdba74; margin-top: 8px; margin-right: 6px; } .sr_section_title { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px; } .sr_card { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; } .sr_card_header { padding: 10px 14px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; overflow: hidden; } .sr_card_title { font-size: 13px; font-weight: 600; color: #1e293b; float: left; } .sr_badge { float: right; background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fde68a; } .sr_card_body { padding: 10px 14px; } .sr_chip { display: inline-block; background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; border: 1px solid #bfdbfe; margin-right: 6px; margin-bottom: 6px; } .sr_empty { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-align: center; padding: 40px 20px; } .sr_empty_icon { font-size: 36px; color: #22c55e; margin-bottom: 10px; } .sr_empty_title { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 6px; } .sr_empty_sub { font-size: 12px; color: #64748b; } </style> <div class="sr_wrapper"> <div class="sr_alert"> <div class="sr_alert_title">⚠ Currency (<b>' + fetCurrency.Currency_Name + '</b>) — cannot be edited or deleted</div> <div class="sr_alert_sub">Remove all references listed below before making any changes.</div> <div> <span class="sr_alert_meta">' + totalModules.toString() + ' Module' + if(totalModules > 1,'s','') + '</span><span class="sr_alert_meta">' + totalRecords.toString() + ' Record' + if(totalRecords > 1,'s','') + '</span> </div> </div> <div class="sr_section_title">Referenced In</div> ' + moduleCards + ' </div>';
			                 	return html;
			                 
			}

			list Deactivate_Records.Deactivate_Buyer()
			{
			
			                 	Buyers_List = List();
			                 	get_From_User = Create_User[Status == "Active"];
			                 	Buyers_List.addAll(get_From_User.Associated_Buyer.getall());
			                 	return Buyers_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_Color()
			{
			
			                 	color_List = List();
			                 	get_Prpduct_Colors = Add_Product[Status == "Approved"];
			                 	color_List.addAll(get_Prpduct_Colors.Style_Colour.getall());
			                 	get_Fabric_Color = Fabric_Form[Status in {"Pending","Active"}];
			                 	color_List.addAll(get_Fabric_Color.Colour_Code.getall());
			                 	return color_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_Country()
			{
			
			                 	country_List = List();
			                 	get_Supplier_Countries = Add_Suppliers[ID != 0 && Status == "Active"];
			                 	country_List.addAll(get_Supplier_Countries.Country.getall());
			                 	get_SizeChart_Countries = Size_Chart_Mapping[ID != 0];
			                 	country_List.addAll(get_SizeChart_Countries.Region_New.getall());
			                 	get_Buyer_Countries = Buyers_Master[ID != 0 && Status == "Active"];
			                 	country_List.addAll(get_Buyer_Countries.Country.getall());
			                 	get_PO_Countries = Purchase_Order[ID != 0 && Order_Status not in {"Awaiting Production","In Production","Completed"}];
			                 	country_List.addAll(get_PO_Countries.Country.getall());
			                 	return country_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_Fabric()
			{
			
			                 	Fabric_List = List();
			                 	get_Fabric = Add_Product[Status == "Approved"];
			                 	Fabric_List.addAll(get_Fabric.Fabric_Code.getall());
			                 	return Fabric_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_Product_Category()
			{
			
			                 	Category_List = List();
			                 	get_Size_Category = Create_Size[Status == "Active"];
			                 	Category_List.addAll(get_Size_Category.Product_Category.getall());
			                 	get_Product_Category = Add_Product[Status == "Approved"];
			                 	Category_List.addAll(get_Product_Category.Style_Category.getall());
			                 	return Category_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_Size()
			{
			
			                 	size_List = List();
			                 	get_Product_Size = Add_Product[Status == "Approved"];
			                 	size_List.addAll(get_Product_Size.Size_Set.getall());
			                 	get_Order_Size = Order_Details[Order_Request.Status in {"Pending","Awaiting Supplier Selection","Awaiting QO Generation"}];
			                 	size_List.addAll(get_Order_Size.Product_Size.getall());
			                 	get_Purchase_Size = Purchase_LineItems[Purchase_Order.Order_Status not in {"Completed","In Production","Awaiting Production"}];
			                 	size_List.addAll(get_Purchase_Size.Product_Size.getall());
			                 	return size_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_Suppliers()
			{
			
			                 	Supplier_List = List();
			                 	get_User_Suppliers = Create_User[Status == "Active"];
			                 	Supplier_List.addAll(get_User_Suppliers.Associated_Factory.getall());
			                 	get_Buyer_Suppliers = Buyer_Product_Mapping[Buyer.Status == "Active"];
			                 	Supplier_List.addAll(get_Buyer_Suppliers.Factory_Allocated.getall());
			                 	return Supplier_List.distinct();
			                 
			}

			list Deactivate_Records.Deactivate_User()
			{
			
			                 	Users_List = List();
			                 	get_From_Order_Request = Order_Request[Status not in {"Completed","Cancelled"}];
			                 	Users_List.addAll(get_From_Order_Request.Buyer_Name.getall());
			                 	get_From_PO = Purchase_Order[Order_Status not in {"Completed","Cancelled"}];
			                 	Users_List.addAll(get_From_PO.Customer_Name.getall());
			                 	Users_List.addAll(get_From_PO.Supplier_old.getall());
			                 	return Users_List.distinct();
			                 
			}

