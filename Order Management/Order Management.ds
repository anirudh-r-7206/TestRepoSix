					Content="<zml webDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>\n\t<layout>\n\t\t<row>\n\t\t\t<column width='25%'>\n\t\t\t\t<panel elementName='Panel'>\n\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t<pc padding='0px' bgColor='#FFFFFF' action='OpenReport' componentLinkName='SSA_and_Admin_Users' target='popup' popupWidth='80%' popupHeight='80%' width='100%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t<pc paddingTop='17px' paddingLeft='17px' paddingRight='0px' paddingBottom='17px' bgColor='transparent' bgColorType='noFill' width='28%' hAlign='center'>\n\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t<pc>\n\t\t\t\t\t\t\t\t\t\t\t<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#7F79F2' width='52px' height='52px' type='icon' value='users-man-23' size='24px' cornerRadius='26px' iconType='outline' /> </pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t<pc padding='0px' bgColor='#FFFFFF' width='72%' hAlign='center' vAlign='middle'>\n\t\t\t\t\t\t\t\t\t<pr width='fill' height='42px'>\n\t\t\t\t\t\t\t\t\t\t<pc padding='17px' bgColor='transparent' bgColorType='noFill' borderColor='#222326' borderWidth='0px' width='100%' hAlign='center' vAlign='middle' cornerRadius='0px'>\n\t\t\t\t\t\t\t\t\t\t\t<pr width='auto' height='auto'>\n\t\t\t\t\t\t\t\t\t\t\t\t<pc hAlign='left'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' value='Users'>\n\t\t\t\t\t\t\t\t\t\t\t\t\t</text>\n\n\t\t\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t\t</pc>\n\t\t\t\t\t\t\t\t\t</pr>\n\t\t\t\t\t\t\t\t\t<pr width='fill' height='fill'>\n\t\t\t\t\t\t\t\t\t\t<pc paddingTop='0px' paddingLeft='17px' paddingRig