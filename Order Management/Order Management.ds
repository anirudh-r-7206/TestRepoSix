														size.Region=oldRegion;
													}
									)
								}
							}
			
						
			}

			Update_Size_Order as "Update Size Order"
			{
			
							type =  form
							form = Create_Size
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														get_Size_Order = Create_Size[ID != input.ID && Gender == input.Gender && Size_Order == input.Size_Order];
													if(get_Size_Order.count() > 0)
													{
														for each  oder in Create_Size[ID != input.ID && Gender == input.Gender && Size_Order >= input.Size_Order]
														{
															oder.Size_Order=oder.Size_Order + 1;
														}
													}
													input.Product_Category1 = input.Product_Category;
									)
								}
							}
			
						
			}

			Valid_status_changes4 as "Valid status changes"
			{
			
							type =  form
							form = Create_Size
			
							record event = on edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														if(input.Status != old.Status)
													{
														alert "Status cannot be changed.";
														cancel submit;
													}
													get_Removed_Category = old.Product_Category;
													get_Removed_Category.removeAll(input.Product_Category);
													mapped_Category = list();
													cat_Name = "";
													if(get_Removed_Category.size() > 0)
													{
														cat_Name = cat_Name + "[";
														for each  cat in get_Removed_Category
														{
															get_Product = Add_Product[Style_Category == cat && Size_Set == input.ID];
															if(get_Product.count() > 0)
															{
																mapped_Category.add(cat);
																cat_Name = cat_Name + Product_Category[ID == cat].Product_Category + ",";
															}
														}
														cat_Name_List = cat_Name.removeLastOccurence(",") + "]";
													}
													if(mapped_Category.size() > 0)
													{
														alert "The following categories are already used by products and cannot be removed: " + cat_Name_List + ". Please keep them selected.";
														cancel submit;
													}
									)
								}
							}
			
						
			}

			Validate_Product_category as "Validate Product category"
			{
			
							type =  form
							form = Create_Size
			
							record event = on edit
			
							on user input of Product_Category
							{
								actions 
								{
									custom deluge script
									(
														get_Removed_Category = input.Product_Category1;
													get_Removed_Category.removeAll(input.Product_Category);
													mapped_Category = list();
													cat_Name = "";
													OldProList = List();
													OldProList.addAll(input.Product_Category);
													if(get_Removed_Category.size() > 0)
													{
														cat_Name = cat_Name + "[";
														for each  cat in get_Removed_Category
														{
															get_Product = Add_Product[Style_Category == cat && Size_Set == input.ID];
															if(get_Product.count() > 0)
															{
																mapped_Category.add(cat);
																cat_Name = cat_Name + Product_Category[ID == cat].Product_Category + ",";
																OldProList.add(cat);
															}
														}
														cat_Name_List = cat_Name.removeLastOccurence(",") + "]";
													}
													if(mapped_Category.size() > 0)
													{
														alert "The following categories are already used by products and cannot be removed: " + cat_Name_List + ". Please keep them selected.";
														input.Product_Category = OldProList;
													}
									)
								}
							}
			
						
			}

			Admin_Auto_Approve as "Admin Auto Approve"
			{
			
							type =  form
							form = Create_User
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Persona_Role == "Administrator")
													{
														input.Status = "Active";
														input.Approval_Status = "Approved";
