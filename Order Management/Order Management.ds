			Validate_Wardrobe1 as "Validate Wardrobe"
			{
			
							type =  form
							form = Buyers_Master
			
							record event = on edit
			
							on user input of Wardrobe
							{
								actions 
								{
									custom deluge script
									(
														get_Removed_Wardrobe = input.Wardrobe1;
													get_Removed_Wardrobe.removeAll(input.Wardrobe);
													mapped_Wardrobe = list();
													wardrobe_Name = "";
													wardrobe_ID = List();
													if(get_Removed_Wardrobe.size() > 0)
													{
														wardrobe_Name = wardrobe_Name + "[";
														for each  war in get_Removed_Wardrobe
														{
															get_Product = Buyer_Mapping_Wardrobes[Buyer_Product_Mapping.Buyer == input.ID && Wardrobe == war];
															if(get_Product.count() > 0)
															{
																mapped_Wardrobe.add(war);
																wardrobe_Name = wardrobe_Name + Wardrobe[ID == war].Wardrobe_Name + ",";
																wardrobe_ID.add(war);
															}
														}
														wardrobe_Name_List = wardrobe_Name.removeLastOccurence(",") + "]";
													}
													if(mapped_Wardrobe.size() > 0)
													{
														alert "The following wardrobes are already used by products and cannot be removed: " + wardrobe_Name_List + ". Please keep them selected.";
														currentList = input.Wardrobe;
														currentList.addAll(wardrobe_ID);
														input.Wardrobe = currentList;
													}
									)
								}
							}
			
						
			}

			Auto_populate_style_detai2 as "Auto populate style details"
			{
			
							type =  form
							form = Copy_of_Purchase_LineItems
			
							record event = on add or edit
			
							on user input of Product
							{
								actions 
								{
									custom deluge script
									(
														get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Copy_of_Purchase_Order.Buyer_Organisation && Style_ID == input.Product && Buyer_Product_Mapping.Factory_Allocated == input.Copy_of_Purchase_Order.Supplier];
													// get_Fabric = Fabric_Form[ID == input.Product.Fabric_Code];
													// get_PO_Item.Fabric_Composition = if(get_Fabric.count(ID) > 0,get_Fabric.Fabric_Composition,"");
													input.Product_Color = input.Product.Style_Colour;
													input.Product_Size = input.Product.Size_Set;
													input.Description = input.Product.Product_Description;
													input.Purchase_Price = if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0);
													input.Selling_Price = if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0);
													input.Style_Code = input.Product.Style_Code.Style_Code;
													input.HS_Code = if(get_product_Price.count(ID) > 0,get_product_Price.HS_Code,"");
													input.Fabric_Composition = input.Product.Fabric_Code.Fabric_Composition;
													if(input.Product != null && input.Quantity != null)
													{
														input.Selling_Price_Sub_Total = input.Selling_Price * input.Quantity;
														input.Purchase_Price_Sub_Total = input.Purchase_Price * input.Quantity;
													}
									)
								}
							}
			
						
			}

			Calculate_Price3 as "Calculate Price"
			{
			
							type =  form
							form = Copy_of_Purchase_LineItems
			
							record event = on add or edit
			
							on user input of Quantity
							{
								actions 
								{
									custom deluge script
									(
														if(input.Quantity <= 0)
													{
														alert "Quantity must be greater than 0.";
														input.Quantity = null;
													}
													else if(input.Product != null && input.Quantity > 0)
													{
														get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Copy_of_Purchase_Order.Buyer_Organisation && Style_ID == input.Product && Buyer_Product_Mapping.Factory_Allocated == input.Copy_of_Purchase_Order.Supplier];
														input.Selling_Price_Sub_Total = if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0) * input.Quantity;
														input.Purchase_Price_Sub_Total = if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0) * input.Quantity;
													}
									)
								}
							}
			
						
			}

