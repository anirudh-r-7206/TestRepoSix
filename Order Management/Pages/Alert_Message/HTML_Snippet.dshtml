	{
		get_PO = Purchase_Order[ID == input.PO_ID.toNumber()];
		svg = "<svg width=\\"130\\" height=\\"100\\" viewBox=\\"0 0 71 51\\" fill=\\"none\\" xmlns=\\"http://www.w3.org/2000/svg\\"> <circle cx=\\"54.5\\" cy=\\"38.5\\" r=\\"1.5\\" stroke=\\"#C3C3C3\\"/> <path d=\\"M37.299 12.25L48.5574 31.75C49.1347 32.75 48.413 34 47.2583 34H24.7417C23.587 34 22.8653 32.75 23.4426 31.75L34.701 12.25C35.2783 11.25 36.7217 11.25 37.299 12.25Z\\" stroke=\\"#C4C4C4\\"/> <path d=\\"M36 25.5625V18\\" stroke=\\"#C4C4C4\\" stroke-width=\\"1.3\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/> <circle cx=\\"35.9875\\" cy=\\"28.3125\\" r=\\"0.34375\\" fill=\\"#C4C4C4\\" stroke=\\"#C4C4C4\\" stroke-width=\\"0.6875\\"/> <path d=\\"M36.299 12.25L47.5574 31.75C48.1347 32.75 47.413 34 46.2583 34H23.7417C22.587 34 21.8653 32.75 22.4426 31.75L33.701 12.25C34.2783 11.25 35.7217 11.25 36.299 12.25Z\\" stroke=\\"#ED3026\\"/> <path d=\\"M35 25.5625V18\\" stroke=\\"#ED3026\\" stroke-width=\\"1.3\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/> <circle cx=\\"34.9875\\" cy=\\"28.3125\\" r=\\"0.6875\\" fill=\\"#ED3026\\"/> <circle cx=\\"15.5\\" cy=\\"42\\" r=\\"3.5\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"15\\" cy=\\"41\\" r=\\"3.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"54\\" cy=\\"38\\" r=\\"1.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"17.5\\" cy=\\"15.5\\" r=\\"1.5\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"17\\" cy=\\"15\\" r=\\"1.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"53\\" cy=\\"8\\" r=\\"2\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"52.5\\" cy=\\"7.5\\" r=\\"2\\" stroke=\\"#ED3026\\"/> </svg>";
		Message_Content = "An amendment request is already pending for this purchase order [" + get_PO.PO_Number + "], so a new amendment request cannot be submitted at this time.";
	}
	else if(input.Message_Type == "bulkUpdate")
	{
		svg = "<svg width=\\"130\\" height=\\"100\\" viewBox=\\"0 0 71 51\\" fill=\\"none\\" xmlns=\\"http://www.w3.org/2000/svg\\"> <circle cx=\\"54.5\\" cy=\\"38.5\\" r=\\"1.5\\" stroke=\\"#C3C3C3\\"/> <path d=\\"M37.299 12.25L48.5574 31.75C49.1347 32.75 48.413 34 47.2583 34H24.7417C23.587 34 22.8653 32.75 23.4426 31.75L34.701 12.25C35.2783 11.25 36.7217 11.25 37.299 12.25Z\\" stroke=\\"#C4C4C4\\"/> <path d=\\"M36 25.5625V18\\" stroke=\\"#C4C4C4\\" stroke-width=\\"1.3\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/> <circle cx=\\"35.9875\\" cy=\\"28.3125\\" r=\\"0.34375\\" fill=\\"#C4C4C4\\" stroke=\\"#C4C4C4\\" stroke-width=\\"0.6875\\"/> <path d=\\"M36.299 12.25L47.5574 31.75C48.1347 32.75 47.413 34 46.2583 34H23.7417C22.587 34 21.8653 32.75 22.4426 31.75L33.701 12.25C34.2783 11.25 35.7217 11.25 36.299 12.25Z\\" stroke=\\"#ED3026\\"/> <path d=\\"M35 25.5625V18\\" stroke=\\"#ED3026\\" stroke-width=\\"1.3\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/> <circle cx=\\"34.9875\\" cy=\\"28.3125\\" r=\\"0.6875\\" fill=\\"#ED3026\\"/> <circle cx=\\"15.5\\" cy=\\"42\\" r=\\"3.5\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"15\\" cy=\\"41\\" r=\\"3.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"54\\" cy=\\"38\\" r=\\"1.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"17.5\\" cy=\\"15.5\\" r=\\"1.5\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"17\\" cy=\\"15\\" r=\\"1.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"53\\" cy=\\"8\\" r=\\"2\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"52.5\\" cy=\\"7.5\\" r=\\"2\\" stroke=\\"#ED3026\\"/> </svg>";
		Message_Content = input.Message_Content1;
	}
	else if(input.Message_Type == "Buyer_Not_Approved")
	{
		Message_Content = "App Sharing Failed: the associated buyer is pending approval. The user's account will remain inactive until the buyer is approved.";
	}
	else if(input.Message_Type == "Buyer_Rejected")
	{
		Message_Content = "App Sharing Failed: the associated buyer has been rejected. Please contact the administrator for further assistance.";
	}
	else if(input.Message_Type == "Buyer_Inactive")
	{
		Message_Content = "App Sharing Failed: the associated buyer is in Inactive Status. Please activate the Buyer and then try again.";
	}
	else if(input.Message_Type == "Supplier_Not_Approved")
	{
		Message_Content = "App Sharing Failed: the associated supplier is pending approval. The user's account will remain inactive until the supplier is approved.";
	}
	else if(input.Message_Type == "Supplier_Rejected")
	{
		Message_Content = "App Sharing Failed: the associated supplier has been rejected. Please contact the administrator for further assistance.";
	}
	else if(input.Message_Type == "Supplier_Inactive")
	{
		Message_Content = "App Sharing Failed: the associated supplier is in Inactive Status. Please activate the Supplier and then try again.";
	}
	else if(input.Message_Type == "User_Inactive")
	{
		Message_Content = "The User Account is yet to be Approved. Please Approve the User to provide access.";
	}
	else
	{
		svg = "<svg width=\\"130\\" height=\\"100\\" viewBox=\\"0 0 71 51\\" fill=\\"none\\" xmlns=\\"http://www.w3.org/2000/svg\\"> <circle cx=\\"54.5\\" cy=\\"38.5\\" r=\\"1.5\\" stroke=\\"#C3C3C3\\"/> <path d=\\"M37.299 12.25L48.5574 31.75C49.1347 32.75 48.413 34 47.2583 34H24.7417C23.587 34 22.8653 32.75 23.4426 31.75L34.701 12.25C35.2783 11.25 36.7217 11.25 37.299 12.25Z\\" stroke=\\"#C4C4C4\\"/> <path d=\\"M36 25.5625V18\\" stroke=\\"#C4C4C4\\" stroke-width=\\"1.3\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/> <circle cx=\\"35.9875\\" cy=\\"28.3125\\" r=\\"0.34375\\" fill=\\"#C4C4C4\\" stroke=\\"#C4C4C4\\" stroke-width=\\"0.6875\\"/> <path d=\\"M36.299 12.25L47.5574 31.75C48.1347 32.75 47.413 34 46.2583 34H23.7417C22.587 34 21.8653 32.75 22.4426 31.75L33.701 12.25C34.2783 11.25 35.7217 11.25 36.299 12.25Z\\" stroke=\\"#ED3026\\"/> <path d=\\"M35 25.5625V18\\" stroke=\\"#ED3026\\" stroke-width=\\"1.3\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/> <circle cx=\\"34.9875\\" cy=\\"28.3125\\" r=\\"0.6875\\" fill=\\"#ED3026\\"/> <circle cx=\\"15.5\\" cy=\\"42\\" r=\\"3.5\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"15\\" cy=\\"41\\" r=\\"3.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"54\\" cy=\\"38\\" r=\\"1.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"17.5\\" cy=\\"15.5\\" r=\\"1.5\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"17\\" cy=\\"15\\" r=\\"1.5\\" stroke=\\"#ED3026\\"/> <circle cx=\\"53\\" cy=\\"8\\" r=\\"2\\" stroke=\\"#C3C3C3\\"/> <circle cx=\\"52.5\\" cy=\\"7.5\\" r=\\"2\\" stroke=\\"#ED3026\\"/> </svg>";
		// 		Message_Content = "";
	}
	%>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Popup Warning Alert</title>
    <style>
        * {
            padding: 0;
            margin: 0;
//             box-sizing: border-box;
        }
		
        /* The popup container (hidden by default) */
        .popup {
//             position: fixed;
//             top: 20%;
//             left: 50%;
//             transform: translate(-50%, -50%);
            background: #fff;
            padding: 20px 20px 30px 20px;
            box-shadow: 0 4px 5px rgba(0, 0, 0, 0.07);
            border-radius: 10px;
			max-width: 600px;
            text-align: center;
			font-size: 18px;
    		font-weight: 600;
        }
		.alert_content{
			display: flex;
			align-items: center;
			justify-content: center;
		}
		[pagelinkname="Alert_Message"] .zc-pb-tile-card{
			background-color: transparent !important;
    		box-shadow: none !important;
		}
		a.back_Button {
			border-radius: 10px;
			padding: 7px 18px;
			font-size: 13px;
			background: #F1F2FA;
			color: #29379E;
			font-weight: 500;
			margin: 10px auto 0px;
			display: flex;
			width: fit-content;
		}
    </style>
</head>
<body>

	<!-- The popup alert -->
    <div class="alert_content">
    <div id="alert" class="popup">
		<div class="alert_Img">
			<%=svg%>
		</div>
  		<div style="font-weight: 500;"><%=Message_Content%></div>
<%
	if(!redirect.isEmpty())
	{
		%>
<a class="back_Button" href="#Script:page.refresh">Go back</a>
<%
	}
	%>
</div>
	</div>
</body>
</html>