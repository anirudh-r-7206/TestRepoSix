<%
	// 	input.PO_ID = 4908788000000528100;
	get_PO = Copy_of_Purchase_Order[Purchase_Order == input.PO_ID];
	Create_URL = "https://creatorapp.zoho.com/" + zoho.appuri + "record-summary/Purchase_Order_detail_view/" + input.PO_ID + "/";
	%>
<style>
		.overAll_Div *{
			box-sizing: border-box;
			padding: 0;
			margin: 0;
		}
		div[pagelinkname="Purchase_Order_Details"]#zppagesLive, div[pagelinkname="Purchase_Order_Details"] div#elementsContainer, div[pagelinkname="Purchase_Order_Details"] div#row_1 {
			height: 100% !important;
		}
		[viewlinkname="Copy_of_Purchase_LineItems_Report"].divEmbedContainer {
			height: calc(100% - 50px) !important;
			min-height: 500px;
		}
		.iframe_Div{
			height: calc(100% - 50px);
		}
		.zc-pb-embed-placeholder-content{
			overflow: auto;
		}
		[pagelinkname="Purchase_Order_Details"] .Layout.elemContainment {
			height: calc(100% - 16px);
		}
		.overAll_Div {
		    height: calc(100% - 15px);
		}
		.detailView{
			margin: 0px 15px;
		}
		.PO_subForm {
			margin: 17px;
			height: calc(100% - 314px);
		}
		.Form_Header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin: 15px 0px;
		}
		.header_Name{
			font-size: 16px;
			font-weight: 600;
		    line-height: 25px;
		}
		.add_POItem{
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 14px;
			gap: 10px;
			height: 30px;
			line-height: normal;
			min-width: 30px;
// 			padding: 8px;
			border-radius: 8px;
			cursor: var(--zc-cursor-pointer);
			background-color: var(--primary_bg_text_color) !important;
			color: var(--primary_color);
			border: 2px solid var(--primary_color);
		}
	
		
		.wrap {
			/* max-width: 1000px; */
			margin: 0 auto;
		}

		/* 3-col price strip */
		.price-strip {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 8px;
			margin-bottom: 10px;
		}

		.price-card {
			background: #fff;
			border: 0.5px solid #e0e0e0;
			border-radius: 8px;
			padding: 10px 12px;
		}

		.price-card.buy {
			border-top: 2px solid #378ADD;
		}

		.price-card.sell {
			border-top: 2px solid #1D9E75;
		}

		.price-card.margin {
			border-top: 2px solid #BA7517;
		}

		.price-label {
			font-size: 10px;
			font-weight: 500;
			text-transform: uppercase;
			letter-spacing: .06em;
			margin-bottom: 3px;
		}

		.price-label.buy {
			color: #185FA5;
		}

		.price-label.sell {
			color: #0F6E56;
		}

		.price-label.margin {
			color: #854F0B;
		}

		.price-val {
			font-size: 18px;
			font-weight: 500;
			line-height: 1;
		}

		.price-val.buy {
			color: #185FA5;
		}

		.price-val.sell {
			color: #0F6E56;
		}

		.price-val.margin {
			color: #854F0B;
		}

		.price-sub {
			font-size: 10px;
			color: #999;
			margin-top: 2px;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		/* Sections */
		.section {
			background: #fff;
			border: 0.5px solid #e0e0e0;
			border-radius: 8px;
			overflow: hidden;
			margin-bottom: 8px;
		}

		.section-hd {
			padding: 6px 12px;
			background: #F8F9FA;
			border-bottom: 0.5px solid #e0e0e0;
			display: flex;
			align-items: center;
			gap: 6px;
		}

		.hd-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
		}

		.section-title {
			font-size: 10px;
			font-weight: 500;
			color: #666;
			text-transform: uppercase;
			letter-spacing: .06em;
		}

		/* 4-column field grid */
		.field-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
		}

		.field {
			padding: 8px 12px;
			border-right: 0.5px solid #e0e0e0;
			border-bottom: 0.5px solid #e0e0e0;
		}

		.field:nth-child(4n) {
			border-right: none;
		}

		.field:nth-last-child(-n+4) {
			border-bottom: none;
		}

		.field-label {
			font-size: 10px;
			color: #999;
			text-transform: uppercase;
			letter-spacing: .05em;
			margin-bottom: 2px;
		}

		.field-val {
			font-size: 12px;
			color: #1a1a2e;
			font-weight: 500;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.field-val.empty {
			color: #bbb;
			font-weight: 400;
			font-style: italic;
		}

		/* Comment */
		.comment-btn {
			display: flex;
			align-items: center;
			gap: 6px;
			background: none;
			border: 0.5px solid #ccc;
			border-radius: 8px;
			padding: 6px 12px;
			font-size: 12px;
			color: #666;
			cursor: pointer;
			margin-top: 8px;
		}

		.comment-btn:hover {
			background: #F8F9FA;
		}
		
		.header_backBtn{
			display: flex;
			align-items: center;
			gap: 10px;
		}
		.back_Product{
			display: flex;
			align-items: center;
		}
		.back_Product:before {
			content: "\\ed89";
			font-family: ZC Live Outline;
			font-size: 30px;
		}
		
		
		form[name="PO_Style_Search"].label-inplace{
			width: 100% !important;
			overflow: unset !important;
		}
		 form[name="PO_Style_Search"] .formContainer {
			padding: 0 !important;
		}
		[formlinkname="PO_Style_Search"] .form-outer-wrapper{
			box-shadow: none !important;
		}
		form[name="PO_Style_Search"] .form-group.clearfix.zc-Select_Supplier-group {
			margin-bottom: 1px !important;
		}
		[formlinkname="PO_Style_Search"]  a.select2-choice.select2-default {
			min-height: 35px !important;
			height: 35px !important;
		}
		[formlinkname="PO_Style_Search"]  .form-group.clearfix.zc-Search_Style-group {
			margin-bottom: 0px !important;
		}
		[formlinkname="PO_Style_Search"] .zc-footer-wrapper{
			display: none;
		}
		
	</style>

	<div class="overAll_Div">
		<div class="detailView">
			<div class="Form_Header">
				<div class="header_Name">Purchase Order</div>
				<div class="header_backBtn">
					<a class="add_POItem" href="#Form:Copy_of_Purchase_Order?zc_LoadIn=dialog&recLinkID=<%=get_PO.ID%>&viewLinkName=Copy_of_Purchase_Order_Report&zc_Header=false">
							<svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="var(--primary_color)">
								<path d="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"/>
							</svg>
						</svg>
					</a>
					<a class="back_Product" href="#Script:page.refresh">
						<!--
						<svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="var(--primary_color)"><path d="M400-240 160-480l240-240 56 58-142 142h486v80H314l142 142-56 58Z"/></svg>
						Back
						-->
					</a>
				</div>
			</div>
			<!--
			<div class="iframe_Div">
				<iframe name='zohoview' height='100%' width='100%' scrolling='Auto' frameborder='0' src='<%=Create_URL%>' ></iframe>
			</div>
			-->
			
			<div class="wrap">
				<div class="price-strip">
				
					<div class="price-card sell">
						<div class="price-label sell">Selling price</div>
						<div class="price-val sell"><%=get_PO.Total_Selling_Price%></div>
						<div class="price-sub"><%=get_PO.Buyer_Organisation.Buyer_Organisation%></div>
					</div>
					<div class="price-card buy">
						<div class="price-label buy">Purchase price</div>
						<div class="price-val buy"><%=get_PO.Total_Purchase_Price%></div>
						<div class="price-sub"><%=get_PO.Supplier.Supplier_Organisation%></div>
					</div>
<%
	profit = get_PO.Total_Selling_Price - get_PO.Total_Purchase_Price;
	percentage = (profit / get_PO.Total_Selling_Price * 100).round(2);
	%>
<div class="price-card margin">
						<div class="price-label margin">Gross margin</div>
						<div class="price-val margin"><%=profit%></div>
						<div class="price-sub"><%=percentage%>% margin on sell</div>
					</div>
				</div>

				<div class="section">
					<div class="section-hd">
						<div class="hd-dot" style="background:#185FA5"></div>
						<span class="section-title">Order details</span>
					</div>
					<div class="field-grid">
						<div class="field">
							<div class="field-label">PO number</div>
							<div class="field-val"><%=get_PO.Purchase_Order.PO_Number%></div>
						</div>
						<div class="field">
							<div class="field-label">Order type</div>
							<div class="field-val"><%=get_PO.Order_Type%></div>
						</div>
						<div class="field">
							<div class="field-label">Order reference</div>
							<div class="field-val"><%=get_PO.Order_Reference%></div>
						</div>
						<div class="field">
							<div class="field-label">Payment terms</div>
							<div class="field-val"><%=get_PO.Payment_Terms%> days</div>
						</div>
					</div>
				</div>

				<div class="section">
					<div class="section-hd">
						<div class="hd-dot" style="background:#1D9E75"></div>
						<span class="section-title">Parties &amp; location</span>
					</div>
					<div class="field-grid">
						<div class="field">
							<div class="field-label">Supplier</div>
							<div class="field-val"><%=get_PO.Supplier.Supplier_Organisation%></div>
						</div>
						<div class="field">
							<div class="field-label">Buyer organisation</div>
							<div class="field-val"><%=get_PO.Buyer_Organisation.Buyer_Organisation%></div>
						</div>
						<div class="field">
							<div class="field-label">Country</div>
							<div class="field-val"><%=get_PO.Country.Country_Name%></div>
						</div>
						<div class="field">
							<div class="field-label">Incoterm</div>
							<div class="field-val"><%=get_PO.Incoterms%></div>
						</div>
					</div>
				</div>
			</div>
			
		</div>
		<div class="PO_subForm">
			<div class="Form_Header">
				<div class="header_Name">Purchase LineItems</div>
				<div class="header_backBtn">
					<div elName='zc-component' formLinkName='PO_Style_Search' style="height: 54px;" params='zc_Header=false&amp;zc_SuccMsg=Data Added Successfully!&amp;zc_SubmitVal=Submit&amp;zc_ResetVal=Reset&Purchase_Order=<%=input.PO_ID%>'></div>
					<a class="add_POItem" style="width: 30px; padding: 0;" href="#Form:Copy_of_Purchase_LineItems?zc_LoadIn=embed-editPO&Copy_of_Purchase_Order=<%=get_PO.ID%>&zc_Header=false">
						<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="var(--primary_color)">
						<path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/>
						</svg>
					</a>
				</div>
			</div>
			<div elName='zc-component' name="POitems" viewLinkName='Copy_of_Purchase_LineItems_Report' params='zc_Header=false&Copy_of_Purchase_Order=<%=get_PO.ID%>'></div>
		</div>
	</div>