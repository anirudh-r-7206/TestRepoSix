                        <td>Unisex</td>
                        <td class="desc-text">Soft, breathable, and comfortable fabric made from cotton fibers, ideal
                            for daily wear and summer clothing.</td>
                        <td>bx374865</td>
                        <td>20</td>
                        <td>400.00</td>
                        <td style="text-align: right;" class="font-medium">3,000.00</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td class="font-medium">Kitchen wash paper</td>
                        <td>20/2/02</td>
                        <td>Denim</td>
                        <td>One size</td>
                        <td>Unisex</td>
                        <td class="desc-text">Soft, breathable, and comfortable fabric made from cotton fibers, ideal
                            for daily wear and summer clothing.</td>
                        <td>bx374865</td>
                        <td>20</td>
                        <td>100.00</td>
                        <td style="text-align: right;" class="font-medium">3,000.00</td>
                    </tr>
                    <tr class="row-subtotal">
                        <td colspan="8" class="font-semibold">Sub Total</td>
                        <td class="font-bold">40</td>
                        <td></td>
                        <td style="text-align: right;" class="font-bold">3,000.00</td>
                    </tr>
                    <tr class="row-grandtotal">
                        <td colspan="8" class="font-bold">Grand Total</td>
                        <td class="font-bold">40</td>
                        <td></td>
                        <td style="text-align: right;" class="font-bold">7,000.00</td>
                    </tr>
                </tbody>
            </table> -->
        </div>

        <div class="footer-signoff">
            <div class="signature-form">
                <div class="form-line">
                    <span class="label">Name</span>
                    <div class="line-input"></div>
                </div>
                <div class="form-line">
                    <span class="label">Position</span>
                    <div class="line-input"></div>
                </div>
                <div class="form-line">
                    <span class="label">Company Stamp</span>
                    <div class="line-input"></div>
                </div>
                <div class="form-line">
                    <span class="label">Signature</span>
                    <div class="line-input"></div>
                </div>
            </div>

            <div class="comments-box">
            </div>
        </div>

    </div>

</body>

</html>