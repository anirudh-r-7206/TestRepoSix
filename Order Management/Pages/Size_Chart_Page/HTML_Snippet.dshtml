<style>
    *{
        padding:0;
        margin:0;
        border:none;
        box-sizing:border-box;
        font-family: Arial, sans-serif;
    }

//     .popupbox{
//         width: 95vw !important;

//     }

    div#zppagesLive,
    div#elementsContainer,
    .Layout.elemContainment,
    div#row_1,
    .zc-pb-formreport-placeholder{
        height: 100% !important;
    }

    #mainContainerDiv{
        width: 100%;
        height: 100%;
        padding: 18px 18px 24px 18px;
        background: #f5f7fb;
        display: flex;
        flex-direction: column;
        gap: 16px;
        overflow: auto;
    }

    .sizeChartHeader{
       
        width: 100%;
        border-radius: 14px;
        padding: 0 16px;
        display: flex;
        align-items: center;
    }

    .sizeChartHeader .title{
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .sizeChartCard{
        width: 100%;
        background: #fff;
        border-radius: 14px;
        padding: 30px;
        border: 1px solid #e7eaf5;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .sizeChartImg{
        width: 100%;
        max-height: 75vh;
        object-fit: contain;
        display: block;
        border-radius: 12px;
    }

    @media(max-width: 768px){
        #mainContainerDiv{
            padding: 12px;
        }
//         .popupbox{
//             width: 98vw !important;

//         }
        .sizeChartHeader,
        .sizeChartCard{
            border-radius: 12px;
        }
        .sizeChartImg{
            border-radius: 10px;
        }
    }
</style>

<div id="mainContainerDiv">

  <div class="sizeChartHeader">
        <div class="title">Size Chart</div>
    </div>
<%
	for each  rec in Size_Chart[ID != null]
	{
		profile = rec.Image.replaceAll("/sharedBy/appLinkName/viewLinkName/fieldName/image","/file" + zoho.appuri + "All_Size_Charts/" + rec.ID + "/Image/image-download?filepath=");
		start = profile.find("https");
		end = profile.find("lowqual");
		imageUrl = profile.subText(start,end - 2);
		%>
<div class="sizeChartCard">
        <img class="sizeChartImg" src="<%=imageUrl%>" alt="Size Chart Image" />
    </div>
<%
	}
	%>
</div>