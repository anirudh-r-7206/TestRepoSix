<panel elementName='Panel 3'>
					<pr width='fill' height='fill'>
						<pc padding='0px' bgColor='#FFFFFF' action='OpenURL' url='#Report:Production_Orders?zc_LoadIn=embed-myOrder&amp;Order_Status=Completed&amp;zc_MoreAction=false&amp;zc_AddRec=false' target='same-window' width='100%' hAlign='center' vAlign='middle'>
							<pr width='fill' height='fill'>
								<pc paddingTop='17px' paddingLeft='17px' paddingRight='0px' paddingBottom='17px' bgColor='transparent' bgColorType='noFill' width='30%' hAlign='center'>
									<pr width='auto' height='auto'>
										<pc>
											<image marginLeft='0px' marginRight='7px' marginBottom='0px' marginTop='0px' color='#FFFFFF' bgColor='#62CC89' width='52px' height='52px' type='icon' value='ui-1-check-simple' size='24px' cornerRadius='26px' iconType='outline' /> </pc>
									</pr>
								</pc>
								<pc padding='10px' bgColor='#FFFFFF' width='70%' hAlign='center' vAlign='middle' cornerRadius='0px'>
									<pr width='auto' height='auto'>
