											<pr>
												<pc hAlign='left'>
													<text margin='0px' padding='0px' color='#333333' size='16px' type='Text' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' value='Completed'>
													</text>

												</pc>
											</pr>
											<pr>
