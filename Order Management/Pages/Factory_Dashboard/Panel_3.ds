													<text marginLeft='0px' marginRight='0px' marginBottom='0px' marginTop='2px' padding='0px' color='#2A70E7' size='36px' bold='true' type='Form Data' bgColor='transparent' bgColorType='noFill' cornerRadius='0px' displayType='actual' thousandsSeperator='LOCALE' decimalSeperator='DOT' numberScale='none' criteria='Supplier.Email == zoho.loginuserid &amp;&amp; Order_Status == &quot;Completed&quot;' value='thisapp.Purchase_Order.ID.count'>
													</text>

