<%
	// 	Po_ID = 4908788000000468095;
	get_PO = Purchase_Order[ID == input.Po_ID];
	get_PO_Items = Purchase_LineItems[Purchase_Order == input.Po_ID];
	get_Buyer = Buyers_Master[ID == get_PO.Buyer_Organisation];
	%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Purchase Order \u2013 <%=get_PO.PO_Number%></title>
<style>

* {
    padding: 0;
    margin: 0;
    border: none;
}
div#zppagesLive,
div#elementsContainer,
.Layout.elemContainment,
div#row_1,
.zc-pb-formreport-placeholder {
    height: 100% !important;
}
.Layout.elemContainment {
    padding: unset !important;
}

	form[name="Print_and_PDF_Button"].label-left{
			width: 100% !important;
			background-color: #000000 !important;
			border-radius: 0 !important;
		}
		form[name="Print_and_PDF_Button"] .label-left{
			width: 100%;
			
		}
		form[name="Print_and_PDF_Button"] .formContainer {
			padding: 0 !important;
		}
		form[name="Print_and_PDF_Button"] .form-group.zc-decisionbox-field-group, form[name="Print_and_PDF_Button"] .zc-form-scroll-wrapper {
			margin: 0 !important;
		}
		form[name="Print_and_PDF_Button"] .decision-box-field.form-field.clearfix {
			display: none;
		}
		form[name="Print_and_PDF_Button"] .formColumn.first-column
		{
			display: flex;
			align-items: center;
			justify-content: end;
			gap: 10px;
		}
		form[name="Print_and_PDF_Button"] label.form-label.decision-box-label {
			color: #fff !important;
			padding: 10px 20px !important;
			background-color: var(--primary_color);
			border-radius: 8px;
			margin: 0px !important;
		}

		.zc-footer-wrapper{
			display: none;
		}
		@media print {
		  /* Specific margins for different sides */
		  @page {
			margin-top: 40px;
			margin-bottom: 40px;
			margin-left: 10px;
			margin-right: 10px;
			size: A4 landscape;
		  }
		   .action-bar{
			 display: none !important;
		 }
		  .page{
			  padding: 0px;
		  }
		}
  /* \u2500\u2500 ROOT CONTAINER \u2500\u2500 */
  #po-root {
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 13px;
    color: #222;
  }

  /* \u2500\u2500 MAIN PAGE CARD \u2500\u2500 */
  #po-card {
    max-width: 100%;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 2px 16px rgba(0,0,0,0.10);
    overflow: hidden;
  }

  /* \u2500\u2500 TOP BAR (inside card) \u2500\u2500 */
  #po-topbar {
    background: #1a1a2e;
    padding: 10px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  #po-topbar .po-logo-img {
    height: 36px;
    width: auto;
    display: inline-block;
    border-radius: 4px;
  }
  #po-topbar .action-bar {
    display: flex;
    gap: 10px;
  }

  /* \u2500\u2500 CONTENT AREA \u2500\u2500 */
  #po-content {
    padding: 36px 40px;
  }

  /* \u2500\u2500 PO HEADER \u2500\u2500 */
  #po-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
  }
  #po-header .po-label {
    font-size: 10.5px;
    font-weight: 700;
    color: #e05a00;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  #po-header .po-number {
    font-size: 26px;
    font-weight: 700;
    color: #111;
    line-height: 1.1;
  }
  #po-header .po-issued {
    font-size: 11.5px;
    color: #888;
    margin-top: 5px;
  }
  #po-header .po-issued .po-due { color: #e05a00; }
  #po-header .po-totals {
    display: flex;
    gap: 40px;
    text-align: right;
  }
  #po-header .po-totals .tot-block .tot-label {
    font-size: 10px;
    font-weight: 700;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 4px;
  }
  #po-header .po-totals .tot-block .tot-val {
    font-size: 24px;
    font-weight: 700;
    color: #111;
  }
  #po-header .po-totals .tot-block .tot-val.tot-accent { color: #e05a00; }

  /* \u2500\u2500 DIVIDER \u2500\u2500 */
  .po-divider {
    border: none;
    border-top: 1.5px solid #e8e8e8;
    margin: 0 0 24px;
  }

  /* \u2500\u2500 SUPPLIER / BUYER \u2500\u2500 */
  #po-parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 28px;
  }
  .po-party .party-title {
    font-size: 14px;
    font-weight: 700;
    color: #111;
    margin-bottom: 10px;
  }
  .po-party .party-info {
    font-size: 12.5px;
    color: #333;
    line-height: 1.7;
  }
  .po-party .party-info .party-name { font-weight: 700; color: #111; }

  /* \u2500\u2500 SUMMARY SECTION \u2500\u2500 */
  #po-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    margin-bottom: 28px;
    overflow: hidden;
    background: #f5f5f5;
  }
  #po-summary-left {
    padding: 22px 26px;
    border-right: 1px solid #e0e0e0;
    background: #f5f5f5;
  }
  #po-summary-left .summary-heading {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #444;
    margin-bottom: 14px;
  }
  #po-summary-left .summary-table { width: 100%; border-collapse: collapse; }
  #po-summary-left .summary-table .s-key {
    color: #888;
    width: 120px;
    padding: 4px 0;
    font-size: 12.5px;
    vertical-align: top;
  }
  #po-summary-left .summary-table .s-colon {
    width: 16px;
    color: #888;
    padding: 4px 0;
    font-size: 12.5px;
  }
  #po-summary-left .summary-table .s-val {
    font-weight: 500;
    color: #111;
    padding: 4px 0;
    font-size: 12.5px;
  }

  /* \u2500\u2500 FACTORY / DELIVERY \u2500\u2500 */
  #po-summary-right { padding: 22px 26px; background: #fff; }
  #po-summary-right .factory-block { margin-bottom: 22px; }
  #po-summary-right .block-title {
    font-size: 14px;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;
  }
  #po-summary-right .block-attn {
    font-size: 12.5px;
    color: #444;
    margin-bottom: 2px;
  }
  #po-summary-right .block-attn .attn-name { font-weight: 700; color: #111; }
  #po-summary-right .block-info {
    font-size: 12.5px;
    color: #444;
    line-height: 1.7;
  }
  #po-summary-right .block-info .info-bold { font-weight: 700; color: #111; }

  /* \u2500\u2500 ORDER TABLE \u2500\u2500 */
  #po-order-title {
    font-size: 16px;
    font-weight: 700;
    color: #111;
    margin-bottom: 12px;
  }
  #po-order-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 28px;
    font-size: 12px;
  }
  #po-order-table .thead-row { background: #1a1a2e; }
  #po-order-table .thead-row .th-cell {
    padding: 11px 10px;
    text-align: center;
    font-weight: 600;
    font-size: 11.5px;
    color: #fff;
    letter-spacing: 0.3px;
  }
  #po-order-table .tbody-row { border-bottom: 1px solid #eee; }
  #po-order-table .tbody-row .td-cell {
    padding: 12px 10px;
    text-align: center;
    color: #333;
    vertical-align: middle;
  }
  #po-order-table .tbody-row .td-fabric {
    text-align: left;
    font-size: 11.5px;
    color: #555;
    padding: 12px 10px;
    vertical-align: middle;
  }
  #po-order-table .tfoot-subtotal .tfd-cell {
    padding: 11px 10px;
    font-weight: 700;
    font-size: 13px;
    background: #f0f0f0;
    border-top: 1.5px solid #ddd;
    text-align: center;
  }
  #po-order-table .tfoot-subtotal .tfd-cell.tfd-label { text-align: left; padding-left: 14px; }
  #po-order-table .tfoot-grandtotal .tfd-cell {
    padding: 11px 10px;
    font-weight: 700;
    font-size: 13px;
    background: #e8e8e8;
    border-top: 1.5px solid #ddd;
    text-align: center;
  }
  #po-order-table .tfoot-grandtotal .tfd-cell.tfd-label { text-align: left; padding-left: 14px; }

  /* \u2500\u2500 DYNAMIC ORDER TABLE (from PO_Templet_Table function) \u2500\u2500 */
  .order-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 28px;
    font-size: 12px;
  }
  .order-table thead tr {
    background: #1a1a2e;
  }
  .order-table thead th {
    padding: 11px 10px;
    text-align: center;
    font-weight: 600;
    font-size: 11.5px;
    color: #fff;
    letter-spacing: 0.3px;
    border: none;
  }
  .order-table tbody tr {
    border-bottom: 1px solid #eee;
  }
  .order-table tbody td {
    padding: 12px 10px;
    text-align: center;
    color: #333;
    vertical-align: middle;
    border: none;
  }
  .order-table .t_right { text-align: right; }
  .order-table .text_Left { text-align: left; padding-left: 14px; }
  .order-table .text_Bold { font-weight: 700; }
  /* Sub Total row */
  .order-table tr:has(td[colspan="8"]:not(.text_Bold ~ *)) td,
  .order-table tbody tr td[colspan="8"] {
    background: #f0f0f0;
  }
  .order-table tbody tr:last-child td {
    background: #e8e8e8;
    font-weight: 700;
    font-size: 13px;
    border-top: 1.5px solid #ddd;
  }
  /* Sub total rows - any row with colspan=8 */
  .order-table tbody tr td.text_Bold[colspan="8"] {
    background: #f0f0f0;
    border-top: 1.5px solid #ddd;
    font-size: 13px;
  }
  .order-table tbody tr:has(td[colspan="8"]) td {
    background: #f0f0f0;
    border-top: 1.5px solid #ddd;
    font-size: 13px;
    font-weight: 700;
  }
  .order-table tbody tr:last-child td {
    background: #e8e8e8 !important;
    border-top: 2px solid #ccc;
  }

  /* \u2500\u2500 FOOTER SIGNATURE \u2500\u2500 */
  #po-footer {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    background: #f5f5f5;
  }
  #po-footer-left {
    padding: 22px 26px;
    border-right: 1px solid #e0e0e0;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #f5f5f5;
  }
  #po-footer-left .sig-row {
    display: flex;
    align-items: flex-end;
    gap: 12px;
  }
  #po-footer-left .sig-row .sig-label {
    font-size: 12.5px;
    color: #444;
    min-width: 110px;
    font-weight: 500;
  }
  #po-footer-left .sig-row .sig-line {
    flex: 1;
    border-bottom: 1.5px solid #bbb;
    height: 20px;
  }
  #po-footer-right {
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
    background: #f5f5f5;
  }
  #po-footer-right .commentss-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #888;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  #po-footer-right .comments-area {
    flex: 1;
    border: 1.5px solid #ccc;
    border-radius: 4px;
    min-height: 90px;
    resize: none;
    padding: 8px;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 12.5px;
    color: #333;
    outline: none;
  }

  /* \u2500\u2500 PRINT \u2500\u2500 */
  .zc-footer-wrapper { display: none; }
  @media print {
    @page {
      margin-top: 40px;
      margin-bottom: 40px;
      margin-left: 10px;
      margin-right: 10px;
      size: A4 landscape;
    }
    .action-bar { display: none !important; }
   #po-footer
   {
page-break-inside: avoid;	   
   }
  }

  span.party-address {
      color: #959595;
    font-weight: 700;
    font-size: 13px;
}
  <%=thisapp.Style.PO_Templet_Style()%>
</style>
</head>
<body>

<div id="po-root">
  <div id="po-card">

    <!-- TOP BAR -->
    <div id="po-topbar">
      <img src="<%=thisapp.Publish_URL.Org_IMG()%>" class="po-logo-img">
      <div class="action-bar">
        <div elName='zc-component' formLinkName='Print_and_PDF_Button' params='zc_Header=false&amp;zc_SuccMsg=Data Added Successfully!&amp;zc_SubmitVal=Submit&amp;zc_ResetVal=Reset&Template=PO_V2&Purchase_Order=<%=input.Po_ID%>'></div>
      </div>
    </div>

    <!-- CONTENT -->
    <div id="po-content">

      <!-- PO HEADER -->
      <div id="po-header">
        <div class="po-meta">
          <div class="po-label">Purchase Order</div>
          <div class="po-number"><%=get_PO.PO_Number%></div>
          <div class="po-issued">Issued <%=get_PO.PO_Date%></div>
        </div>

      </div>

      <hr class="po-divider"/>

      <!-- SUPPLIER / BUYER -->
      <div id="po-parties">
        <div class="po-party">
          <div class="party-title">Buyer</div>
          <div class="party-info">
            <span class="party-name"><%=if(get_PO.Buyer_Organisation.Buyer_Organisation.isEmpty(),"---",get_PO.Buyer_Organisation.Buyer_Organisation)%></span><br>
        <span class = "party-address">    <%=if(get_PO.Buyer_Organisation.Office_Address.isEmpty(),"---",get_PO.Buyer_Organisation.Office_Address)%></span><br>
            <%=if(get_PO.Buyer_Organisation.Primary_Name1.isEmpty(),"---",get_PO.Buyer_Organisation.Primary_Name1)%><br>
            <%=if(get_PO.Buyer_Organisation.Primary_Phone.isEmpty(),"---",get_PO.Buyer_Organisation.Primary_Phone)%><br>
            <%=if(get_PO.Buyer_Organisation.Primary_Email.isEmpty(),"---",get_PO.Buyer_Organisation.Primary_Email)%>
          </div>
        </div>
        <div class="po-party">
          <div class="party-title">Supplier</div>
          <div class="party-info">
            <span class="party-name"><%=if(get_PO.Supplier.Supplier_Organisation.isEmpty(),"---",get_PO.Supplier.Supplier_Organisation)%></span><br>
         <span class = "party-address">     <%=if(get_PO.Supplier.Factory_Address.isEmpty(),"---",get_PO.Supplier.Factory_Address)%><br> </span> 
            <%=if(get_PO.Supplier.Contact_Person2.isEmpty(),"---",get_PO.Supplier.Contact_Person2)%><br>
            <%=if(get_PO.Supplier.Phone.isEmpty(),"---",get_PO.Supplier.Phone)%><br>
            <%=if(get_PO.Supplier.Email.isEmpty(),"---",get_PO.Supplier.Email)%>
          </div>
        </div>
      </div>

      <!-- SUMMARY + FACTORY -->
      <div id="po-summary">
        <div id="po-summary-left">
          <div class="summary-heading">Summary</div>
          <table class="summary-table">
            <tr><td class="s-key">Payment Terms</td><td class="s-colon">:</td><td class="s-val"><%=get_PO.Customer_Name.Associated_Buyer.Payment_Terms%></td></tr>
			            <tr><td class="s-key">Currency</td><td class="s-colon">:</td><td class="s-val"><%=get_PO.Purchase_Currency.Currency_Name%></td></tr>
            <tr><td class="s-key">Total Cost</td><td class="s-colon">:</td><td class="s-val"><%=thisapp.Page.PO_Currency_Convert(get_PO.Total_Purchase_Price.round(2))%></td></tr>
            <tr><td class="s-key">Total Qty</td><td class="s-colon">:</td><td class="s-val"><%=thisapp.Page.PO_Currency_Convert(get_PO_Items.sum(Quantity))%></td></tr>
			            <tr><td class="s-key">COO</td><td class="s-colon">:</td><td class="s-val"><%=if(get_PO.Supplier.Country != null,get_PO.Supplier.Country.Country_Name.upper(),"---")%></td></tr>
            <tr><td class="s-key">Freight Mode</td><td class="s-colon">:</td><td class="s-val"><%=get_PO.Transport_Mode.upper()%></td></tr>
            <tr><td class="s-key">Incoterm</td><td class="s-colon">:</td><td class="s-val">FOB</td></tr>
          </table>
        </div>
        <div id="po-summary-right">
          <div class="factory-block">
            <div class="block-title">Factory</div>
            <div class="block-attn"><span class="attn-name">ATTN :</span> <%=if(get_PO.Factory_Contact_Person.isEmpty(),"---",get_PO.Factory_Contact_Person)%></div>
            <div class="block-info">
              <span class="info-bold"><%=if(get_PO.Factory_Company_Name.isEmpty(),"---",get_PO.Factory_Company_Name)%></span><br>
             <span class = "party-address">   <%=if(get_PO.Factory_Address1.address_line_1.isempty(),"---",get_PO.Factory_Address1.address_line_1)%>, <%=if(get_PO.Factory_Address1.address_line_2.isEmpty(),"---",get_PO.Factory_Address1.address_line_2)%>, <%=if(get_PO.Factory_Address1.district_city.isEmpty(),"---",get_PO.Factory_Address1.district_city)%>, <%=if(get_PO.Factory_Address1.state_province.isEmpty(),"---",get_PO.Factory_Address1.state_province)%>, <%=if(get_PO.Factory_Address1.postal_Code.isEmpty(),"---",get_PO.Factory_Address1.postal_Code)%>, <%=if(get_PO.Factory_Address1.country.isEmpty(),"---",get_PO.Factory_Address1.country)%><br> </span>
              <%=if(get_PO.Factory_Phone.isEmpty(),"---",get_PO.Factory_Phone)%><br>
              <%=if(get_PO.Factory_Email.isEmpty(),"---",get_PO.Factory_Email)%>
            </div>
          </div>
          <div class="delivery-block">
            <div class="block-title">Delivery Address</div>
            <div class="block-attn"><span class="attn-name">ATTN :</span> <%=if(get_PO.Buyer_Contact_Person.isEmpty(),"---",get_PO.Buyer_Contact_Person)%></div>
            <div class="block-info">
              <span class="info-bold"><%=if(get_PO.Buyer_Company_Name.isEmpty(),"---",get_PO.Buyer_Company_Name)%></span><br>
           <span class = "party-address">     <%=if(get_PO.Delivery_Address1.address_line_1.isEmpty(),"---",get_PO.Delivery_Address1.address_line_1)%>, <%=if(get_PO.Delivery_Address1.address_line_2.isEmpty(),"---",get_PO.Delivery_Address1.address_line_2)%>, <%=if(get_PO.Delivery_Address1.district_city.isEmpty(),"---",get_PO.Delivery_Address1.district_city)%>, <%=if(get_PO.Delivery_Address1.state_province.isEmpty(),"---",get_PO.Delivery_Address1.state_province)%>, <%=if(get_PO.Delivery_Address1.postal_Code.isEmpty(),"---",get_PO.Delivery_Address1.postal_Code)%>, <%=if(get_PO.Delivery_Address1.country.isEmpty(),"---",get_PO.Delivery_Address1.country)%><br></span>
              <%=if(get_PO.Buyer_Phone.isEmpty(),"---",get_PO.Buyer_Phone)%><br>
              <%=if(get_PO.Buyer_Email.isEmpty(),"---",get_PO.Buyer_Email)%>
            </div>
          </div>
        </div>
      </div>

      <!-- ORDER TABLE -->
      <%=thisapp.Page.PO_Templet_Table(input.Po_ID,"PO")%>

      <!-- FOOTER SIGNATURE -->
      <div id="po-footer">
        <div id="po-footer-left">
          <div class="sig-row"><span class="sig-label">Name</span><div class="sig-line"></div></div>
          <div class="sig-row"><span class="sig-label">Position</span><div class="sig-line"></div></div>
          <div class="sig-row"><span class="sig-label">Company Stamp</span><div class="sig-line"></div></div>
          <div class="sig-row"><span class="sig-label">Signature</span><div class="sig-line"></div></div>
        </div>
        <div id="po-footer-right">
          <div class="commentss-label">Comments:</div>
          <div class="comments-area"><%=get_PO.Comments%></div>
        </div>
      </div>

    </div><!-- /#po-content -->
  </div><!-- /#po-card -->
</div><!-- /#po-root -->

</body>
</html>