<%
	get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
	// 	if(get_User.User_Type != "Buyer")
	// 	{
	// 		openUrl("#Page:Alert_Message?Message_Type=Buyer_Page","same window");
	// 	}
	get_Data = thisapp.Page.dashboard_data("buyerData");
	%>
<html>

<head>
    <title>Document</title>
	<style>
		.zc-content-loader {
			display: none !important;
		}

		<%=thisapp.Style.buyer_Dashboard_Styles()%>
		
		[pagelinkname="Buyer_Dashboard_V2"], [pagelinkname="Buyer_Dashboard_V2"] div#elementsContainer, [pagelinkname="Buyer_Dashboard_V2"] .Layout.elemContainment, [pagelinkname="Buyer_Dashboard_V2"] div#row_2{
			height: 100%;
		}
		[pagelinkname="Buyer_Dashboard_V2"] .Layout.elemContainment{
			padding: 0 !important;
		}
	</style>
</head>

<body>
    <div class="overAll_Div">
        <div class="stat-cards">

            <a href="#Report:My_Order_Requests?zc_LoadIn=embed-myOrder&zc_MoreAction=false&zc_AddRec=false" class="stat-card">
                <div class="stat-card__body">
				<div class="stat-num"><%=get_Data.get("Total_Request")%></div>
                    <div class="stat-card__icon">

                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M13.3924 34.4712L13.3924 22.4736V16.3602H9.79935C9.43699 16.3602 9.14323 16.0665 9.14323 15.7041V13.3921C9.14323 11.0453 11.0457 9.1429 13.3924 9.1429L28.8983 9.1429C29.8473 9.1429 30.7574 9.56424 31.4285 10.3142C32.0996 11.0642 32.4766 12.0815 32.4766 13.1421V34.4712C32.4774 34.7061 32.4227 34.9371 32.3179 35.1407C32.2132 35.3444 32.0622 35.5135 31.8802 35.631C31.6989 35.748 31.4932 35.8096 31.2838 35.8096C31.0744 35.8096 30.8687 35.748 30.6874 35.631L27.1091 33.3381L23.5309 35.631C23.3496 35.748 23.1439 35.8096 22.9345 35.8096C22.7251 35.8096 22.5194 35.748 22.3381 35.631L18.7598 33.3381L15.1816 35.631C15.0003 35.748 14.7946 35.8096 14.5852 35.8096C14.3758 35.8096 14.1701 35.748 13.9888 35.631C13.8068 35.5135 13.6558 35.3444 13.5511 35.1407C13.4463 34.9371 13.3916 34.7061 13.3924 34.4712Z"
                                fill="#EEDAFF" />
                            <path
                                d="M26.4217 11.9996L15.1651 11.9996M21.6507 22.6641H15.1651M26.4217 17.3319L15.1651 17.3319M10.9159 6.66732L26.4217 6.66732C27.3707 6.66732 28.2809 7.08866 28.9519 7.83865C29.623 8.58865 30 9.60587 30 10.6665L30 31.9956C30.0008 32.2305 29.9461 32.4615 29.8414 32.6652C29.7367 32.8688 29.5856 33.0379 29.4036 33.1554C29.2223 33.2724 29.0166 33.334 28.8072 33.334C28.5979 33.334 28.3922 33.2724 28.2109 33.1554L24.6326 30.8625L21.0543 33.1554C20.873 33.2724 20.6673 33.334 20.4579 33.334C20.2486 33.334 20.0429 33.2724 19.8616 33.1554L16.2833 30.8625L12.705 33.1554C12.5237 33.2724 12.318 33.334 12.1086 33.334C11.8993 33.334 11.6936 33.2724 11.5123 33.1554C11.3302 33.0379 11.1792 32.8688 11.0745 32.6652C10.9698 32.4615 10.915 32.2305 10.9159 31.9956L10.9159 19.998V13.8846M10.9159 6.66732V13.8846M10.9159 6.66732C8.5691 6.66732 6.66667 8.56975 6.66667 10.9165V13.2285C6.66667 13.5909 6.96042 13.8846 7.32279 13.8846H10.9159"
                                stroke="#AD46FF" stroke-width="1.5" stroke-linecap="round" />
                        </svg>

                    </div>
                </div>
                <div class="stat-sub">Total Requests</div>
            </a>

            <a href="#Report:My_Order_Requests?zc_LoadIn=embed-myOrder&Status=Pending&zc_MoreAction=false&zc_AddRec=false" class="stat-card">
                <div class="stat-card__body">
                    <div class="stat-num"><%=get_Data.get("Pending_Request")%></div>
                    <div class="stat-card__icon">

                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M23.9994 37.7147C31.5736 37.7147 37.7137 31.5746 37.7137 24.0004C37.7137 16.4262 31.5736 10.2861 23.9994 10.2861C16.4253 10.2861 10.2852 16.4262 10.2852 24.0004C10.2852 31.5746 16.4253 37.7147 23.9994 37.7147Z"
                                fill="#FFEDD9" />
                            <path
                                d="M20.5717 34.286C28.1459 34.286 34.286 28.1459 34.286 20.5717C34.286 12.9975 28.1459 6.85742 20.5717 6.85742C12.9975 6.85742 6.85742 12.9975 6.85742 20.5717C6.85742 28.1459 12.9975 34.286 20.5717 34.286Z"
                                stroke="#FF8904" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M20.5723 12.5713V20.2856L26.2866 22.857" stroke="#FF8904" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>

                    </div>
                </div>
                <div class="stat-sub">Pending</div>
            </a>

            <a href="#Report:My_Order_Requests?zc_LoadIn=embed-myOrder&Status=[Submitted,Validation Pending,In Transit,Approved]&zc_MoreAction=false&zc_AddRec=false" class="stat-card">
                <div class="stat-card__body">
                    <div class="stat-num"><%=get_Data.get("InProgress_Request")%></div>
                    <div class="stat-card__icon">

                        <svg width="35" height="35" viewBox="0 0 35 35" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M20.7143 34.4286C28.2885 34.4286 34.4286 28.2885 34.4286 20.7143C34.4286 13.1401 28.2885 7 20.7143 7C13.1401 7 7 13.1401 7 20.7143C7 28.2885 13.1401 34.4286 20.7143 34.4286Z"
                                fill="#FFEAFA" />
                            <path
                                d="M15.0811 30.8513C7.85756 29.3646 3.20687 22.3036 4.69354 15.08C6.18021 7.85641 13.2413 3.20572 20.4648 4.69238"
                                stroke="#FF04C0" stroke-width="2" stroke-linecap="round" stroke-dasharray="3 3" />
                            <path
                                d="M20.4648 4.69238C27.6884 6.17905 32.3391 13.2401 30.8525 20.4637C29.633 26.3887 24.6633 30.5828 18.9296 31.0788"
                                stroke="#FF04C0" stroke-width="2" stroke-linecap="round" />
                            <path d="M23.6653 13.1982L15.954 21.8609L11.6738 18.3375" stroke="#FF04C0" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>

                    </div>
                </div>
                <div class="stat-sub">In progress</div>
            </a>

            <a href="#Report:My_Order_Requests?zc_LoadIn=embed-myOrder&Status=Completed&zc_MoreAction=false&zc_AddRec=false" class="stat-card">
                <div class="stat-card__body">
                    <div class="stat-num"><%=get_Data.get("Completed_Request")%></div>
                    <div class="stat-card__icon">
                        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M22.8569 36.5712C30.4311 36.5712 36.5712 30.4311 36.5712 22.8569C36.5712 15.2827 30.4311 9.14258 22.8569 9.14258C15.2827 9.14258 9.14258 15.2827 9.14258 22.8569C9.14258 30.4311 15.2827 36.5712 22.8569 36.5712Z"
                                fill="#D6F2C5" />
                            <path
                                d="M20.2857 34.5714C28.1755 34.5714 34.5714 28.1755 34.5714 20.2857C34.5714 12.3959 28.1755 6 20.2857 6C12.3959 6 6 12.3959 6 20.2857C6 28.1755 12.3959 34.5714 20.2857 34.5714Z"
                                stroke="#51B517" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M25.9915 16L18.2802 24.6627L14 21.1392" stroke="#51B517" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>

                    </div>
                </div>
                <div class="stat-sub">Completed</div>
            </a>

        </div>
        <div class="report_Div">
			<div elName='zc-component' name="myOrder" style="height: 100%;" viewLinkName='My_Order_Requests' params='zc_Header=true&zc_MoreAction=false&zc_AddRec=false'></div>
        </div>
    </div>
</body>

</html>