<page linkname = "Buyer_Dashboard" displayname = "Buyer Dashboard"/>
<content>
<zml webDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>
	<layout>
		<row>
			<column width='25%'>
				<file name:Panel.ds/>
			</column>
			<column width='25%'>
				<file name:Panel_1.ds/>
			</column>
			<column width='25%'>
				<file name:Panel_2.ds/>
			</column>
			<column width='25%'>
				<file name:Panel_3.ds/>
			</column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='html_snippet5' elementName='HTML Snippet' bgColor=\"#FFFFFF\">
          <![CDATA[htmlpage html_snippet5()
content
			<%{%>
            <file name:HTML_Snippet.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
	</layout>
</zml>
</content>
