<%
	if(input.DeleteCart == "Delete")
	{
		thisapp.Delete_Records.Delete_Cart_Details(input.Buyer_ID,input.Suppliyer_ID);
		openUrl("#Script:page.refresh","same window");
	}
	%>
<style>
		.no_Data{
		    height: 100%;
			align-content: center;
			text-align: center;
			font-size: 16px;
			font-weight: 600;
		}
	</style>
<div style="height: 100%;">
<%
	if(input.Suppliyer_ID != null)
	{
		%>
<a href="#Page:Cart_Page?zc_LoadIn=embed-cartPage&Buyer_ID=<%=input.Buyer_ID%>&Suppliyer_ID=<%=input.Suppliyer_ID%>" class="cartSection">
		<div class="cartRow">
			<div class="cartCount"><%=thisapp.Page.Cart_Count(input.Buyer_ID,input.Suppliyer_ID)%></div>
			<div class="cartIcon">
				<svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="rgb(113 113 140)"><path d="M280-80q-33 0-56.5-23.5T200-160q0-33 23.5-56.5T280-240q33 0 56.5 23.5T360-160q0 33-23.5 56.5T280-80Zm400 0q-33 0-56.5-23.5T600-160q0-33 23.5-56.5T680-240q33 0 56.5 23.5T760-160q0 33-23.5 56.5T680-80ZM246-720l96 200h280l110-200H246Zm-38-80h590q23 0 35 20.5t1 41.5L692-482q-11 20-29.5 31T622-440H324l-44 80h480v80H280q-45 0-68-39.5t-2-78.5l54-98-144-304H40v-80h130l38 80Zm134 280h280-280Z"/></svg>
			</div>
		</div>	
	</a>
<%
		get_Product_List = thisapp.Filters.Filter_Products();
		if(get_Product_List.size() > 0)
		{
			%>
<div elName='zc-component' viewLinkName='Active_Products' params='zc_Header=true&zc_AddRec=false&zc_MoreAction=false&zc_ReportName=false'></div>
<%
		}
		else
		{
			%>
<div class="no_Data">No products available for the selected buyer.</div>
<%
		}
	}
	else
	{
		%>
<div class="no_Data">Please select a factory before adding the product to your cart.</div>
<%
	}
	%>
</div>