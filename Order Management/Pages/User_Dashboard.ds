<page linkname = "User_Dashboard" displayname = "User Dashboard"/>
<content>
<zml webDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>
	<layout>
		<row>
			<column width='25%'>
				<file name:Panel.ds/>
			</column>
			<column width='25%'>
				<file name:Panel_1.ds/>
			</column>
			<column width='25%'>
				<file name:Panel_2.ds/>
			</column>
			<column width='25%'>
				<file name:Panel_3.ds/>
			</column>
		</row>
		<row>
			<column width='50%'>
				<chart elementName='Chart 1' title='Request Details' titleSize='16px' titleColor='#222326' type='Donut' bgColor='#FFFFFF' theme='theme1' legendPos='right.center' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Order_Request' xfield='Status' yfields='count:Status' /> </column>
			<column width='50%'>
				<chart elementName='Chart 2' title='Purchase Orders' titleSize='16px' titleColor='#222326' type='Bar' bgColor='#FFFFFF' theme='theme1' legendPos='center.top' heightType='auto' heightValue='300px' appLinkName='thisapp' formLinkName='Purchase_Order' xfield='Order_Status' yfields='count:Order_Status' /> </column>
		</row>
		<row>
			<column width='100%'>
				<dsp id='html_snippet61' elementName='HTML Snippet' bgColor=\"#FFFFFF\">
          <![CDATA[htmlpage html_snippet61()
content
			<%{%>
            <file name:HTML_Snippet.dshtml/>
			<%}%>
      
      ]]>
        </dsp>
			</column>
		</row>
	</layout>
</zml>
</content>