default list All_Wardrobes
{

			displayName = "Wardrobes"
			show all rows from Wardrobe    
			(
				Wardrobe_Name as "Wardrobe Name"
				Product_Category as "Product Category"
				Product_Category1 as "Product Category old  value"
			)
			custom actions
			(
				"Delete Wardrobes"
				(
	  			workflow = Delete_Selected_Wardrobes
				show action in view header = true
				show action in edit record menu = true
				condition = (ID != thisapp.Delete_Records.Delete_Wardrobes())
				)
				"Edit "
				(
	  			workflow = Edit_Wardrobes
				show action in view header = true
				show action in edit record menu = true
				)
				"Delete "
				(
	  			workflow = Delete_Wardrobe1
				show action in view header = true
				show action in edit record menu = true
				)
			)
		
}