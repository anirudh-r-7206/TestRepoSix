Delete_Wardrobe1 as "Delete Wardrobe"
{

				type =  functions
				form = Wardrobe
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						reference = thisapp.References.Wardrobe(input.ID);
										if(reference.trim() != "" && reference != null)
										{
											url = "#Form:Alert_References?zc_Header=false&Wardrobe=" + input.ID;
											window = "popup window";
											openUrl(url,window);
										}
										else
										{
											delete from Wardrobe[ID == input.ID];
										}
					)
					}
				}
			
}