Edit_Wardrobes as "Edit Wardrobes"
{

				type =  functions
				form = Wardrobe
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						reference = thisapp.References.Wardrobe(input.ID);
										if(reference.trim() != "" && reference != null)
										{
											url = "#Form:Alert_References?zc_Header=false&Wardrobe=" + input.ID + "&zc_NextUrl=#Script:page.refresh";
											window = "popup window";
										}
										else
										{
											url = "#Form:Wardrobe?zc_LoadIn=dialog&viewLinkName=All_Wardrobes&recLinkID=" + input.ID + "&zc_NextUrl=#Script:page.refresh";
											window = "same window";
										}
										openUrl(url,window);
					)
					}
				}
			
}