form Email_Template
{

			displayname = "Email Template"
			success message = "Email Template Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Template_Name
			(
    			type = text
				displayname = "Template Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Notification_Type
			(
				type = picklist
				displayname = "Notification Type"
				maxchar = 100
				values = {"Email","In-App Notification"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_CC_Emails
			(
				type = list	
				displayname = "Additional CC Emails"
				values  = Create_User[User_Type == "Internal" || User_Type == "Admin"].ID
    			displayformat = [Email]
				sortorder = ascending
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Subject_field
			(
    			type = text
				displayname = "Subject"
	 			row = 1
	 			column = 1   
				width = large
			)
			must have Message_Content
			(
    			type = richtext
				displayname = "Message Content"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, html, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = large
			)
			must have In_App_Message_Content
			(
    			type = textarea
				displayname = "In-App Message Content"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}