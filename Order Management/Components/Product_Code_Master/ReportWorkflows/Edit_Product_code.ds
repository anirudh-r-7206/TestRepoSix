Edit_Product_code as "Edit Product code"
{

				type =  functions
				form = Product_Code_Master
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						reference = thisapp.References.ProductCodeMaster(input.ID);
										if(reference.trim() != "" && reference != null)
										{
											url = "#Form:Alert_References?zc_Header=false&Product_Code_Master=" + input.ID + "&zc_NextUrl=#Script:page.refresh";
											window = "popup window";
										}
										else
										{
											url = "#Form:Product_Code_Master?zc_LoadIn=dialog&viewLinkName=All_Product_Code_Masters&recLinkID=" + input.ID + "&zc_NextUrl=#Script:page.refresh";
											window = "same window";
										}
										openUrl(url,window);
					)
					}
				}
			
}