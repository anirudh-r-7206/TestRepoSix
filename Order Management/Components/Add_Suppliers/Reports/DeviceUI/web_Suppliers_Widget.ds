report Suppliers_Widget
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Supplier_Code as "Supplier Code"
								Supplier_Organisation as "Supplier Organisation"
								Email
								Phone as "Phone "
								Factory_Address as "Invoice Address"
								Status
								Supplier_type as " Supplier type"
							)
						)
					)
						menu
						(
							header
							(
								"Delete Suppliers"
							)
						record
						(
							"Activate"
							"Deactivate"
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							"Activate"
							"Deactivate"
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Supplier_type as " Supplier type"
								Supplier_Code as "Supplier Code"
								Supplier_Organisation as "Supplier Organisation"
								Contact_Person as "Contact Person1"
								Email
								Phone as "Phone "
								Factory_Address as "Invoice Address"
								Country
								ERP_System as "ERP System"
								Status
							)
						)
						datablock4
						(
							layout type = -1
		     				title = "User"
		     				related field = Create_User_Employee_External_ID
							fields
							(
								User_Name as "User Name"
								Employee_External_ID as "Employee/External ID"
								Email
								Mobile_Number as "Mobile Number"
								User_Type as "User Type"
								Persona_Role as "Persona/Role"
								Status as "Status "
							)
						)
						datablock5
						(
							layout type = -1
		     				title = "Associated Buyers"
		     				related field = Create_User.Associated_Factory
							fields
							(
								User_Name as "User Name"
								Employee_External_ID as "Employee/External ID"
								Email
								Mobile_Number as "Mobile Number"
								User_Type as "User Type"
								Persona_Role as "Persona/Role"
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								"Activate"
								"Deactivate"
								Edit 
							)
						)
				)
			
}