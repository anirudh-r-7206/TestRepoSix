Valid_Secondary_Person_De as "Valid Secondary Person Details"
{

				type =  form
				form = Add_Suppliers

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(!Contact_Person3.first_name.isEmpty() && Contact_Person3.last_name.isEmpty())
										{
											alert "Please enter the last name in Secondary Contact Details.";
											cancel submit;
										}
										else if(Contact_Person3.first_name.isEmpty() && !Contact_Person3.last_name.isEmpty())
										{
											alert "Please enter the first name in Secondary Contact Details.";
											cancel submit;
										}
										else if(!Contact_Person3.first_name.isEmpty() && !Contact_Person3.last_name.isEmpty())
										{
											if(input.Email1.isEmpty())
											{
												alert "Please enter the email address in Secondary Contact Details.";
												cancel submit;
											}
											else if(input.Phone_Number.isEmpty())
											{
												alert "Please enter the phone number in Secondary Contact Details.";
												cancel submit;
											}
										}
										else if(!input.Email1.isEmpty())
										{
											if(Contact_Person3.first_name.isEmpty() || Contact_Person3.last_name.isEmpty())
											{
												alert "Please enter the full name in Secondary Contact Details.";
												cancel submit;
											}
											else if(input.Phone_Number.isEmpty())
											{
												alert "Please enter the phone number in Secondary Contact Details.";
												cancel submit;
											}
										}
										else if(!input.Phone_Number.isEmpty())
										{
											if(Contact_Person3.first_name.isEmpty() || Contact_Person3.last_name.isEmpty())
											{
												alert "Please enter the full name in Secondary Contact Details.";
												cancel submit;
											}
											else if(input.Email1.isEmpty())
											{
												alert "Please enter the email address in Secondary Contact Details.";
												cancel submit;
											}
										}
						)
					}
				}

			
}