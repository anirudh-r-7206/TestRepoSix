Generate_Supplier_Code as "Generate Supplier Code"
{

				type =  form
				form = Add_Suppliers

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Supplier_type = "Factory")
										{
											fet_Supplier = Add_Suppliers[Supplier_type == "Factory"] sort by Added_Time desc;
											if(fet_Supplier.count(ID) > 0)
											{
												id_number = fet_Supplier.Supplier_Code;
												id_number = id_number.getsuffix("FAC-").toNumber() + 1;
												id_number = id_number.leftpad(4).replaceAll(" ","0");
												input.Supplier_Code = "FAC-" + id_number;
											}
											else
											{
												id_number = 1;
												id_number = id_number.leftPad(4).replaceAll(" ","0");
												input.Supplier_Code = "FAC-" + id_number;
											}
										}
										else if(input.Supplier_type == "Fabrics")
										{
											fet_Supplier = Add_Suppliers[Supplier_type == "Fabrics"] sort by Added_Time desc;
											if(fet_Supplier.count(ID) > 0)
											{
												id_number = fet_Supplier.Supplier_Code;
												id_number = id_number.getsuffix("FAB-").toNumber() + 1;
												id_number = id_number.leftpad(4).replaceAll(" ","0");
												input.Supplier_Code = "FAB-" + id_number;
											}
											else
											{
												id_number = 1;
												id_number = id_number.leftPad(4).replaceAll(" ","0");
												input.Supplier_Code = "FAB-" + id_number;
											}
										}
										else if(input.Supplier_type == "Others")
										{
											fet_Supplier = Add_Suppliers[Supplier_type == "Others"] sort by Added_Time desc;
											if(fet_Supplier.count(ID) > 0)
											{
												id_number = fet_Supplier.Supplier_Code;
												id_number = id_number.getsuffix("OT-").toNumber() + 1;
												id_number = id_number.leftpad(4).replaceAll(" ","0");
												input.Supplier_Code = "OT-" + id_number;
											}
											else
											{
												id_number = 1;
												id_number = id_number.leftPad(4).replaceAll(" ","0");
												input.Supplier_Code = "OT-" + id_number;
											}
										}
						)
					}
				}

			
}