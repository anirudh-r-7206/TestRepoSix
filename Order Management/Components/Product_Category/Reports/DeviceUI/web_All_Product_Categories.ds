report All_Product_Categories
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Product_Category as "Product Category"
								Wardrobe
								Style
								Status
							)
						)
					)
						menu
						(
							header
							(
							)
						record
						(
							"Activate"
							"Deactivate"
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							"Activate"
							"Deactivate"
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Product_Category as "Product Category"
								Wardrobe
								Style
								Status
							)
						)
						datablock2
						(
							layout type = -1
		     				title = "Products Catalogue"
		     				related field = Add_Product.Style_Category
							fields
							(
								Style_Name as "Style Name"
								Product_Picture.Image as "Product Picture"
								Product_Description as "Fabric Description"
								Style_Colour as "Style Colour"
								Style_Range as "Style Range"
								Product_Weight as "Product Weight"
								Gender
								Size_Set as "Size Set"
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								"Edit "
								"Delete "
								"Activate"
								"Deactivate"
							)
						)
				)
			
}