default list All_Buyer_Mapping_Wardrobes
{

			displayName = "All Buyer Mapping Wardrobes"
			show all rows from Buyer_Mapping_Wardrobes    
			(
				Wardrobe
				Product_Category as "Product Category"
				Buyer_Product_Mapping as "Buyer Product Mapping"
				Buyer_Product_Mapping.Buyer
				Buyer_Product_Mapping.Factory_Allocated as "Factory Allocated"
				ID
			)
		
}