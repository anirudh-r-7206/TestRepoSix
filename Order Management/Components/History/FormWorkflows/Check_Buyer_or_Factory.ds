Check_Buyer_or_Factory as "Check Buyer or Factory"
{

				type =  form
				form = History

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											hide Order_ID;
										hide Approval_Status;
										disable Purchase_Order_ID;
										disable Raised_By;
										hide On_behalf_of;
										hide Status;
										hide QO_Viewed;
										hide Copy_of_Purchase_Order;
										hide Hide_Section;
										if(input.Raised_By == null)
										{
											get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
											input.Raised_By = get_User.ID;
										}
										if(input.Raised_By != null)
										{
											if(Raised_By.User_Type == "Buyer")
											{
												show Status;
												input.On_behalf_of = "Buyer";
												if(input.Purchase_Order_ID.Order_Status == "Awaiting Buyer Review" && input.Status.isEmpty())
												{
													input.Status:ui.add({"Approved","Amendment / Cancellation Required"});
												}
												else
												{
													input.Status:ui.add({"Amendment / Cancellation Required"});
													Status.select("Amendment / Cancellation Required");
													disable Status;
												}
											}
											else if(Raised_By.User_Type == "Factory")
											{
												show Status;
												input.On_behalf_of = "Factory";
												if(input.Purchase_Order_ID.Order_Status == "Awaiting Factory Review" && input.Status.isEmpty())
												{
													input.Status:ui.add({"Move to Production","Amendment / Cancellation Required"});
												}
												else
												{
													input.Status:ui.add({"Amendment / Cancellation Required"});
													Status.select("Amendment / Cancellation Required");
													disable Status;
												}
											}
											else
											{
												show On_behalf_of;
											}
										}
										else
										{
										}
						)
					}
				}

			
}