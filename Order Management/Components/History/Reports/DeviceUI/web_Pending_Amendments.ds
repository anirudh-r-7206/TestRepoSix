report Pending_Amendments
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Purchase_Order_ID.PO_Number as "PO Number"
								Purchase_Order_ID.QO_Number as "QO Number"
								Raised_By as "Raised By"
								Status
								Comments
								Purchase_Order_ID.Order_Type as "Order Type "
								Purchase_Order_ID.Order_Reference as "Order Reference"
								Purchase_Order_ID.Buyer_Organisation as "Buyer Organisation"
								Purchase_Order_ID.Supplier as "Supplier"
								Purchase_Order_ID.Total_Quantity as "Total Quantity"
								Purchase_Order_ID.Incoterms as "Incoterm"
								Purchase_Order_ID.Selling_Currency as "Selling Currency"
								Purchase_Order_ID.Total_Selling_Price as "Total Selling Price"
								Purchase_Order_ID.Purchase_Currency as "Purchase Currency"
								Purchase_Order_ID.Total_Purchase_Price as "Total Purchase Price"
								Approval_Status as "Approval Status"
								"View QO"
								"Approve"
								"Reject"
								"Edit QO"
								"Generate/Update PO"
							)
						)
					)
						menu
						(
							header
							(
							)
						record
						(
							"Send to Buyer"
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							View Record   	   
							"Send to Buyer"
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Purchase_Order_ID.QO_Number as "QO Number"
								Raised_By as "Raised By"
								Status
								Approval_Status as "Approval Status"
								Comments
							)
						)
						datablock3
						(
		     				title = "Purchase Order"
		     				related field = Purchase_Order_ID
							fields
							(
								QO_Number as "QO Number"
								Order_Reference as "Order Reference"
								Supplier
								Buyer_Organisation as "Buyer Organisation"
								Total_Quantity as "Total Quantity"
								Purchase_Currency as "Purchase Currency"
								Total_Purchase_Price as "Total Purchase Price"
								Selling_Currency as "Selling Currency"
								Total_Selling_Price as "Total Selling Price"
							)
						)
					)
						menu
						(
							header
							(
							)
						)
				)
			
}