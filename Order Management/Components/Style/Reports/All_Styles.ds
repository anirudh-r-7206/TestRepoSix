default list All_Styles
{

			displayName = "Styles"
			show all rows from Style    
			(
				Style_Name as "Style Name"
				Style_Code as "Style Code"
				Style_Description as "Style Description"
				Product_Code as "Style Master Code"
				Product_Colour as "Style Colour"
				Style_Category as "Style Category"
			)
			group by
			(
				Style_Category ascending
			)
			custom actions
			(
				"Delete Styles"
				(
	  			workflow = Delete_Selected_Styles
				show action in view header = true
				show action in edit record menu = true
				condition = (ID != thisapp.Delete_Records.Delete_Styles())
				)
				"Edit "
				(
	  			workflow = Edit_Style1
				show action in view header = true
				show action in edit record menu = true
				)
				"Delete "
				(
	  			workflow = Delete_Style1
				show action in view header = true
				show action in edit record menu = true
				confirmation before execution
				(
					message for individual record = "Execute the Delete Style action for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		
}