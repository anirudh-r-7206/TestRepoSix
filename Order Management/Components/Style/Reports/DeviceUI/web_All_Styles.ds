report All_Styles
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Product_Code as "Style Master Code"
								Style_Code as "Style Code"
								Product_Colour as "Style Colour"
								Style_Description as "Style Description"
							)
						)
					)
						menu
						(
							header
							(
							)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Style_Category as "Style Category"
								Product_Code as "Style Master Code"
								Style_Code as "Style Code"
								Product_Colour as "Style Colour"
								Style_Description as "Style Description"
								Style_Name as "Style Name"
							)
						)
						datablock2
						(
							layout type = -1
		     				title = "Products Catalog Form"
		     				related field = Add_Product.Style_Code
							fields
							(
								Style_Category as "Product Category"
								Style_Name as "Style Name"
								Product_Description as "Fabric Description"
								Style_Colour as "Style Colour"
								Style_Range as "Style Range"
								Product_Weight as "Product Weight"
								Size_Set as "Size Set"
								Gender
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								"Edit "
								"Delete "
							)
						)
				)
			
}