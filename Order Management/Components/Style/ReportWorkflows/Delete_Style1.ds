Delete_Style1 as "Delete Style"
{

				type =  functions
				form = Style
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						reference = thisapp.References.Style(input.ID);
										if(reference.trim() != "" && reference != null)
										{
											url = "#Form:Alert_References?zc_Header=false&Style=" + input.ID;
											window = "popup window";
											openUrl(url,window);
										}
										else
										{
											delete from Style[ID == input.ID];
										}
					)
					}
				}
			
}