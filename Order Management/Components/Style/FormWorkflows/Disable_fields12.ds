Disable_fields12 as "Disable fields"
{

				type =  form
				form = Style

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											get_Style_List = thisapp.Delete_Records.Delete_Styles();
										enable Style_Name;
										if(input.ID in get_Style_List)
										{
											disable Style_Name;
										}
						)
					}
				}

			
}