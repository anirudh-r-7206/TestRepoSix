On_Created_Edited_User_in1 as "On Created & Edited - User input of Hex Color Code"
{

				type =  form
				form = Add_Colors

				record event = on add or edit

				on user input of Hex_Color_Code
				{
					actions 
					{
						custom deluge script
						(
											if(input.Hex_Color_Code != null && input.Hex_Color_Code.toString() != "")
										{
											isValid = input.Hex_Color_Code.matches("^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$");
											if(!isValid)
											{
												alert "Invalid hex color code. Use format #RRGGBB (e.g. #FF5733) or shorthand #RGB (e.g. #F53).";
												input.Hex_Color_Code = null;
											}
											// 	else
											// 	{
											// 		input.plain = "<style>label[for=\"zc-Hex_Color_Code\"] + div:after { content: \"\"; height: 25px; width: 25px; background: " + input.Hex_Color_Code + "; border-radius: 50%; display: inline-block; vertical-align: middle; margin-left: 10px; margin-top: 5px; box-shadow: rgb(0 0 0 / 25%) 0px 0px 50px 1px; border: 0.1px solid lightgrey; }</style>";
											// 	}
										}
										else
										{
											// 	input.plain = "";
										}
						)
					}
				}

			
}