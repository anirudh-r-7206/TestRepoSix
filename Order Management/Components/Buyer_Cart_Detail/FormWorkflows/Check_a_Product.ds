Check_a_Product as "Check a Product"
{

				type =  form
				form = Buyer_Cart_Detail

				record event = on add

				on user input of Colour
				{
					actions 
					{
						custom deluge script
						(
											if(input.Colour != null)
										{
											get_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() && Status == "Active"];
											get_Order_Buyer = Order_Request[Order_By.Email == thisapp.Dev.get_User_Email() && Factory == input.Supplier && Status == "Pending"];
											get_Style_IDs = Style[Product_Code == input.Product_Code].ID.getAll();
											if(get_Order_Buyer.count() > 0)
											{
												get_Order_Product = Order_Details[Order_Request == get_Order_Buyer.ID && Product.Wardrobe == input.Wardrobe && Product.Style_Category == input.Product_Category && Product.Style_Code in get_Style_IDs && Product_Size == input.Size && Product_Color == input.Colour];
												if(get_Order_Product.count() > 0)
												{
													input.Quantity = get_Order_Product.Quantity;
												}
												else
												{
													input.Quantity = 1;
												}
											}
											get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer.Associated_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID.Style_Code in get_Style_IDs && Style_ID.Wardrobe == input.Wardrobe && Style_ID.Style_Category == input.Product_Category && Size == input.Size && Colors == input.Colour];
											if(get_Product.count() > 0)
											{
												input.Product_Style = "<div class=\"product-details\"><div class=\"product_name\">" + get_Product.Style_ID.Style_Name + "</div> <div class=\"product_price\">$" + (get_Product.Sell_Price.getall()).smallest() + "</div> <div class=\"product-description\"> " + if(!get_Product.Style_Description.isEmpty(),get_Product.Style_Description,"") + " </div><a href=\"#Page:Size_Chart_Page?zc_LoadIn=dialog\" class=\"sizeChartLink\">Size Chart &gt;</a></div>";
												openUrl("#Page:Dynamic_Product_Image?zc_LoadIn=embed-ProductIMG&Product_ID=" + get_Product.Style_ID,"same window");
											}
											//
											get_Product_Color = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer.Associated_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID.Style_Code in get_Style_IDs && Style_ID.Wardrobe == input.Wardrobe && Style_ID.Style_Category == input.Product_Category && Size == input.Size].Colors.getAll().distinct();
											if(get_Product_Color.size() > 0)
											{
												color_Count = 0;
												for each  col in get_Product_Color
												{
													color_Count = color_Count + 1;
													get_Color_Master = Add_Colors[ID == col];
													input.Product_Style = input.Product_Style + "<style>span > input[type=\"radio\"] + label[elname=\"radioEl_zc-Colour_" + color_Count + "\"] { background-color: " + get_Color_Master.Hex_Color_Code + " !important; }</style>";
												}
											}
										}
						)
					}
				}

			
}