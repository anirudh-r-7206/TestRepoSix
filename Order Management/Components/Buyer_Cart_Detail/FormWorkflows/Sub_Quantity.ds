Sub_Quantity as "Sub Quantity"
{

				type =  form
				form = Buyer_Cart_Detail

				record event = on add

				on user input of Decision_box2
				{
					actions 
					{
						custom deluge script
						(
											if(input.Quantity > 1)
										{
											input.Quantity = input.Quantity - 1;
										}
										else
										{
											input.Quantity = 1;
											alert "Quantity cannot be less than 1.";
										}
						)
					}
				}

			
}