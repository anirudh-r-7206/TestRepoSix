form Buyer_Filter
{

			displayname = "Buyer Filter"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Select_Supplier
			(
				type = picklist	
				displayname = "Select Supplier"
				values  = Add_Suppliers.ID
    			displayformat = [Supplier_Organisation]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
	
		
}