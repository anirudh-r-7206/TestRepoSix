default list Awaiting_Approvals
{

			displayName = "Buyers"
			show all rows from Buyers_Master  [Approval_Status == "Pending"]  
			(
				Buyer_Code as "Buyer Code"
				Buyer_Type as "Buyer Type"
				Region
				custom action "Raise Order"
				(
	  			workflow = Raise_Order
				show action in edit record menu = true
				column header = "Raise Order"
				condition = (Approval_Status == "Approved")
				)
				Office_Address  as "Invoice Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				custom action "Delete Buyer"
				(
	  			workflow = Delete_Selected_Buyers
				show action in view header = true
				show action in edit record menu = true
				column header = "Delete Buyer"
				condition = (ID != thisapp.Buyer.Order_Request_Buyers())
				)
				Product_Range as "Product Range"
				Wardrobe
				Country
				Approval_Status as "Approval Status"
				HS_Code_Allocation as "HS Code Allocation"
				Payment_Terms as "Payment Terms"
				Currency1 as "Currency"
				Primary_Email as "Email"
				Primary_Phone as "Phone"
				(
					displayformat = plainnumber 
				)
				Buyer_Organisation as "Buyer Organisation"
				Currency
				Primary_Name1  as "Name"
				Person_2_Email as "Email"
				Person_2_Phone as "Phone"
				(
					displayformat = plainnumber 
				)
				custom action "Approve"
				(
	  			workflow = Buyer_Approve
				show action in view header = true
				show action in edit record menu = true
				column header = "Approve"
				condition = (Approval_Status == "Pending")
				)
				custom action "Reject"
				(
	  			workflow = Buyer_Reject
				show action in view header = true
				show action in edit record menu = true
				column header = "Reject"
				condition = (Approval_Status == "Pending")
				)
			)
			filters
			(
				Approval_Status
				Region
			)
			custom actions
			(
				"Activate"
				(
	  			workflow = Activate_Buyers
				show action in view header = true
				show action in edit record menu = true
				condition = (Status == "Inactive")
				)
				"Deactivate"
				(
	  			workflow = Deactivate_Buyer
				show action in view header = true
				show action in edit record menu = true
				condition = (Status == "Active")
				)
			)
			conditional formatting
			(
				"Pending"
				{
				condition = (Approval_Status == "Pending")
				fields = [Approval_Status]
				format = "color:#398ef3;"
				}
				"Approved"
				{
				condition = (Approval_Status == "Approved")
				fields = [Approval_Status]
				format = "color:#5dc35a;"
				}
				"Rejected"
				{
				condition = (Approval_Status == "Rejected")
				fields = [Approval_Status]
				format = "color:#ef1616;"
				}
			)
		
}