Valid_emails as "Valid emails"
{

				type =  form
				form = Buyers_Master

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Primary_Email.equalsIgnoreCase(input.Person_2_Email))
										{
											alert(Person_2_Email,"Duplicate email not allowed.");
											input.Person_2_Email = null;
											alert(Primary_Email,"Duplicate email not allowed.");
											input.Primary_Email = null;
											cancel submit;
										}
										duplicate_Email = false;
										focal_Count = 0;
										for each  focal in input.Focal_Details_Subform
										{
											focal_Count = focal_Count + 1;
											if(focal.Email.equalsIgnoreCase(input.Person_2_Email) || focal.Email.equalsIgnoreCase(input.Primary_Email))
											{
												// 		alert "Duplicate email not allowed.";
												duplicate_Email = true;
												focal.Email=null;
												cancel submit;
											}
											sub_Focal_Count = 0;
											for each  subFocal in input.Focal_Details_Subform
											{
												sub_Focal_Count = sub_Focal_Count + 1;
												if(focal_Count != sub_Focal_Count && focal.Email.equalsIgnoreCase(subFocal.Email))
												{
													// 			alert "Duplicate email not allowed.";
													duplicate_Email = true;
													subFocal.Email=null;
													cancel submit;
												}
											}
										}
										if(duplicate_Email == true)
										{
											alert "This email address has already been added. Duplicate email addresses are not allowed.";
										}
										else
										{
											if(!Person_2_Name1.first_name.isEmpty() && Person_2_Name1.last_name.isEmpty())
											{
												alert "Please enter the last name for Contact Person.";
												cancel submit;
											}
											else if(Person_2_Name1.first_name.isEmpty() && !Person_2_Name1.last_name.isEmpty())
											{
												alert "Please enter the first name for Contact Person.";
												cancel submit;
											}
											else if(!Person_2_Name1.first_name.isEmpty() && !Person_2_Name1.last_name.isEmpty())
											{
												if(input.Person_2_Email.isEmpty())
												{
													alert "Please enter the email address for Contact Person.";
													cancel submit;
												}
												else if(input.Person_2_Phone.isEmpty())
												{
													alert "Please enter the phone number for Contact Person.";
													cancel submit;
												}
											}
											else if(!input.Person_2_Email.isEmpty())
											{
												if(Person_2_Name1.first_name.isEmpty() || Person_2_Name1.last_name.isEmpty())
												{
													alert "Please enter the full name for Contact Person.";
													cancel submit;
												}
												else if(input.Person_2_Phone.isEmpty())
												{
													alert "Please enter the phone number for Contact Person.";
													cancel submit;
												}
											}
											else if(!input.Person_2_Phone.isEmpty())
											{
												if(Person_2_Name1.first_name.isEmpty() || Person_2_Name1.last_name.isEmpty())
												{
													alert "Please enter the full name for Contact Person.";
													cancel submit;
												}
												else if(input.Person_2_Email.isEmpty())
												{
													alert "Please enter the email address for Contact Person.";
													cancel submit;
												}
											}
										}
						)
					}
				}

			
}