Disable_fields5 as "Disable fields"
{

				type =  form
				form = Buyers_Master

				record event = on edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.Same_as_previous_selectable == true)
										{
											disable Delivery_Address;
										}
										if(input.Primary_Email != null && input.Primary_email_old == null)
										{
											input.Primary_email_old = input.Primary_Email;
										}
										if(input.Person_2_Email != null && input.Secondary_email_old == null)
										{
											input.Secondary_email_old = input.Person_2_Email;
										}
										for each  delivery in input.Delivery_Person_Details
										{
											if(delivery.Email != null && delivery.Email_old == null)
											{
												delivery.Email_old=delivery.Email;
											}
										}
										if(input.Wardrobe.size() > 0 && input.Wardrobe1.size() == 0)
										{
											input.Wardrobe1 = input.Wardrobe;
										}
						)
					}
				}

			
}