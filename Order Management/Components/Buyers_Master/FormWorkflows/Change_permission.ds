Change_permission as "Change permission"
{

				type =  form
				form = Buyers_Master

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status != old.Status)
										{
											alert "Status cannot be changed.";
											cancel submit;
										}
										get_Removed_Wardrobe = input.Wardrobe1;
										get_Removed_Wardrobe.removeAll(input.Wardrobe);
										mapped_Wardrobe = list();
										wardrobe_Name = "";
										if(get_Removed_Wardrobe.size() > 0)
										{
											wardrobe_Name = wardrobe_Name + "[";
											for each  war in get_Removed_Wardrobe
											{
												get_Product = Buyer_Mapping_Wardrobes[Buyer_Product_Mapping.Buyer == input.ID && Wardrobe == war];
												if(get_Product.count() > 0)
												{
													mapped_Wardrobe.add(war);
													wardrobe_Name = wardrobe_Name + Wardrobe[ID == war].Wardrobe_Name + ",";
												}
											}
											wardrobe_Name_List = wardrobe_Name.removeLastOccurence(",") + "]";
										}
										if(mapped_Wardrobe.size() > 0)
										{
											alert "The following wardrobes are already used by products and cannot be removed: " + wardrobe_Name_List + ". Please keep them selected.";
											cancel submit;
										}
										// if(old.Primary_Email != input.Primary_Email)
										// {
										// 	add_User = insert into Create_User
										// 	[
										// 		Added_User=zoho.loginuser
										// 		Persona_Role="Buyer"
										// 		User_Name.first_name=input.Primary_Name
										// 		User_Name.last_name=input.Primary_Name
										// 		Email=input.Primary_Email
										// 		User_Type="Buyer"
										// 		Employee_External_ID=""
										// 		Associated_Buyer=input.ID
										// 		Mobile_Number=input.Primary_Phone
										// 		Approval_Status="Pending"
										// 		Status="Inactive"
										// 	];
										// }
						)
					}
				}

			
}