form Trigger_Form
{

			displayname = "Trigger Form"
			success message = "Trigger Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Action_field
			(
    			type = text
				displayname = "Action"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supplier_ID
			(
    			type = text
				displayname = "Supplier ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}