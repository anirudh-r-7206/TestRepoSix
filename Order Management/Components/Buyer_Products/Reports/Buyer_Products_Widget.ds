list Buyer_Products_Widget
{

			displayName = "Buyer Products Widget"
			show all rows from Buyer_Products  [ID == thisapp.helpers.getUniqueProductIds()]  
			(
				Style_ID as "Style ID"
				Colors
				Size
				Sell_Price as "QO Unit Price"
				Buy_Price as "PO Unit Price"
				HS_Name as "HS Code Region"
				HS_Code as "HS Code"
				Product_ID as "Product ID"
				Style_Name as "Style Name"
				Style_Description as "Style Description"
				Buyer_Product_Mapping as "Buyer Product Mapping"
				Style_ID.Primary_Image as "Primary Image"
				Colors.Color_Name as "Color Name"
				Price_Validity as "Price Validity"
				Style_ID.Style_Colour as "Style Colour"
				Colors.Hex_Color_Code as "Hex Color Code"
				Style_ID.Style_Master_Code as "Style Master Code"
				Size.Size as "Universal Size"
				Size.Chart_Details as "Chart Details"
				Size.Size_Order as "Size Order"
				Buyer_Product_Mapping.Buy_Currency as "Buy Currency"
				Style_ID.ID
				Style_ID.Product_Description as "Fabric Description"
				Style_Name.Style_Category as "Style Category"
				Style_ID.Wardrobe
				Wardrobe_Id as "Wardrobe Id"
				Category_Id as "Category Id"
				Style_ID.Gender
				Buyer_Product_Mapping.Factory_Allocated as "Factory Allocated"
				Style_ID.Style_Code as "Style Code"
				Buyer_Product_Mapping.Buyer
			)
			sort by
			(
				Style_Name ascending
				Size.Size_Order ascending
			)
			custom actions
			(
				"Duplicate Product"
				(
	  			workflow = Duplicate_Buyer_Product
				show action in view header = true
				show action in edit record menu = true
				)
			)
		
}