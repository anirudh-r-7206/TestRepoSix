Auto_populate_style_detai as "Auto populate style details"
{

				type =  form
				form = Buyer_Products

				record event = on add

				on user input of Style_ID
				{
					actions 
					{
						custom deluge script
						(
											input.Product_ID = input.Style_ID.Style_ID + "-" + input.Buyer_Product_Mapping.Factory_Allocated.Supplier_Code + "-" + input.Buyer_Product_Mapping.Buyer.Buyer_Code;
										input.Colors = input.Style_ID.Style_Colour;
										input.Size = input.Style_ID.Size_Set;
										input.Style_Name:ui.add(input.Style_ID.toList());
										input.Style_Name = input.Style_ID;
										input.Style_Description = input.Style_ID.Style_Code.Style_Description;
										input.HS_Code = null;
										if(input.HS_Name == "USA")
										{
											input.HS_Code = input.Style_ID.HS_Code_USA;
										}
										else if(input.HS_Name == "EU")
										{
											input.HS_Code = input.Style_ID.HS_Code_EU;
										}
										else if(input.HS_Name == "APAC")
										{
											input.HS_Code = input.Style_ID.HS_Code_APAC;
										}
						)
					}
				}

			
}