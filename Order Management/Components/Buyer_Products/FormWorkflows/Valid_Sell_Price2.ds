Valid_Sell_Price2 as "Valid Sell Price"
{

				type =  form
				form = Buyer_Products

				record event = on add or edit

				on user input of Sell_Price
				{
					actions 
					{
						custom deluge script
						(
											if(input.Sell_Price <= 0)
										{
											alert "Sell price must be greater than 0.";
											input.Sell_Price = null;
										}
						)
					}
				}

			
}