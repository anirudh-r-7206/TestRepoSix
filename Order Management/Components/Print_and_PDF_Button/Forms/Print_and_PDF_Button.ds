form Print_and_PDF_Button
{

			displayname = "Print and PDF Button"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Print
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			PDF
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hide_Section
			(
				type = section
				displayname = "Hide Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Purchase_Order
			(
				type = picklist	
				displayname = "Purchase Order"
				values  = Purchase_Order.ID
    			displayformat = [PO_Number]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			Template
			(
				type = radiobuttons
				maxchar = 100
				values = {"PO","QO","PO_V2","QO_V2"}
				layout = 2
	 			row = 2
	 			column = 1   
				width = medium
			)
	
		
}