PDF_template as "PDF template"
{

				type =  form
				form = Print_and_PDF_Button

				record event = on add

				on user input of PDF
				{
					actions 
					{
						custom deluge script
						(
											if(input.Template == "PO_V2")
										{
											// 	openUrl("https://creatorapp.zoho.com/export" + zoho.appuri + "pdf/PO_Template/?PO_ID=" + input.Purchase_Order + "&isc5page=true","new window");
											thisapp.Publish_URL.Download_PDF_to_PO_QO(input.Purchase_Order,"PO");
										}
										else
										{
											// 	openUrl("https://creatorapp.zoho.com/export" + zoho.appuri + "pdf/PO_Template/?QO_ID=" + input.Purchase_Order + "&isc5page=true","new window");
											thisapp.Publish_URL.Download_PDF_to_PO_QO(input.Purchase_Order,"QO");
										}
						)
					}
				}

			
}