form Copy_of_Purchase_LineItems
{

			displayname = "Copy of Purchase LineItems"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div> <br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Copy_of_Purchase_Order
			(
				type = picklist	
				displayname = "Copy of Purchase Order"
				values  = Copy_of_Purchase_Order.ID
    			bidirectional = Copy_Purchase_LineItems
    			displayformat = [ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			S_No
			(
				type = number
				displayname = "S.No"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product
			(
				type = picklist	
				displayname = "Style ID"
				values  = Add_Product.ID
    			displayformat = [Style_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Style_Code
			(
    			type = text
				displayname = "Style Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Color
			(
				type = picklist	
				displayname = "Product Color"
				values  = Add_Colors.ID
    			displayformat = [Color_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Size
			(
				type = picklist	
				displayname = "Product Size"
				values  = Create_Size.ID
    			displayformat = [Size]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = small
			)
			Selling_Price
			(
				type = decimal
				displayname = "Selling Price"
	 			row = 1
	 			column = 1   
				width = small
			)
			Purchase_Price
			(
				type = decimal
				displayname = "Purchase Price"
	 			row = 1
	 			column = 1   
				width = small
			)
			Selling_Price_Sub_Total
			(
				type = decimal
				displayname = "Selling Price Sub Total"
	 			row = 1
	 			column = 1   
				width = small
			)
			Purchase_Price_Sub_Total
			(
				type = decimal
				displayname = "Purchase Price Sub Total"
	 			row = 1
	 			column = 1   
				width = small
			)
			Hidden_Section
			(
				type = section
				displayname = "Hidden Section"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			HS_Code
			(
    			type = text
				displayname = "HS Code"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Fabric_Composition
			(
    			type = textarea
				displayname = "Fabric Composition"
				height = 100px
	 			row = 2
	 			column = 1   
				width = medium
			)
			Size_Order
			(
				type = number
				displayname = "Size Order"
	 			row = 2
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Product_Size.Size_Order
    						visibility = false
    			)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}