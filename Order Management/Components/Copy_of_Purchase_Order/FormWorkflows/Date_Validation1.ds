Date_Validation1 as "Date Validation"
{

				type =  form
				form = Copy_of_Purchase_Order

				record event = on add or edit

				on user input of Delivery_Date
				{
					actions 
					{
						custom deluge script
						(
											if(input.Delivery_Date <= zoho.currentdate)
										{
											alert "Delivery date must be later than the current date";
											input.Delivery_Date = zoho.currentdate.addDay(60);
										}
						)
					}
				}

			
}