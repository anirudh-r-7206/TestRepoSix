Redirection as "Redirection"
{

				type =  form
				form = Copy_of_Purchase_Order

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											fetPO = Purchase_Order[ID == input.Purchase_Order];
										fetPO.Record_is_Edited=true;
										openUrl("#Page:Purchase_Order_Details?zc_LoadIn=embed-editPO&PO_ID=" + input.Purchase_Order,"same window");
						)
					}
				}

			
}