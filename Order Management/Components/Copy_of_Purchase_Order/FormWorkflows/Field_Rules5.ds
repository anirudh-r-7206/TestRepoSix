Field_Rules5 as "Field Rules"
{

				type =  form
				form = Copy_of_Purchase_Order

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Order_Status,Purchase_Currency1,Selling_Currency1;
					}
					actions 
					{
						disable Buyer_Organisation,Order_Request,Total_Quantity,Order_Type;
					}
				}

			
}