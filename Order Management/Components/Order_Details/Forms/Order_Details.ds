form Order_Details
{

			displayname = "Order Details"
			success message = "Cart Product Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Order_Request
			(
				type = picklist	
				displayname = "Order Request"
				values  = Order_Request.ID
    			bidirectional = Order_details
    			displayformat = [Order_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supplier
			(
				type = picklist	
				values  = Add_Suppliers.ID
    			displayformat = [Supplier_Organisation]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product
			(
				type = picklist	
				values  = Add_Product.ID
    			displayformat = [Style_Name + " / " + Style_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Product_Color
			(
				type = picklist	
				displayname = "Product Color"
				values  = Add_Colors.ID
    			displayformat = [Color_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			must have Product_Size
			(
				type = picklist	
				displayname = "Product Size"
				values  = Create_Size.ID
    			displayformat = [Size]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = small
			)
			Description
			(
    			type = textarea
				displayname = "Description "
				height = 70px
	 			row = 1
	 			column = 2   
				width = medium
			)
			must have Quantity
			(
				type = number
				format = commadotwestern
	 			row = 1
	 			column = 2   
				width = small
			)
			Sub_Total
			(
				type = decimal
				displayname = "Sub Total"
				format = commadotwestern
				maxchar = 16
	 			row = 1
	 			column = 2   
				width = small
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}