list My_Order_Requests
{

			displayName = "My Basket"
			show all rows from Order_Request  [Buyer_Organisation.ID == thisapp.Filters.filterBuyerOrg(zoho.loginuserid) || Order_By.Email == zoho.loginuserid && Status == "Pending" || Status == "Awaiting QO Generation" && Cart_Total > 0]  
			(
				Order_ID as "Order ID"
				Cart_Total as "Total Price"
				Status
				custom action "Generate PO"
				(
	  			workflow = Generate_QO
				show action in edit record menu = true
				column header = "Generate PO"
				condition = (Status == "Pending")
				)
				Buyer_Name as "Buyer Name"
				Order_By as "Order By"
				Buyer_Organisation as "Buyer Organisation"
				Factory as "Supplier"
				Buyer_Name.User_Name  as "User Name"
				Buyer_Name.Employee_External_ID as "Employee/External ID"
				Buyer_Name.User_Type as "User Type"
				Buyer_Organisation.Primary_Email as "Email"
				Buyer_Name.Mobile_Number as "Mobile Number"
				(
					displayformat = plainnumber 
				)
				Buyer_Name.Persona_Role as "Persona/Role"
				Factory.ID
				Selling_Currency as "Currency"
				Total_Quantity as "Total Quantity"
				Delivery_Address as "Delivery Address"
				Order_Reference as "Order Reference"
				Transport_Mode as "Transport Mode"
				Comments
				Added_Time as "Order Date"
				(
					displayformat = dateonly
				)
			)
			custom actions
			(
				"Submit"
				(
	  			workflow = Submit_Order
				show action in view header = true
				show action in edit record menu = true
				condition = (Status == "Pending")
				confirmation before execution
				(
					message for individual record = "Are you sure you want to submit this order?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
			conditional formatting
			(
				"Pending"
				{
				condition = (Status == "Pending")
				fields = [Status]
				format = "color:#398ef3;"
				}
				"Completed"
				{
				condition = (Status == "Completed")
				fields = [Status]
				format = "color:#5dc35a;"
				}
				"In Production"
				{
				condition = (Status == "In Production")
				fields = [Status]
				format = "color:#a811cc;"
				}
				"Closed"
				{
				condition = (Status == "Closed")
				fields = [Status]
				format = "color:#ef1616;"
				}
				"Awaiting QO"
				{
				condition = (Status == "Awaiting QO Generation")
				fields = [Status]
				format = "color:#efb116;"
				}
				"Validation Pending"
				{
				condition = (Status == "Validation Pending")
				fields = [Status]
				format = "color:#38d7bb;"
				}
				"Awaiting Supplier Selection"
				{
				condition = (Status == "Awaiting Supplier Selection")
				fields = [Status]
				format = "color:#aaaaaa;"
				}
			)
		
}