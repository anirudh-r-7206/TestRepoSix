Auto_Fill_Buyer as "Auto Fill Buyer"
{

				type =  form
				form = Order_Request

				record event = on add

				on user input of Buyer_Organisation
				{
					actions 
					{
						custom deluge script
						(
											if(input.Buyer_Organisation != null && input.Purchase_Order == null)
										{
											get_Buyers = Create_User[Associated_Buyer == input.Buyer_Organisation && Status == "Active" && Persona_Role == "Buyer"];
											input.Buyer_Name:ui.add(get_Buyers.ID.getall());
											get_factory = Buyer_Product_Mapping[Buyer == input.Buyer_Organisation && Factory_Allocated.Status == "Active"].Factory_Allocated.getAll();
											input.Factory:ui.add(get_factory);
											fetch_Buyer = Create_User[Email == zoho.loginuserid && Status == "Active" && Persona_Role == "Buyer"];
											if(fetch_Buyer.count(ID) > 0)
											{
												input.Buyer_Name = fetch_Buyer.ID;
											}
										}
						)
					}
				}

			
}