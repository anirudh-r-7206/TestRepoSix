Clear_Subform as "Clear Subform"
{

				type =  form
				form = Order_Request

				record event = on add or edit

				on user input of Factory
				{
					actions 
					{
						custom deluge script
						(
											if(input.Purchase_Order == null)
										{
											input.Order_details.clear();
										}
						)
					}
				}

			
}