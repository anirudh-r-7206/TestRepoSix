Delete_Product as "Delete Product"
{

				type =  functions
				form = Add_Product
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						reference = thisapp.References.Product(input.ID);
										if(reference.trim() != "" && reference != null)
										{
											url = "#Form:Alert_References?zc_Header=false&Add_Product=" + input.ID;
											window = "popup window";
											openUrl(url,window);
										}
										else
										{
											delete from Add_Product[ID == input.ID];
										}
					)
					}
				}
			
}