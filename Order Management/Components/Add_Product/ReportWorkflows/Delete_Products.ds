Delete_Products as "Delete Products"
{

				type =  functions
				form = Add_Product
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						non_delete_Products = thisapp.Delete_Records.Delete_Product_catalog();
										if(!non_delete_Products.contains(input.ID))
										{
											delete from Add_Product[ID == input.ID];
										}
					)
					}
				}
			
}