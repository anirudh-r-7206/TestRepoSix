Update_Primary_Image as "Update Primary Image"
{

				type =  form
				form = Add_Product

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											for each  pic in input.Product_Picture
										{
											if(pic.Set_Primary == true)
											{
												input.Primary_Image = pic.Image;
											}
										}
						)
					}
				}

			
}