form Fabric_Form
{

			displayname = "Fabric Form"
			success message = "Fabric Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Fabric_Code
			(
    			type = text
				displayname = "Fabric Colour Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Fabric_Name
			(
    			type = text
				displayname = "Fabric Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Fabric_Master_Code
			(
    			type = text
				displayname = "Fabric Master Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Colour_Code
			(
				type = picklist	
				displayname = "Fabric Colour"
				values  = Add_Colors[Status == "Active"].ID
    			displayformat = [Color_Name + " - " + Color_Code]
				allow new entries
				[
					displayname = "Add Colour"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Fabric_Description
			(
    			type = text
				displayname = "Fabric Description"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Fabric_Composition
			(
    			type = text
				displayname = "Fabric Composition"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Country_of_Origin
			(
				type = picklist	
				displayname = "Country of Origin"
				values  = Add_Country[Status == "Active"].ID
    			displayformat = [Country_Name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Active","Inactive","Rejected"}
				initial value = "Pending"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		
}