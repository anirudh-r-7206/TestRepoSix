Valid_status_changes2 as "Valid status changes"
{

				type =  form
				form = Fabric_Form

				record event = on edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Status != old.Status)
										{
											alert "Status cannot be changed.";
											cancel submit;
										}
						)
					}
				}

			
}