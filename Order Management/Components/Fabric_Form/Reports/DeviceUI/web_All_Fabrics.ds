report All_Fabrics
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Fabric_Master_Code as "Fabric Master Code"
								Fabric_Code as "Fabric Colour Code"
								Fabric_Name as "Fabric Name"
								Colour_Code as "Fabric Colour"
								Country_of_Origin as "Country of Origin"
								Fabric_Composition as "Fabric Composition"
								Fabric_Description as "Fabric Description"
								Status
							)
						)
					)
						menu
						(
							header
							(
							)
						record
						(
							"Approve"
							"Reject"
							"Active"
							"Deactivate"
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							"Approve"
							"Reject"
							"Active"
							"Deactivate"
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Fabric_Master_Code as "Fabric Master Code"
								Fabric_Code as "Fabric Colour Code"
								Fabric_Name as "Fabric Name"
								Fabric_Description as "Fabric Description"
								Fabric_Composition as "Fabric Composition"
								Country_of_Origin as "Country of Origin"
								Colour_Code as "Fabric Colour"
								Status
							)
						)
						datablock2
						(
		     				title = "Colour Code"
		     				related field = Colour_Code
							fields
							(
								Color_Code as "Color Code"
								Color_Name as "Color Name"
								Status
							)
						)
						datablock3
						(
							layout type = -1
		     				title = "Products Catalogue"
		     				related field = Add_Product.Fabric_Code
							fields
							(
								Style_Category as "Product Category"
								Style_Name as "Style Name"
								Product_Description as "Fabric Description"
								Style_Colour as "Style Colour"
								Style_Range as "Style Range"
								Gender
								Size_Set as "Size Set"
								Product_Weight as "Product Weight"
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								"Approve"
								"Reject"
								"Edit Fabric"
								"Delete Fabric"
								"Active"
								"Deactivate"
							)
						)
				)
			
}