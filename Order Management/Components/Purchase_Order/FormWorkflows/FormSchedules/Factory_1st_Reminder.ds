Factory_1st_Reminder as "Factory_1st_Reminder"
{

				type =  schedule
				form = Purchase_Order[Order_Status == "Awaiting Factory Review"]
				start = after 48 hours from Modified_Time
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						thisapp.Send_Mail.Email_Template(input.ID,"Factory_1st_Reminder");
					)
					}
				}
			
}