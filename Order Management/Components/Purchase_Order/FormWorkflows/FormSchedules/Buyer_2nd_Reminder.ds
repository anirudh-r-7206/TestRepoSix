Buyer_2nd_Reminder as "Buyer_2nd_Reminder"
{

				type =  schedule
				form = Purchase_Order[Order_Status == "Awaiting Buyer Review"]
				start = after 96 hours from Modified_Time
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						thisapp.Send_Mail.Email_Template(input.ID,"Buyer_2nd_Reminder");
					)
					}
				}
			
}