Add_SNo as "Add SNo"
{

				type =  form
				form = Purchase_Order

				record event = on add or edit

				on add row of Purchase_LineItems
				{
					actions 
					{
						custom deluge script
						(
											row.S_No=input.Purchase_LineItems.count(S_No) + 1;
										// 
										if(row.Product != null)
										{
											selectedProd = row.Product;
										}
										if(input.Customer_Name != null)
										{
											get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Customer_Name.Associated_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Supplier];
											get_Product = get_Buyer_Product.Style_ID.getall();
										}
										else
										{
											get_Product = Add_Product[ID != 0 && Status == "Approved"].ID.getAll();
											input.Purchase_LineItems.clear();
											alert "Please choose an order request before adding a product.";
										}
										get_Product.removeAll(input.Purchase_LineItems.Product.getall());
										row.Product:ui.add(get_Product);
										row.Product=selectedProd;
						)
					}
				}

			
}