Duplicate_PO as "Duplicate PO"
{

				type =  functions
				form = Purchase_Order
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Order_Request?Purchase_Order=" + input.ID,"popup window","height=<height>,width=<width>");
					)
					}
				}
			
}