Filter_Style_ID as "Filter Style ID"
{

				type =  form
				form = Purchase_LineItems

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.S_No = (input.Purchase_Order.Purchase_LineItems.Product.getall()).size() + 1;
										if(input.Purchase_Order.Customer_Name != null)
										{
											get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Purchase_Order.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == input.Purchase_Order.Supplier];
											get_Product = get_Buyer_Product.Style_ID.getall();
										}
										get_Product.removeAll(input.Purchase_Order.Purchase_LineItems.Product.getall());
										input.Product:ui.add(get_Product);
						)
					}
				}

			
}