Show_hide_associated_fiel1 as "Show/hide associated field - On Edit"
{

				type =  form
				form = Create_User

				record event = on edit

				on user input of Persona_Role
				{
					actions 
					{
						custom deluge script
						(
											hide Associated_Buyer;
										hide Associated_Factory;
										if(input.Persona_Role == "Buyer")
										{
											show Associated_Buyer;
											disable Associated_Buyer;
										}
										else if(input.Persona_Role == "Factory Team")
										{
											show Associated_Factory;
											disable Associated_Factory;
										}
						)
					}
				}

			
}