Check_Valid_User as "Check Valid User"
{

				type =  form
				form = Create_User

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											get_User_Permission = thisapp.permissions.profileForUser(input.Email);
										if(get_User_Permission == "Administrator")
										{
											input.Persona_Role = "Administrator";
										}
										else if(get_User_Permission == "Developer")
										{
											input.Persona_Role = "Developer";
										}
										// else if(get_User_Permission == "Sodexo Team")
										// {
										// 	input.Persona_Role = "Sodexo Team";
										// }
										// else if(get_User_Permission == "Buyer")
										// {
										// 	input.Persona_Role = "Buyer";
										// }
										// else if(get_User_Permission == "Factory")
										// {
										// 	input.Persona_Role = "Factory Team";
										// }
						)
					}
				}

			
}