Admin_Auto_Approve as "Admin Auto Approve"
{

				type =  form
				form = Create_User

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Persona_Role == "Administrator")
										{
											input.Status = "Active";
											input.Approval_Status = "Approved";
										}
										convertLower = input.Email.toLowerCase();
										openUrl("#Script:page.refresh","same window");
						)
					}
				}

			
}