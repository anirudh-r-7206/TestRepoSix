User_Deactivate as "User Deactivate"
{

				type =  functions
				form = Create_User
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						UserList = thisapp.Deactivate_Records.Deactivate_User();
										if(!UserList.contains(input.ID))
										{
											try 
											{
												if(input.Persona_Role in {"Sodexo Team","Buyer","Administrator","Developer","Factory Team"})
												{
													Delete_User = thisapp.permissions.deleteUser(input.Email);
												}
												// 		else if(input.Persona_Role in {"Factory Team"})
												// 		{
												// 			delete_Portal = thisapp.portal.deleteUser(input.Email);
												// 		}
												// Change Status
												input.Status = "Inactive";
												input.Portal_Access_Enabled = false;
												success message "User deactivated successfully.";
												// 		}
											}	catch (e)
											{
												success message "Unable to deactivate the user. Please contact the application administrator.";
											}
										}
					)
					}
				}
			
}