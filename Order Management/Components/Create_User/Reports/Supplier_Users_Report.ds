list Supplier_Users_Report
{

			displayName = "Supplier Users Report"
			show all rows from Create_User  [User_Type == "Factory"]  
			(
				User_Name  as "User Name"
				Email
				User_Type as "User Type"
				Employee_External_ID as "Employee/External ID"
				Mobile_Number as "Mobile Number"
				(
					displayformat = plainnumber 
				)
				Persona_Role as "Persona/Role"
				Associated_Factory as "Associated Factory "
				Remarks as "Remarks "
				Portal_Access_Enabled as "Portal Access Enabled"
				Approval_Status as "Approval Status"
				Status as "Status "
				Need_App_Access as "Provided App Access"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
				Send_Notifications_Only as "Send Notifications Only"
				(
						displaytrue = "Yes"
						displayfalse = "No"
				)
			)
			group by
			(
				Associated_Factory ascending
			)
			custom actions
			(
				"Activate Supplier User"
				(
	  			workflow = Activate_Supplier_User
				show action in view header = true
				show action in edit record menu = true
				condition = (Status == "Inactive")
				confirmation before execution
				(
					message for individual record = "Do you wish to Activate this Supplier User?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
				"Deactivate Supplier User"
				(
	  			workflow = Deactivate_Supplier_User
				show action in view header = true
				show action in edit record menu = true
				condition = (Status == "Active")
				confirmation before execution
				(
					message for individual record = "Execute the Deactivate Supplier User action for this record?"
					confirm button text = "Yes"		
					cancel button text = "No"
				)
				)
			)
		
}