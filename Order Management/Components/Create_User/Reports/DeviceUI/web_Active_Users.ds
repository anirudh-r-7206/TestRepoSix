report Active_Users
{

				quickview
				(
					layout
					(
		 				type = 2
	     				recordsperrow = 3
						datablock1
						(
							layout type = 4
							fields
							(
								User_Name as "User Name"
								User_Type as "User Type"
								Email
								Mobile_Number as "Mobile Number"
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								Edit 
							)
						record
						(
							"Deactivate"
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							"Deactivate"
							View Record   	   
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
							fields
							(
								Employee_External_ID as "Employee/External ID"
								User_Name as "User Name"
								Email
								Mobile_Number as "Mobile Number"
								User_Type as "User Type"
								Persona_Role as "Persona/Role"
								Associated_Buyer as "Associated Buyer"
								Associated_Factory as "Associated Factory "
								Portal_Access_Enabled as "Portal Access"
								Remarks as "Remarks "
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								"Deactivate"
								Edit 
							)
						)
				)
			
}