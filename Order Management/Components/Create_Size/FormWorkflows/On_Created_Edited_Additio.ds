On_Created_Edited_Additio as "On Created & Edited - Addition of a row"
{

				type =  form
				form = Create_Size

				record event = on add or edit

				on add row of Size_Chart_Details
				{
					actions 
					{
						custom deluge script
						(
											currentRegionList = input.Size_Chart_Details.Region_New.getall();
										allRegions = Add_Region[ID != null].ID.getAll();
										allRegions.removeAll(currentRegionList);
										row.Region_New:ui.add(allRegions);
						)
					}
				}

			
}