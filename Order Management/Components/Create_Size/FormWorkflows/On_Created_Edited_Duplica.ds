On_Created_Edited_Duplica as "On Created & Edited - Duplicate Size"
{

				type =  form
				form = Create_Size

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											mapped_Category = list();
										cat_Name = "";
										cat_Name = cat_Name + "[";
										for each  cat in input.Product_Category
										{
											duplicateSize = Create_Size[ID != input.ID && Gender == input.Gender && Size.equalsIgnoreCase(input.Size) && Product_Category.contains(cat)];
											if(duplicateSize.count() > 0)
											{
												mapped_Category.add(cat);
												cat_Name = cat_Name + Product_Category[ID == cat].Product_Category + ",";
											}
										}
										cat_Name_List = cat_Name.removeLastOccurence(",") + "]";
										if(mapped_Category.size() > 0)
										{
											alert "These categories are already used for the same size. Please remove them before submit: " + cat_Name_List;
											cancel submit;
										}
						)
					}
				}

			
}