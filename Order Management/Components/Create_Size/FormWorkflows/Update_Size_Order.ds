Update_Size_Order as "Update Size Order"
{

				type =  form
				form = Create_Size

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											get_Size_Order = Create_Size[ID != input.ID && Gender == input.Gender && Size_Order == input.Size_Order];
										if(get_Size_Order.count() > 0)
										{
											for each  oder in Create_Size[ID != input.ID && Gender == input.Gender && Size_Order >= input.Size_Order]
											{
												oder.Size_Order=oder.Size_Order + 1;
											}
										}
										input.Product_Category1 = input.Product_Category;
						)
					}
				}

			
}