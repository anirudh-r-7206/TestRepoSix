Delete_Sizes as "Delete Sizes"
{

				type =  functions
				form = Create_Size
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						not_Delete_Rec = thisapp.Delete_Records.Delete_Size();
										if(!not_Delete_Rec.contains(input.ID))
										{
											delete from Create_Size[ID == input.ID];
										}
					)
					}
				}
			
}