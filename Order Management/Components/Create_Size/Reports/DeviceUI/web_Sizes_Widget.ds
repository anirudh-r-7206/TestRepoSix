report Sizes_Widget
{

				quickview
				(
					layout
					(
						datablock1
						(
							fields
							(
								Size as "Universal Size"
								Product_Category as "Product Category"
								Gender
								Size_Order as "Size Order"
								Size_Chart_Details.Region_New as "Equivalent Regional Size"
								Chart_Details as "Chart Details"
								Status
							)
						)
					)
						menu
						(
							header
							(
							)
						record
						(
							"Activate"
							"Deactivate"
    					)
						)
    				action
    				(
						on click
						(
							View Record   	   
    					)
						on right click
						(
							"Activate"
    					)
     				)
				)

				detailview
				(
					layout
					(
		 				type = 2
						datablock1
						(
		     				title = "Overview"
							fields
							(
								Size as "Universal Size"
								Product_Category as "Product Category"
								Gender
								Size_Order as "Size Order"
								Chart_Details as "Chart Details"
								Status
								Size_Chart_Details.Region_New as "Equivalent Regional Size"
							)
						)
						datablock3
						(
							layout type = -1
		     				title = "Size Chart Details"
		     				related field = Size_Chart_Details
							fields
							(
								Region_New as "Region New"
								Size_Name as "Size Name"
							)
						)
						datablock4
						(
							layout type = -1
		     				title = "Products Catalog Form"
		     				related field = Add_Product.Size_Set
							fields
							(
								Style_Name as "Style Name"
								Product_Description as "Fabric Description"
								Style_Category as "Product Category"
								Style_Colour as "Style Colour"
								Style_Range as "Style Range"
								Gender
								Size_Set as "Size Set"
								Product_Weight as "Product Weight"
								Status as "Status "
							)
						)
					)
						menu
						(
							header
							(
								"Edit "
								"Delete "
								"Activate"
								"Deactivate"
							)
						)
				)
			
}