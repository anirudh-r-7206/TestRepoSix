Filter_Size_Color as "Filter Size & Color"
{

				type =  form
				form = Buyer_product_duplicate

				record event = on add

				on user input of Variant_Type
				{
					actions 
					{
						custom deluge script
						(
											clear Size;
										clear Colors;
										hide Size;
										hide Colors;
										if(input.Buyer_Product_Mapping != null && input.Product != null)
										{
											if(input.Variant_Type == "Size")
											{
												show Size;
												// 		getAll_Size = Create_Size[Product_Category == input.Product.Style_Category && Gender == input.Product.Gender && Status == "Active"].ID.getAll();
												get_Product_Size = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code == input.Product.Style_Code && Style_Colour == input.Product.Style_Colour].Size_Set.getAll();
												get_Buyer_Product_Size = Buyer_Products[Buyer_Product_Mapping == input.Buyer_Product_Mapping && Style_ID.Style_Code == input.Product.Style_Code].Size.getAll();
												get_Product_Size.removeAll(get_Buyer_Product_Size);
												input.Size:ui.add(get_Product_Size);
											}
											else if(input.Variant_Type == "Color")
											{
												show Colors;
												get_Product_Color = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code.Product_Code == input.Product.Style_Code.Product_Code].Style_Colour.getAll();
												get_Style_Code = Style[Product_Code == input.Product.Style_Code.Product_Code].ID.getAll();
												get_Buyer_Product_Color = Buyer_Products[Buyer_Product_Mapping == input.Buyer_Product_Mapping && Style_ID.Style_Code in get_Style_Code].Colors.getAll();
												get_Product_Color.removeAll(get_Buyer_Product_Color);
												input.Colors:ui.add(get_Product_Color);
											}
										}
						)
					}
				}

			
}