Duplicate_Product1 as "Duplicate Product"
{

				type =  form
				form = Buyer_product_duplicate
				button = Submit
				on click
				{
					actions 
					{
					on click
					(
						if(input.Variant_Type == "Size" && input.Size.Size() <= 0)
										{
											alert "Size is required.";
										}
										else if(input.Variant_Type == "Color" && input.Colors.size() <= 0)
										{
											alert "Color is required.";
										}
										else
										{
											if(input.Variant_Type == "Size" && input.Size != null)
											{
												for each  siz in input.Size
												{
													get_Product = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code == input.Product.Style_Code && Size_Set == siz];
													info get_Product.Style_ID;
													ProductID = get_Product.Style_ID + "-" + input.Buyer_Product_Mapping.Factory_Allocated.Supplier_Code + "-" + input.Buyer_Product_Mapping.Buyer.Buyer_Code;
													insert_Buyer_Products = insert into Buyer_Products
													[
														Buyer_Product_Mapping=input.Buyer_Product_Mapping
														Product_ID=ProductID
														Style_ID=get_Product.ID
														Style_Name=get_Product.ID
														Size=siz
														Colors=input.Buyer_Products.Colors
														Buy_Price=input.Buyer_Products.Buy_Price
														Sell_Price=input.Buyer_Products.Sell_Price
														HS_Name=input.Buyer_Products.HS_Name
														HS_Code=input.Buyer_Products.HS_Code
														Added_User=zoho.loginuser
													];
												}
											}
											else if(input.Variant_Type == "Color" && input.Colors != null)
											{
												for each  col in input.Colors
												{
													get_Product = Add_Product[Wardrobe == input.Product.Wardrobe && Style_Category == input.Product.Style_Category && Style_Code.Product_Code == input.Product.Style_Code.Product_Code && Style_Colour == col];
													// 		info get_Product.Style_ID;
													ProductID = get_Product.Style_ID + "-" + input.Buyer_Product_Mapping.Factory_Allocated.Supplier_Code + "-" + input.Buyer_Product_Mapping.Buyer.Buyer_Code;
													insert_Buyer_Products = insert into Buyer_Products
													[
														Buyer_Product_Mapping=input.Buyer_Product_Mapping
														Product_ID=ProductID
														Style_ID=get_Product.ID
														Style_Name=get_Product.ID
														Size=get_Product.Size_Set
														Colors=col
														Buy_Price=input.Buyer_Products.Buy_Price
														Sell_Price=input.Buyer_Products.Sell_Price
														HS_Name=input.Buyer_Products.HS_Name
														HS_Code=input.Buyer_Products.HS_Code
														Added_User=zoho.loginuser
													];
												}
											}
											// 	openUrl("#Page:Buyer_Product_Mapping_Page?zc_LoadIn=embed-BuyerProducts&map_ID=" + input.Buyer_Product_Mapping,"same window");
											thisapp.PageRefresh();
										}
					)
					}
				}
			
}