string Style.PO_Templet_Style()
{

                 	return "<style>.page * { padding: 0; margin: 0; box-sizing: border-box; } .page { margin: auto; background: #fff; padding: 30px 10px; } .header { display: flex; justify-content: space-between; /* border-bottom: 3px solid #000; */ padding-bottom: 20px; } .logo img { width: 130px; } .logo p { font-size: 12px; margin: 5px 0 0; } .title { display: flex; flex-direction: column; justify-content: space-around; text-align: right; } .title h2 { margin: 0; } .title p { font-size: 12px; } .info-section { display: flex; justify-content: space-between; margin-top: 15px; margin-bottom: 15px; } .box { width: calc(100% / 3); font-size: 12px; } .box h4 { background: #000; color: #fff; padding: 5px; margin: 0 0 5px; } .box_Content { height: calc(100% - 30px); font-size: 11px; display: flex; flex-direction: column; justify-content: space-between; padding-right: 10px; } .summary { width: 100%; border-collapse: collapse; } .summary td { padding: 3px; font-size: 11px; } .order-title { text-align: center !important; padding: 6px !important; font-weight: bold; font-size: 15px; } .order-table { width: 100%; border-collapse: collapse; font-size: 11px; } .order-table th, .order-table td { border: 1px solid #000; padding: 4px 10px; text-align: center; }.order-table td:last-child { text-align: right; } .order-table th { color: #fff; background: #000; } /*  */ .text_Left { text-align: right !important; } .text_Bold { font-weight: bold; } /* Repeat header on every page */ thead { display: table-header-group !important; } /* Comments box */ .comments-table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 12px; page-break-inside: avoid !importent; } .comments-label { width: 120px; border: 1px solid #000; vertical-align: top; padding: 6px;page-break-inside: avoid; } .comments-content { border: 1px solid #000; padding: 6px 6px 6px 20px; line-height: 1.4; } /* Signature box */ .signature-table { width: 40%; border-collapse: collapse; border: 1px solid #000; margin-top: 30px; font-size: 12px; bold;page-break-inside: avoid;  } .signature-table td { padding: 12px; height: 30px; font-weight:} td.t_right { text-align: right; }</style>";
                 
}