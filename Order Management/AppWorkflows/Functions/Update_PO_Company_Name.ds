void OneTime.Update_PO_Company_Name()
{

                 	fetPO = Purchase_Order[Factory_Company_Name == null || Buyer_Company_Name == null];
                 	for each  po in fetPO
                 	{
                 		get_PO = Purchase_Order[ID == po.ID];
                 		// 		if(get_PO.Factory_Address == null)
                 		// 		{
                 		fetFactory = Factory_Details_Subform[Add_Suppliers == get_PO.Supplier] sort by Added_Time desc;
                 		get_PO.Factory_Company_Name=fetFactory.Company_Name;
                 		get_PO.Factory_Contact_Person=if(fetFactory.Contact_Person1.first_name.isEmpty(),"",fetFactory.Contact_Person1.first_name) + if(fetFactory.Contact_Person1.last_name.isEmpty(),""," " + fetFactory.Contact_Person1.last_name);
                 		get_PO.Factory_Email=fetFactory.Factory_Email;
                 		get_PO.Factory_Phone=fetFactory.Factory_Phone;
                 		// 		}
                 		// 		if(get_PO.Delivery_Address == null)
                 		// 		{
                 		fetBuyer = Buyer_Contact_Person_Details[Buyers_Master == get_PO.Buyer_Organisation] sort by Added_Time desc;
                 		get_PO.Buyer_Company_Name=fetBuyer.Company_Name;
                 		get_PO.Buyer_Contact_Person=if(fetBuyer.Contact_Person1.first_name.isEmpty(),"",fetBuyer.Contact_Person1.first_name) + if(fetBuyer.Contact_Person1.last_name.isEmpty(),""," " + fetBuyer.Contact_Person1.last_name);
                 		get_PO.Buyer_Email=fetBuyer.Email;
                 		get_PO.Buyer_Phone=fetBuyer.Phone_Number;
                 		// 		}
                 	}
                 
}