list Delete_Records.Delete_Colors()
{

                 	color_List = List();
                 	get_Product_Color = Add_Product[ID != 0];
                 	color_List.addAll(get_Product_Color.Style_Colour.getall());
                 	get_Order_Color = Order_Details[ID != 0];
                 	color_List.addAll(get_Order_Color.Product_Color.getall());
                 	get_Purchase_Color = Purchase_LineItems[ID != 0];
                 	color_List.addAll(get_Purchase_Color.Product_Color.getall());
                 	get_Fabric_Color = Fabric_Form[ID != 0];
                 	color_List.addAll(get_Fabric_Color.Colour_Code.getall());
                 	return color_List.distinct();
                 
}