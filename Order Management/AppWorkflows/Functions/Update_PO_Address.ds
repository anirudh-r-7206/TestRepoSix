void OneTime.Update_PO_Address()
{

                 	get_POs = Purchase_Order[Factory_Address != null || Delivery_Address != null];
                 	for each  po in get_POs
                 	{
                 		get_PO = Purchase_Order[ID == po.ID];
                 		// 		Factory Address
                 		get_PO.Factory_Address1.address_line_1=po.Factory_Address.Factory_Address.address_line_1;
                 		get_PO.Factory_Address1.address_line_2=po.Factory_Address.Factory_Address.address_line_2;
                 		get_PO.Factory_Address1.district_city=po.Factory_Address.Factory_Address.district_city;
                 		get_PO.Factory_Address1.state_province=po.Factory_Address.Factory_Address.state_province;
                 		get_PO.Factory_Address1.postal_Code=po.Factory_Address.Factory_Address.postal_Code;
                 		get_PO.Factory_Address1.country=po.Factory_Address.Factory_Address.country;
                 		// Delivery Address
                 		get_PO.Delivery_Address1.address_line_1=po.Delivery_Address.Address.address_line_1;
                 		get_PO.Delivery_Address1.address_line_2=po.Delivery_Address.Address.address_line_2;
                 		get_PO.Delivery_Address1.district_city=po.Delivery_Address.Address.district_city;
                 		get_PO.Delivery_Address1.state_province=po.Delivery_Address.Address.state_province;
                 		get_PO.Delivery_Address1.postal_Code=po.Delivery_Address.Address.postal_Code;
                 		get_PO.Delivery_Address1.country=po.Delivery_Address.Address.country;
                 	}
                 
}