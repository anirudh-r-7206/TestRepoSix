void OneTime.Update_Purchase_Currency()
{

                 	get_Currency = Currency[Currency_Name.equalsIgnorecase("usd")];
                 	get_PO = Purchase_Order[Purchase_Currency != get_Currency.ID];
                 	for each  po in get_PO
                 	{
                 		get_Current_PO = Purchase_Order[ID == po.ID];
                 		get_Current_PO.Purchase_Currency=get_Currency.ID;
                 	}
                 
}