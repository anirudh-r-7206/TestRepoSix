void Delete_Records.Delete_PO(int ID1)
{

                 	fetPO = Purchase_Order[ID == ID1];
                 	// Build PO details for email
                 	poNumber = fetPO.PO_Number;
                 	qoNumber = fetPO.QO_Number;
                 	orderRef = fetPO.Order_Reference;
                 	poDate = fetPO.PO_Date;
                 	orderType = fetPO.Order_Type;
                 	deliveryDate = fetPO.Delivery_Date;
                 	transportMode = fetPO.Transport_Mode;
                 	paymentTerms = fetPO.Payment_Terms;
                 	orderStatus = fetPO.Order_Status;
                 	totalQty = fetPO.Total_Quantity;
                 	totalSellingPrice = fetPO.Total_Selling_Price;
                 	totalPurchasePrice = fetPO.Total_Purchase_Price;
                 	comments = fetPO.Comments11;
                 	// Get Supplier display name from lookup
                 	supplierName = "";
                 	supplierID = fetPO.Supplier;
                 	if(!supplierID.isNull())
                 	{
                 		supplierRec = Add_Suppliers[ID == supplierID];
                 		supplierName = supplierRec.Supplier_Organisation;
                 	}
                 	// Get Buyer Organisation display name from lookup
                 	buyerName = "";
                 	buyerID = fetPO.Buyer_Organisation;
                 	if(!buyerID.isNull())
                 	{
                 		buyerRec = Buyers_Master[ID == buyerID];
                 		buyerName = buyerRec.Buyer_Organisation;
                 	}
                 	// Handle null values for display
                 	if(poNumber.isNull())
                 	{
                 		poNumber = "-";
                 	}
                 	if(qoNumber.isNull())
                 	{
                 		qoNumber = "-";
                 	}
                 	if(orderRef.isNull())
                 	{
                 		orderRef = "-";
                 	}
                 	poDateStr = "";
                 	if(!poDate.isNull())
                 	{
                 		poDateStr = poDate.toString("dd-MMM-yyyy");
                 	}
                 	else
                 	{
                 		poDateStr = "-";
                 	}
                 	if(orderType.isNull())
                 	{
                 		orderType = "-";
                 	}
                 	deliveryDateStr = "";
                 	if(!deliveryDate.isNull())
                 	{
                 		deliveryDateStr = deliveryDate.toString("dd-MMM-yyyy");
                 	}
                 	else
                 	{
                 		deliveryDateStr = "-";
                 	}
                 	if(transportMode.isNull())
                 	{
                 		transportMode = "-";
                 	}
                 	if(paymentTerms.isNull())
                 	{
                 		paymentTerms = "-";
                 	}
                 	if(orderStatus.isNull())
                 	{
                 		orderStatus = "-";
                 	}
                 	if(totalQty.isNull())
                 	{
                 		totalQty = 0;
                 	}
                 	if(totalSellingPrice.isNull())
                 	{
                 		totalSellingPrice = 0;
                 	}
                 	if(totalPurchasePrice.isNull())
                 	{
                 		totalPurchasePrice = 0;
                 	}
                 	if(comments.isNull())
                 	{
                 		comments = "-";
                 	}
                 	if(supplierName.isNull() || supplierName.isEmpty())
                 	{
                 		supplierName = "-";
                 	}
                 	if(buyerName.isNull() || buyerName.isEmpty())
                 	{
                 		buyerName = "-";
                 	}
                 	// Build styled HTML table
                 	hdrStyle = "style=\"background-color:#2c3e50;color:#ffffff;padding:10px 15px;text-align:left;font-family:Arial,sans-serif;font-size:14px;border:1px solid #ddd;\"";
                 	oddRowLbl = "style=\"background-color:#f9f9f9;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;border:1px solid #ddd;color:#333;\"";
                 	oddRowVal = "style=\"background-color:#f9f9f9;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;border:1px solid #ddd;color:#555;\"";
                 	evenRowLbl = "style=\"background-color:#ffffff;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;border:1px solid #ddd;color:#333;\"";
                 	evenRowVal = "style=\"background-color:#ffffff;padding:8px 15px;font-family:Arial,sans-serif;font-size:13px;border:1px solid #ddd;color:#555;\"";
                 	htmlBody = "<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#333;\">";
                 	htmlBody = htmlBody + "<p>The following Purchase Order has been deleted:</p>";
                 	htmlBody = htmlBody + "<table style=\"border-collapse:collapse;width:100%;max-width:700px;margin:15px 0;border:1px solid #ddd;\">";
                 	htmlBody = htmlBody + "<thead><tr><th " + hdrStyle + ">Field</th><th " + hdrStyle + ">Value</th></tr></thead>";
                 	htmlBody = htmlBody + "<tbody>";
                 	// Row 1 - PO Number (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">PO Number</td><td " + oddRowVal + ">" + poNumber + "</td></tr>";
                 	// Row 2 - QO Number (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">QO Number</td><td " + evenRowVal + ">" + qoNumber + "</td></tr>";
                 	// Row 3 - Order Reference (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Order Reference</td><td " + oddRowVal + ">" + orderRef + "</td></tr>";
                 	// Row 4 - PO Date (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">PO Date</td><td " + evenRowVal + ">" + poDateStr + "</td></tr>";
                 	// Row 5 - Supplier (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Supplier</td><td " + oddRowVal + ">" + supplierName + "</td></tr>";
                 	// Row 6 - Buyer Organisation (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Buyer Organisation</td><td " + evenRowVal + ">" + buyerName + "</td></tr>";
                 	// Row 7 - Order Type (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Order Type</td><td " + oddRowVal + ">" + orderType + "</td></tr>";
                 	// Row 8 - Delivery Date (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Delivery Date</td><td " + evenRowVal + ">" + deliveryDateStr + "</td></tr>";
                 	// Row 9 - Transport Mode (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Transport Mode</td><td " + oddRowVal + ">" + transportMode + "</td></tr>";
                 	// Row 10 - Payment Terms (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Payment Terms</td><td " + evenRowVal + ">" + paymentTerms + "</td></tr>";
                 	// Row 11 - Order Status (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Order Status</td><td " + oddRowVal + ">" + orderStatus + "</td></tr>";
                 	// Row 12 - Total Quantity (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Total Quantity</td><td " + evenRowVal + ">" + totalQty + "</td></tr>";
                 	// Row 13 - Total Selling Price (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Total Selling Price</td><td " + oddRowVal + ">" + totalSellingPrice + "</td></tr>";
                 	// Row 14 - Total Purchase Price (even)
                 	htmlBody = htmlBody + "<tr><td " + evenRowLbl + ">Total Purchase Price</td><td " + evenRowVal + ">" + totalPurchasePrice + "</td></tr>";
                 	// Row 15 - Comments (odd)
                 	htmlBody = htmlBody + "<tr><td " + oddRowLbl + ">Comments</td><td " + oddRowVal + ">" + comments + "</td></tr>";
                 	htmlBody = htmlBody + "</tbody></table>";
                 	htmlBody = htmlBody + "</div>";
                 	// Perform all deletions
                 	delete from Purchase_LineItems[Purchase_Order == ID1];
                 	delete from Additional_Charges_Form[Purchase_Order == ID1];
                 	fileRec = History[Purchase_Order_ID == ID1 && !File_upload.isEmpty()];
                 	delete from History[Purchase_Order_ID == ID1];
                 	fetCopyPO = Copy_of_Purchase_Order[Purchase_Order == fetPO.ID];
                 	delete from Copy_of_Purchase_LineItems[Copy_of_Purchase_Order == fetCopyPO.ID];
                 	delete from Copy_of_Purchase_Order[ID == fetCopyPO.ID];
                 	delete from Order_Details[Order_Request == fetPO.Order_Request];
                 	delete from Order_Request[ID == fetPO.Order_Request];
                 	delete from Purchase_Order[ID == ID1];
                 	emailList = Create_User[User_Type == "Admin" && User_Type == "Internal"].Email.getAll();
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :emailList
                 		subject :"PO Deleted : " + poNumber
                 		message :htmlBody
                 		content type :HTML
                 	]
                 
}