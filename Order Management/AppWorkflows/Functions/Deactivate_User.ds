list Deactivate_Records.Deactivate_User()
{

                 	Users_List = List();
                 	get_From_Order_Request = Order_Request[Status not in {"Completed","Cancelled"}];
                 	Users_List.addAll(get_From_Order_Request.Buyer_Name.getall());
                 	get_From_PO = Purchase_Order[Order_Status not in {"Completed","Cancelled"}];
                 	Users_List.addAll(get_From_PO.Customer_Name.getall());
                 	Users_List.addAll(get_From_PO.Supplier_old.getall());
                 	return Users_List.distinct();
                 
}