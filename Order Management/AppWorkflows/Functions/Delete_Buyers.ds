list Delete_Records.Delete_Buyers()
{

                 	Buyers_List = List();
                 	get_From_User = Create_User[ID != 0];
                 	Buyers_List.addAll(get_From_User.Associated_Buyer.getall());
                 	get_product_Buyer = Buyer_Product_Mapping[ID != 0];
                 	Buyers_List.addAll(get_product_Buyer.Buyer.getall());
                 	get_Order_Buyer = Order_Request[ID != 0];
                 	Buyers_List.addAll(get_Order_Buyer.Buyer_Organisation.getall());
                 	get_PO_Buyer = Purchase_Order[ID != 0];
                 	Buyers_List.addAll(get_PO_Buyer.Buyer_Organisation.getall());
                 	return Buyers_List.distinct();
                 
}