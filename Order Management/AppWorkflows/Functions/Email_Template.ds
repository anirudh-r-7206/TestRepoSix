void Send_Mail.Email_Template(int QO_ID, String Template_Name)
{

                 	//	QO Email Template
                 	// 			QO_ID = 4908788000001014076;
                 	// 			Template_Name = "Buyer_QO_Cancelled";
                 	// 			
                 	get_PO = Purchase_Order[ID == input.QO_ID];
                 	// 	to_Email = get_PO.Buyer_Organisation.Primary_Email;
                 	cc_Email = List();
                 	cc_Email.add(thisapp.Dev.Primary_SSA_Admin_Email());
                 	PO_File = false;
                 	QO_File = false;
                 	if(input.Template_Name == "Buyer_Order_Submit")
                 	{
                 		get_Order = Order_Request[ID == input.QO_ID];
                 		to_Email = get_Order.Buyer_Organisation.Primary_Email;
                 		//	mail content
                 		get_Email_Template = Email_Template[Template_Name == "Buyer_Order_Submit"];
                 		report_Name = "Production_Orders";
                 		if(get_Email_Template.count() > 0)
                 		{
                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${OR_Number}",get_Order.Order_ID,true);
                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Buyer_Name}",get_Order.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${OR_Number}",get_Order.Order_ID,true);
                 			//	In app notification
                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${OR_Number}",get_Order.Order_ID,true);
                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Buyer_Name}",get_Order.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${OR_Number}",get_Order.Order_ID,true);
                 		}
                 	}
                 	else if(input.Template_Name == "QO_Template")
                 	{
                 		QO_File = true;
                 		to_Email = get_PO.Buyer_Organisation.Primary_Email;
                 		//	QO mail content
                 		get_Email_Template = Email_Template[Template_Name == "QO_Template"];
                 		report_Name = "My_Purchase_Orders";
                 		if(get_Email_Template.count() > 0)
                 		{
                 			cc_Email.addAll(get_Email_Template.Additional_CC_Emails.Email.getall());
                 			mail_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
                 			mail_Msg = get_Email_Template.Message_Content.replaceAll("${Buyer_Name}",get_PO.Buyer_Organisation.Buyer_Organisation,true).replaceAll("${QO_Number}",get_PO.QO_Number,true);
                 			mail_Msg = mail_Msg.replaceAll("${Review_Link}","<a href='https://creatorapp.zoho.com" + thisapp.Publish_URL.AppURI() + "#Report:My_Purchase_Orders?zc_AddRec=false&zc_MoreAction=false&QO_Number=" + get_PO.QO_Number + "' style='display:inline-block; padding:10px 18px; background-color:#2563eb; color:#ffffff; text-decoration:none; border-radius:4px; font-weight:600;'> Review Order </a>",true);
                 			app_Subject = get_Email_Template.Subject_field.replaceAll("${QO_Number}",get_PO.QO_Number,true);
                 			app_Msg = get_Email_Template.In_App_Message_Content.replaceAll("${Buyer_Name}",get_PO.Buyer_Organisation.Buyer_Organisation,true);
                 			app_Msg = app_Msg.replaceAll("${QO_Number}",get_PO.QO_Number,true);
                 		}
                 	}
