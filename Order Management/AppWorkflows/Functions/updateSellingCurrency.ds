void OneTime.updateSellingCurrency()
{

                 	fetorderRequest = Order_Request[Selling_Currency == null];
                 	if(fetorderRequest.count() > 0)
                 	{
                 		for each  order in fetorderRequest
                 		{
                 			fetBuyerProduct = Buyer_Product_Mapping[Buyer == order.Buyer_Organisation && Factory_Allocated == order.Factory];
                 			order.Selling_Currency=if(fetBuyerProduct.count() > 0,fetBuyerProduct.Sell_Currency,null);
                 		}
                 	}
                 
}