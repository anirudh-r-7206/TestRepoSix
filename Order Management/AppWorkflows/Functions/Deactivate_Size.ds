list Deactivate_Records.Deactivate_Size()
{

                 	size_List = List();
                 	get_Product_Size = Add_Product[Status == "Approved"];
                 	size_List.addAll(get_Product_Size.Size_Set.getall());
                 	get_Order_Size = Order_Details[Order_Request.Status in {"Pending","Awaiting Supplier Selection","Awaiting QO Generation"}];
                 	size_List.addAll(get_Order_Size.Product_Size.getall());
                 	get_Purchase_Size = Purchase_LineItems[Purchase_Order.Order_Status not in {"Completed","In Production","Awaiting Production"}];
                 	size_List.addAll(get_Purchase_Size.Product_Size.getall());
                 	return size_List.distinct();
                 
}