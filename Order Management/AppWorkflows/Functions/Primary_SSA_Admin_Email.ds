string Dev.Primary_SSA_Admin_Email()
{

                 	get_Primary_Mail = Create_User[Primary_Email == true && User_Type in {"Internal","Admin"}];
                 	if(get_Primary_Mail.count() > 0)
                 	{
                 		return get_Primary_Mail.Email;
                 	}
                 	else
                 	{
                 		return "dylfa.d+zcjscom@zohotest.com";
                 	}
                 
}