string Page.PO_Templet_Table(int Po_ID, String type)
{

                 	// 	Po_ID = 4235496000027466275;
                 	get_PO = Purchase_Order[ID == input.Po_ID];
                 	get_Po_Cat_No = (get_PO.Purchase_LineItems.Style_Code.getall()).distinct();
                 	//	Table Header 
                 	// 	(" + if(input.type == "PO","Purchase Price","Selling Price") + ")
                 	// 	<tr> <th colspan=\"11\" class=\"order-title\">Order Information</th> </tr>
                 	PO_Table = "<table class=\"order-table\"> <thead>  <tr> <th>#</th> <th>Style Name</th> <th>Style Code</th> <th>Colour</th> <th>Size</th> <th>Gender</th> <th>Fabric Composition</th> <th>HS Code</th> <th>Qty</th> <th>Unit Price<br></th> <th>Total</th> </tr> </thead>";
                 	// Table Body
                 	PO_Table = PO_Table + "<tbody>";
                 	s_No = 0;
                 	total_Qty = 0;
                 	for each  catNO in get_Po_Cat_No
                 	{
                 		s_No = s_No + 1;
                 		get_Cat_Items = Purchase_LineItems[Purchase_Order == input.Po_ID && Style_Code == catNO] sort by Size_Order;
                 		for each  Items in get_Cat_Items
                 		{
                 			// 			s_No = s_No + 1;
                 			get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_PO.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == get_PO.Supplier && Style_ID == Items.Product];
                 			// 			if(get_Buyer_Product.count(ID) > 0,get_Buyer_Product.HS_Code,"")
                 			PO_Table = PO_Table + "<tr> <td>" + s_No + "</td> <td>" + get_Cat_Items.Product.Style_Code.Style_Name + "</td> <td>" + catNO + "</td> <td>" + Items.Product_Color.Color_Name + "</td> <td>" + Items.Product_Size.Size + "</td> <td>" + Items.Product.Gender + "</td> <td>" + if(!Items.Fabric_Composition.isEmpty(),Items.Fabric_Composition,"") + "</td> <td>" + if(!Items.HS_Code,Items.HS_Code,"") + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(Items.Quantity) + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(if(input.type == "PO",Items.Purchase_Price,Items.Selling_Price)) + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(if(input.type == "PO",Items.Purchase_Price_Sub_Total,Items.Selling_Price_Sub_Total)) + "</td> </tr>";
                 		}
                 		total_Qty = total_Qty + get_Cat_Items.sum(Quantity);
                 		PO_Table = PO_Table + "<tr> <td colspan=\"8\" class=\"text_Left text_Bold\">Sub Total</td> <td class=\"text_Bold t_right\">" + thisapp.Page.PO_Currency_Convert(get_Cat_Items.sum(Quantity)) + "</td> <td></td> <td class=\"text_Bold t_right\">" + thisapp.Page.PO_Currency_Convert(if(input.type == "PO",get_Cat_Items.sum(Purchase_Price_Sub_Total).round(2),get_Cat_Items.sum(Selling_Price_Sub_Total).round(2))) + "</td> </tr>";
                 	}
                 	// ---- Buyer-paid Additional Charges (QO template only) ----
                 	if(input.type == "QO")
                 	{
                 		buyerCharges = Additional_Charges_Form[Purchase_Order == input.Po_ID && Paid_By == "Buyer"];
                 		if(buyerCharges.count() > 0)
                 		{
                 			PO_Table = PO_Table + "<tr> <td colspan=\"11\" class=\"text_Left text_Bold\">Additional Charges : </td> </tr>";
                 			for each  charge in buyerCharges
                 			{
                 				chargeLabel = ifnull(charge.Charge_Type.Charge_Type,"Additional Charge");
                 				if(!charge.Description.isEmpty())
                 				{
                 					chargeLabel = chargeLabel + " - " + charge.Description;
                 				}
                 				PO_Table = PO_Table + "<tr> <td colspan=\"10\" class=\"text_Left\">" + chargeLabel + "</td> <td class=\"t_right\">" + thisapp.Page.PO_Currency_Convert(ifnull(charge.Amount1,0).round(2)) + "</td> </tr>";
                 			}
                 		}
                 	}
                 	//Grand Total
                 	PO_Table = PO_Table + "<tr> <td colspan=\"8\" class=\"text_Left text_Bold\">Grand Total</td> <td class=\"text_Bold t_right\">" + thisapp.Page.PO_Currency_Convert(total_Qty) + "</td> <td></td> <td class=\"text_Bold t_right\">" + if(input.type == "PO",thisapp.Page.PO_Currency_Convert(get_PO.Total_Purchase_Price.round(2)),thisapp.Page.PO_Currency_Convert(get_PO.Total_Selling_Price.round(2))) + "</td> </tr>";
                 	PO_Table = PO_Table + "</tbody> </table>";
                 	return PO_Table;
                 
}