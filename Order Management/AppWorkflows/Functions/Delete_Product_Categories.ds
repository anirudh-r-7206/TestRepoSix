list Delete_Records.Delete_Product_Categories()
{

                 	Product_Category_List = List();
                 	get_From_Sizes = Create_Size[ID != 0];
                 	Product_Category_List.addAll(get_From_Sizes.Product_Category.getall());
                 	get_From_Catelog = Add_Product[ID != 0];
                 	Product_Category_List.addAll(get_From_Catelog.Style_Category.getall());
                 	get_Style = Style[ID != 0];
                 	Product_Category_List.addAll(get_Style.Style_Category.getall());
                 	return Product_Category_List.distinct();
                 
}