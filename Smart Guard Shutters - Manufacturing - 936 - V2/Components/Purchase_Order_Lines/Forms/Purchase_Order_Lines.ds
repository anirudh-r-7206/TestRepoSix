form Purchase_Order_Lines
{
    displayname = "Purchase Order Lines"
    PO_Line_Details
    (
        type = section
        displayname = "PO Line Details"
        row = 1
        column = 0
        width = medium
    )
    Purchase_Order
    (
        type = picklist
        displayname = "Purchase Order"
        values = Purchase_Orders.ID
        displayformat = [PO_Number]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Line_Number
    (
        type = number
        displayname = "Line Number"
        maxchar = 10
        row = 1
        column = 2
        width = medium
    )
    Line_Type
    (
        type = picklist
        displayname = "Line Type"
        maxchar = 100
        values = {"Raw Material","Powder","Finished Product","Service Part","General"}
        row = 1
        column = 1
        width = medium
    )
    Material
    (
        type = picklist
        values = Material_Master.ID
        displayformat = [Material_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Powder
    (
        type = picklist
        values = Powder_Coating_Inventory.ID
        displayformat = [Powder_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Product
    (
        type = picklist
        values = Product_Catalogue.ID
        displayformat = [Product_Name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Description
    (
        type = textarea
        height = 100px
        row = 1
        column = 1
        width = medium
    )
    Quantity_Pricing
    (
        type = section
        displayname = "Quantity Pricing"
        visibility = true
        row = 2
        column = 1
        width = medium
    )
    Quantity
    (
        type = decimal
        decimalplace = 3
        row = 2
        column = 1
        width = medium
    )
    Unit
    (
        type = picklist
        values = Unit_Master.ID
        displayformat = [Unit_Name]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    Unit_Rate
    (
        type = decimal
        displayname = "Unit Rate"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Line_Discount
    (
        type = decimal
        displayname = "Line Discount"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Line_Tax
    (
        type = decimal
        displayname = "Line Tax"
        decimalplace = 2
        row = 2
        column = 1
        width = medium
    )
    Line_Total
    (
        type = decimal
        displayname = "Line Total"
        decimalplace = 2
        row = 2
        column = 2
        width = medium
    )
    Receiving_Links
    (
        type = section
        displayname = "Receiving Links"
        visibility = true
        row = 3
        column = 1
        width = medium
    )
    Received_Quantity
    (
        type = decimal
        displayname = "Received Quantity"
        decimalplace = 3
        row = 3
        column = 1
        width = medium
    )
    Received_Date
    (
        type = date
        displayname = "Received Date"
        row = 3
        column = 2
        width = medium
    )
    Stock_Posted
    (
        type = checkbox
        displayname = "Stock Posted"
        initial value = false
        row = 3
        column = 1
        width = medium
    )
    Linked_Production
    (
        type = picklist
        displayname = "Linked Production"
        values = Production_Records.ID
        displayformat = [Production_Code]
        searchable = true
        row = 3
        column = 2
        width = medium
    )
    Linked_Service
    (
        type = picklist
        displayname = "Linked Service"
        values = Service_Requests.ID
        displayformat = [Service_Code]
        searchable = true
        row = 3
        column = 1
        width = medium
    )
    Notes
    (
        type = textarea
        height = 120px
        row = 3
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
