void Dev.Insert_Buyer_to_User()
{

			
			                 	//	Create Buyer Users
			                 	get_Buyers = Buyers_Master[ID != 0];
			                 	for each  buyer in get_Buyers
			                 	{
			                 		get_Buyer_Primary_User = Create_User[Email.equalsIgnoreCase(buyer.Primary_Email)];
			                 		if(get_Buyer_Primary_User.count() <= 0 && !buyer.Primary_Name1.first_name.isEmpty() && !buyer.Primary_Name1.last_name.isEmpty() && !buyer.Primary_Email.isEmpty() && !buyer.Primary_Phone.isEmpty())
			                 		{
			                 			insert into Create_User
			                 			[
			                 				Added_User=zoho.loginuser
			                 				User_Name.first_name=buyer.Primary_Name1.first_name
			                 				User_Name.last_name=buyer.Primary_Name1.last_name
			                 				Email=buyer.Primary_Email.toLowerCase()
			                 				Mobile_Number=buyer.Primary_Phone
			                 				User_Type="Buyer"
			                 				Persona_Role="Buyer"
			                 				Associated_Buyer=buyer.ID
			                 				From_Supplier_Buyer=true
			                 				Approval_Status="Pending"
			                 				Status="Inactive"
			                 			]
			                 		}
			                 		get_Buyer_Secondary_User = Create_User[Email.equalsIgnoreCase(buyer.Person_2_Email)];
			                 		if(get_Buyer_Secondary_User.count() <= 0 && !buyer.Person_2_Name1.first_name.isEmpty() && !buyer.Person_2_Name1.last_name.isEmpty() && !buyer.Person_2_Email.isEmpty() && !buyer.Person_2_Phone.isEmpty())
			                 		{
			                 			insert into Create_User
			                 			[
			                 				Added_User=zoho.loginuser
			                 				User_Name.first_name=buyer.Person_2_Name1.first_name
			                 				User_Name.last_name=buyer.Person_2_Name1.last_name
			                 				Email=buyer.Person_2_Email.toLowerCase()
			                 				Mobile_Number=buyer.Person_2_Phone
			                 				User_Type="Buyer"
			                 				Persona_Role="Buyer"
			                 				Associated_Buyer=buyer.ID
			                 				From_Supplier_Buyer=true
			                 				Approval_Status="Pending"
			                 				Status="Inactive"
			                 			]
			                 		}
			                 		for each  by_Delivery in buyer.Delivery_Person_Details
			                 		{
			                 			get_Buyer_Delivery_User = Create_User[Email.equalsIgnoreCase(by_Delivery.Email)];
			                 			if(get_Buyer_Delivery_User.count() <= 0 && !by_Delivery.Contact_Person1.first_name.isEmpty() && !by_Delivery.Contact_Person1.last_name.isEmpty() && !by_Delivery.Email.isEmpty() && !by_Delivery.Phone_Number.isEmpty())
			                 			{
			                 				insert into Create_User
			                 				[
			                 					Added_User=zoho.loginuser
			                 					User_Name.first_name=by_Delivery.Contact_Person1.first_name
			                 					User_Name.last_name=by_Delivery.Contact_Person1.last_name
			                 					Email=by_Delivery.Email.toLowerCase()
			                 					Mobile_Number=by_Delivery.Phone_Number
			                 					User_Type="Buyer"
			                 					Persona_Role="Buyer"
			                 					From_Supplier_Buyer=true
			                 					Associated_Buyer=buyer.ID
			                 					Approval_Status="Pending"
			                 					Status="Inactive"
			                 				]
			                 			}
			                 		}
			                 	}
			                 
			
}