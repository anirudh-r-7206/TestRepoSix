string Style.PO_V2_Templet_Style()
{

			
			                 	return ".po-container *{ padding: 0; margin: 0; box-sizing: border-box; } .po-container { background-color: #ffffff; position: relative; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05); } /* Action Bar inside Header Row */ .logo-area { width: 140px; height: 46px; } .logo-area img { height: 100%; } .action-bar { display: flex; gap: 12px; } /* Updated Button Styles to White Background */ .btn { font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500; padding: 8px 24px; border-radius: 4px; cursor: pointer; outline: none; background-color: #ffffff; color: #000000; border: 1px solid #ffffff; } /* Header & First Row (Updated with Black Background) */ .header { background-color: #000000; margin-bottom: 25px; padding: 20px; display: flex; justify-content: space-between; align-items: center; } /* Metadata Title Area */ .po-meta-row { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 15px; } .title-tag { font-size: 11px; font-weight: 600; color: #7a8b9a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; } .po-number { font-size: 28px; font-weight: 700; color: #0d1b2a; margin-bottom: 5px; } .date-info { font-size: 12px; color: #9aa8b6; } /* Right side totals block styling preserved */ .totals-summary { display: flex; gap: 45px; text-align: right; } /* Divider line */ .divider { border: none; border-top: 1px solid #edf1f5; margin: 20px 0; } /* Parties Section */ .parties-grid { display: flex; justify-content: space-between; margin-top: 25px; margin-bottom: 25px; } .party-col { width: 48%; } .party-title { font-size: 16px; font-weight: 600; color: #1a2530; margin-bottom: 14px; } .party-name { font-size: 14px; font-weight: 600; color: #2c3a47; margin-bottom: 8px; } .party-details { font-size: 13px; color: #5a6b7c; line-height: 1.6; } /* Summary and Factory/Delivery Grid */ .logistics-grid { display: grid; grid-template-columns: 4.8fr 5.2fr; gap: 50px; margin-top: 25px; margin-bottom: 35px; } .sec-heading { font-size: 14px; font-weight: 600; color: #1a2530; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 15px; } /* Summary Table Specifics */ .summary-box { background-color: #fcfdfe; border-radius: 4px; } .summary-table { width: 100%; border-collapse: collapse; } .summary-table td { padding: 7px 0; font-size: 13.5px; color: #5a6b7c; vertical-align: top; } .summary-table td:nth-child(1) { width: 120px; } .summary-table td:nth-child(2) { width: 25px; color: #9aa8b6; } .summary-table td:nth-child(3) { color: #000000; font-weight: 500; } /* Factory / Delivery text styling */ .addr-text { font-size: 13px; color: #2c3a47; line-height: 1.6; } .muted-text { color: #5a6b7c; } /* Items Table Container Wrapper */ .order-info-section { margin-top: 40px; } /* Items Table */ .items-table { width: 100%; border-collapse: collapse; margin-bottom: 30px; } .items-table th { background-color: #000000; color: #ffffff; font-size: 11px; font-weight: 500; text-align: left; padding: 12px 8px; letter-spacing: 0.2px; vertical-align: middle; } .items-table td { padding: 16px 8px; font-size: 12px; color: #2c3a47; border-bottom: 1px solid #edf1f5; vertical-align: top; line-height: 1.4; } .items-table td.desc-text { color: #5a6b7c; font-size: 11.5px; max-width: 250px; } /* Table helper weight classes */ .font-medium { font-weight: 500; } .font-semibold { font-weight: 600; } .font-bold { font-weight: 700; } /* Totals Row Backgrounds */ .row-subtotal td { background-color: #eef1f4; border-bottom: 1px solid #ffffff; padding: 12px 8px; font-size: 13px; color: #1a2530; } .row-grandtotal td { background-color: #e2e7ec; border-bottom: none; padding: 12px 8px; font-size: 13px; color: #1a2530; } /* Footer signoff layout */ .footer-signoff { display: grid; grid-template-columns: 4.8fr 5.2fr; gap: 50px; margin-top: 45px; align-items: start; } /* Lines Signature inputs */ .signature-form { display: flex; flex-direction: column; gap: 16px; } .form-line { display: flex; align-items: flex-end; } .form-line .label { width: 110px; font-size: 12px; font-weight: 600; color: #3e4e5e; padding-bottom: 2px; } .form-line .line-input { flex-grow: 1; border-bottom: 1px solid #ced7e0; height: 20px; } /* Empty placeholder container to maintain layout structure */ .comments-box { display: flex; flex-direction: column; } .t_right {text-align: right;} thead { display: table-header-group !important; } .po-meta-row, .parties-grid, .logistics-grid, .order-info-section { margin: 0 25px; }";
			                 
			
}