string Style.buyer_Dashboard_Styles()
{

			
			                 	return ".overAll_Div,.stat-cards * { padding: 0; margin: 0; box-sizing: border-box; } .overAll_Div { height: calc(100% - 0px); display: flex; flex-direction: column; gap: 14px; padding: 20px; background-color: #f2f2f4;} .stat-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; } .stat-card { max-height: 150px; display: grid; background: #ffffff; border-radius: 14px; padding: 18px 20px 16px; border: 1px solid #ebebeb; box-shadow: 0 1px 4px rgba(0, 0, 0, .05); text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s; cursor: pointer; } .stat-card:hover { box-shadow: 0 6px 18px rgba(0, 0, 0, .09); transform: translateY(-2px); border-color: #d4d4d4; } .stat-card:active { transform: translateY(0px); box-shadow: 0 2px 6px rgba(0, 0, 0, .07); } .stat-card__body { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; } .stat-num { font-size: 2rem; font-weight: 800; color: #0f172a; letter-spacing: -1px; line-height: 1; } .stat-sub { font-size: 0.8rem; color: #94a3b8; font-weight: 400; } /* Icon circles */ .stat-card__icon { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; } .report_Div{ height: calc(100% - 14px); } /* Responsive */ @media (max-width: 768px) { .stat-cards { grid-template-columns: repeat(2, 1fr); } } @media (max-width: 420px) { .stat-cards { grid-template-columns: 1fr; } }";
			                 
			
}