list Deactivate_Records.Deactivate_Product_Category()
{

			
			                 	Category_List = List();
			                 	get_Size_Category = Create_Size[Status == "Active"];
			                 	Category_List.addAll(get_Size_Category.Product_Category.getall());
			                 	get_Product_Category = Add_Product[Status == "Approved"];
			                 	Category_List.addAll(get_Product_Category.Style_Category.getall());
			                 	return Category_List.distinct();
			                 
			
}