string Style.user_dashboard_style()
{

			
			                 	return "/* ============================= CSS VARIABLES & RESET ============================= */ :root { --bg-page: #f4f5f7; --bg-card: #ffffff; --bg-sidebar: #ffffff; --bg-topnav: #ffffff; --clr-primary: #4f46e5; --clr-primary-light: #818cf8; --clr-text-main: #1e293b; --clr-text-sub: #101828; --clr-text-muted: #94a3b8; --clr-border: #ECEEFF; --clr-hover: #f8fafc; --clr-purple: #7c3aed; --clr-purple-bg: #f5f3ff; --clr-orange: #ea580c; --clr-orange-bg: #fff7ed; --clr-pink: #db2777; --clr-pink-bg: #fdf2f8; --clr-blue: #2563eb; --clr-blue-bg: #eff6ff; --shadow-sm: 0 1px 3px rgba(0, 0, 0, .06), 0 1px 2px rgba(0, 0, 0, .04); --shadow-md: 0 4px 12px rgba(0, 0, 0, .07); --radius-sm: 8px; --radius-md: 12px; --radius-lg: 16px; --sidebar-w: 200px; --topnav-h: 60px; --font: 'DM Sans', sans-serif; } .procure-dashboard *, .procure-dashboard *::before, .procure-dashboard *::after { box-sizing: border-box; margin: 0; padding: 0; } .procure-dashboard { height: 100%; margin: 0; padding: 0; box-sizing: border-box; font-family: var(--font); background: var(--bg-page); color: var(--clr-text-main); /* min-height: 100vh; */ font-size: 14px; } .procure-dashboard a { text-decoration: none; color: inherit; } .procure-dashboard ul { list-style: none; } .procure-dashboard input { font-family: var(--font); } .procure-dashboard button { font-family: var(--font); cursor: pointer; } /* ============================= PAGE WRAPPER + SIDEBAR ============================= */ .page-wrapper { display: flex; height: 100%; } /* ============================= MAIN CONTENT ============================= */ .main-content { flex: 1; padding: 24px; display: flex; flex-direction: column; gap: 14px; overflow-x: hidden; min-width: 0; background-color: #f2f2f4;} /* ============================= STAT CARDS ============================= */ .stat-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; } .stat-card { background: var(--bg-card); border-radius: var(--radius-md); padding: 18px 20px; box-shadow: var(--shadow-sm); border: 1px solid var(--clr-border); transition: box-shadow 0.2s, transform 0.2s; padding-bottom: 5px;} .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-1px); } .stat-card__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #DADADA; } .stat-card__label { font-size: 16px; font-weight: 500; color: var(--clr-text-sub); letter-spacing: 0.4px; } .stat-card__icon { width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; } .stat-card__body { height: calc(100% - 55px); display: flex; align-items: center; gap: 16px; } .stat-item { flex: 1; display: flex; flex-direction: column; justify-content: space-around; height: 100%; margin-bottom: 7px; margin-top: 7px; border-radius: 5px;} .stat-num { font-size: 20px; font-weight: 700; color: var(--clr-text-main); letter-spacing: -1px; line-height: 1.1; } .stat-sub { font-size: 14px; color: var(--clr-text-muted); margin-top: 3px; } .stat-divider { width: 1px; height: 50px; background: #DADADA; flex-shrink: 0; } /* ============================= MIDDLE ROW ============================= */ .middle-row { display: grid; grid-template-columns: 1.3fr 1.6fr 0.7fr; gap: 14px; align-items: start; } /* Shared card */ .card { height: calc(100% - 0px); min-height: 300px; background: var(--bg-card); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); border: 1px solid var(--clr-border); } .card-title { font-size: 18px; font-weight: 700; color: var(--clr-text-main); margin-bottom: 15px; letter-spacing: -0.2px; border-bottom: 1px solid #E4E4E4; padding: 20px;} /* Donut chart card */ .donut-wrapper { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; padding: 0 20px 20px;} /* Bar chart card */ .bar-list { display: flex; flex-direction: column; gap: 10px; padding: 0 20px 20px; height: calc(100% - 113px); justify-content: space-between;} .bar-row { display: flex; align-items: center; gap: 16px; } .bar-label { font-size: 14px; color: var(--clr-text-sub); width: 160px; flex-shrink: 0; line-height: 1.35; } .bar-track { flex: 1; height: 8px; background: #e5e7eb; border-radius: 99px; overflow: hidden; } .bar-fill { height: 100%; border-radius: 99px; transition: width 0.7s cubic-bezier(.4, 0, .2, 1); } .bar-val { font-size: 14px; font-weight: 600; color: var(--clr-text-main); width: 24px; text-align: right; flex-shrink: 0; } /* Quick Links */ .link-list { display: flex; flex-direction: column; gap: 2px; list-style: none; padding: 0 20px 20px; margin: 0px; } .link-list li a { display: block; padding: 8px 10px; border-radius: 6px; font-size: 14px; color: var(--clr-text-sub); transition: background 0.15s, color 0.15s; } .link-list li a:hover { background: var(--clr-hover); color: var(--clr-primary); } /* ============================= RESPONSIVE ============================= */ @media (max-width: 1200px) { .stat-cards { grid-template-columns: repeat(2, 1fr); } .middle-row { grid-template-columns: 1fr 1fr; } .quick-links { grid-column: 1 / -1; } } @media (max-width: 900px) { :root { --sidebar-w: 56px; } .sidebar { padding: 16px 8px; } .menu-item span { display: none; } .menu-item { justify-content: center; gap: 0; } .topnav__links { display: none; } .logo-text { display: none; } } @media (max-width: 680px) { .stat-cards { grid-template-columns: 1fr; } .middle-row { grid-template-columns: 1fr; } .quick-links { grid-column: auto; } .main-content { padding: 14px; gap: 14px; } .topnav { padding: 0 14px; gap: 10px; } .search-bar { display: none; } .page-wrapper { flex-direction: column; } .sidebar { width: 100%; height: auto; position: relative; top: 0; border-right: none; border-bottom: 1px solid var(--clr-border); padding: 10px 12px; } .sidebar__menu { flex-direction: row; gap: 4px; flex-wrap: wrap; } .menu-item span { display: inline; } .menu-item { padding: 7px 10px; } .stat-num { font-size: 1.5rem; } } /* ============================= SUBTLE ANIMATIONS ============================= */ @keyframes fadeInUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } } .stat-card { animation: fadeInUp 0.35s ease both; } .stat-card:nth-child(1) { animation-delay: 0.05s; } .stat-card:nth-child(2) { animation-delay: 0.10s; } .stat-card:nth-child(3) { animation-delay: 0.15s; } .stat-card:nth-child(4) { animation-delay: 0.20s; } .middle-row .card { animation: fadeInUp 0.4s ease 0.25s both; } .table-card { animation: fadeInUp 0.4s ease 0.35s both; } ul.zc-legend-legseries, .legendgroup { max-width: 150px !important; width: 150px !important; } .popupbox:not(.zc-alert-popup-wrapper .popupbox) { height: 80%; width: 80%; }";
			                 
			
}