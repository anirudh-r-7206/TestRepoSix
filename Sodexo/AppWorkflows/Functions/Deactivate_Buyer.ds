list Deactivate_Records.Deactivate_Buyer()
{

			
			                 	Buyers_List = List();
			                 	get_From_User = Create_User[Status == "Active"];
			                 	Buyers_List.addAll(get_From_User.Associated_Buyer.getall());
			                 	return Buyers_List.distinct();
			                 
			
}