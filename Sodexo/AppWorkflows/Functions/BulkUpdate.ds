void BulkUpdate(Buyer_Products id)
{

			
			                 	getBuyerMapping = id.ID.getall();
			                 	resp = insert into Bulk_Edit_Tigger
			                 	[
			                 		Buyer_Products=getBuyerMapping
			                 		Added_User=zoho.loginuser
			                 	];
			                 	openUrl("#Form:Bulk_Update?Bulk_Edit_Tigger=" + resp,"popup window");
			                 
			
}