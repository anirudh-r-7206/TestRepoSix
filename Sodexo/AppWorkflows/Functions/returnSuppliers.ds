list helpers.returnSuppliers()
{

			
			                 	get_User = Create_User[Email == thisapp.Dev.get_User_Email() && Status == "Active"];
			                 	if(get_User.count() > 0)
			                 	{
			                 		return Buyer_Product_Mapping[Buyer == get_User.Associated_Buyer].Factory_Allocated.getAll();
			                 	}
			                 	return {};
			                 
			
}