void OneTime.Update_HS_Code_to_PO()
{

			
			                 	try 
			                 	{
			                 		for each  PO_Items in Purchase_LineItems[Purchase_Order != null && HS_Code.isEmpty()]
			                 		{
			                 			get_PO_Item = Purchase_LineItems[ID == PO_Items.ID];
			                 			get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == PO_Items.Purchase_Order.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == PO_Items.Purchase_Order.Supplier && Style_ID == PO_Items.Product];
			                 			get_PO_Item.HS_Code=if(get_Buyer_Product.count(ID) > 0,get_Buyer_Product.HS_Code,"");
			                 			info get_Buyer_Product;
			                 		}
			                 	}
			                 	catch (e)
			                 	{
			                 		sendmail
			                 		[
			                 			from :zoho.adminuserid
			                 			to :"dylfa.d+zcjscom@zohotest.com"
			                 			subject :"Error - `OneTime.Update_HS_Code_to_PO` function."
			                 			message :e
			                 		]
			                 	}
			                 
			
}