void OneTime.Update_PO_Buyer_Name()
{

			
			                 	fetPO = Purchase_Order[ID != 0];
			                 	for each  po in fetPO
			                 	{
			                 		get_PO = Purchase_Order[ID == po.ID];
			                 		fetBuyer = Buyer_Contact_Person_Details[Buyers_Master == get_PO.Buyer_Organisation] sort by Added_Time desc;
			                 		get_PO.Buyer_Contact_Person=if(fetBuyer.Contact_Person1.first_name.isEmpty(),"",fetBuyer.Contact_Person1.first_name) + if(fetBuyer.Contact_Person1.last_name.isEmpty(),""," " + fetBuyer.Contact_Person1.last_name);
			                 	}
			                 
			
}