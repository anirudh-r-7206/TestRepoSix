string References.Country(int countryId)
{

			
			                 	fetchCountry = Add_Country[ID == countryId];
			                 	// ─── Fetch references with meaningful display fields ───
			                 	refMap = Map();
			                 	// Add Product — display: Product_Custom_Display
			                 	rec1 = Add_Suppliers[Country == countryId];
			                 	if(rec1 != null && rec1.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r1 in rec1
			                 		{
			                 			val = if(r1.Supplier_Organisation != null && r1.Supplier_Organisation.toString() != "",r1.Supplier_Organisation.toString(),"Unnamed Supplier");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Add Suppliers",displayList.distinct());
			                 	}
			                 	// Buyer Products — display: Product_ID
			                 	rec2 = Buyers_Master[Country == countryId];
			                 	if(rec2 != null && rec2.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r2 in rec2
			                 		{
			                 			val = if(r2.Buyer_Organisation != null && r2.Buyer_Organisation.toString() != "",r2.Buyer_Organisation.toString(),"Unnamed Buyer");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyers Master",displayList.distinct());
			                 	}
			                 	// Order Details — display: Order_Request.Order_ID (lookup traversal)
			                 	rec3 = Fabric_Form[Country_of_Origin == countryId];
			                 	if(rec3 != null && rec3.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r3 in rec3
			                 		{
			                 			val = if(r3.Fabric_Code != null && r3.Fabric_Code.toString() != "",r3.Fabric_Code.toString(),"Unnamed Fabric");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Fabric Form",displayList.distinct());
			                 	}
			                 	// Purchase Line Items — display: Purchase_Order.PO_Number (lookup traversal)
			                 	rec4 = Purchase_Order[Country == countryId];
			                 	if(rec4 != null && rec4.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r4 in rec4
			                 		{
			                 			val = if(r4.PO_Number != null && r4.PO_Number.toString() != "",r4.PO_Number.toString(),"Unnamed PO");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Purchase Order",displayList.distinct());
			                 	}
			                 	// Size Chart Mapping — display: Size_Name
			                 	// 	rec5 = Size_Chart_Mapping[Region_New == countryId];
			                 	// 	if(rec5 != null && rec5.count() > 0)
			                 	// 	{
			                 	// 		displayList = List();
			                 	// 		for each  r5 in rec5
			                 	// 		{
			                 	// 			val = if(r5.Size_Name != null && r5.Size_Name.toString() != "",r5.Size_Name.toString(),"Unnamed Size Chart");
			                 	// 			displayList.add(val);
			                 	// 		}
			                 	// 		refMap.put("Size Chart Mapping",displayList.distinct());
			                 	// 	}
			                 	// Factory Details Subform — display: Factory Details
			                 	rec6 = Factory_Details_Subform[Factory_Country == countryId];
			                 	if(rec6 != null && rec6.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r6 in rec6
			                 		{
			                 			val = if(r6.Factory_Name != null && r6.Factory_Name.toString() != "",r6.Factory_Name.toString(),"Unnamed Factory");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Factory Details",displayList.distinct());
			                 	}
			                 	// Buyer Details Subform — display: Buyer Details
			                 	rec7 = Buyer_Contact_Person_Details[Country == countryId];
			                 	if(rec7 != null && rec7.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r7 in rec7
			                 		{
			                 			val = if(r7.Contact_Person1 != null && r7.Contact_Person1.toString() != "",r7.Contact_Person1.toString(),"Unnamed Contact");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Buyer Details",displayList.distinct());
			                 	}
			                 	// ─── Empty state ───
			                 	if(refMap.size() == 0)
			                 	{
			                 		return '';
			                 	}
			                 	// ─── Build module cards ───
			                 	moduleCards = '';
			                 	for each  key in refMap.keys()
			                 	{
			                 		displayValues = refMap.get(key);
			                 		itemCount = displayValues.size();
			                 		// Build chips from display values
			                 		chips = '';
			                 		for each  val in displayValues
			                 		{
			                 			chips = chips + '<span class="sr_chip">' + val + '</span>';
			                 		}
			                 		moduleCards = (moduleCards + '<div class="sr_card"> <div class="sr_card_header"> <span class="sr_card_title">' + key + '</span> <span class="sr_badge">') + itemCount.toString() + ' record' + if(itemCount > 1,'s','') + '</span> </div> <div class="sr_card_body">' + chips + '</div> </div>';
			                 	}
			                 	// ─── Totals ───
			                 	totalModules = refMap.size();
			                 	totalRecords = 0;
			                 	for each  key in refMap.keys()
			                 	{
			                 		totalRecords = totalRecords + refMap.get(key).size();
			                 	}
			                 	// ─── Final HTML ───
			                 	html = '<style> .sr_wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: 16px; background: #fff; } .sr_alert { background: #fff8f0; border: 1px solid #f97316; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; } .sr_alert_title { font-size: 14px; font-weight: 700; color: #c2410c; margin-bottom: 4px; } .sr_alert_sub { font-size: 12px; color: #9a3412; line-height: 1.5; } .sr_alert_meta { display: inline-block; background: #ffedd5; color: #9a3412; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fdba74; margin-top: 8px; margin-right: 6px; } .sr_section_title { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px; } .sr_card { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; } .sr_card_header { padding: 10px 14px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; overflow: hidden; } .sr_card_title { font-size: 13px; font-weight: 600; color: #1e293b; float: left; } .sr_badge { float: right; background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fde68a; } .sr_card_body { padding: 10px 14px; } .sr_chip { display: inline-block; background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; border: 1px solid #bfdbfe; margin-right: 6px; margin-bottom: 6px; } .sr_empty { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-align: center; padding: 40px 20px; } .sr_empty_icon { font-size: 36px; color: #22c55e; margin-bottom: 10px; } .sr_empty_title { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 6px; } .sr_empty_sub { font-size: 12px; color: #64748b; } </style> <div class="sr_wrapper"> <div class="sr_alert"> <div class="sr_alert_title">⚠ Country (<b>' + fetchCountry.Country_Name + '</b>) — cannot be edited, deactivated, or deleted</div> <div class="sr_alert_sub">Remove all references listed below before making any changes.</div> <div> <span class="sr_alert_meta">' + totalModules.toString() + ' Module' + if(totalModules > 1,'s','') + '</span><span class="sr_alert_meta">' + totalRecords.toString() + ' Record' + if(totalRecords > 1,'s','') + '</span> </div> </div> <div class="sr_section_title">Referenced In</div> ' + moduleCards + ' </div>';
			                 	return html;
			                 
			
}