string Style.Cart_Detail_Page_Style()
{

			
			                 	Form_Style = "form[name=\"Buyer_Cart_Detail\"].label-top{ width: auto !important; } [formLinkName='Buyer_Cart_Detail'] div.form-outer-wrapper  { padding: 0px !important; } [formLinkName='Buyer_Cart_Detail'] .formContainer { padding: 0px !important; } [formLinkName='Buyer_Cart_Detail'] label.zc_decision_box_label, [formLinkName='Buyer_Cart_Detail'] label#zc-Quantity-arialabel, [formLinkName='Buyer_Cart_Detail'] .zc-Size .choice-table-cell label:first-of-type, .zc-Colour label.choice-label-text { display: none; } .zc-Colour .customRadio+label:hover, .zc-Colour .customRadio:checked+label { border: none !important; outline: none; } span > input[type='radio'] + label { margin: 0px; } .customRadio+label:after { background-color: transparent; } .customRadio:checked+label:after { content: ''; height: calc(100% + 6px); width: calc(100% + 6px); top: -3px; left: -3px; background-color: transparent; border: 1px solid #29379E; } [formLinkName='Buyer_Cart_Detail'] .flLeft.tempContDiv.zc-Size, [formLinkName='Buyer_Cart_Detail'] .flLeft.tempContDiv.zc-Colour { display: flex; flex-wrap: wrap; } [formLinkName='Buyer_Cart_Detail'] .formColumn.first-column, [formLinkName='Buyer_Cart_Detail'] .formColumn.second-column, [formLinkName='Buyer_Cart_Detail'] .formColumn.column-3 { width: auto !important; } [formLinkName='Buyer_Cart_Detail'] .dual-column.column-block { width: fit-content; border: 1px solid #D3D3D3; border-radius: 10px; padding: 5px; } [formLinkName='Buyer_Cart_Detail'] input#zc-Quantity { width: 136px !important; text-align: center; border: none; box-shadow: none !important; } [formLinkName='Buyer_Cart_Detail'] span.zc-label-text { font-size: 12px !important; color: #696969 !important; font-weight: 500 !important; } [formLinkName='Buyer_Cart_Detail'] .choice-table-cell { padding: 0px !important; } [formLinkName='Buyer_Cart_Detail'] .choice-table-cell span{ padding: 0px !important; padding-right: 7px !important; padding-bottom: 7px !important; } [formLinkName='Buyer_Cart_Detail'] .zc-Size label.choice-label-text { min-width: 40px; min-height: 40px; text-align: center; align-content: center; font-size: 14px !important; font-weight: 600; white-space: nowrap; color: #4E4E4E !important; border-radius: 6px; padding: 10px !important; background: #F4F4F4; border: 1px solid #DFDFDF; } [formLinkName='Buyer_Cart_Detail'] .zc-Size .customRadio:checked~label { color: #29379E !important; border: 1px solid #29379E !important; background-color: #F1F2FA; } [formLinkName='Buyer_Cart_Detail'] label.form-label.decision-box-label { height: 38px; width: 38px !important; padding: 0px !important; margin: 0px !important; background-color: #F4F4F4; display: flex !important; align-items: center; justify-content: center; border-radius: 10px; font-size: 16px !important; font-weight: 600; } [formLinkName='Buyer_Cart_Detail'] .form-group.clearfix.zc-decisionbox-field-group, [formLinkName='Buyer_Cart_Detail'] .form-group.clearfix.zc-Quantity-group { margin: 0px !important; } [formLinkName='Buyer_Cart_Detail'] .zc-footer-wrapper { width: calc(100% - 240px); padding: 0px !important; position: absolute; bottom: 0; right: 0; } [formLinkName='Buyer_Cart_Detail'] input.zc-live-primary-btn{ margin: 0px; min-width: 100px; width: 100%; height: 49px; }";
			                 	page_Style = ".product-container *, .product-container *::before, .product-container *::after { box-sizing: border-box; margin: 0; padding: 0; } .product-container { display: flex; gap: 48px; width: calc(100% - 64px); background: #fff; border-radius: 12px; padding: 32px; box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08); } /* ── Left: Image ── */ .product-image { flex-shrink: 0; width: 320px; height: 380px; border-radius: 10px; overflow: hidden; background: #f0f0f0; } .product-image img { width: 100%; height: 100%; display: block; } /* ── Right: Details ── */ .product-details { min-width: 450px; flex: 1; display: flex; flex-direction: column; gap: 14px; position: relative; } .product_name { font-size: 22px; font-weight: 600; color: #1a1714; } .product_price { font-size: 26px; font-weight: 700; color: #3b3bbf; } .product-description { font-size: 13.5px; color: #555; line-height: 1.7; } [pagelinkname='Dynamic_Product_Image'] .Layout.elemContainment { height: 100%; } .sizeChartLink { font-size: 12px; color: #29379E; font-weight: 600; position: absolute; bottom: -32px; left: 100px; }";
			                 	return Form_Style + page_Style;
			                 
			
}