string Page.Buyer_Product_List(int Supplier, int Wardrobe, int Category)
{

			
			                 	return_Value = "";
			                 	get_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() && Status == "Active"];
			                 	if(get_Buyer.count() > 0)
			                 	{
			                 		get_Buyer_Org = Buyers_Master[ID == get_Buyer.Associated_Buyer && Status == "Active"];
			                 		if(get_Buyer_Org.count() > 0)
			                 		{
			                 			get_Stye_Codes = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer_Org.ID && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID.Wardrobe == input.Wardrobe && Style_ID.Style_Category == input.Category];
			                 			// 			info get_Stye_Codes;
			                 			style_Code = get_Stye_Codes.Style_ID.Style_Code.getall();
			                 			get_Product_Code = Style[ID in style_Code].Product_Code.getAll().distinct();
			                 			for each  pro_Code in get_Product_Code
			                 			{
			                 				info pro_Code;
			                 				get_style = Style[Product_Code == pro_Code];
			                 				for each  st_Code in get_style
			                 				{
			                 					get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer_Org.ID && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID.Style_Code in get_style.ID.getall() && Style_ID.Wardrobe == input.Wardrobe && Style_ID.Style_Category == input.Category];
			                 					get_Product_List = get_Product.Style_ID.getall();
			                 					if(get_Product_List.size() > 0)
			                 					{
			                 						image_link = get_Product.Style_ID.Primary_Image;
			                 						price_List = get_Product.Sell_Price.getall();
			                 						fileName = image_link.getSuffix("image/").getPrefix("\" lowqual");
			                 						pubImageUrl = "https://creatorapp.zoho.com/file" + zoho.appuri + "Buyer_Products1/" + get_Product.Style_ID + "/Primary_Image/image-download?filepath=/" + fileName;
			                 						return_Value = return_Value + "<a href='#Page:Product_Cart_Details?zc_LoadIn=dialog&Supplier=" + input.Supplier + "&Wardrobe=" + input.Wardrobe + "&Category=" + input.Category + "&Style_Master_Code=" + pro_Code + "' class=\"product-card\"> <div class='prod-img-wrapper'> <img src=" + pubImageUrl + "> </div> <div class=\"product-info\"> <div class=\"product-name\">Product Name</div> <div class=\"product-sku\">" + get_style.Product_Code.Product_Code + "</div> <div class=\"product-price\">Starting at : <strong>" + price_List.smallest() + "</strong></div> </div> </a>";
			                 						break;
			                 					}
			                 				}
			                 			}
			                 		}
			                 	}
			                 	return return_Value;
			                 
			
}