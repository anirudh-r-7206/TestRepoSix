string References.Fabrics(int fabricId)
{

			
			                 	fetchFabric = Fabric_Form[ID == fabricId];
			                 	// ─── Fetch references with meaningful display fields ───
			                 	refMap = Map();
			                 	// Add Product — display: Product_Custom_Display
			                 	rec1 = Add_Product[Fabric_Code == fabricId];
			                 	if(rec1 != null && rec1.count() > 0)
			                 	{
			                 		displayList = List();
			                 		for each  r1 in rec1
			                 		{
			                 			val = if(r1.Style_Name != null && r1.Style_Name.toString() != "",r1.Style_Name.toString(),"Unnamed Product");
			                 			displayList.add(val);
			                 		}
			                 		refMap.put("Add Product",displayList.distinct());
			                 	}
			                 	// ─── Empty state ───
			                 	if(refMap.size() == 0)
			                 	{
			                 		return '';
			                 	}
			                 	// ─── Build module cards ───
			                 	moduleCards = '';
			                 	for each  key in refMap.keys()
			                 	{
			                 		displayValues = refMap.get(key);
			                 		itemCount = displayValues.size();
			                 		// Build chips from display values
			                 		chips = '';
			                 		for each  val in displayValues
			                 		{
			                 			chips = chips + '<span class="sr_chip">' + val + '</span>';
			                 		}
			                 		moduleCards = (moduleCards + '<div class="sr_card"> <div class="sr_card_header"> <span class="sr_card_title">' + key + '</span> <span class="sr_badge">') + itemCount.toString() + ' record' + if(itemCount > 1,'s','') + '</span> </div> <div class="sr_card_body">' + chips + '</div> </div>';
			                 	}
			                 	// ─── Totals ───
			                 	totalModules = refMap.size();
			                 	totalRecords = 0;
			                 	for each  key in refMap.keys()
			                 	{
			                 		totalRecords = totalRecords + refMap.get(key).size();
			                 	}
			                 	// ─── Final HTML ───
			                 	html = '<style> .sr_wrapper { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; padding: 16px; background: #fff; } .sr_alert { background: #fff8f0; border: 1px solid #f97316; border-radius: 10px; padding: 14px 16px; margin-bottom: 16px; } .sr_alert_title { font-size: 14px; font-weight: 700; color: #c2410c; margin-bottom: 4px; } .sr_alert_sub { font-size: 12px; color: #9a3412; line-height: 1.5; } .sr_alert_meta { display: inline-block; background: #ffedd5; color: #9a3412; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fdba74; margin-top: 8px; margin-right: 6px; } .sr_section_title { font-size: 11px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 10px; } .sr_card { border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; overflow: hidden; background: #fff; } .sr_card_header { padding: 10px 14px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; overflow: hidden; } .sr_card_title { font-size: 13px; font-weight: 600; color: #1e293b; float: left; } .sr_badge { float: right; background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px; border: 1px solid #fde68a; } .sr_card_body { padding: 10px 14px; } .sr_chip { display: inline-block; background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 500; padding: 3px 10px; border-radius: 20px; border: 1px solid #bfdbfe; margin-right: 6px; margin-bottom: 6px; } .sr_empty { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; text-align: center; padding: 40px 20px; } .sr_empty_icon { font-size: 36px; color: #22c55e; margin-bottom: 10px; } .sr_empty_title { font-size: 15px; font-weight: 700; color: #1e293b; margin-bottom: 6px; } .sr_empty_sub { font-size: 12px; color: #64748b; } </style> <div class="sr_wrapper"> <div class="sr_alert"> <div class="sr_alert_title">⚠ Fabric (<b>' + fetchFabric.Fabric_Code + '</b>) — cannot be edited, deactivated, or deleted</div> <div class="sr_alert_sub">Remove all references listed below before making any changes.</div> <div> <span class="sr_alert_meta">' + totalModules.toString() + ' Module' + if(totalModules > 1,'s','') + '</span><span class="sr_alert_meta">' + totalRecords.toString() + ' Record' + if(totalRecords > 1,'s','') + '</span> </div> </div> <div class="sr_section_title">Referenced In</div> ' + moduleCards + ' </div>';
			                 	return html;
			                 
			
}