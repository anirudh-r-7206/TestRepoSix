string Style.Cart_Page_Style()
{

			
			                 	return ".overAll_Div *, .overAll_Div *::before, .overAll_Div *::after { margin: 0; padding: 0; box-sizing: border-box; text-decoration: none; } .overAll_Div { background: #f9f7f4; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #1a1714; height: calc(100% - 40px); overflow: hidden; display: flex; flex-direction: column; padding: 20px; background-color: #fff; border-radius: 20px; } /* ── Wardrobe Nav ── */ .wardrobe-nav { width: calc(100% - 67px); background: #fff; display: flex; gap: 35px; flex-shrink: 0; overflow: auto; } .wardrobe-nav a { text-decoration: none; font-size: 14px; font-weight: 400; color: #4C4C4C; padding: 10px 0px 13px 0px; border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s; white-space: nowrap; } .wardrobe-nav a.active { color: #29379E; border-bottom-color: #041362; font-weight: 500; } .wardrobe-nav a:hover:not(.active) { color: #1a1714; } /* ── Category Pills ── */ .category-bar { padding: 20px 0px; display: flex; gap: 10px; flex-wrap: wrap; flex-shrink: 0; } .pill { background: #F6F6F6; border-radius: 10px; padding: 7px 18px; font-size: 13px; font-weight: 400; color: #1a1714; cursor: pointer; transition: background 0.2s, border-color 0.2s, color 0.2s; user-select: none; } .pill.active { background: #F1F2FA; color: #29379E; font-weight: 500; } .pill:hover:not(.active) { background: #f0ece7; } /* ── Grid Wrapper (scrollable) ── */ .grid-wrapper { flex: 1; overflow-y: auto; min-height: 0; } /* ── Product Grid ── */ .product-grid { padding: 10px 5px; display: grid; grid-template-columns: repeat(auto-fill, minmax(221px, 1fr)); gap: 18px; }  /* ── Product Card ── */ .product-card { height: 370px; background: #fff; border-radius: 10px; overflow: hidden; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease; } .product-card:hover { transform: translateY(-4px); box-shadow: 1px 3px 15px rgba(0, 0, 0, .08); } .product-card img { width: 100%; height: 280px; border-radius: 10px; object-fit: contain; display: block; mix-blend-mode: darken;} .product-info { padding: 9px 14px 9px 5px; } .product-name { font-size: 14px; font-weight: 500; color: #000; margin-bottom: 8px; overflow: hidden; text-overflow: ellipsis; text-wrap: nowrap; } .product-sku { font-size: 14px; color: #7a7370; margin-bottom: 8px; overflow: hidden; text-overflow: ellipsis; text-wrap: nowrap; } .product-price { font-size: 14px; color: #555; overflow: hidden; text-overflow: ellipsis; text-wrap: nowrap; } .product-price strong { font-weight: 700; color: #1a1714; font-size: 13.5px; } .noData { height: 100%; font-size: 14px; font-weight: 500; text-align: center; align-content: center; } [pagelinkname=\"Buyer_Cart_Page\"] .Layout.elemContainment{ padding: 0px !important; }";
			                 
			
}