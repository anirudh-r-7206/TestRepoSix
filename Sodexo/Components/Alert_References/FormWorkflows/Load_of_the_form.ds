Load_of_the_form as "Load of the form"
{

			
							type =  form
							form = Alert_References
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														style = "<style>form[name=\"Alert_References\"].label-left{ width: 100% !important; }</style>";
													if(input.Create_Size != null)
													{
														input.Notes = style + thisapp.References.Size(input.Create_Size);
													}
													else if(input.Product_Code_Master != null)
													{
														input.Notes = style + thisapp.References.ProductCodeMaster(input.Product_Code_Master);
													}
													else if(input.Wardrobe != null)
													{
														input.Notes = style + thisapp.References.Wardrobe(input.Wardrobe);
													}
													else if(input.Add_Colors != null)
													{
														input.Notes = style + thisapp.References.Color(input.Add_Colors);
													}
													else if(input.Style != null)
													{
														input.Notes = style + thisapp.References.Style(input.Style);
													}
													else if(input.Add_Country != null)
													{
														input.Notes = style + thisapp.References.Country(input.Add_Country);
													}
													else if(input.Product_Category != null)
													{
														input.Notes = style + thisapp.References.ProductCategory(input.Product_Category);
													}
													else if(input.Freight_Partners_Form != null)
													{
														input.Notes = style + thisapp.References.FreightPartners(input.Freight_Partners_Form);
													}
													else if(input.Currency != null)
													{
														input.Notes = style + thisapp.References.Currency(input.Currency);
													}
													else if(input.Add_Product != null)
													{
														input.Notes = style + thisapp.References.Product(input.Add_Product);
													}
													else if(input.Fabric_Form != null)
													{
														input.Notes = style + thisapp.References.Fabrics(input.Fabric_Form);
													}
									)
								}
							}
			
						
			
}