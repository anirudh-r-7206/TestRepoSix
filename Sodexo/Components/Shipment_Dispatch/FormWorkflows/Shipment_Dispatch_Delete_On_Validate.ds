Shipment_Dispatch_Delete_On_Validate as "Validate Shipment Dispatch Delete"
{

			    type = form
			    form = Shipment_Dispatch
			    record event = on delete
			
			    on validate
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Dispatch_Status != "Draft")
			                {
			                    alert "Only draft shipment dispatches can be deleted.";
			                    cancel delete;
			                }
			            )
			        }
			    }
			
}