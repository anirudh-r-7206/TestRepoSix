kanban Shipment_Status_Board
{

		    displayName = "Shipment Status Board"
		    show all rows from Shipment_Dispatch [Dispatch_Status != "Cancelled"]
		    (
		        Shipment_Reference as "Shipment Reference"
		        Dispatch_Status as "Dispatch Status"
		        Buyer
		        Supplier
		        Transit_Mode as "Transit Mode"
		        Shipment_Status as "Shipment Status"
		        Estimated_Delivery_Date as "Estimated Delivery Date"
		    )
		    filters
		    (
		        Dispatch_Status
		        Buyer
		        Supplier
		        Transit_Mode
		        Shipment_Status
		    )
		    sort by
		    (
		        Estimated_Delivery_Date ascending
		    )
		    options
		    (
		        display field = Shipment_Status
		        emptycolumn = "No Status"
		        sortorder = ascending
		        recordcount = enable
		    )
		
}