Add_to_Cart as "Add to Cart"
{

			
							type =  functions
							form = Add_Product
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									get_Order_Buyer = Order_Request[Order_By.Email == zoho.loginuserid && Status == "Awaiting QO Generation" && Last_Order == true];
													get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
													if(get_Order_Buyer.count() > 0)
													{
														get_Product = Order_Details[Order_Request == get_Order_Buyer.ID && Product == input.ID];
														if(get_Product.count() > 0)
														{
															success message "This product is already in the cart.";
														}
														else
														{
															openUrl("#Form:Order_Details?Order_Request=" + get_Order_Buyer.ID + "&Product=" + input.ID,"popup window");
														}
													}
													else
													{
														success message "Please choose a buyer before adding the product to your cart.";
													}
								)
								}
							}
						
			
}