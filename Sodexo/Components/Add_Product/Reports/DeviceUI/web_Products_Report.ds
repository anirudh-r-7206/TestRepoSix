report Products_Report
{

		
						quickview
						(
							layout
							(
								datablock1
								(
									fields
									(
										Primary_Image as "Style Image"
										Style_Colour as "Colours"
										Fabric_Code.Fabric_Name as "Fabrics"
										Style_Name as "Styles"
										Style_Code as "Style Code"
										Style_Category as "Style Categories"
										Style_Code.Style_Description as "Style Description"
										Size_Set as "Sizes"
										Wardrobe as "Wardrobes"
									)
								)
							)
								menu
								(
									header
									(
										"Approve "
										"Discontinue"
									)
								record
								(
									"Duplicate Product"
		    					)
								)
		    				action
		    				(
								on click
								(
									View Record   	   
		    					)
								on right click
								(
									View Record   	   
		    					)
		     				)
						)
		
						detailview
						(
							layout
							(
				 				type = 2
								datablock1
								(
				     				title = "Overview"
									fields
									(
										Style_ID as "Style ID"
										Product_Sub_Code as "Product Sub Code"
										Style_Category as "Style Categories"
										Product_Picture.Image as "Product Picture"
										Style_Name as "Styles"
										Product_Description as "Fabric Description"
										Style_Colour as "Colours"
										Size_Set as "Sizes"
										Style_Range as "Style Range"
										Product_Weight as "Product Weight"
										Gender
										Fabric_Code as "Fabric Colour Code"
										Style_Code as "Style Code"
										HS_Code_EU as "HS Code EU "
										HS_Code_USA as "HS Code USA"
										HS_Code_APAC as "HS Code APAC"
										Wardrobe as "Wardrobes"
										CBM
										Status as "Status "
									)
								)
								datablock2
								(
									layout type = -1
				     				title = "Packaging Options "
				     				related field = Packaging_Options
									fields
									(
										Carton_Measurement as "Carton Measurement"
										Quantity_Per_Carton as "Quantity Per Carton"
										Weight_Per_Carton as "Weight Per Carton"
									)
								)
							)
								menu
								(
									header
									(
										"Edit "
										"Delete "
									)
								)
						)
					
		
}