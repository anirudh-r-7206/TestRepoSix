list Active_Products
{

		
					displayName = "Active Products"
					show all rows from Add_Product  [ID == thisapp.Filters.Filter_Products() && Status == "Approved"]  
					(
						Style_Code as "Style Code"
						Style_Colour as "Style Colour"
						Style_Range as "Style Range"
						Style_Name as "Style Name"
						Style_Category as "Product Category"
						Gender
						Size_Set as "Size Set"
						Fabric_Code as "Fabric Colour Code"
						HS_Code_EU as "HS Code EU "
						HS_Code_USA as "HS Code USA"
						HS_Code_APAC as "HS Code APAC"
						Product_Weight as "Product Weight"
						Status as "Status "
						Wardrobe
						CBM
						Product_Picture.Image as "Product Picture"
						Product_Description as "Fabric Description"
						Product_Sub_Code as "Product Sub Code"
						Style_ID as "Style ID"
						custom action "Add to Cart"
						(
			  			workflow = Add_to_Cart
						show action in edit record menu = true
						column header = "Add to Cart"
						)
						Primary_Image as "Primary Image"
						Size_Set.Size_Order as "Size Order"
					)
					filters
					(
						Status
						Wardrobe
						Style_Category
					)
					group by
					(
						properties
		    			(
		  	    			display record count = true
		   				)
						Style_Category ascending
						Style_Code ascending
					)
					sort by
					(
						Style_Category ascending
						Size_Set.Size_Order ascending
					)
					custom actions
					(
						"Discontinue"
						(
			  			workflow = Discontinue_Product_Catal
						show action in view header = true
						execute action for collection of records
						condition = (Status == "Approved")
						confirmation before execution
						(
							message for multiple records = "Are you sure you want to discontinue the selected ${record_count} records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Approve "
						(
			  			workflow = Approve_Product_Catalog
						show action in view header = true
						execute action for collection of records
						condition = (Status == "Discontinued")
						confirmation before execution
						(
							message for multiple records = "Are you sure you want to Approve  for the selected ${record_count} records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Delete Products"
						(
			  			workflow = Delete_Products
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Product_catalog())
						confirmation before execution
						(
							message for multiple records = "Are you sure you want to delete products for the selected ${record_count} records?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					conditional formatting
					(
						"Approved"
						{
						condition = (Status == "Approved")
						fields = [Status]
						format = "color:#5dc35a;"
						}
						"Discontinued"
						{
						condition = (Status == "Discontinued")
						fields = [Status]
						format = "color:#cc1111;"
						}
					)
				
		
}