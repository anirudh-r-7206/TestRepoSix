Generate_product_sub_code4 as "Generate product sub code"
{

			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Size_Set
							{
								actions 
								{
									custom deluge script
									(
														input.Style_ID = if(input.Style_Code == null,"",input.Style_Code.Style_Code) + if(input.Size_Set == null,"","-" + input.Size_Set.Size);
													//  + if(input.Product_Colour == null,"","-" + input.Product_Colour.Color_Code)
									)
								}
							}
			
						
			
}