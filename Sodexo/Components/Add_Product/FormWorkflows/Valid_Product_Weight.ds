Valid_Product_Weight as "Valid Product Weight"
{

			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Product_Weight
							{
								actions 
								{
									custom deluge script
									(
														if(input.Product_Weight != null && input.Product_Weight <= 0)
													{
														alert "Product weight must be greater than 0";
														input.Product_Weight = null;
													}
