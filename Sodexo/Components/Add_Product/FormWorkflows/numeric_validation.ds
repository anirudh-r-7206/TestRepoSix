numeric_validation as "numeric validation"
{

			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of CBM
							{
								actions 
								{
									custom deluge script
									(
														if(!input.CBM.isEmpty())
													{
														if(input.CBM.isNumber() == false)
														{
															alert "CBM must be a numeric value.";
															input.CBM = null;
														}
													}
									)
								}
							}
			
						
			
}