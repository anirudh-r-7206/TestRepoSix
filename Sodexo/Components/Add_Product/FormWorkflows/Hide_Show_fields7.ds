Hide_Show_fields7 as "Hide & Show fields"
{

			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														hide Hide_Section;
													disable Style_ID;
													disable Style_Colour;
													disable Style_Range;
													hide Packaging_Options;
													hide CBM;
													if(input.Fabric_Code != null)
													{
														old_Fabric = input.Fabric_Code;
														get_Fabric_Code = Fabric_Form[Colour_Code == input.Style_Colour].ID.getAll();
														get_Fabric_Code.add(old_Fabric);
														input.Fabric_Code:ui.add(get_Fabric_Code);
														input.Fabric_Code = old_Fabric;
													}
													if(input.Size_Set != null)
													{
														if(input.Style_Category != null)
														{
															getAll_Size = Create_Size[Product_Category == input.Style_Category && Status == "Active"].ID.getAll();
															get_Product_Size = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Style_Category && Style_Code == input.Style_Code && Style_Colour == input.Style_Colour].Size_Set.getAll();
															getAll_Size.removeAll(get_Product_Size);
															if(input.Size_Set != null)
															{
																old_Size = input.Size_Set;
																getAll_Size.add(old_Size);
																input.Size_Set:ui.add(getAll_Size.distinct());
																input.Size_Set = old_Size;
															}
															else
															{
																input.Size_Set:ui.add(getAll_Size);
															}
														}
														else
														{
															clear Size_Set;
														}
													}
									)
								}
							}
			
						
			
}