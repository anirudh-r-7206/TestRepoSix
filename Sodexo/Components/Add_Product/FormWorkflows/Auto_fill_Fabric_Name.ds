Auto_fill_Fabric_Name as "Auto fill Fabric Name"
{

			
							type =  form
							form = Add_Product
			
							record event = on add or edit
			
							on user input of Fabric_Code
							{
								actions 
								{
									custom deluge script
									(
														input.Product_Description = input.Fabric_Code.Fabric_Description;
									)
								}
							}
			
						
			
}