default list Factory_Details_Subform_Report
{

		
					displayName = "Factory Details Subform Report"
					show all rows from Factory_Details_Subform    
					(
						Factory_Name as "Factory Name"
						Contact_Person as "Contact Person1"
						Factory_Email as "Factory Email"
						Factory_Phone as "Factory Phone"
						(
							displayformat = plainnumber 
						)
						Factory_Address  as "Factory Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						Factory_Country as "Factory Country"
						Add_Suppliers as "Add Suppliers"
						Factory_Email_old as "Factory Email old"
						Need_App_Access as "Need App Access"
						Contact_Person1  as "Contact Person"
						Company_Name as "Company Name"
					)
				
		
}