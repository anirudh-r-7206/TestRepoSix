Delete_Freight_Partners as "Delete  Freight Partners"
{

			
							type =  functions
							form = Freight_Partners_Form
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									reference = thisapp.References.FreightPartners(input.ID);
													if(reference.trim() != "" && reference != null)
													{
														url = "#Form:Alert_References?zc_Header=false&Freight_Partners_Form=" + input.ID;
														window = "popup window";
														openUrl(url,window);
													}
													else
													{
														delete from Freight_Partners_Form[ID == input.ID];
													}
								)
								}
							}
						
			
}