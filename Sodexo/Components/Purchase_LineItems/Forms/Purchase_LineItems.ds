form Purchase_LineItems
{

		
					displayname = "Purchase LineItems"
					success message = "Data Added Successfully!"
					Section1
					(
						type = section
						displayname = "Section"
			 			row = 1
			 			column = 0   
						width = medium
					)
					plain
					(
		    			type = plaintext
						value = "<div> <br /></div>"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Section
					(
						type = section
			 			row = 2
			 			column = 0   
						width = medium
					)
					Purchase_Order
					(
						type = picklist	
						displayname = "Purchase Order"
						values  = Purchase_Order.ID
		    			bidirectional = Purchase_LineItems
		    			displayformat = [PO_Number]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
					S_No
					(
						type = number
						displayname = "S.No"
			 			row = 2
			 			column = 1   
						width = medium
					)
					must have Product
					(
						type = picklist	
						displayname = "Style ID"
						values  = Add_Product.ID
		    			displayformat = [Style_ID]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
					Style_Code
					(
		    			type = text
						displayname = "Style Code"
			 			row = 2
			 			column = 1   
						width = medium
					)
					must have Product_Color
					(
						type = picklist	
						displayname = "Product Color"
						values  = Add_Colors.ID
		    			displayformat = [Color_Name]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = medium
					)
					must have Product_Size
					(
						type = picklist	
						displayname = "Product Size"
						values  = Create_Size.ID
		    			displayformat = [Size]
						sortorder = ascending
			 			row = 2
			 			column = 1   
						width = small
					)
					Description
					(
		    			type = textarea
						height = 100px
			 			row = 2
			 			column = 1   
						width = medium
					)
					must have Quantity
					(
						type = number
						format = commadotwestern
			 			row = 2
			 			column = 1   
						width = small
					)
					Selling_Price
					(
						type = decimal
						displayname = "Selling Price"
						format = commadotwestern
			 			row = 2
			 			column = 2   
						width = small
					)
					Purchase_Price
					(
						type = decimal
						displayname = "Purchase Price"
						format = commadotwestern
			 			row = 2
			 			column = 2   
						width = small
					)
					Selling_Price_Sub_Total
					(
						type = decimal
						displayname = "Selling Price Sub Total"
						format = commadotwestern
			 			row = 2
			 			column = 2   
						width = small
					)
					Purchase_Price_Sub_Total
					(
						type = decimal
						displayname = "Purchase Price Sub Total"
						format = commadotwestern
			 			row = 2
			 			column = 2   
						width = small
					)
					Hidden_Section
					(
						type = section
						displayname = "Hidden Section"
						visibility = true
			 			row = 3
			 			column = 0   
						width = medium
					)
					HS_Code
					(
		    			type = text
						displayname = "HS Code"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Fabric_Composition
					(
		    			type = textarea
						displayname = "Fabric Composition"
						height = 100px
			 			row = 3
			 			column = 1   
						width = medium
					)
					Size_Order
					(
		    			type = formula
						displayname = "Size Order"
						value =  input.Product_Size.Size_Order
						visibility = false
			 			row = 3
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
						}
					}
				
		
}