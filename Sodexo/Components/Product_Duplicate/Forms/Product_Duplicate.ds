form Product_Duplicate
{

		
					displayname = "Product Duplicate"
					store data in zc = false
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Product
					(
						type = picklist	
						values  = Add_Product.ID
		    			displayformat = [Style_ID]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Variant_Type
					(
						type = radiobuttons
						displayname = "Variant Type"
						maxchar = 100
						values = {"Size","Color"}
						layout = 2
			 			row = 1
			 			column = 1   
						width = medium
					)
					Size
					(
						type = list	
						values  = Create_Size.ID
		    			displayformat = [Size]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Colors
					(
						type = list	
						values  = Add_Colors.ID
		    			displayformat = [Color_Name]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Style
					(
						type = list	
						values  = Style.ID
		    			displayformat = [Style_Code]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						Submit
						(
		   					type = submit
		   					displayname = "Submit"
						)
					}
				
		
}