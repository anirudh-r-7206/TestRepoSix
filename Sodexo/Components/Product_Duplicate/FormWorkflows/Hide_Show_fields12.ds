Hide_Show_fields12 as "Hide & Show fields"
{

			
							type =  form
							form = Product_Duplicate
			
							record event = on add
			
							field rules
							{
								actions 
								{
									hide Size,Style,Colors,Product;
								}
								actions  (Variant_Type == "Size")
								{
									show Size;
								}
								actions  (Variant_Type == "Color")
								{
									show Style,Colors;
								}
								actions 
								{
									disable Style;
								}
							}
			
						
			
}