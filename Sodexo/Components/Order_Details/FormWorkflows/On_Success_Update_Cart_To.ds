On_Success_Update_Cart_To as "On Success - Update Cart Total"
{

			
							type =  form
							form = Order_Details
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														buyer_info = Create_User[Email == zoho.loginuserid && Status == "Active"];
													fetBuyerProduct = Buyer_Product_Mapping[Buyer == buyer_info.Associated_Buyer && Factory_Allocated == input.Supplier];
													if(buyer_info.User_Type == "Buyer")
													{
														order_request = Order_Request[Order_By.Email == zoho.loginuserid && Buyer_Organisation == buyer_info.Associated_Buyer.ID && Buyer_Name == buyer_info.ID && Factory == input.Supplier && Status == "Pending"];
														if(order_request.count() == 0)
														{
															order_id = insert into Order_Request
															[
																Added_User=zoho.loginuser
																Buyer_Name=buyer_info.ID
																Buyer_Organisation=buyer_info.Associated_Buyer.ID
																Factory=input.Supplier
																Cart_Total=input.Sub_Total
																Total_Quantity=0
																Selling_Currency=if(fetBuyerProduct.count() > 0,fetBuyerProduct.Sell_Currency,null)
																Order_By=buyer_info.ID
																Status="Pending"
															];
															inserted_request = Order_Request[ID == order_id];
															inserted_request.Order_ID="OR" + inserted_request.Auto_Number;
															input.Order_Request = inserted_request.ID;
															fetOrder = Order_Details[Order_Request == order_id];
															inserted_request.Total_Quantity=fetOrder.sum(Quantity);
															HistoryPush = insert into History
															[
																Added_User=zoho.loginuser
																Order_ID=inserted_request.ID
																Raised_By=buyer_info.ID
																Status="Pending"
																Comments="Order Request " + inserted_request.Order_ID + " has been raised by " + if(inserted_request.Order_By != null,inserted_request.Order_By.User_Name,inserted_request.Buyer_Name.User_Name) + "."
															];
														}
														else
														{
															input.Order_Request = order_request.ID;
															order_request.Selling_Currency=if(fetBuyerProduct.count() > 0,fetBuyerProduct.Sell_Currency,null);
															order_request.Cart_Total=order_request.Cart_Total + input.Sub_Total;
															fetOrder = Order_Details[Order_Request == order_request.ID];
															order_request.Total_Quantity=fetOrder.sum(Quantity);
														}
													}
													else
													{
														get_Order_Buyer = Order_Request[ID == input.Order_Request];
														if(get_Order_Buyer.count() > 0)
														{
															get_Order_Buyer.Cart_Total=get_Order_Buyer.Cart_Total + input.Sub_Total;
															fetOrder = Order_Details[Order_Request == get_Order_Buyer.ID];
															get_Order_Buyer.Total_Quantity=fetOrder.sum(Quantity);
															fetBuyerProduct = Buyer_Product_Mapping[Buyer == get_Order_Buyer.Buyer_Organisation && Factory_Allocated == get_Order_Buyer.Factory];
															get_Order_Buyer.Selling_Currency=if(fetBuyerProduct.count() > 0,fetBuyerProduct.Sell_Currency,null);
															openUrl("#Page:Product_Catalogue_Cart_Page?zc_LoadIn=embed-Cart_Products&Buyer_ID=" + get_Order_Buyer.Buyer_Organisation + "&Suppliyer_ID=" + get_Order_Buyer.Factory,"same window");
														}
													}
									)
								}
							}
			
						
			
}