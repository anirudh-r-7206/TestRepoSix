Valid_Sell_Price1 as "Valid Sell Price"
{

			
							type =  form
							form = Buyer_Product_Mapping
			
							record event = on add or edit
			
							on user input of Style_Details.Sell_Price
							{
								actions 
								{
									custom deluge script
									(
														if(row.Sell_Price <= 0)
													{
														alert "Sell price must be greater than 0.";
														row.Sell_Price=null;
													}
									)
								}
							}
			
						
			
}