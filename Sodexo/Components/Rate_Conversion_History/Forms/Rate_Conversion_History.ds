form Rate_Conversion_History
{

		
					displayname = "Rate Conversion History"
					success message = "Currency Conversion Rate Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Currency_Conversion_Rates
					(
						type = picklist	
						displayname = "Currency Conversion Rates"
						values  = Currency_Conversion_Rates.ID
		    			bidirectional = Rate_Conversion_History_ID
		    			displayformat = [ID]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Style_Name
					(
						type = picklist	
						displayname = "Style Name"
						values  = Style.ID
		    			displayformat = [Style_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Currency
					(
						type = picklist
						maxchar = 100
						values = {"Choice 1","Choice 2","Choice 3"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					Conversion_Rate
					(
						type = decimal
						displayname = "Conversion Rate"
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}