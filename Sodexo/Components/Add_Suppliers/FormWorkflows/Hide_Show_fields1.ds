Hide_Show_fields1 as "Hide & Show fields"
{

			
							type =  form
							form = Add_Suppliers
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														hide Hide_Section;
													hide Factory_Details.Factory_Email_old;
													hide Contact_Person1;
													hide Contact_Person;
													hide Factory_Details.Contact_Person;
									)
								}
							}
			
						
			
}