Valid_Factory_Email as "Valid Factory Email"
{

			
							type =  form
							form = Add_Suppliers
			
							record event = on add or edit
			
							on user input of Factory_Details.Factory_Email
							{
								actions 
								{
									custom deluge script
									(
														if(row.Factory_Email != null && row.Factory_Email != "")
													{
														// 	duplicate_Email = false;
														// 	focal_Count = 0;
														// 	if(duplicate_Email == true)
														// 	{
														// 		alert "Duplicate email not allowed.";
														// 		row.Factory_Email=null;
														// 	}
														// 	if(duplicate_Email == false)
														// 	{
														row.Need_App_Access=false;
														if(row.Factory_Email == input.Email)
														{
															row.Need_App_Access=input.Need_App_Access;
														}
														fetUser = Create_User[Email.equalsIgnoreCase(row.Factory_Email)];
														if(fetUser.count() > 0)
														{
															if(fetUser.User_Type != "Factory")
															{
																alert "This email is already associated with buyer or internal user.";
																row.Factory_Email=null;
															}
															else if(fetUser.User_Type == "Factory" && fetUser.Associated_Factory != input.ID)
															{
																alert "This email is already linked to another factory.";
																row.Factory_Email=null;
															}
														}
														else
														{
															if(!thisapp.permissions.profileForUser(row.Factory_Email).isEmpty())
															{
																alert "This email is already mapped to a different user profile.";
																row.Factory_Email=null;
															}
															else if(thisapp.permissions.adminEmailIds().containsIgnoreCase(row.Factory_Email))
															{
																alert "User email IDs cannot be used as factory email IDs.";
																row.Factory_Email=null;
															}
														}
														// 	}
													}
													if(row.Factory_Email != null)
													{
														if(input.Email.equalsIgnoreCase(row.Factory_Email))
														{
															input.Need_App_Access = row.Need_App_Access;
														}
														if(input.Email1.equalsIgnoreCase(row.Factory_Email))
														{
															input.Need_App_Access1 = row.Need_App_Access;
														}
													}
									)
								}
							}
			
						
			
}