report Active_Suppliers
{

		
						quickview
						(
							layout
							(
				 				type = 2
			     				recordsperrow = 3
								datablock1
								(
									layout type = 4
									fields
									(
										Supplier_Organisation as "Supplier Organisation"
										Factory_Address as "Invoice Address"
										Email
										Phone
										Status
									)
								)
							)
								menu
								(
									header
									(
										"Delete Suppliers"
									)
								record
								(
									"Deactivate"
		    					)
								)
		    				action
		    				(
								on click
								(
									View Record   	   
		    					)
								on right click
								(
									"Deactivate"
									View Record   	   
		    					)
		     				)
						)
		
						detailview
						(
							layout
							(
				 				type = 2
								datablock1
								(
				     				title = "Overview"
									fields
									(
										Supplier_type as " Supplier type"
										Supplier_Code as "Supplier Code"
										Supplier_Organisation as "Supplier Organisation"
										Contact_Person2 as "Contact Person"
										Email
										Phone
										Factory_Address as "Invoice Address"
										Country
										ERP_System as "ERP System"
										Status
									)
								)
								datablock3
								(
				     				title = "Secondary Contact Details"
									fields
									(
										Contact_Person3 as "Contact Person"
										Email1 as "Email"
										Phone_Number as "Phone"
									)
								)
								datablock2
								(
									layout type = -1
				     				title = "Factory Details"
				     				related field = Factory_Details
									fields
									(
										Company_Name as "Company Name"
										Factory_Name as "Factory Name"
										Contact_Person1 as "Contact Person"
										Factory_Email as "Factory Email"
										Factory_Phone as "Factory Phone"
										Factory_Address as "Factory Address"
										Factory_Country as "Factory Country"
									)
								)
							)
								menu
								(
									header
									(
										"Deactivate"
										Edit 
									)
								)
						)
					
		
}