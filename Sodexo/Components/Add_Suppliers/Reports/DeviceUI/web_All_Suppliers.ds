report All_Suppliers
{

		
						quickview
						(
							layout
							(
								datablock1
								(
									fields
									(
										Supplier_Code as "Supplier Code"
										Supplier_Organisation as "Supplier Organisation"
										Email
										Phone as "Phone "
										Factory_Address as "Invoice Address"
										Status
										Supplier_type as " Supplier type"
									)
								)
							)
								menu
								(
									header
									(
										"Delete Suppliers"
									)
								record
								(
									"Activate"
									"Deactivate"
		    					)
								)
		    				action
		    				(
								on click
								(
									View Record   	   
		    					)
								on right click
								(
									"Activate"
									"Deactivate"
									View Record   	   
		    					)
		     				)
						)
		
						detailview
						(
							layout
							(
				 				type = 2
								datablock1
								(
				     				title = "Overview"
									fields
									(
										Supplier_type as " Supplier type"
										Supplier_Code as "Supplier Code"
										Supplier_Organisation as "Supplier Organisation"
										Contact_Person2 as "Contact Person"
										Email
										Phone as "Phone "
										Factory_Address as "Invoice Address"
										Country
										ERP_System as "ERP System"
										Status
									)
								)
								datablock7
								(
				     				title = "Secondary Contact Details"
									fields
									(
										Contact_Person3 as "Contact Person"
										Email1 as "Email"
										Phone_Number as "Phone"
									)
								)
								datablock6
								(
									layout type = -1
				     				title = "Factory Details"
				     				related field = Factory_Details
									fields
									(
										Company_Name as "Company Name"
										Factory_Name as "Factory Name"
										Contact_Person1 as "Contact Person"
										Factory_Email as "Factory Email"
										Factory_Phone as "Factory Phone"
										Factory_Address as "Factory Address"
										Factory_Country as "Factory Country"
									)
								)
								datablock4
								(
									layout type = -1
				     				title = "User"
				     				related field = Create_User_Employee_External_ID
									fields
									(
										User_Name as "User Name"
										Employee_External_ID as "Employee/External ID"
										Email
										Mobile_Number as "Mobile Number"
										User_Type as "User Type"
										Persona_Role as "Persona/Role"
										Status as "Status "
									)
								)
								datablock5
								(
									layout type = -1
				     				title = "Associated Buyers"
				     				related field = Create_User.Associated_Factory
									fields
									(
										User_Name as "User Name"
										Employee_External_ID as "Employee/External ID"
										Email
										Mobile_Number as "Mobile Number"
										User_Type as "User Type"
										Persona_Role as "Persona/Role"
										Status as "Status "
									)
								)
							)
								menu
								(
									header
									(
