list Awaiting_Supplier_Approvals
{

		
					displayName = "Suppliers"
					show all rows from Add_Suppliers  [Approval_Status == "Pending"]  
					(
						Supplier_Code as "Supplier Code"
						Country
						Email
						Phone as "Phone "
						(
							displayformat = plainnumber 
						)
						Factory_Address  as "Invoice Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						ERP_System as "ERP System"
						Status
						Approval_Status as "Approval Status"
						Supplier_Organisation as "Supplier Organisation"
						Supplier_type as " Supplier type"
						Contact_Person2  as "Contact Person"
						custom action "Approve"
						(
			  			workflow = Approve_Supplier
						show action in view header = true
						show action in edit record menu = true
						column header = "Approve"
						confirmation before execution
						(
							message for individual record = "Are you sure you want to approve this supplier?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						custom action "Reject"
						(
			  			workflow = Reject_Supplier
						show action in view header = true
						show action in edit record menu = true
						column header = "Reject"
						confirmation before execution
						(
							message for individual record = "Are you sure you want to reject this supplier?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					custom actions
					(
						"Activate"
						(
			  			workflow = Active_Supplier
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Inactive")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to activate this supplier?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Deactivate"
						(
			  			workflow = Deactivate_Supplier
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Active")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to deactivate this supplier?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Delete Suppliers"
						(
			  			workflow = Delete_Selected_Suppliers
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Suppliers())
						)
					)
					conditional formatting
					(
						"Approved"
						{
						condition = (Approval_Status == "Approved")
						fields = [Status, Approval_Status]
						format = "color:#5dc35a;"
						}
						"Rejected"
						{
						condition = (Approval_Status == "Rejected")
						fields = [Status, Approval_Status]
						format = "color:#ef1616;"
						}
						"Pending"
						{
						condition = (Approval_Status == "Pending")
						fields = [Approval_Status]
						format = "color:#11b1cc;"
						}
					)
				
		
}