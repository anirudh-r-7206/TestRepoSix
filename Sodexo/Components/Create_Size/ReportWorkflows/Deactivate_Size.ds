Deactivate_Size as "Deactivate Size"
{

			
							type =  functions
							form = Create_Size
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									reference = thisapp.References.Size(input.ID);
													if(reference.trim() != "" && reference != null)
													{
														url = "#Form:Alert_References?zc_Header=false&Create_Size=" + input.ID;
														window = "popup window";
														openUrl(url,window);
													}
													else
													{
														input.Status = "Inactive";
													}
								)
								}
							}
						
			
}