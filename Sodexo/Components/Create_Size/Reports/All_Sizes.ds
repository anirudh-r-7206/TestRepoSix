default list All_Sizes
{

		
					displayName = "Sizes"
					show all rows from Create_Size    
					(
						Size as "Universal Size"
						Product_Category as "Product Category"
						Status
						Chart_Details as "Chart Details"
						Gender
						Size_Order as "Size Order"
						Size_Chart_Details as "Equivalent Regional Size"
						(
							view = All_Size_Chart_Mappings
							field = Size_Chart_Details.Region_New + " " + Size_Chart_Details.Size_Name
						)
					)
					group by
					(
						Gender ascending
					)
					custom actions
					(
						"Activate"
						(
			  			workflow = Activate_Size
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Inactive")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to activate this Size?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Deactivate"
						(
			  			workflow = Deactivate_Size
						show action in view header = true
						show action in edit record menu = true
						condition = (Status == "Active")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to deactivate this size?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Delete Sizes"
						(
			  			workflow = Delete_Sizes
						show action in view header = true
						show action in edit record menu = true
						condition = (ID != thisapp.Delete_Records.Delete_Size())
						)
						"Edit "
						(
			  			workflow = Edit
						show action in view header = true
						show action in edit record menu = true
						)
						"Delete "
						(
			  			workflow = Delete_workflow1
						show action in view header = true
						show action in edit record menu = true
						confirmation before execution
						(
							message for individual record = "Are you sure you want to delete this item? This action cannot be undone."
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
					conditional formatting
					(
						"Active"
						{
						condition = (Status == "Active")
						fields = [Status]
						format = "color:#5dc35a;"
						}
						"Inactive"
						{
						condition = (Status == "Inactive")
						fields = [Status]
						format = "color:#ef1616;"
						}
					)
				
		
}