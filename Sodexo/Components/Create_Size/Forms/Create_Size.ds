form Create_Size
{

		
					displayname = "Create Size"
					success message = "Size Created Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have Gender
					(
						type = picklist
						maxchar = 100
						values = {"Men","Women","Unisex"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Product_Category
					(
						type = list	
						displayname = "Product Category"
						values  = Product_Category[Status == "Active"].ID
		    			displayformat = [Product_Category]
						allow new entries
						[
							displayname = "Add Category"
						]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Size
					(
		    			type = text
						displayname = "Universal Size"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						maxchar = 100
						values = {"Active","Inactive"}
						initial value = "Active"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Chart_Details
					(
		    			type = textarea
						displayname = "Chart Details"
						height = 100px
			 			row = 1
			 			column = 2   
						width = medium
					)
					must have Size_Order
					(
						type = number
						displayname = "Size Order"
			 			row = 1
			 			column = 2   
						width = medium
					)
					Size_Chart_Details
					(
						type = grid
						displayname = "Equivalent Regional Size"
						values  = Size_Chart_Mapping.ID
		    			bidirectional = Size
			 			row = 2
			 			column = 1   
						width = medium
					)
					Hidden_Section
					(
						type = section
						displayname = "Hidden Section"
			 			row = 3
			 			column = 0   
						width = medium
					)
					Product_Category1
					(
						type = list	
						displayname = "Product Category Old Value"
						values  = Product_Category.ID
		    			displayformat = [Product_Category]
						sortorder = ascending
						height = 60px
			 			row = 3
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Create"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}