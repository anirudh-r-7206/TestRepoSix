Shipment_Split_Charge_On_Success as "Shipment Split Charge On Success"
{

			    type = form
			    form = Shipment_Split_Charge
			    record event = on add or edit
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Shipment_Dispatch != null)
			                {
			                    thisapp.Shipment_Recalculate(input.Shipment_Dispatch.ID);
			                }
			                if(input.Purchase_Order != null)
			                {
			                    thisapp.Update_PO_Shipment_Summary(input.Purchase_Order.ID);
			                }
			            )
			        }
			    }
			
}