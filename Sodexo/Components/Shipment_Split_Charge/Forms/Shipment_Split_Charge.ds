form Shipment_Split_Charge
{

		    displayname = "Shipment Split Charge"
		    success message = "Shipment split charge saved successfully."
		    Section
		    (
		        type = section
		        row = 1
		        column = 0
		        width = medium
		    )
		    Shipment_Dispatch
		    (
		        type = picklist
		        displayname = "Shipment Dispatch"
		        values = Shipment_Dispatch.ID
		        displayformat = [Shipment_Reference]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Shipment_Dispatch_Split
		    (
		        type = picklist
		        displayname = "Shipment Dispatch Split"
		        values = Shipment_Dispatch_Split.ID
		        displayformat = [PO_Number_Display]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Purchase_Order
		    (
		        type = picklist
		        displayname = "PO / QO"
		        values = Purchase_Order.ID
		        displayformat = [PO_Number]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Charge_Category
		    (
		        type = picklist
		        displayname = "Charge Category"
		        values = {"Shipping","Duty / Tax","Miscellaneous","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Currency
		    (
		        type = picklist
		        values = Currency.ID
		        displayformat = [Currency_Name]
		        searchable = true
		        row = 1
		        column = 1
		        width = medium
		    )
		    Amount
		    (
		        type = decimal
		        decimalplace = 2
		        initial value = 0
		        row = 1
		        column = 1
		        width = medium
		    )
		    must have Paid_By
		    (
		        type = picklist
		        displayname = "Paid By"
		        values = {"Factory","Buyer","Sodexo","Other"}
		        row = 1
		        column = 1
		        width = medium
		    )
		    Description
		    (
		        type = textarea
		        height = 100px
		        row = 1
		        column = 1
		        width = medium
		    )
		    Source
		    (
		        type = picklist
		        values = {"Manual","API"}
		        initial value = "Manual"
		        row = 1
		        column = 1
		        width = medium
		    )
		
		    actions
		    {
		        on add
		        {
		            submit
		            (
		                type = submit
		                displayname = "Submit"
		            )
		            reset
		            (
		                type = reset
		                displayname = "Reset"
		            )
		        }
		        on edit
		        {
		            update
		            (
		                type = submit
		                displayname = "Update"
		            )
		            cancel
		            (
		                type = cancel
		                displayname = "Cancel"
		            )
		        }
		    }
		
}