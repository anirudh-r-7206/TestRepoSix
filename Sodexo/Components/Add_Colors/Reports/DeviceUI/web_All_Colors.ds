report All_Colors
{

		
						quickview
						(
							layout
							(
								datablock1
								(
									fields
									(
										Color_Name as "Color Name"
										Color_Code as "Color Code"
										Hex_Color_Code as "Hex Color Code"
										Status
									)
								)
							)
								menu
								(
									header
									(
									)
								record
								(
									"Activate"
									"Deactivate"
		    					)
								)
		    				action
		    				(
								on click
								(
									View Record   	   
		    					)
								on right click
								(
									"Activate"
									"Deactivate"
									View Record   	   
		    					)
		     				)
						)
		
						detailview
						(
							layout
							(
				 				type = 2
								datablock1
								(
				     				title = "Overview"
									fields
									(
										Color_Code as "Color Code"
										Color_Name as "Color Name"
										Hex_Color_Code as "Hex Color Code"
										Status
									)
								)
								datablock2
								(
									layout type = -1
				     				title = "Fabrics"
				     				related field = Fabric_Form.Colour_Code
									fields
									(
										Fabric_Code as "Fabric Colour Code"
										Fabric_Name as "Fabric Name"
										Fabric_Composition as "Fabric Composition"
										Fabric_Description as "Fabric Description"
										Status
									)
								)
								datablock3
								(
									layout type = -1
				     				title = "Products Catalogue"
				     				related field = Add_Product.Style_Colour
									fields
									(
										Style_Name as "Style Name"
										Product_Description as "Fabric Description"
										Style_Range as "Style Range"
										Style_Colour as "Style Colour"
										Style_Category as "Product Category"
										Gender
										Size_Set as "Size Set"
										Status as "Status "
									)
								)
							)
								menu
								(
									header
									(
										"Edit "
										"Delete "
										"Activate"
										"Deactivate"
									)
								)
						)
					
		
}