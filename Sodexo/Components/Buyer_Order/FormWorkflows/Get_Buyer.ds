Get_Buyer as "Get_Buyer"
{

			
							type =  form
							form = Buyer_Order
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														clear Select_Factory;
													clear Select_Style_Code;
													get_Buyer = Create_User[Status == "Active"].Associated_Buyer.getAll().distinct();
													input.Select_Buyer:ui.add(get_Buyer);
													get_Order_Buyer = Order_Request[Order_By.Email == zoho.loginuserid && Status == "Awaiting QO Generation" && Last_Order == true];
													if(get_Order_Buyer.count() > 0)
													{
														input.Select_Buyer = get_Order_Buyer.Buyer_Organisation;
														get_Order_Buyer.Search_Style_Code=null;
													}
									)
								}
							}
			
						
			
}