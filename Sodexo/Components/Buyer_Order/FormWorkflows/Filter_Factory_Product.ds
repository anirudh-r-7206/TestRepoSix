Filter_Factory_Product as "Filter Factory Product"
{

			
							type =  form
							form = Buyer_Order
			
							record event = on add
			
							on user input of Select_Factory
							{
								actions 
								{
									custom deluge script
									(
														input.Select_Style_Code = null;
													clear Select_Style_Code;
													get_Sodexo_Orders = Order_Request[Order_By.Email == zoho.loginuserid && Status == "Awaiting QO Generation"];
													for each  SO_Order in get_Sodexo_Orders
													{
														get_Order = Order_Request[ID == SO_Order.ID];
														get_Order.Last_Order=false;
														get_Order.Search_Style_Code=null;
													}
													if(input.Select_Buyer != null && input.Select_Factory != null)
													{
														get_product_ID = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Select_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Select_Factory].Style_ID.getAll();
														get_Style_ID = Add_Product[ID in get_product_ID].Style_Code.getAll();
														input.Select_Style_Code:ui.add(get_Style_ID);
														// 	
														get_Order_Buyer = Order_Request[Buyer_Organisation == input.Select_Buyer && Factory == input.Select_Factory && Order_By.Email == zoho.loginuserid && Status == "Awaiting QO Generation"];
														get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
														fetBuyerProductmap = Buyer_Product_Mapping[Buyer == input.Select_Buyer && Factory_Allocated == input.Select_Factory];
														if(get_Order_Buyer.count() <= 0)
														{
															get_Prime_User = Create_User[Email == input.Select_Buyer.Primary_Email && Status == "Active"];
															get_User_sec = Create_User[Associated_Buyer == input.Select_Buyer && Status == "Active"];
															insert_Order = insert into Order_Request
															[
																Added_User=zoho.loginuser
																Buyer_Organisation=input.Select_Buyer
																Factory=input.Select_Factory
																Selling_Currency=if(fetBuyerProductmap.count() > 0,fetBuyerProductmap.Sell_Currency,null)
																Total_Quantity=0
																Buyer_Name=if(get_Prime_User.count(ID) > 0,get_Prime_User.ID,get_User_sec.ID)
																Order_By=get_User.ID
																Last_Order=true
																Search_Style_Code=if(input.Select_Style_Code != null,input.Select_Style_Code,null)
																Status="Awaiting QO Generation"
															];
															get_Currect_Order = Order_Request[ID == insert_Order];
															get_Currect_Order.Order_ID="OR" + get_Currect_Order.Auto_Number;
															fetOrderDetails = Order_Details[Order_Request == get_Currect_Order.ID];
															get_Currect_Order.Total_Quantity=fetOrderDetails.sum(Quantity);
															// Order History Push
															// 		fetOrder = Order_Request[ID == insert_Order];
															HistoryPush = insert into History
															[
																Added_User=zoho.loginuser
																Order_ID=get_Currect_Order.ID
																Raised_By=get_User.ID
																Status="Awaiting QO Generation"
																Comments="Order Request " + get_Currect_Order.Order_ID + " has been raised by " + get_User.User_Name + "."
															];
														}
														else
														{
															get_Order_Buyer.Last_Order=true;
															get_Order_Buyer.Selling_Currency=if(fetBuyerProductmap.count() > 0,fetBuyerProductmap.Sell_Currency,null);
															get_Order_Buyer.Search_Style_Code=if(input.Select_Style_Code != null,input.Select_Style_Code,null);
															fetOrderDetails = Order_Details[Order_Request == get_Order_Buyer.ID];
															get_Order_Buyer.Total_Quantity=fetOrderDetails.sum(Quantity);
															// 		input.Select_Factory = get_Order_Buyer.Factory;
														}
														openUrl("#Page:Product_Catalogue_Cart_Page?zc_LoadIn=embed-Cart_Products&Buyer_ID=" + input.Select_Buyer + "&Suppliyer_ID=" + input.Select_Factory,"same window");
													}
													else if(input.Select_Factory == null && input.Select_Buyer != null)
													{
														openUrl("#Page:Product_Catalogue_Cart_Page?zc_LoadIn=embed-Cart_Products&Buyer_ID=" + input.Select_Buyer,"same window");
													}
													else
													{
														openUrl("#Script:page.refresh","same window");
													}
									)
								}
							}
			
						
			
}