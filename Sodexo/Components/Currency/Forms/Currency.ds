form Currency
{

		
					success message = "Currency Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have unique Currency_Name
					(
		    			type = text
						displayname = "Currency Name"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Symbol
					(
		    			type = text
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}