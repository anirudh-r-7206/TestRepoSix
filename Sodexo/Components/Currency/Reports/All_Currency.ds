default list All_Currency
{

		
					displayName = "Currency"
					show all rows from Currency    
					(
						Currency_Name as "Currency Name"
						Symbol
					)
					custom actions
					(
						"Delete Currency"
						(
			  			workflow = Delete_Currency
						show action in view header = true
						show action in edit record menu = true
						confirmation before execution
						(
							message for individual record = "Are you sure you want to delete this item? This action cannot be undone."
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						"Edit Currency"
						(
			  			workflow = Edit2
						show action in view header = true
						)
					)
				
		
}