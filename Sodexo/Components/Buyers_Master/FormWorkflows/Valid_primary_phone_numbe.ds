Valid_primary_phone_numbe as "Valid primary phone number"
{

			
							type =  form
							form = Buyers_Master
			
							record event = on add or edit
			
							on user input of Primary_Phone
							{
								actions 
								{
									custom deluge script
									(
														if(input.Person_2_Phone == input.Primary_Phone)
													{
														alert "Duplicate phone number not allowed.";
														input.Primary_Phone = null;
													}
									)
								}
							}
			
						
			
}