Field_Rules as "Field Rules"
{

			
							type =  form
							form = Buyers_Master
			
							record event = on add or edit
			
							field rules
							{
								actions 
								{
									hide Buyer_Code,Approval_Status,Create_User_Employee_External_ID,Status,Hide_Section,Currency1,Same_as_previous_selectable,Delivery_Address;
								}
							}
			
						
			
}