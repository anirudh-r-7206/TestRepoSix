default list Additional_Charges_Form_Report
{

		
					displayName = "Additional Charges Form Report"
					show all rows from Additional_Charges_Form    
					(
						Charge_Type as "Charge Type"
						Description
						Amount as "Amount - Old"
						Paid_By as "Paid By"
						Purchase_Order as "Purchase Order"
						Currency
						Amount1 as "Amount"
					)
				
		
}