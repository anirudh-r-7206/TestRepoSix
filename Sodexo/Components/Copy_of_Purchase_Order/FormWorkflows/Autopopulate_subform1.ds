Autopopulate_subform1 as "Autopopulate subform"
{

			
							type =  form
							form = Copy_of_Purchase_Order
			
							record event = on add or edit
			
							on user input of Order_Request
							{
								actions 
								{
									custom deluge script
									(
														input.Country = input.Order_Request.Buyer_Name.Associated_Buyer.Country;
													input.Buyer_Organisation = input.Order_Request.Buyer_Organisation;
													input.Customer_Name = input.Order_Request.Buyer_Name;
													input.Supplier = input.Order_Request.Factory;
													input.Order_Reference = if(!Order_Request.Order_Reference.isEmpty(),input.Order_Request.Order_Reference,input.Order_Request.Order_ID);
													input.Payment_Terms = input.Buyer_Organisation.Payment_Terms;
													get_Mapped_Currency = Buyer_Product_Mapping[Buyer == input.Buyer_Organisation && Factory_Allocated == input.Supplier];
													if(get_Mapped_Currency.count() > 0)
													{
														input.Purchase_Currency = get_Mapped_Currency.Buy_Currency;
														input.Selling_Currency = get_Mapped_Currency.Sell_Currency;
													}
													else
													{
														input.Purchase_Currency = input.Order_Request.Buyer_Name.Associated_Buyer.Currency;
													}
													if(input.Order_Request != null)
													{
														disable Supplier;
													}
													input.Copy_Purchase_LineItems.clear();
													get_Order = Order_Details[Order_Request == input.Order_Request];
													s_No = 0;
													for each  item in get_Order
													{
														s_No = s_No + 1;
														get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Order_Request.Buyer_Organisation && Style_ID == item.Product && Buyer_Product_Mapping.Factory_Allocated == input.Supplier];
														get_Fabric = Fabric_Form[ID == item.Product.Fabric_Code];
														sub_Form = Copy_of_Purchase_Order.Copy_Purchase_LineItems();
														sub_Form.S_No=s_No;
														sub_Form.Product=item.Product;
														sub_Form.Style_Code=item.Product.Style_Code.Style_Code;
														sub_Form.Product_Color=item.Product_Color;
														sub_Form.Product_Size=item.Product_Size;
														sub_Form.Description=item.Description;
														sub_Form.Quantity=item.Quantity;
														sub_Form.Purchase_Price=if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0);
														sub_Form.Selling_Price=if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0);
														sub_Form.Purchase_Price_Sub_Total=item.Quantity * if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0);
														sub_Form.Selling_Price_Sub_Total=item.Quantity * if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0);
														sub_Form.HS_Code=if(get_product_Price.count(ID) > 0,get_product_Price.HS_Code,"");
														sub_Form.Fabric_Composition=if(get_Fabric.count() > 0,get_Fabric.Fabric_Composition,"");
														input.Copy_Purchase_LineItems.insert(sub_Form);
													}
													input.Total_Purchase_Price = input.Copy_Purchase_LineItems.sum(Purchase_Price_Sub_Total);
													input.Total_Selling_Price = input.Copy_Purchase_LineItems.sum(Selling_Price_Sub_Total);
													input.Total_Quantity = get_Order.sum(Quantity);
													//
													// info "User input of Order Request : " + input.Order_Reference;
									)
								}
							}
			
						
			
}