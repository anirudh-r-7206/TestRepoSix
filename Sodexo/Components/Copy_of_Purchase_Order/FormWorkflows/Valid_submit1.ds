Valid_submit1 as "Valid submit"
{

			
							type =  form
							form = Copy_of_Purchase_Order
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														alert_Count = 0;
													if(input.Order_Reference.isEmpty())
													{
														alert_Count = alert_Count + 1;
														alert(Order_Reference,"This field is mandatory. Enter a value.");
													}
													if(Selling_Currency == null)
													{
														alert_Count = alert_Count + 1;
														alert(Selling_Currency,"This field is mandatory. Select a value.");
													}
													if(alert_Count > 0)
													{
														cancel submit;
													}
													for each  item in input.Copy_Purchase_LineItems
													{
														get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Order_Request.Buyer_Organisation && Style_ID == item.Product && Buyer_Product_Mapping.Factory_Allocated == input.Supplier];
														if(item.Product.Size_Set != item.Product_Size)
														{
															item.Product_Size=item.Product.Size_Set;
														}
														if(item.Product.Style_Colour != item.Product_Color)
														{
															item.Product_Color=item.Product.Style_Colour;
														}
														Buy_Price = if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0);
														Sell_Price = if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0);
														Buy_Sub_Total = item.Quantity * if(get_product_Price.count(ID) > 0,get_product_Price.Buy_Price,0);
														Sell_Sub_Total = item.Quantity * if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0);
														if(item.Purchase_Price != Buy_Price)
														{
															item.Purchase_Price=Buy_Price;
														}
														if(item.Selling_Price != Sell_Price)
														{
															item.Selling_Price=Sell_Price;
														}
														if(item.Purchase_Price_Sub_Total != Buy_Sub_Total)
														{
															item.Purchase_Price_Sub_Total=Buy_Sub_Total;
														}
														if(item.Selling_Price_Sub_Total != Sell_Sub_Total)
														{
															item.Selling_Price_Sub_Total=Sell_Sub_Total;
														}
													}
									)
								}
							}
			
						
			
}