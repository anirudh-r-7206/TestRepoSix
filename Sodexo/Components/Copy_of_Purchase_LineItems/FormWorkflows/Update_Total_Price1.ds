Update_Total_Price1 as "Update Total Price"
{

			
							type =  form
							form = Copy_of_Purchase_LineItems
			
							record event = on add or edit
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														get_PO = Copy_of_Purchase_Order[ID == input.Copy_of_Purchase_Order];
													get_PO.Record_is_Edited=true;
													if(get_PO.count() > 0)
													{
														get_Buy_Price = 0;
														get_Sell_Price = 0;
														get_Qty = 0;
														po_Price_List = input.Copy_of_Purchase_Order.Copy_Purchase_LineItems;
														for each  po_Price in po_Price_List
														{
															get_Buy_Price = get_Buy_Price + po_Price.Purchase_Price_Sub_Total;
															get_Sell_Price = get_Sell_Price + po_Price.Selling_Price_Sub_Total;
															get_Qty = get_Qty + po_Price.Quantity;
														}
														get_PO.Total_Quantity=get_Qty;
														get_PO.Total_Purchase_Price=get_Buy_Price;
														get_PO.Total_Selling_Price=get_Sell_Price;
													}
													fetPO = Purchase_Order[ID == input.Copy_of_Purchase_Order.Purchase_Order];
													fetPO.Record_is_Edited=true;
													// thisapp.PageRefresh();
													openUrl("#Page:Purchase_Order_Details?zc_LoadIn=embed-editPO&PO_ID=" + input.Copy_of_Purchase_Order.Purchase_Order,"same window");
									)
								}
							}
			
						
			
}