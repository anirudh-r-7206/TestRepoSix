Filter_Style_ID2 as "Filter Style ID"
{

			
							type =  form
							form = Copy_of_Purchase_LineItems
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														fetProduct = Copy_of_Purchase_LineItems[Copy_of_Purchase_Order == input.Copy_of_Purchase_Order];
													input.S_No = (fetProduct.Product.getall()).size() + 1;
													if(input.Copy_of_Purchase_Order.Customer_Name != null)
													{
														get_Buyer_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Copy_of_Purchase_Order.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == input.Copy_of_Purchase_Order.Supplier];
														get_Product = get_Buyer_Product.Style_ID.getall();
													}
													get_Product.removeAll(fetProduct.Product.getall());
													input.Product:ui.add(get_Product);
									)
								}
							}
			
						
			
}