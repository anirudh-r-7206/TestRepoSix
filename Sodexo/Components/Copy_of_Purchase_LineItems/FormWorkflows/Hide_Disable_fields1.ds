Hide_Disable_fields1 as "Hide & Disable fields"
{

			
							type =  form
							form = Copy_of_Purchase_LineItems
			
							record event = on add or edit
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														hide Hidden_Section;
													hide Copy_of_Purchase_Order;
													hide S_No;
													hide Style_Code;
													hide Product_Color;
													hide Product_Size;
													disable Purchase_Price;
													disable Selling_Price;
													disable Purchase_Price_Sub_Total;
													disable Selling_Price_Sub_Total;
													url = "#Page:Purchase_Order_Details?zc_LoadIn=embed-editPO&PO_ID=" + input.Copy_of_Purchase_Order.Purchase_Order;
													input.plain = "<style>.form-group.clearfix.zc-plain-group.zc-addnote-fld { width: 100%; } span.close_Icon:before { content: \"\ed89\"; font-family: ZC Live Outline; font-size: 28px;} .header_backBtn{ display: flex; align-items: center; justify-content: space-between;border-bottom: 1px solid #e9ebef; padding: 10px 0px;} .back_Product{ display: flex; align-items: center; }.header_Name { font-size: 18px;}.zcform_Copy_of_Purchase_LineItems .first-column .notes-field{width:100% !important;}</style>";
													input.plain = input.plain + "<div class=\"header_backBtn\"> <div class=\"header_Name\">Purchase LineItem</div> <a class=\"back_Product\" href=" + url + "> <span class=\"close_Icon\"></span></a> </div>";
									)
								}
							}
			
						
			
}