form Bulk_Edit_Tigger
{

		
					displayname = "Bulk Edit Tigger"
					success message = "Data Added Successfully!"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Buyer_Product_Mapping
					(
						type = list	
						displayname = "Buyer Product Mapping"
						values  = Buyer_Product_Mapping.ID
		    			displayformat = [ID]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
					Buyer_Products
					(
						type = list	
						displayname = "Buyer Products"
						values  = Buyer_Products.ID
		    			displayformat = [ID]
						sortorder = ascending
						height = 60px
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}