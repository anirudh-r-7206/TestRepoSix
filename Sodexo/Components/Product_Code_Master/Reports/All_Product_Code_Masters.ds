default list All_Product_Code_Masters
{

		
					displayName = "Style Master Codes"
					show all rows from Product_Code_Master    
					(
						Product_Code as "Product Code"
					)
					sort by
					(
						Product_Code ascending
					)
					custom actions
					(
						"Edit "
						(
			  			workflow = Edit_Product_code
						show action in view header = true
						show action in edit record menu = true
						)
						"Delete "
						(
			  			workflow = Delete_Product_code
						show action in view header = true
						show action in edit record menu = true
						confirmation before execution
						(
							message for individual record = "Execute the Delete Product code action for this record?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
					)
				
		
}