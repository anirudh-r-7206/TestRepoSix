Validation_and_insert_to_ as "Validation and insert to Raise Request"
{

			
							type =  form
							form = Buyer_Cart_Detail
							button = Add_to_Cart
							on click
							{
								actions 
								{
								on click
								(
									if(input.Size == null)
													{
														alert "Size is required. Please enter a value.";
													}
													else if(input.Colour == null)
													{
														alert "Colour is required. Please enter a value.";
													}
													else if(input.Quantity == null)
													{
														alert "Quantity is required. Please enter a value.";
													}
													else
													{
														try 
														{
															get_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() && Status == "Active"];
															get_Order_Buyer = Order_Request[Order_By.Email == thisapp.Dev.get_User_Email() && Factory == input.Supplier && Status == "Pending"];
															get_Product = Add_Product[Wardrobe == input.Wardrobe && Style_Category == input.Product_Category && Style_Code.Product_Code == input.Product_Code && Size_Set == input.Size && Style_Colour == input.Colour];
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer.Associated_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID == get_Product.ID];
															product_Total = input.Quantity * get_product_Price.Sell_Price;
															if(get_Order_Buyer.count() > 0)
															{
																get_Style_IDs = Style[Product_Code == input.Product_Code].ID.getAll();
																get_Order_Product = Order_Details[Order_Request == get_Order_Buyer.ID && Product.Wardrobe == input.Wardrobe && Product.Style_Category == input.Product_Category && Product.Style_Code in get_Style_IDs && Product_Size == input.Size && Product_Color == input.Colour];
																if(get_Order_Product.count() > 0)
																{
																	get_Order_Product.Quantity=input.Quantity;
																	get_Order_Product.Sub_Total=product_Total;
																	get_Order_Buyer.Cart_Total=Order_Details[Order_Request == get_Order_Buyer.ID].sum(Sub_Total);
																}
																else
																{
																	order_Detail_Subform = Order_Request.Order_details();
																	order_Detail_Subform.Order_Request=get_Order_Buyer.ID;
																	order_Detail_Subform.Product=get_Product.ID;
																	order_Detail_Subform.Description=get_Product.Product_Description;
																	order_Detail_Subform.Product_Color=input.Colour;
																	order_Detail_Subform.Product_Size=input.Size;
																	order_Detail_Subform.Quantity=input.Quantity;
																	order_Detail_Subform.Sub_Total=product_Total;
																	//
																	get_Order_Buyer.Order_details.insert(order_Detail_Subform);
																	get_Order_Buyer.Cart_Total=get_Order_Buyer.Cart_Total + product_Total;
																}
															}
															else
															{
																Add_Request = insert into Order_Request
																[
																	Added_User=zoho.loginuser
																	Buyer_Organisation=get_Buyer.Associated_Buyer
																	Buyer_Name=get_Buyer.ID
																	Order_By=get_Buyer.ID
																	Factory=input.Supplier
																	Status="Pending"
																];
																fetOrder = Order_Request[ID == Add_Request];
																if(fetOrder.count() > 0)
																{
																	order_Detail = Order_Request.Order_details();
																	order_Detail.Order_Request=fetOrder.ID;
																	order_Detail.Product=get_Product.ID;
																	order_Detail.Description=get_Product.Product_Description;
																	order_Detail.Product_Color=input.Colour;
																	order_Detail.Product_Size=input.Size;
																	order_Detail.Quantity=input.Quantity;
																	order_Detail.Sub_Total=product_Total;
																	fetOrder.Order_details.insert(order_Detail);
																	//
																	fetOrder.Order_ID="OR" + fetOrder.Auto_Number;
																	fetOrder.Cart_Total=fetOrder.Cart_Total + product_Total;
																}
																// Order History Push
																HistoryPush = insert into History
																[
																	Added_User=zoho.loginuser
																	Order_ID=fetOrder.ID
																	Raised_By=get_Buyer.ID
																	Status="Pending"
																	Comments="Order Request " + fetOrder.Order_ID + " has been raised by " + get_Buyer.User_Name + "."
																];
															}
															openUrl("#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&Wardrobe=" + input.Wardrobe + "&Category=" + input.Product_Category + "&Supplier=" + input.Supplier.ID,"parent window");
															// 		openUrl("#Script:page.refresh","popup window");
															// 		openUrl( "#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&Wardrobe="+input.Wardrobe+"&Category="+input.Product_Category, "parent window");
														}
														catch (e)
														{
														}
													}
								)
								}
							}
						
			
}