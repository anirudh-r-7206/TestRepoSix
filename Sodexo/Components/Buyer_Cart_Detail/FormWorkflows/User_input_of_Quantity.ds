User_input_of_Quantity as "User input of Quantity"
{

			
							type =  form
							form = Buyer_Cart_Detail
			
							record event = on add
			
							on user input of Quantity
							{
								actions 
								{
									custom deluge script
									(
														if(input.Quantity == null)
													{
														input.Quantity = 1;
														alert "Quantity cannot be empty. Default value set to 1.";
													}
													else if(input.Quantity < 1)
													{
														input.Quantity = 1;
														alert "Quantity cannot be less than 1.";
													}
									)
								}
							}
			
						
			
}