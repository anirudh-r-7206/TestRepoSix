Filter_Colors1 as "Filter Colors"
{

			
							type =  form
							form = Buyer_Cart_Detail
			
							record event = on add
			
							on user input of Size
							{
								actions 
								{
									custom deluge script
									(
														clear Colour;
													if(input.Size != null)
													{
														show Colour;
														get_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() && Status == "Active"];
														get_style = Style[Product_Code == input.Product_Code];
														get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer.Associated_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID.Style_Code in get_style.ID.getall() && Style_ID.Wardrobe == input.Wardrobe && Style_ID.Style_Category == input.Product_Category && Size == input.Size];
														if(get_Product.count() > 0)
														{
															input.Product_Style = "<div class=\"product-details\"><div class=\"product_name\">" + get_Product.Style_ID.Style_Name + "</div> <div class=\"product_price\">$" + (get_Product.Sell_Price.getall()).smallest() + "</div> <div class=\"product-description\"> " + if(!get_Product.Style_Description.isEmpty(),get_Product.Style_Description,"") + " </div></div>";
															get_Color = (get_Product.Colors.getall()).distinct();
															input.Colour:ui.add(get_Color);
															input.Colour = get_Color.get(0);
															color_Count = 0;
															for each  col in get_Color
															{
																color_Count = color_Count + 1;
																get_Color_Master = Add_Colors[ID == col];
																input.Product_Style = input.Product_Style + "<style>span > input[type=\"radio\"] + label[elname=\"radioEl_zc-Colour_" + color_Count + "\"] { background-color: " + get_Color_Master.Hex_Color_Code + " !important; }</style>";
																// 			alert get_Color_Master.Color_Name +" == " +get_Color_Master.Hex_Color_Code ;
															}
															openUrl("#Page:Dynamic_Product_Image?zc_LoadIn=embed-ProductIMG&Product_ID=" + get_Product.Style_ID,"same window");
														}
													}
									)
								}
							}
			
						
			
}