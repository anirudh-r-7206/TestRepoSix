Shipment_Dispatch_Split_Delete_On_Success as "Shipment Dispatch Split Delete On Success"
{

			    type = form
			    form = Shipment_Dispatch_Split
			    record event = on delete
			
			    on success
			    {
			        actions
			        {
			            custom deluge script
			            (
			                if(input.Purchase_Order != null)
			                {
			                    thisapp.Update_PO_Shipment_Summary(input.Purchase_Order);
			                }
			                if(input.Shipment_Dispatch != null)
			                {
			                    thisapp.Shipment_Recalculate(input.Shipment_Dispatch);
			                }
			            )
			        }
			    }
			
}