form Packaging_Details
{

		
					displayname = "Packaging Details"
					success message = "Packaging Detail Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Product
					(
						type = picklist	
						values  = Add_Product.ID
		    			bidirectional = Packaging_Options
		    			displayformat = [Style_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Carton_Measurement
					(
		    			type = text
						displayname = "Carton Measurement"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Quantity_Per_Carton
					(
						type = number
						displayname = "Quantity Per Carton"
			 			row = 1
			 			column = 1   
						width = medium
					)
					Weight_Per_Carton
					(
		    			type = formula
						displayname = "Weight Per Carton"
						value =  input.Quantity_Per_Carton * input.Product.Product_Weight
						visibility = true
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}