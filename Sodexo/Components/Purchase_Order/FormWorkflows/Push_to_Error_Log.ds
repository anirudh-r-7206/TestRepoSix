Push_to_Error_Log as "Push to Error Log"
{

			
							type =  form
							form = Purchase_Order
			
							record event = on add or edit
			
							on validate
							{
								actions 
								{
									custom deluge script
									(
														for each  recRow in input.Purchase_LineItems
													{
														if(recRow.Product.Size_Set != recRow.Product_Size || recRow.Product.Style_Colour != recRow.Product_Color)
														{
															errLog = insert into Error_Log_Form
															[
																Added_User=zoho.loginuser
																Form_Name="Purchase_Order"
																Rec_ID=input.ID
																Comment="Mismatch in subform values \nPO ID : " + input.PO_Number + "\nProduct : " + recRow.Product.Style_ID + "\nColor : " + recRow.Product_Color.Color_Name + "\nSize : " + recRow.Product_Size.Size
															];
														}
													}
									)
								}
							}
			
						
			
}