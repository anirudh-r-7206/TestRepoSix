Calculate_Selling_price as "Calculate Selling price"
{

			
							type =  form
							form = Purchase_Order
			
							record event = on add or edit
			
							on delete row of Additional_Charges
							{
								actions 
								{
									custom deluge script
									(
														selling_Cost = 0;
													for each  purchase in input.Purchase_LineItems
													{
														selling_Cost = selling_Cost + purchase.Selling_Price_Sub_Total;
													}
													addnCharge = 0;
													for each  chargeRow in input.Additional_Charges
													{
														if(chargeRow.Paid_By == "Buyer")
														{
															addnCharge = addnCharge + ifnull(chargeRow.Amount1,0);
														}
													}
													input.Total_Selling_Price = selling_Cost + addnCharge;
									)
								}
							}
			
						
			
}