list My_Purchase_Orders
{

		
					displayName = "My Purchase Orders"
					show all rows from Purchase_Order  [Customer_Name.Email == zoho.loginuserid || Buyer_Organisation.ID == thisapp.Filters.filterBuyerOrg(zoho.loginuserid) || Added_User == zoho.loginuser]  
					(
						Order_Reference as "Order Reference"
						PO_Date as "PO Date"
						Order_Type as "Order Type "
						Order_Status as "Order Status"
						Delivery_Date as "Ex-Factory date"
						Delivery_Contact as "Delivery Contact "
						Freight_Forwarder as "Freight Forwarder"
						Incoterms as "Incoterm"
						Order_Request as "Order Request"
						PO_Number as "PO Number"
						Total_Selling_Price as "Total Price"
						QO_Number as "QO Number"
						Shipment_Tracking_Status as "Shipment Tracking Status"
						Latest_Estimated_Delivery_Date as "Latest Estimated Delivery Date"
						Latest_Actual_Delivery_Date as "Latest Actual Delivery Date"
						custom action "View PO"
						(
			  			workflow = View_PO
						show action in edit record menu = true
						column header = "View PO"
						)
						custom action "View QO"
						(
			  			workflow = View_QO
						show action in edit record menu = true
						column header = "View QO"
						)
						Country
						custom action "Generate QO"
						(
			  			workflow = Generate_PO1
						show action in view header = true
						show action in edit record menu = true
						column header = "Generate QO"
						condition = (Order_Status == "Awaiting QO Generation")
						)
						custom action "Move to Production"
						(
			  			workflow = Move_to_Production
						show action in view header = true
						show action in edit record menu = true
						column header = "Move to Production"
						condition = (Order_Status == "Awaiting Production")
						)
						custom action "Completed"
						(
			  			workflow = Complete_PO
						show action in edit record menu = true
						column header = "Completed"
						condition = (Order_Status == "In Production")
						)
						Purchase_Currency as "Purchase Currency"
						Selling_Currency as "Currency"
						custom action "Raise Amendment"
						(
			  			workflow = Buyer_Review
						show action in edit record menu = true
						column header = "Raise Amendment"
						condition = (Order_Status != "Completed" && ID != thisapp.Filters.Filter_buyer_pending_amendment() && Order_Status != "Cancelled")
						)
						custom action "Approve"
						(
			  			workflow = Approved_by_Buyer
						show action in edit record menu = true
						column header = "Approve"
						condition = (ID != thisapp.Filters.Filter_buyer_pending_amendment() && Order_Status == "Awaiting Buyer Review")
						confirmation before execution
						(
							message for individual record = "Are you sure you want to approve order  ${QO_Number} ?"
							confirm button text = "Yes"		
							cancel button text = "No"
						)
						)
						Supplier
						Factory_Address1  as "Factory Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						Delivery_Address1  as "Delivery Address"
			 			(
			      			enable = Link_to_Map,Show_As_Text
			 			)
						Factory_Company_Name as "Company Name"
						Factory_Contact_Person as "Contact Person"
						Factory_Email as "Email"
						Factory_Phone as "Phone"
						(
							displayformat = plainnumber 
						)
						Buyer_Company_Name as "Company Name"
						Buyer_Contact_Person as "Contact Person"
						Buyer_Email as "Email"
						Buyer_Phone as "Phone"
						(
							displayformat = plainnumber 
						)
						Buyer_Organisation as "Buyer Organisation"
						Total_Quantity as "Total Quantity"
					)
					sort by
					(
						PO_Number descending
					)
					custom actions
					(
						"Edit PO"
						(
			  			workflow = Edit_PO
						show action in view header = true
						show action in edit record menu = true
						condition = (Order_Status == "Amendment Requested (Buyer)" || Order_Status == "Amendment Requested (Factory)")
						)
					)
					conditional formatting
					(
						"Completed"
						{
						condition = (Order_Status == "Completed")
						fields = [Order_Status]
						format = "color:#16a34a;"
						}
						"Awaiting QO Generation"
						{
						condition = (Order_Status == "Awaiting QO Generation")
						fields = [Order_Status]
						format = "color:#3b82f6;"
						}
						"Awaiting Buyer Review"
						{
						condition = (Order_Status == "Awaiting Buyer Review")
						fields = [Order_Status]
						format = "color:#f59e0b;"
						}
						"Amendment Requested (Buyer)"
						{
						condition = (Order_Status == "Amendment Requested (Buyer)")
						fields = [Order_Status]
						format = "color:#ea580c;"
						}
						"Awaiting PO Generation"
						{
						condition = (Order_Status == "Awaiting PO Generation")
						fields = [Order_Status]
						format = "color:#eab308;"
						}
						"Awaiting Factory Review"
						{
						condition = (Order_Status == "Awaiting Factory Review")
						fields = [Order_Status]
						format = "color:#f59e0b;"
						}
						"Amendment Requested (Factory)"
						{
						condition = (Order_Status == "Amendment Requested (Factory)")
						fields = [Order_Status]
						format = "color:#ea580c;"
						}
						"Awaiting Production"
						{
						condition = (Order_Status == "Awaiting Production")
						fields = [Order_Status]
						format = "color:#6366f1;"
						}
						"In Production"
						{
						condition = (Order_Status == "In Production")
						fields = [Order_Status]
						format = "color:#a811cc;"
						}
					)
				
		
}