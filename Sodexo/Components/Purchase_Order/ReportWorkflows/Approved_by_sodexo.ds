Approved_by_sodexo as "Approved by sodexo"
{

			
							type =  functions
							form = Purchase_Order
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									input.Enable_Edit = false;
													input.Record_is_Edited = false;
													if(input.Order_Status == "Awaiting Buyer Review")
													{
														input.Order_Status = "Awaiting Factory Review";
														thisapp.Send_Mail.Email_Template(input.ID,"Factory_Review");
														thisapp.Send_Mail.Email_Template(input.ID,"Approved_By_Internal_User");
													}
													else if(input.Order_Status == "Awaiting Factory Review")
													{
														input.Order_Status = if(input.Order_Type == "Bulk" || input.Order_Type == "SM","In Production","Awaiting Production");
														thisapp.Send_Mail.Email_Template(input.ID,"Buyer_QO_Completed");
													}
													// Order History Push
													get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
													if(get_User.count() > 0)
													{
														HistoryPush = insert into History
														[
															Added_User=zoho.loginuser
															Purchase_Order_ID=input.ID
															Raised_By=get_User.ID
															Status=input.Order_Status
															Comments="Purchase Order " + input.PO_Number + " has been moved to '" + input.Order_Status + "' by " + get_User.User_Name + "."
														];
													}
													success message "Request approved successfully";
								)
								}
							}
						
			
}