Generate_PO1 as "Generate PO"
{

			
							type =  functions
							form = Purchase_Order
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									input.Enable_Edit = false;
													Complete_Amendment = History[Purchase_Order_ID == input.ID && Approval_Status == "Approved"];
													get_Factory_History = History[Purchase_Order_ID == input.ID && Status == "Awaiting Factory Review"];
													for each  amend in Complete_Amendment
													{
														amend.Approval_Status="Completed";
														if(amend.Status == "Amendment Requested (Factory)" || amend.Status == "Awaiting Factory Review" || get_Factory_History.count() <= 0)
														{
															input.Order_Status = "Awaiting Buyer Review";
														}
														else
														{
															input.Order_Status = "Awaiting Factory Review";
														}
														delete from Copy_of_Purchase_Order[ID == amend.Copy_of_Purchase_Order];
														delete from Copy_of_Purchase_LineItems[Copy_of_Purchase_Order == null];
													}
													get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
													PO_History = insert into History
													[
														Added_User=zoho.loginuser
														Purchase_Order_ID=input.ID
														Raised_By=input.Customer_Name
														Status="Awaiting Factory Review"
														Comments="Purchase Order " + input.PO_Number + " has been moved to '" + input.Order_Status + "' by " + get_User.User_Name + "."
													];
													if(input.Order_Status = "Awaiting Buyer Review")
													{
														thisapp.Send_Mail.Email_Template(input.ID,"Buyer_Review");
													}
													else
													{
														thisapp.Send_Mail.Email_Template(input.ID,"Factory_Review");
													}
													// thisapp.Send_Mail.Email_Template(input.ID,"Factory_Review");
								)
								}
							}
						
			
}