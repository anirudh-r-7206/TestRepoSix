Approved_by_Buyer as "Approved by Buyer"
{

			
							type =  functions
							form = Purchase_Order
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									input.Enable_Edit = false;
													input.Record_is_Edited = false;
													input.Order_Status = "Awaiting Factory Review";
													// Order History Push
													get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
													if(get_User.count() > 0)
													{
														HistoryPush = insert into History
														[
															Added_User=zoho.loginuser
															Purchase_Order_ID=input.ID
															Raised_By=get_User.ID
															Status=input.Order_Status
															Comments="Quotation Order " + input.QO_Number + " has been moved to '" + input.Order_Status + "' by " + get_User.User_Name + "."
														];
													}
													thisapp.Send_Mail.Email_Template(input.ID,"Factory_Review");
													thisapp.Send_Mail.Email_Template(input.ID,"Approved_by_Buyer");
													openUrl("#Page:Alert_Message?PO_ID=" + input.PO_Number + "&Message_Type=PO_Generation","popup window");
								)
								}
							}
						
			
}