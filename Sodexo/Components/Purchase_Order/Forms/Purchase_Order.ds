						display type = text
						format = plaintext
			 			row = 7
			 			column = 2   
						width = medium
					)
					Order_Status
					(
						type = picklist
						displayname = "Order Status"
						maxchar = 100
						values = {"Awaiting QO Generation","Awaiting Buyer Review","Amendment Requested (Buyer)","Awaiting PO Generation","Awaiting Factory Review","Amendment Requested (Factory)","Awaiting Production","In Production","Completed","Cancelled"}
						initial value = "Awaiting Buyer Review"
						sortorder = ascending
			 			row = 7
			 			column = 2   
