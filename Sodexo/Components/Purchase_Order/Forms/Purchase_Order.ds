			 			row = 7
			 			column = 1   
						width = medium
						personal data = true
					)
					Factory_Phone
					(
		    			type = phonenumber
						displayname = "Factory Phone"
			 			row = 7
			 			column = 1   
						width = medium
						personal data = true
					)
					QO_Number
