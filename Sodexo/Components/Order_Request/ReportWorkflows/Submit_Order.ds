Submit_Order as "Submit Order"
{

			
							type =  functions
							form = Order_Request
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									openUrl("#Form:Order_Request_Update?Order_Request=" + input.ID + "&zc_Header=false","popup window");
								)
								}
							}
						
			
}