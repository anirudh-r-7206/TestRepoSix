Autopopulate_subform_valu as "Autopopulate subform values"
{

			
							type =  form
							form = Order_Request
			
							record event = on add or edit
			
							on user input of Order_details.Product
							{
								actions 
								{
									custom deluge script
									(
														disable row.Product;
													if(row.Product != null)
													{
														row.Product_Color=row.Product.Style_Colour;
														row.Product_Size=row.Product.Size_Set;
														row.Description=row.Product.Product_Description;
														//
														row.Sub_Total=null;
														if(row.Quantity > 0)
														{
															if(input.Factory != null)
															{
																get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
															}
															else
															{
																get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product];
															}
															row.Sub_Total=get_product_Price.Sell_Price * row.Quantity;
														}
													}
													else
													{
														row.Product_Color=null;
														row.Product_Size=null;
														row.Description=null;
														row.Sub_Total=null;
													}
													input.Cart_Total = input.Order_details.sum(Sub_Total);
													// 
													if(input.Factory != null)
													{
														get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
													}
													else
													{
														get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation];
													}
													get_All_product = get_Product.Style_ID.getall();
													get_All_product.removeAll(input.Order_details.Product.getall());
													for each  order in input.Order_details
													{
														old_Product = order.Product;
														add_sub_Product = get_All_product;
														add_sub_Product.add(old_Product);
														order.Product:ui.add(add_sub_Product);
														order.Product=old_Product;
													}
									)
								}
							}
			
						
			
}