Check_Buyer_or_Factory2 as "Check Buyer or Factory"
{

			
							type =  form
							form = Order_Request
			
							record event = on add
			
							on load
							{
								actions 
								{
									custom deluge script
									(
														if(input.Purchase_Order != null)
													{
														disable Buyer_Organisation;
														disable Buyer_Name;
														disable Factory;
														// 	
														input.Buyer_Organisation = input.Purchase_Order.Buyer_Organisation;
														input.Buyer_Name = input.Purchase_Order.Customer_Name;
														input.Factory = input.Purchase_Order.Supplier;
														get_PO = Purchase_LineItems[Purchase_Order == input.Purchase_Order];
														for each  items in get_PO
														{
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == items.Product && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
															map_Item = Order_Request.Order_details();
															map_Item.Product=items.Product;
															map_Item.Product_Color=items.Product_Color;
															map_Item.Product_Size=items.Product_Size;
															map_Item.Description=items.Description;
															map_Item.Quantity=items.Quantity;
															map_Item.Sub_Total=if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,items.Selling_Price) * items.Quantity;
															input.Order_details.insert(map_Item);
														}
														input.Cart_Total = input.Order_details.sum(Sub_Total);
													}
													else
													{
														// Fetch Buyer Details
														get_Buyer = Create_User[Status == "Active"].Associated_Buyer.getAll().distinct();
														input.Buyer_Organisation:ui.add(get_Buyer);
														clear Buyer_Name;
														clear Factory;
														fetch_Buyer = Create_User[Email == zoho.loginuserid && Status == "Active" && Persona_Role == "Buyer"];
														get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
														if(fetch_Buyer.count(ID) > 0)
														{
															input.Buyer_Organisation = fetch_Buyer.Associated_Buyer;
															disable Buyer_Organisation;
															disable Buyer_Name;
														}
														else if(get_User.count(ID) <= 0)
														{
															openUrl("#Page:Alert_Message?Message_Type=Buyer_Page","popup window");
														}
													}
									)
								}
							}
			
						
			
}