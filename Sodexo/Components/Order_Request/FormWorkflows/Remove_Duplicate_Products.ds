Remove_Duplicate_Products as "Remove Duplicate Products"
{

			
							type =  form
							form = Order_Request
			
							record event = on add or edit
			
							on add row of Order_details
							{
								actions 
								{
									custom deluge script
									(
														//
													enable row.Product;
													if(input.Factory == null)
													{
														alert "Please select a factory before adding products.";
														input.Order_details.clear();
													}
													else
													{
														get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
														get_All_product = get_Product.Style_ID.getall();
														get_All_product.removeAll(input.Order_details.Product.getall());
														row.Product:ui.add(get_All_product);
													}
									)
								}
							}
			
						
			
}