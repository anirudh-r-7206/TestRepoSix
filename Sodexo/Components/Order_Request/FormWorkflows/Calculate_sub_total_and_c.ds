Calculate_sub_total_and_c as "Calculate sub total and cart total"
{

			
							type =  form
							form = Order_Request
			
							record event = on add or edit
			
							on user input of Order_details.Quantity
							{
								actions 
								{
									custom deluge script
									(
														row.Sub_Total=null;
													if(row.Quantity <= 0)
													{
														alert "Quantity must be greater than 0.";
														row.Quantity=null;
													}
													else if(row.Product != null && row.Quantity > 0)
													{
														if(input.Factory != null)
														{
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product && Buyer_Product_Mapping.Factory_Allocated == input.Factory];
														}
														else
														{
															get_product_Price = Buyer_Products[Buyer_Product_Mapping.Buyer == input.Buyer_Organisation && Style_ID == row.Product];
														}
														row.Sub_Total=if(get_product_Price.count(ID) > 0,get_product_Price.Sell_Price,0) * row.Quantity;
													}
													input.Cart_Total = input.Order_details.sum(Sub_Total);
									)
								}
							}
			
						
			
}