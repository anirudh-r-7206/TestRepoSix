								(
									View Record   	   
		    					)
								on right click
								(
									View Record   	   
		    					)
		     				)
						)
		
						detailview
						(
							layout
							(
				 				type = 2
								datablock1
								(
				     				title = "Overview"
									fields
									(
										Order_ID as "Order ID"
										Buyer_Organisation as "Buyer Organisation"
										Buyer_Name as "Buyer Name"
										Cart_Total as "Cart Total "
										Status
									)
								)
								datablock3
								(
									layout type = -1
				     				title = "Order details"
