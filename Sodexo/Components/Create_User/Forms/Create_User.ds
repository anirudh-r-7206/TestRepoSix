form Create_User
{

		
					displayname = "Create User"
					success message = "User Created Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					must have User_Name
					(
		    			type = name
						displayname = "User Name"
		     			prefix
		     			(
			     			 type = prefix
			     			 displayname ="Prefix"
			     			 visibility = false
			     			 value = {"Mr.","Mrs.","Ms."}
		     			) 
		     			first_name
		     			(
			     			 type = first_name
			     			 displayname ="First Name"
		     			) 
		     			last_name
		     			(
			     			 type = last_name
			     			 displayname ="Last Name"
		     			) 
		     			suffix
		     			(
			     			 type = suffix
			     			 displayname ="Suffix"
			     			 visibility = false
		     			) 
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have unique Email
					(
		    			type = email
						maxchar = 80
			 			row = 1
			 			column = 1   
						width = medium
						personal data = true
					)
					must have User_Type
					(
						type = picklist
						displayname = "User Type"
						maxchar = 100
						values = {"Internal","Buyer","Factory","Admin"}
			 			row = 1
			 			column = 1   
						width = medium
					)
					unique Employee_External_ID
					(
		    			type = text
						displayname = "Employee/External ID"
			 			row = 1
			 			column = 2   
						width = medium
					)
					Mobile_Number
					(
		    			type = phonenumber
						displayname = "Mobile Number"
			 			row = 1
			 			column = 2   
						width = medium
						personal data = true
					)
					must have Persona_Role
					(
						type = picklist
						displayname = "Persona/Role"
						maxchar = 100
						values = {"Administrator","Developer","Buyer","Sodexo Team","Factory Team"}
			 			row = 1
			 			column = 2   
						width = medium
					)
					Primary_Email
					(
		    			type = checkbox
						displayname = "Primary Email"
						initial value = false
			 			row = 1
			 			column = 2   
						width = medium
					)
					Associated_Buyer
					(
						type = picklist	
						displayname = "Associated Buyer"
						values  = Buyers_Master[Status == "Active"].ID
		    			bidirectional = Create_User_Employee_External_ID
		    			displayformat = [Buyer_Code + " - " + Buyer_Organisation]
						sortorder = ascending
			 			row = 1
			 			column = 2   
						width = medium
					)
					Associated_Factory
					(
						type = picklist	
						displayname = "Associated Factory "
						values  = Add_Suppliers[Status == "Active" && Supplier_type == "Factory"].ID
		    			bidirectional = Create_User_Employee_External_ID
		    			displayformat = [Supplier_Organisation]
						sortorder = ascending
			 			row = 1
			 			column = 2   
						width = medium
					)
					Remarks
					(
		    			type = textarea
						displayname = "Remarks "
						height = 100px
			 			row = 1
			 			column = 2   
						width = medium
					)
					Permissions
					(
						type = section
						visibility = true
			 			row = 2
			 			column = 0   
						width = medium
					)
					Need_App_Access
					(
		    			type = checkbox
						displayname = "Provide App Access"
						initial value = false
			 			row = 2
			 			column = 1   
						width = medium
					)
					Send_Notifications_Only
					(
		    			type = checkbox
						displayname = "Send Notifications Only"
						initial value = false
			 			row = 2
			 			column = 2   
						width = medium
					)
					Hide_Section
					(
						type = section
						displayname = "Hide Section"
						visibility = true
			 			row = 3
			 			column = 0   
						width = medium
					)
					Portal_Access_Enabled
					(
		    			type = checkbox
						displayname = "Portal Access Enabled"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
					Approval_Status
					(
						type = picklist
						displayname = "Approval Status"
						maxchar = 100
						values = {"Pending","Approved","Rejected"}
						initial value = "Pending"
			 			row = 3
			 			column = 1   
						width = medium
					)
					Status
					(
						type = picklist
						displayname = "Status "
						maxchar = 100
						values = {"Active","Inactive"}
						initial value = "Inactive"
			 			row = 3
			 			column = 1   
						width = medium
					)
					From_Supplier_Buyer
					(
		    			type = checkbox
						displayname = "From Supplier / Buyer"
						initial value = false
			 			row = 3
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Create"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}