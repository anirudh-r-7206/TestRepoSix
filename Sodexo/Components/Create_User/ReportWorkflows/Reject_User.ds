Reject_User as "Reject_User"
{

			
							type =  functions
							form = Create_User
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									if(input.Persona_Role == "Buyer")
													{
														if(input.Associated_Buyer.Approval_Status != "Approved")
														{
															if(input.Associated_Buyer.Approval_Status == "Pending")
															{
																success message "This user cannot be assigned because the associated buyer is pending approval. Please complete the buyer approval process first.";
															}
															else if(input.Associated_Buyer.Approval_Status == "Rejected")
															{
																success message "This user cannot be assigned because the associated buyer has been rejected. Please contact the administrator for further assistance.";
															}
														}
														else if(input.Associated_Buyer.Approval_Status == "Approved")
														{
															input.Approval_Status = "Rejected";
														}
													}
													else if(input.Persona_Role == "Factory Team")
													{
														if(input.Associated_Factory.Approval_Status != "Approved")
														{
															if(input.Associated_Factory.Approval_Status == "Pending")
															{
																success message "This user cannot be assigned because the associated factory is pending approval. Please complete the buyer approval process first.";
															}
															else if(input.Associated_Factory.Approval_Status == "Rejected")
															{
																success message "This user cannot be assigned because the associated factory has been rejected. Please contact the administrator for further assistance.";
															}
														}
														else if(input.Associated_Factory.Approval_Status == "Approved")
														{
															input.Approval_Status = "Rejected";
														}
													}
													else
													{
														input.Approval_Status = "Rejected";
													}
								)
								}
							}
						
			
}