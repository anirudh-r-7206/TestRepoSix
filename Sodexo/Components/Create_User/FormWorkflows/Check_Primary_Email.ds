Check_Primary_Email as "Check Primary Email"
{

			
							type =  form
							form = Create_User
			
							record event = on add or edit
			
							on user input of Primary_Email
							{
								actions 
								{
									custom deluge script
									(
														if(Primary_Email == true)
													{
														get_Primary = Create_User[Primary_Email == true && User_Type in {"Internal","Admin"}];
														if(get_Primary.count() > 0)
														{
															alert "The current email will be set as the primary email and the existing primary email (" + get_Primary.Email + ") will be removed.";
														}
													}
									)
								}
							}
			
						
			
}