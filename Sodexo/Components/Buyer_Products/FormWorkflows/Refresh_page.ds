Refresh_page as "Refresh page"
{

			
							type =  form
							form = Buyer_Products
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														fetch_wardrobe = Buyer_Mapping_Wardrobes[Buyer_Product_Mapping == input.Buyer_Product_Mapping && Wardrobe == input.Style_ID.Wardrobe];
													if(fetch_wardrobe.count() == 0)
													{
														insert into Buyer_Mapping_Wardrobes
														[
															Added_User=zoho.loginuser
															Buyer_Product_Mapping=input.Buyer_Product_Mapping
															Product_Category=input.Style_ID.Style_Category
															Wardrobe=input.Style_ID.Wardrobe
														]
													}
													else
													{
														cat_list = fetch_wardrobe.Product_Category.ID.getall();
														cat_list.add(input.Style_ID.Style_Category);
														fetch_wardrobe.Product_Category=cat_list;
													}
													openUrl("#Page:Buyer_Product_Mapping_Page?zc_LoadIn=embed-BuyerProducts&map_ID=" + input.Buyer_Product_Mapping,"same window");
													// thisapp.PageRefresh();
									)
								}
							}
			
						
			
}