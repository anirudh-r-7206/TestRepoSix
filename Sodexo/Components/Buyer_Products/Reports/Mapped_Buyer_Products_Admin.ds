list Mapped_Buyer_Products_Admin
{

		
					displayName = "Mapped Buyer Products - Admin"
					show all rows from Buyer_Products    
					(
						Style_ID as "Style ID"
						Colors
						Size
						Sell_Price as "QO Unit Price"
						Buy_Price as "PO Unit Price"
						HS_Name as "HS Code Region"
						HS_Code as "HS Code"
						Product_ID as "Product ID"
						Style_Name as "Style Name"
						Style_Description as "Style Description"
						Buyer_Product_Mapping as "Buyer Product Mapping"
					)
					custom actions
					(
						"Duplicate Product"
						(
			  			workflow = Duplicate_Buyer_Product
						show action in view header = true
						show action in edit record menu = true
						)
					)
				
		
}