default list All_Buyer_Products
{

		
					displayName = "Mapped Buyer Products"
					show all rows from Buyer_Products    
					(
						Style_ID as "Style ID"
						Colors
						Size
						Sell_Price as "QO Unit Price"
						Buy_Price as "PO Unit Price"
						HS_Name as "HS Code Region"
						HS_Code as "HS Code"
						Product_ID as "Product ID"
						Style_Name as "Style Name"
						Style_Description as "Style Description"
						Buyer_Product_Mapping as "Buyer Product Mapping"
						Style_Name.Style_Master_Code as "Style Master Code"
						Size.Size_Order as "Size Order"
						Style_Master_Code as "Style Master Code"
						Wardrobe_Name as "Wardrobe Name"
						Category
						Wardrobe_Data as "Wardrobe Data"
					)
					group by
					(
						Style_Name.Style_Master_Code ascending
					)
					sort by
					(
						Colors ascending
						Size.Size_Order ascending
					)
					custom actions
					(
						"Duplicate Product"
						(
			  			workflow = Duplicate_Buyer_Product
						show action in view header = true
						show action in edit record menu = true
						)
						"Edit "
						(
			  			workflow = Bulk_Edit
						show action in view header = true
						execute action for collection of records
						)
					)
				
		
}