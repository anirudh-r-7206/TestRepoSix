form Buyer_Products
{

		
					displayname = "Buyer Products"
					success message = "Buyer Product Added Successfully"
					Section
					(
						type = section
			 			row = 1
			 			column = 0   
						width = medium
					)
					Buyer_Product_Mapping
					(
						type = picklist	
						displayname = "Buyer Product Mapping"
						values  = Buyer_Product_Mapping.ID
		    			bidirectional = Style_Details
		    			displayformat = [ID]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have unique Product_ID
					(
		    			type = text
						displayname = "Product ID"
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Style_ID
					(
						type = picklist	
						displayname = "Style ID"
						values  = Add_Product.ID
		    			displayformat = [Style_ID]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Style_Name
					(
						type = picklist	
						displayname = "Style Name"
						values  = Add_Product.ID
		    			displayformat = [Style_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					Style_Description
					(
		    			type = textarea
						displayname = "Style Description"
						height = 100px
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Colors
					(
						type = picklist	
						values  = Add_Colors.ID
		    			displayformat = [Color_Name]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Size
					(
						type = picklist	
						values  = Create_Size.ID
		    			displayformat = [Size]
						sortorder = ascending
			 			row = 1
			 			column = 1   
						width = medium
					)
					must have Sell_Price
					(
						type = decimal
						displayname = "QO Unit Price"
						format = commadotwestern
			 			row = 1
			 			column = 1   
						width = small
					)
					must have Buy_Price
					(
						type = decimal
						displayname = "PO Unit Price"
						format = commadotwestern
			 			row = 1
			 			column = 1   
						width = small
					)
					Price_Validity
					(
		    			type = date
						displayname = "Price Validity"
						alloweddays = 0,1,2,3,4,5,6
			 			row = 1
			 			column = 1   
						width = small
					)
					must have HS_Name
					(
						type = picklist
						displayname = "HS Code Region"
						maxchar = 100
						values = {"USA","EU","APAC"}
			 			row = 1
			 			column = 1   
						width = small
					)
					must have HS_Code
					(
		    			type = text
						displayname = "HS Code"
			 			row = 1
			 			column = 1   
						width = small
					)
					Wardrobe_Name
					(
		    			type = formula
						displayname = "Wardrobe Name"
						value =  input.Style_ID.Wardrobe.Wardrobe_Name
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
					Category
					(
		    			type = formula
						value =  input.Style_ID.Style_Category.Product_Category
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
					Wardrobe_Id
					(
		    			type = formula
						displayname = "Wardrobe Id"
						value =  input.Style_ID.Wardrobe.ID
						visibility = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Category_Id
					(
		    			type = formula
						displayname = "Category Id"
						value =  input.Style_ID.Style_Category.ID
						visibility = false
			 			row = 1
			 			column = 1   
						width = medium
					)
					Wardrobe_Data
					(
		    			type = formula
						displayname = "Wardrobe Data"
						value =  "{'Wardrobe_Name':" + input.Style_ID.Wardrobe.Wardrobe_Name + ", 'Wardrobe_ID': " + input.Style_ID.Wardrobe.ID + ",'Product_Category':" + input.Style_ID.Style_Category.Product_Category + ",'Product_Category_ID':" + input.Style_ID.Style_Category.ID + "}"
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
					Style_Master_Code
					(
		    			type = formula
						displayname = "Style Master Code"
						value =  input.Style_ID.Style_Master_Code
						visibility = false
						display type = text
						format = plaintext
			 			row = 1
			 			column = 1   
						width = medium
					)
			
					actions
					{
						on add
						{
							submit
							(
		   						type = submit
		   						displayname = "Submit"
							)
						}
						on edit
						{
							update
							(
		   						type = submit
		   						displayname = "Update"
							)
							cancel
							(
		   						type = cancel
		   						displayname = "Cancel"
							)
						}
					}
				
		
}