returnJSON as "returnJSON"
{

			
							type =  form
							form = Trigger_Form
			
							record event = on add
			
							on success
							{
								actions 
								{
									custom deluge script
									(
														if(input.Action_field == "Get Wardrobe Data")
													{
														success message thisapp.helpers.getWardrobesAndCategories(input.Supplier_ID.toNumber());
													}
													delete from Trigger_Form[ID != input.ID];
									)
								}
							}
			
						
			
}