Delete_workflow2 as "Delete"
{

			
							type =  functions
							form = Fabric_Form
							execution type = for each record	
							on start
							{
								actions 
								{
								on click
								(
									reference = thisapp.References.Fabrics(input.ID);
													if(reference.trim() != "" && reference != null)
													{
														url = "#Form:Alert_References?zc_Header=false&Fabric_Form=" + input.ID;
														window = "popup window";
														openUrl(url,window);
													}
													else
													{
														delete from Fabric_Form[ID == input.ID];
													}
								)
								}
							}
						
			
}