<style>
	div[pagelinkname="Factory_Dashboard"], [pagelinkname="Factory_Dashboard"] div#elementsContainer{
		height: 100%;
	}
	div#html_snippet5 {
		height: 100% !important;
	}
	[pagelinkname="Factory_Dashboard"] .Layout.elemContainment {
		height: calc(100% - 1.5rem);
	}
	div#row_2 {
		height: calc(100% - 108px);
	}
	[pagelinkname="Factory_Dashboard"] .zc-pb-tile-card {
		overflow: unset;
	}
	[viewlinkname="Production_Orders"] .zc-new-report-header.row.zc-fixed-header{
		border-radius: 16px;
	}
	[viewlinkname="Production_Orders"] .zc-reports-footer-sec.zc-mfooter-search-icon
	{
		border-radius: 0 0 16px 16px !important;
		border-left: none;
		border-right: none;
	}
</style>

<div elName='zc-component' name="myOrder" style="height: 100%;" viewLinkName='Production_Orders' params='zc_Header=true&zc_MoreAction=false&zc_AddRec=false'></div>