<page linkname = "Buyer_Cart" parameters = "string appLinkName, string baseURL, string buyerCurrency, string buyerEmail, string buyerOrg, string buyerRegion, string imageFieldLinkName, string imgReportName, string reportPrivateLink, string userRole" displayname = "Buyer Cart"/>
<content>
<zml webDeviceConfig='{\"layout\":{\"displayType\":\"plain\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:0px;padding-bottom:0px;padding-left:0px;\"}}'>
	<layout>
		<row>
			<column width='100%'>
				<widgets elementName='Widget' importedTemplate='true'/> </column>
		</row>
