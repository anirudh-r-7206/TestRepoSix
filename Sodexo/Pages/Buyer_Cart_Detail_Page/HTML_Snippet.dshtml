<%
	// 	fetEmp = Employee[Mail_ID.equalsIgnoreCase(zoho.loginuserid)];
	// 	get_Order_Buyer = Order_Request[Buyer_Organisation == input.Buyer_ID && Factory == input.Suppliyer_ID && Order_By.Email == zoho.loginuserid && Status == "Awaiting QO Generation"];
	// 	input.CartCount = thisapp.Page.Cart_Count(input.Buyer_ID,input.Suppliyer_ID);
	get_Order_Buyer = Order_Request[Order_By.Email == thisapp.Dev.get_User_Email() && Factory == input.Supplier && Status == "Pending"];
	input.CartCount = (get_Order_Buyer.Order_details.ID.getall()).size();
	if(input.Cart_Delete_or_Submit == "Delete")
	{
		get_Order_Buyer.Order_details.clear();
		get_Order_Buyer.Cart_Total=0;
		// 		openUrl("#Script:page.refresh","same window");
		openUrl("#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&Supplier=" + input.Supplier,"same window");
	}
	else if(input.Cart_Delete_or_Submit == "Submit" && input.CartCount > 0)
	{
		get_Order_Buyer.Status="Awaiting QO Generation";
		// 		openUrl("#Script:page.refresh","same window");
		openUrl("#Page:Buyer_Cart_Page?zc_LoadIn=embed-BuyerCart&Supplier=" + input.Supplier,"same window");
	}
	%>
<style>
		.popupbox-wrapper:not(.zc-alert-popup-wrapper) .popupbox {
			width: 80% !important;
			overflow: unset !important;
		}
		.overAllDiv {
			height: calc(100vh - 110px);
			padding: 10px;
			background: var(--teritiary_bg_color);
			display: flex;
			flex-direction: column;
			gap: 15px;
		}
		.CartReportSection {
			height: calc(100% - 70px);
		}
		.HeaderSectionUser{
			position: absolute;
			z-index: 1;
			width: calc(100% - 100px);
			top: 28px;
		}
		.HeaderSectionUser, .ButtonsSection {
			height: 35px;
			padding: 10px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			background-color: #fff;
			border-radius: 10px;
		}
		.UserName, .ItemsCount {
			margin: 0px;
			font-size: 16px;
			font-weight: 600;
		}
		.ProceedBtn, .ResetBtn {
			padding: 10px;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #fff;
			font-size: 16px;
			background: var(--theme_brand_color);
			border: 1px solid #ffffff;
			border-radius: 25px;
		}
		/* Report Style */
		[viewLinkName='My_Cart_Details'] .record-container .scroll-fix {
			padding-top: 10px;
		}
		[viewLinkName='My_Cart_Details'] .record-container.record-container-fix {
			padding: 0;
		}
		[viewLinkName='My_Cart_Details'] .gridpad.gridpad-table {
			background: var(--theme_light_bg_color);
		}
		[viewlinkname="My_Cart_Details"] .zc-pb-tile-card.zc-pb-tile-cnt-wrapper{
			border-radius: 10px !important;
		}
		[viewlinkname="My_Cart_Details"] .view-header, [viewlinkname="My_Cart_Details"] .col-sm-4.zc-reportoptionheader {
			padding-right: 10px !important;
		}
		[viewlinkname="My_Cart_Details"] {
			height: 100% !important;
		}
		form[name="Order_Details"] .formContainer {
			padding-left: 14px !important;
		}
<%
	if(input.CartCount == 0)
	{
		%>
.ProceedBtn {
				display: none;
			}
<%
	}
	%>
</style>
	<div class="overAllDiv">
		<div class="HeaderSectionUser">
			<p class="UserName">Welcome <%=get_Order_Buyer.Buyer_Name.User_Name%>,</p>
			<p class="ItemsCount" style="padding-right: 20px;">Total Items : <%=if(input.CartCount != null,input.CartCount,"0")%></p>
		</div>
		<div class="CartReportSection">
			<div elName='zc-component' name='CartView' viewLinkName='My_Cart_Details' params='zc_Header=true&zc_Footer=false&zc_AddRec=false&zc_MoreAction=false&zc_ReportName=false&zc_Search=true&Order_Request=<%=get_Order_Buyer.Order_ID%>'></div>
		</div>
<%
	if(input.CartCount > 0)
	{
		%>
<div class="ButtonsSection" style="height: 50px; justify-content: center; gap: 15px;">
			<a class="ResetBtn" href="#Page:Buyer_Cart_Detail_Page?zc_LoadIn=dialog&Supplier=<%=input.Supplier%>&Cart_Delete_or_Submit=Submit" style="width: 110px;">Submit</a>
			<a class="ResetBtn" href="#Page:Buyer_Cart_Detail_Page?zc_LoadIn=dialog&Supplier=<%=input.Supplier%>&Cart_Delete_or_Submit=Delete" style="width: 110px;">Reset Cart</a>
		</div>
<%
	}
	%>
</div>