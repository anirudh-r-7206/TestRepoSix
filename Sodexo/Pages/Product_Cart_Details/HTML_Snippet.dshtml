<%
	get_Buyer = Create_User[Email == thisapp.Dev.get_User_Email() && Status == "Active"];
	get_style = Style[Product_Code == input.Style_Master_Code];
	get_Product = Buyer_Products[Buyer_Product_Mapping.Buyer == get_Buyer.Associated_Buyer && Buyer_Product_Mapping.Factory_Allocated == input.Supplier && Style_ID.Style_Code in get_style.ID.getall() && Style_ID.Wardrobe == input.Wardrobe && Style_ID.Style_Category == input.Category];
	price = get_Product.Sell_Price.getall();
	discription = get_Product.Style_Description;
	%>
<html>

<head>
	<style>
		<%=thisapp.Style.Cart_Detail_Page_Style()%>
		.zc-content-loader {
			display: none !important;
		}
	</style>
</head>

<body>

		<div class="product-container">

				<!-- Left: Product Image -->
				<div class="product-image">
					 <!-- <img src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=600&q=80" alt="Product" /> -->
		   <div elName='zc-component' name="ProductIMG" PageLinkName='Dynamic_Product_Image' params='zc_Header=false&Product_ID=<%=get_Product.Style_ID%>'>Loading View...</div>
				</div>

				<!-- Right: Product Details -->
				<div class="product-details">

					 <!-- <div class="product_name">Product Name</div>
						<div class="product_price">$<%=price.smallest()%></div>

						<div class="product-description">
								<%=discription%>
						</div> -->

						<!-- Size -->
						<div>
				<div elName='zc-component' formLinkName='Buyer_Cart_Detail' params='zc_Header=false&amp;zc_SuccMsg=Data Added Successfully!&amp;zc_SubmitVal=Submit&amp;zc_ResetVal=Reset&Supplier=<%=input.Supplier%>&Product_Code=<%=input.Style_Master_Code%>&Wardrobe=<%=input.Wardrobe%>&Product_Category=<%=input.Category%>'></div>
						</div>

				</div>
		</div>
</body>

</html>