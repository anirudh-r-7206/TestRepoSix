<%
	get_User = Create_User[Email == zoho.loginuserid && Status == "Active"];
	// 	if(get_User.User_Type != "Buyer")
	// 	{
	// 		openUrl("#Page:Alert_Message?Message_Type=Buyer_Page","same window");
	// 	}
	get_Data = thisapp.Page.dashboard_data("factoryData");
	%>
<html>

<head>
		<title>Document</title>
	<style>
	
		.zc-content-loader {
			display: none !important;
		}

		<%=thisapp.Style.buyer_Dashboard_Styles()%>
		
		[pagelinkname="Factory_Dashboard_V2"], [pagelinkname="Factory_Dashboard_V2"] div#elementsContainer, [pagelinkname="Factory_Dashboard_V2"] .Layout.elemContainment, [pagelinkname="Factory_Dashboard_V2"] div#row_1{
			height: 100%;
		}
		[pagelinkname="Factory_Dashboard_V2"] .Layout.elemContainment{
			padding: 0 !important;
		}
	</style>
</head>

