calendar Service_Calendar
{
    displayName = "Service Calendar"
    show all rows from Service_Requests [Scheduled_Start is not null]
    (
        Service_Code
        Customer
        Customer_Name
        Priority
        Service_Status
        Scheduled_Start
        Scheduled_End
        Technician
    )
    filters
    (
        Priority
        Service_Status
        Technician
    )
    options
    (
        display type = month
        week start day = monday
        display field = Service_Code
        start date = Scheduled_Start
        end date = Scheduled_End
        allowed views = month,week,day
        default date
        (
            day = Today
            month = Currentmonth
            year = Currentyear
        )
    )
}
