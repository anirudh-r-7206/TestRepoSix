form Service_Requests
{
    displayname = "Service Requests"
    Service_Details
    (
        type = section
        displayname = "Service Details"
        row = 1
        column = 0
        width = medium
    )
    Service_Code
    (
        type = autonumber
        displayname = "Service Code"
        start index = 2301
        row = 1
        column = 1
        width = medium
    )
    Customer
    (
        type = picklist
        values = Customer_Master.ID
        displayformat = [Customer_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Customer_Name
    (
        type = text
        displayname = "Customer Name"
        maxchar = 150
        row = 1
        column = 2
        width = medium
    )
    Phone
    (
        type = phonenumber
        row = 1
        column = 1
        width = medium
    )
    Email
    (
        type = email
        row = 1
        column = 2
        width = medium
    )
    Related_Order
    (
        type = picklist
        displayname = "Related Order"
        values = Customer_Orders.ID
        displayformat = [Order_Code]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Product_or_Shutter_Details
    (
        type = textarea
        displayname = "Product or Shutter Details"
        height = 120px
        row = 1
        column = 2
        width = medium
    )
    Issue_Description
    (
        type = textarea
        displayname = "Issue Description"
        height = 140px
        row = 1
        column = 1
        width = medium
    )
    Service_Address_Section
    (
        type = section
        displayname = "Service Address"
        visibility = true
        row = 2
        column = 1
        width = medium
    )
    Service_Address
    (
        type = address
        displayname = "Service Address"
        address_line_1
        (
            type = address_line_1
            displayname = "Address Line 1"
        )
        address_line_2
        (
            type = address_line_2
            displayname = "Address Line 2"
        )
        district_city
        (
            type = district_city
            displayname = "City / District"
        )
        state_province
        (
            type = state_province
            displayname = "State / Province"
        )
        postal_Code
        (
            type = postal_Code
            displayname = "Postal Code"
        )
        country
        (
            type = country
            displayname = "Country"
        )
        latitude
        (
            type = latitude
            displayname = "Latitude"
            visibility = false
        )
        longitude
        (
            type = longitude
            displayname = "Longitude"
            visibility = false
        )
        row = 2
        column = 1
        width = medium
    )
    Scheduling_Status
    (
        type = section
        displayname = "Scheduling Status"
        visibility = true
        row = 3
        column = 1
        width = medium
    )
    Request_Date
    (
        type = date
        displayname = "Request Date"
        initial value = "${zoho.currentdate}"
        row = 3
        column = 1
        width = medium
    )
    Priority
    (
        type = picklist
        maxchar = 100
        values = {"Low","Normal","High","Urgent"}
        initial value = "Normal"
        row = 3
        column = 2
        width = medium
    )
    Service_Status
    (
        type = picklist
        displayname = "Service Status"
        maxchar = 100
        values = {"New","Triage","Scheduled","In Progress","Parts Required","Repaired","Completed","Closed","Cancelled"}
        initial value = "New"
        row = 3
        column = 1
        width = medium
    )
    Scheduled_Start
    (
        type = datetime
        displayname = "Scheduled Start"
        row = 3
        column = 2
        width = medium
    )
    Scheduled_End
    (
        type = datetime
        displayname = "Scheduled End"
        row = 3
        column = 1
        width = medium
    )
    Technician
    (
        type = picklist
        values = Add_Employee.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 3
        column = 2
        width = medium
    )
    Technician_Notes
    (
        type = textarea
        displayname = "Technician Notes"
        height = 120px
        row = 3
        column = 1
        width = medium
    )
    Parts_Usage_Section
    (
        type = section
        displayname = "Parts Usage"
        visibility = false
        row = 4
        column = 1
        width = medium
    )
    Parts_Usage
    (
        type = grid
        displayname = "Parts Usage"
        values = Service_Parts_Usage.ID
        bidirectional = Service_Request
        defaultrow = 0
        row = 4
        column = 1
        width = medium
    )
    Completion_Details
    (
        type = section
        displayname = "Completion Details"
        visibility = true
        row = 5
        column = 1
        width = medium
    )
    Linked_PO
    (
        type = picklist
        displayname = "Linked PO"
        values = Purchase_Orders.ID
        displayformat = [PO_Number]
        searchable = true
        row = 5
        column = 1
        width = medium
    )
    Completion_Date
    (
        type = date
        displayname = "Completion Date"
        row = 5
        column = 2
        width = medium
    )
    Service_Photos
    (
        type = upload file
        displayname = "Service Photos"
        file count = 10
        row = 5
        column = 1
        width = medium
    )
    Stock_Consumption_Posted
    (
        type = checkbox
        displayname = "Stock Consumption Posted"
        initial value = false
        row = 5
        column = 2
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
