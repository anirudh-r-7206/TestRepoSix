form Purchase_Orders
{
    displayname = "Purchase Orders"
    PO_Details
    (
        type = section
        displayname = "PO Details"
        row = 1
        column = 0
        width = medium
    )
    PO_Number
    (
        type = autonumber
        displayname = "PO Number"
        start index = 2001
        row = 1
        column = 1
        width = medium
    )
    Vendor
    (
        type = picklist
        values = Vendor_Master.ID
        displayformat = [Vendor_Name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    PO_Date
    (
        type = date
        displayname = "PO Date"
        initial value = "${zoho.currentdate}"
        row = 1
        column = 2
        width = medium
    )
    Expected_Delivery_Date
    (
        type = date
        displayname = "Expected Delivery Date"
        row = 1
        column = 1
        width = medium
    )
    PO_Status
    (
        type = picklist
        displayname = "PO Status"
        maxchar = 100
        values = {"Draft","Submitted for Approval","Approved","Ordered","Partially Received","Received","Cancelled"}
        initial value = "Draft"
        row = 1
        column = 2
        width = medium
    )
    Requested_By
    (
        type = picklist
        displayname = "Requested By"
        values = Add_Employee.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 1
        column = 1
        width = medium
    )
    Approved_By
    (
        type = picklist
        displayname = "Approved By"
        values = Add_Employee.ID
        displayformat = [Employee_Name.first_name]
        searchable = true
        row = 1
        column = 2
        width = medium
    )
    Approved_Date
    (
        type = date
        displayname = "Approved Date"
        row = 1
        column = 1
        width = medium
    )
    Related_Work
    (
        type = section
        displayname = "Related Work"
        visibility = true
        row = 2
        column = 1
        width = medium
    )
    Linked_Production
    (
        type = picklist
        displayname = "Linked Production"
        values = Production_Records.ID
        displayformat = [Production_Code]
        searchable = true
        row = 2
        column = 1
        width = medium
    )
    Linked_Service
    (
        type = picklist
        displayname = "Linked Service"
        values = Service_Requests.ID
        displayformat = [Service_Code]
        searchable = true
        row = 2
        column = 2
        width = medium
    )
    PO_Line_Items
    (
        type = section
        displayname = "PO Line Items"
        visibility = false
        row = 3
        column = 1
        width = medium
    )
    Lines
    (
        type = grid
        displayname = "Lines"
        values = Purchase_Order_Lines.ID
        bidirectional = Purchase_Order
        defaultrow = 1
        row = 3
        column = 1
        width = medium
    )
    Totals_Documents
    (
        type = section
        displayname = "Totals Documents"
        visibility = true
        row = 4
        column = 1
        width = medium
    )
    Subtotal
    (
        type = decimal
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    Discount_Total
    (
        type = decimal
        displayname = "Discount Total"
        decimalplace = 2
        row = 4
        column = 2
        width = medium
    )
    Tax_Total
    (
        type = decimal
        displayname = "Tax Total"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    Shipping_or_Adjustment
    (
        type = decimal
        displayname = "Shipping or Adjustment"
        decimalplace = 2
        row = 4
        column = 2
        width = medium
    )
    Total_Amount
    (
        type = decimal
        displayname = "Total Amount"
        decimalplace = 2
        row = 4
        column = 1
        width = medium
    )
    PO_Document
    (
        type = upload file
        displayname = "PO Document"
        row = 4
        column = 2
        width = medium
    )
    Notes
    (
        type = textarea
        height = 120px
        row = 4
        column = 1
        width = medium
    )
    actions
    {
        on add
        {
            Submit
            (
                type = submit
                displayname = "Submit"
            )
            Reset
            (
                type = reset
                displayname = "Reset"
            )
        }
        on edit
        {
            Update
            (
                type = submit
                displayname = "Update"
            )
            Cancel
            (
                type = cancel
                displayname = "Cancel"
            )
        }
    }
}
