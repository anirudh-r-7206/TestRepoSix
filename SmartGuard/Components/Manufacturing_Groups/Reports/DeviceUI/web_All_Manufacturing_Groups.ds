            (
                Edit
                Duplicate
                Delete
            )
        )
        action
        (
            on click
            (
                View Record
            )
            on right click
            (
                Edit
                Delete
                Duplicate
                View Record
            )
        )
    )
    detailview
    (
        layout
        (
            type = 1
            datablock1
            (
                layout type = -2
                fields
                (
                    Group_Code
                    Group_Name
                    Suggested_Basis
                    Product
                    Colour
                    Planned_Date
                    Group_Status
                    Active
                )
            )
        )
        menu
